                            }</script><script>var post_article={"post_id":924495930,"post_user":{"user_id":"1240112345602898","user_nickname":"毛竹下的橙子","user_name":"isadoo","user_v":0,"user_type":0,"user_is_majia":false,"user_level":0,"user_first_en_name":"mzxdcz","user_age":"17.9年","user_influ_level":5,"user_black_type":0,"user_bizflag":"2","user_bizsubflag":"001001","user_extend":{"uid":"1240112345602898","ncfh_authorid":247657,"ncfh_status":1,"ncfh_orgtag":"001001","ncfh_isdel":0,"ncfh_bigvip":0,"ncfh_qualificationinfo":"","ncfh_organizationtag":0,"ncfh_updatetime":"2022-08-09 22:43:21","pushtime":"2022-08-09 22:43:45"},"user_introduce":"一流选手研究情绪，二流选手研究政策，三流选手研究基本面，四流选手看K线。\n本人一直致力于情绪流龙头战法研究——欢迎关注交流","user_extendinfos":{"user_accreditinfos":"[{\"accreditation_type\":\"001001\",\"accreditation_title\":\"\",\"accreditation_status\":\"0\",\"accreditation_abandon\":\"0\"}]","deactive":"0","user_v_hide":null,"user_column":"{\"ColumnList\":[\"4149\"],\"ColumnPostCount\":1}","is_enterprise":"false","new_medal":"{\"medal_list\":[],\"medal_count\":0}","asset_rank":null,"spzhshow":null},"user_medal_details":[],"passport_medal_details":{"medal_list":[],"medal_count":0},"column_user_fans_count":0},"post_guba":{"stockbar_type":205,"stockbar_code":"cfhpl","stockbar_inner_code":"cfhpl","stockbar_name":"财富号评论","stockbar_market":"cfhpl","stockbar_quote":2,"stockbar_exchange":-1,"stockbar_external_code":"cfhpl","bar_info":{"QMarket":-404,"QCode":"","OuterCode":"cfhpl","Category":205,"Market":-1,"ShortName":"财富号评论","Type":[-1]}},"post_title":"4月22日 龙头战法复盘及逻辑梳理","post_content":"<p>走势梳理：医药板块继续退潮，<a href=\"https://quote.eastmoney.com/unify/r/0.002030\">达安基因</a>全天水下，仅叠加网络游戏的<a href=\"https://quote.eastmoney.com/unify/r/0.300151\">昌红科技</a>晋级。</p><p>大数据板块，走出了情绪修复，<a href=\"https://quote.eastmoney.com/unify/r/0.002400\">省广集团</a>加速，<a href=\"https://quote.eastmoney.com/unify/r/0.300002\">神州泰岳</a>涨停，<a href=\"https://quote.eastmoney.com/unify/r/0.002152\">广电运通</a>，<a href=\"https://quote.eastmoney.com/unify/r/0.002104\">恒宝股份</a>反包，众应互联晋级失败。</p><p>基建板块，<a href=\"https://quote.eastmoney.com/unify/r/1.600268\">国电南自</a>分歧上板，<a href=\"https://quote.eastmoney.com/unify/r/1.601789\">宁波建工</a>弱转强上板，<a href=\"https://quote.eastmoney.com/unify/r/0.002480\">新筑股份</a>继续大单顶一字。特高压属性出现首板助攻，<a href=\"https://quote.eastmoney.com/unify/r/1.601179\">中国西电</a>全天水下，美芝股份，<a href=\"https://quote.eastmoney.com/unify/r/1.603183\">建研院</a>等晋级失败。板块分歧较大，明日观察是否走反包修复。</p><p>食品板块 受世界粮食紧缺消息刺激午后集体爆发，身位股<a href=\"https://quote.eastmoney.com/unify/r/0.000019\">深粮控股</a>，前龙头<a href=\"https://quote.eastmoney.com/unify/r/1.600127\">金健米业</a>等，纷纷上板。明日预期分化，只关注3板深粮控股能否弱转强。</p><p>精彩逻辑分享：至金健米业6板空间高度以来，一直被压制到5板左右导致市场被迫走N+板路线，皆受制于金健米业周期。国电南自今日7板晋级具有非凡意义，打通了短线上升通道，故称为国电南自周期！</p><p>明日推演：7板 国电南自 周期妖股，理论上还存在2次确定性上车机会。1，PK掉省广集团的换手机会。2，断板后的首阴机会（水上抢筹盘口）。</p><p> N+3板 省广集团 今日继续缩量加速，已无买点，持筹者的盛宴。</p><p> 3板 深粮控股 分歧转一致，梯队完整，关注加速机会。</p><p>注：今日辨识度板较多，大多套利逻辑不构成龙头买点。</p><p>总结：超短情绪处于一个可操作的状态,且无极端杀跌，但龙头的两条线分化明显，小弟助攻龙头后纷纷冲高回落，后排资金被农业分流明显，明日若无修复，省广集团如果继续缩量将会受到承压，国电南自走出一致性以后，冰点将接踵而至。</p>","post_abstract":"走势梳理：医药板块继续退潮，达安基因全天水下，仅叠加网络游戏的昌红科技晋级。大数据板块，走出了情绪修复，省广集团加速，神州泰岳涨停，广电运通，恒宝股份反包，众应互联晋级失败。基建板块，国电南自分歧上板，宁波建工弱转强上板，新筑股份继续大单顶一字。特高压属性出现首板助攻，中国西电全天水下，美芝股份，建研院等晋级失败。板块分歧较大，明日观察是否走反包修复。食品板块受世界粮食紧缺消息刺激午后集体爆发，...","post_publish_time":"2020-04-22 17:15:34","post_last_time":"2020-04-22 17:17:53","post_display_time":"2020-04-22 17:15:34","post_ip":"","post_state":0,"post_checkState":0,"post_click_count":3500,"post_forward_count":0,"post_comment_count":0,"post_comment_authority":0,"post_like_count":1,"post_is_like":false,"post_is_collected":false,"post_type":20,"post_source_id":"20200422171520965711910","post_top_status":0,"post_status":0,"post_from":"东方财富Android版","post_from_num":42,"post_pdf_url":"","post_has_pic":false,"has_pic_not_include_content":false,"post_pic_url":[],"source_post_id":0,"source_post_state":0,"source_post_user_id":"","source_post_user_nickname":"","source_post_user_type":0,"source_post_user_is_majia":false,"source