  <script type="application/json" data-target="react-app.embeddedData">{"payload":{"codeViewRepoRoute":{"path":"/","refInfo":{"name":"main","listCacheKey":"v0:1790758450.0","canEdit":false,"refType":"branch","currentOid":"91de43dac619e901b4ebae7366cd52f9c681cc85"},"tree":{"items":[{"name":"chaogu","path":"chaogu","contentType":"directory"},{"name":"docs","path":"docs","contentType":"directory"},{"name":"licenses","path":"licenses","contentType":"directory"},{"name":"tools","path":"tools","contentType":"directory"},{"name":".gitignore","path":".gitignore","contentType":"file"},{"name":"AGENTS.md","path":"AGENTS.md","contentType":"file"},{"name":"LICENSE","path":"LICENSE","contentType":"file"},{"name":"README.md","path":"README.md","contentType":"file"},{"name":"THIRD_PARTY_NOTICES.md","path":"THIRD_PARTY_NOTICES.md","contentType":"file"},{"name":"run.py","path":"run.py","contentType":"file"},{"name":"setup.sh","path":"setup.sh","contentType":"file"}],"totalCount":11,"templateDirectorySuggestionUrl":null,"readme":null,"showBranchInfobar":false},"userNameDisplayConfiguration":null,"treeExpanded":false,"symbolsExpanded":false,"copilotSWEAgentEnabled":false,"copilotAccessAllowed":false,"isOverview":true,"overview":{"banners":{"shouldRecommendReadme":false,"isPersonalRepo":false,"showUseActionBanner":false,"actionSlug":null,"actionId":null,"showProtectBranchBanner":false,"requiredCustomPropertyValuesMissingCount":0,"transactionalMessageBanner":null,"publishBannersInfo":{"dismissActionNoticePath":"/settings/dismiss-notice/publish_action_from_repo","releasePath":"/dongdonglog/a-share-observer/releases/new?marketplace=true","showPublishActionBanner":false},"interactionLimitBanner":null,"showInvitationBanner":false,"inviterName":null,"actionsMigrationBannerInfo":{"releaseTags":[],"showImmutableActionsMigrationBanner":false,"initialMigrationStatus":null},"copilotSurveyBanner":null,"showSpammyBanner":false,"blockedContributorsBanner":null,"codespacesSurveyBanner":null},"codeButton":{"contactPath":"/contact","isEnterprise":false,"local":{"protocolInfo":{"httpAvailable":true,"sshAvailable":null,"httpUrl":"https://github.com/dongdonglog/a-share-observer.git","showCloneWarning":null,"sshUrl":null,"sshCertificatesRequired":null,"sshCertificatesAvailable":null,"ghCliUrl":"gh repo clone dongdonglog/a-share-observer","defaultProtocol":"http","newSshKeyUrl":"/settings/ssh/new","setProtocolPath":"/users/set_protocol?protocol_type=clone"},"platformInfo":{"cloneUrl":"https://desktop.github.com","showVisualStudioCloneButton":false,"visualStudioCloneUrl":"https://windows.github.com","showXcodeCloneButton":false,"xcodeCloneUrl":"xcode://clone?repo=https%3A%2F%2Fgithub.com%2Fdongdonglog%2Fa-share-observer","zipballUrl":"/dongdonglog/a-share-observer/archive/refs/heads/main.zip"}},"newCodespacePath":"/codespaces/new?hide_repo_select=true\u0026repo=1397411165"},"popovers":{"rename":null,"renamedParentRepo":null},"commitCount":"1","overviewFiles":[{"displayName":"README.md","repoName":"a-share-observer","refName":"main","path":"README.md","preferredFileType":"readme","tabName":"README","richText":"\u003carticle class=\"markdown-body entry-content container-lg\" itemprop=\"text\"\u003e\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch1 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eA股观察站 (a-share-observer) —— A股市场数据与情绪周期看板\u003c/h1\u003e\u003ca id=\"user-content-a股观察站-a-share-observer--a股市场数据与情绪周期看板\" class=\"anchor\" aria-label=\"Permalink: A股观察站 (a-share-observer) —— A股市场数据与情绪周期看板\" href=\"#a股观察站-a-share-observer--a股市场数据与情绪周期看板\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e一个可\u003cstrong\u003e长期驻留在本机\u003c/strong\u003e的 A 股数据看板：自动抓取涨停板生态数据，计算情绪周期指标，\n侦测新题材、评估题材延续性、识别龙头，并对次日情绪做可回验的统计预测。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e它不是选股软件，也不预测\"明天哪只票涨\"。它做的是\u003cstrong\u003e把短线交易者需要每天看的数据，\n自动化地整理成一张表\u003c/strong\u003e，让你把精力放在判断上，而不是搬运数字上。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e新电脑快速部署\u003c/h2\u003e\u003ca id=\"user-content-新电脑快速部署\" class=\"anchor\" aria-label=\"Permalink: 新电脑快速部署\" href=\"#新电脑快速部署\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003emacOS 上克隆后运行下面一条命令，即可创建 Python 环境、采集首批数据并安装登录自启：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"git clone https://github.com/dongdonglog/a-share-observer.git\ncd a-share-observer\n./setup.sh --collect --autostart\"\u003e\u003cpre\u003egit clone https://github.com/dongdonglog/a-share-observer.git\n\u003cspan class=\"pl-c1\"\u003ecd\u003c/span\u003e a-share-observer\n./setup.sh --collect --autostart\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003ccode\u003e--collect\u003c/code\u003e 会访问公开行情数据源；\u003ccode\u003e--autostart\u003c/code\u003e 会安装 macOS LaunchAgent，并在交易日收盘后自动采集。\n只想初始化项目时运行 \u003ccode\u003e./setup.sh\u003c/code\u003e。给其他 AI 助手部署时，可让它先读\n\u003ca href=\"/dongdonglog/a-share-observer/blob/main/AGENTS.md\"\u003e\u003ccode\u003eAGENTS.md\u003c/code\u003e\u003c/a\u003e 和\u003ca href=\"/dongdonglog/a-share-observer/blob/main/docs/AI_SETUP.md\"\u003eAI 部署教程\u003c/a\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003ePython 3.10+，没有第三方 Python 依赖。非 macOS 的手动部署方式见 \u003ca href=\"/dongdonglog/a-share-observer/blob/main/docs/AI_SETUP.md\"\u003eAI 部署教程\u003c/a\u003e。\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e新版看板（2026-09-30 起）：结论先行 + 一句话生成\u003c/h2\u003e\u003ca id=\"user-content-新版看板2026-09-30-起结论先行--一句话生成\" class=\"anchor\" aria-label=\"Permalink: 新版看板（2026-09-30 起）：结论先行 + 一句话生成\" href=\"#新版看板2026-09-30-起结论先行--一句话生成\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e打开 \u003ca href=\"http://127.0.0.1:8787/\" rel=\"nofollow\"\u003ehttp://127.0.0.1:8787/\u003c/a\u003e 。旧版仍在 \u003ccode\u003e/legacy\u003c/code\u003e。\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e顶部「今日结论」\u003c/strong\u003e：情绪阶段与姿态、明日前 3 主线及龙头、风险提示，大字一屏看完。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e一句话生成看板\u003c/strong\u003e：输入\"盯机器人这条线：龙头梯队、相关快讯、明天怎么做\"，\nAI 从面板目录里挑面板、填参数、排布局（AI 只能组织已有查询，\u003cstrong\u003e不能编造数据\u003c/strong\u003e）。\n可拖动排序、拉右下角改大小，自动保存为新标签页。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e主线 · 催化原文对得上了\u003c/strong\u003e：旧版按同花顺\"概念归属\"（一带一路、专精特新）聚合，\n再去取成分股的涨停原因，原文和题材对不上。新版 \u003ccode\u003echaogu/catalyst.py\u003c/code\u003e 按个股\n\u003cstrong\u003e真实涨停原因\u003c/strong\u003e（reason_type 关键词 + reason_info 里的同一段「行业原因」）聚类，\n每条主线展示的原文都来自它自己的成分股。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e明日关注\u003c/strong\u003e（\u003ccode\u003echaogu/outlook.py\u003c/code\u003e）：排序 = 今日涨停家数 + 2×连续活跃天数。\n这是回测选出来的：连续活跃 3 天的主线次日续存 74%，当日才冒头的只有 18%，\n\"今天突然放量\"反而多为一日游。每天取前 3 的续存率在样本外约 60%（全部主线基准约 34%），\n看板上的数字每天自动重算。它回答\"明天这条线还在不在\"，\u003cstrong\u003e不是\u003c/strong\u003e\"买龙头能赚钱\"。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eAI 明日作战计划\u003c/strong\u003e：基于当日数据写成，每个题材都附\"成立信号 / 放弃信号\"。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e盘中实时\u003c/strong\u003e（\u003ccode\u003echaogu/live.py\u003c/code\u003e，默认开启，\u003ccode\u003e--no-live\u003c/code\u003e 关闭）：快讯全天每 30 秒；\n交易时段涨停/炸板池每 60 秒、题材与催化原文每 3 分钟、指数每 30 秒，并重算当日情绪。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e点任意股票名\u003c/strong\u003e → 侧栏显示完整催化原文、近期涨停记录、相关快讯。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003eAI 配置（开机自启的看板读不到 shell 环境变量，所以要落盘一次）：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 run.py llm-setup                       # 从 ANTHROPIC_BASE_URL/AUTH_TOKEN 读取\npython3 run.py llm-setup --api openai --base https://ark.cn-beijing.volces.com/api/v3 \\\n    --key \u0026lt;KEY\u0026gt; --model \u0026lt;模型或接入点\u0026gt;          # 豆包/DeepSeek 等 OpenAI 兼容接口\"\u003e\u003cpre\u003epython3 run.py llm-setup                       \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 从 ANTHROPIC_BASE_URL/AUTH_TOKEN 读取\u003c/span\u003e\npython3 run.py llm-setup --api openai --base https://ark.cn-beijing.volces.com/api/v3 \\\n    --key \u003cspan class=\"pl-k\"\u003e\u0026lt;\u003c/span\u003eKEY\u003cspan class=\"pl-k\"\u003e\u0026gt;\u003c/span\u003e --model \u003cspan class=\"pl-k\"\u003e\u0026lt;\u003c/span\u003e模型或接入点\u003cspan class=\"pl-k\"\u003e\u0026gt;\u003c/span\u003e          \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 豆包/DeepSeek 等 OpenAI 兼容接口\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e未配置 AI 时，一句话生成退回关键词规则，其他面板不受影响。\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e注意：项目目录挪动后必须重跑 \u003ccode\u003e./tools/dash.sh install\u003c/code\u003e。launchd 配置里保存了\n仓库的绝对路径；移动后旧服务仍会访问原路径。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e〇、看板（长期驻留，推荐入口）\u003c/h2\u003e\u003ca id=\"user-content-〇看板长期驻留推荐入口\" class=\"anchor\" aria-label=\"Permalink: 〇、看板（长期驻留，推荐入口）\" href=\"#〇看板长期驻留推荐入口\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e一个跑在本机、长期开着的 Web 看板，打开就有当下情绪与候选。\n\u003cstrong\u003e这是日常最该用的入口\u003c/strong\u003e，报告是它的离线快照。\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"./tools/dash.sh start      # 启动 → http://127.0.0.1:8787/\n./tools/dash.sh status     # 状态\n./tools/dash.sh logs       # 日志\n./tools/dash.sh stop       # 停止\n./tools/dash.sh install    # 安装开机自启（重启后自动恢复）\n./tools/dash.sh autostart  # 查看自启状态\"\u003e\u003cpre\u003e./tools/dash.sh start      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 启动 → http://127.0.0.1:8787/\u003c/span\u003e\n./tools/dash.sh status     \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 状态\u003c/span\u003e\n./tools/dash.sh logs       \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 日志\u003c/span\u003e\n./tools/dash.sh stop       \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 停止\u003c/span\u003e\n./tools/dash.sh install    \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 安装开机自启（重启后自动恢复）\u003c/span\u003e\n./tools/dash.sh autostart  \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 查看自启状态\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e或直接 \u003ccode\u003epython3 run.py dash --port 8787\u003c/code\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e顶部「今日要点」：3 秒看完\u003c/h3\u003e\u003ca id=\"user-content-顶部今日要点3-秒看完\" class=\"anchor\" aria-label=\"Permalink: 顶部「今日要点」：3 秒看完\" href=\"#顶部今日要点3-秒看完\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e打开就先看这一条，不用翻表格：\u003c/p\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"情绪 53 发酵 | 打不打得动：情绪上行，可正常参与但别追高板\n跟随候选 5 个，其中低频 2 个 | 最热题材 一带一路 昨 10 家\n留痕战绩 D5 +4.0% 胜率 60%\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003e情绪 53 发酵 | 打不打得动：情绪上行，可正常参与但别追高板\n跟随候选 5 个，其中低频 2 个 | 最热题材 一带一路 昨 10 家\n留痕战绩 D5 +4.0% 胜率 60%\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e「打不打得动」按阶段给\u003cstrong\u003e容错高低\u003c/strong\u003e提示（冰点→右侧确认／高潮→\n\u003cstrong\u003e追高最危险\u003c/strong\u003e／退潮→\u003cstrong\u003e空仓等冰点\u003c/strong\u003e），并注明\n\u003cstrong\u003e这不是操作建议、不预测明天\u003c/strong\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e看板有六栏\u003c/h3\u003e\u003ca id=\"user-content-看板有六栏\" class=\"anchor\" aria-label=\"Permalink: 看板有六栏\" href=\"#看板有六栏\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e栏\u003c/th\u003e\n\u003cth\u003e内容\u003c/th\u003e\n\u003cth\u003e诚实标注\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e① 情绪周期\u003c/td\u003e\n\u003ctd\u003e温度/阶段/封板率/溢价/晋级率 + 近 10 日走势\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e描述状态有效，预测明天无效\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e② 新题材 \u0026amp; 延续性\u003c/td\u003e\n\u003ctd\u003e新题材侦测、延续性排序、\u003cstrong\u003e催化原文\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e评分\u003cstrong\u003e已证伪\u003c/strong\u003e；想象力给\u003cstrong\u003e判断清单\u003c/strong\u003e不给分数\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e③ 龙头\u003c/td\u003e\n\u003ctd\u003e全市场龙头（高度/换手/封单/首封）\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e可以看，不能追\u003c/strong\u003e（买不进占 37.7%）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e④ 大神风格 · 席位跟随\u003c/td\u003e\n\u003ctd\u003e跟随候选（低频/高频标记）、高胜率席位榜\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e唯一通过样本外检验的信号\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e⑤ 外围市场\u003c/td\u003e\n\u003ctd\u003e纳指/道指/标普/恒生/日经/黄金/美元\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e⑥ 快讯\u003c/td\u003e\n\u003ctd\u003e最近 12 条\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e四个为\"长期运行\"专门做的设计\u003c/h3\u003e\u003ca id=\"user-content-四个为长期运行专门做的设计\" class=\"anchor\" aria-label=\"Permalink: 四个为\u0026quot;长期运行\u0026quot;专门做的设计\" href=\"#四个为长期运行专门做的设计\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e数据新鲜度指示灯\u003c/strong\u003e。页头有绿/黄圆点，黄点时会醒目提示\n「数据不是今天」并列出各数据源的实际日期与最后采集时间。\n让你一眼看出是不是对着旧数据做决策。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e可选自动采集\u003c/strong\u003e（默认\u003cstrong\u003e关闭\u003c/strong\u003e）。加上 \u003ccode\u003e--autocollect\u003c/code\u003e 后，\n每个工作日 \u003cstrong\u003e15:30\u003c/strong\u003e 之后自动跑一次 \u003ccode\u003erun.py daily\u003c/code\u003e，看板自己保持最新：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"DASH_EXTRA=\u0026quot;--autocollect\u0026quot; ./tools/dash.sh start\n# 或自定义时间\npython3 run.py dash --autocollect --at 15:45\"\u003e\u003cpre\u003eDASH_EXTRA=\u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e--autocollect\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e ./tools/dash.sh start\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 或自定义时间\u003c/span\u003e\npython3 run.py dash --autocollect --at 15:45\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e为什么默认关闭\u003c/strong\u003e：采集会打外部接口（东财/新浪/腾讯），\n属于有副作用的网络行为，不该在看板一启动就悄悄发生。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e三道防重复守卫（都实测过）：\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e当天已成功采集（\u003ccode\u003ecollect_log\u003c/code\u003e 有记录）→ 不再跑；\u003c/li\u003e\n\u003cli\u003e非交易日（工作日但无行情，如节假日）→ 落盘标记，\u003cstrong\u003e跨重启也只试一次\u003c/strong\u003e；\u003c/li\u003e\n\u003cli\u003e同一天无论成败只尝试一次，避免崩溃循环打满外部接口。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e这个守卫是修出来的，不是一开始就对：最初只用\n\u003ccode\u003ecollect_log\u003c/code\u003e 判断，而\u003cstrong\u003e节假日采集\"成功但无数据\"\u003c/strong\u003e，\n判定恒为 False，会导致每 5 分钟重试一整天、反复打接口。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e数据按天变化，所以 15 秒 TTL 缓存\u003c/strong\u003e：连点刷新 / 多标签页 /\nAPI 轮询不再重复打重查询。\n实测 20 并发：总耗时 \u003cstrong\u003e11.20s → 1.59s\u003c/strong\u003e，尾延迟 \u003cstrong\u003e5826ms → 1468ms\u003c/strong\u003e\n（瓶颈是 \u003ccode\u003e_seats\u003c/code\u003e 单次约 500ms，占整页 90%）。\n缓存有\u003cstrong\u003e容量上限\u003c/strong\u003e——键含日期而日期每天都变，只按 TTL 淘汰会\n导致旧键永不淘汰、长期运行缓慢泄漏（实测 9 天攒 36 个键）。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e页面每 60 秒自刷新\u003c/strong\u003e；日志用 \u003ccode\u003e-u\u003c/code\u003e 无缓冲，出问题能立刻看到。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e怎么学大神：行为画像（\u003ccode\u003erun.py style\u003c/code\u003e）\u003c/h3\u003e\u003ca id=\"user-content-怎么学大神行为画像runpy-style\" class=\"anchor\" aria-label=\"Permalink: 怎么学大神：行为画像（run.py style）\" href=\"#怎么学大神行为画像runpy-style\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e胜率只回答「他准不准」，回答不了「他怎么做」——而后者才是能学的。\n看板 ④ 栏底部与 \u003ccode\u003epython3 run.py style\u003c/code\u003e 给出\u003cstrong\u003e可复现的行为特征\u003c/strong\u003e：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 run.py style --top 5              # D5 最高的席位 + 风格标签\npython3 run.py style --seat 华源证券股份有限公司深圳分公司   # 单个席位详解\"\u003e\u003cpre\u003epython3 run.py style --top 5              \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e D5 最高的席位 + 风格标签\u003c/span\u003e\npython3 run.py style --seat 华源证券股份有限公司深圳分公司   \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 单个席位详解\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e维度\u003c/th\u003e\n\u003cth\u003e怎么看\u003c/th\u003e\n\u003cth\u003e实测对比\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e买点\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e上榜日涨幅分布\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e逆势绿盘买入是最可靠的反面特征\u003c/strong\u003e（见下）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e频率\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e60 日上榜天数\u003c/td\u003e\n\u003ctd\u003e≤2 \u003cstrong\u003e低频\u003c/strong\u003e（D5 净 +5.40%）/ ≥10 \u003cstrong\u003e高频\u003c/strong\u003e（-2.11%）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e持有期\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e收益随期衰减形状\u003c/td\u003e\n\u003ctd\u003e「峰在 D5」值得持有；「一日游脉冲」靠隔夜溢价，学不来\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e标的\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e是否买退市股\u003c/td\u003e\n\u003ctd\u003e见下方 \u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e集中度\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e日均笔数、单笔金额中位\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e板块\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e主板/创业板/科创板/北交所分布\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e实证发现（182 个席位，每席位 ≥25 笔，按各席位主要买点分组）\u003c/strong\u003e：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e主要买点\u003c/th\u003e\n\u003cth\u003e席位数\u003c/th\u003e\n\u003cth\u003eD5 中位\u003c/th\u003e\n\u003cth\u003eD5 均值\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e低吸（红盘但不追高）\u003c/td\u003e\n\u003ctd\u003e3\u003c/td\u003e\n\u003ctd\u003e+0.27%\u003c/td\u003e\n\u003ctd\u003e+1.13%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e打板（涨停价买入）\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e133\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.18%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.39%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e逆势（绿盘买入）\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e46\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-2.87%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-3.09%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e能得到的结论只有一条，而且是负面的\u003c/strong\u003e：\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e「逆势绿盘买入」是最可靠的反面特征\u003c/strong\u003e（46 个席位，D5 中位 -2.87%）。\n而且 5 个最差席位里有 \u003cstrong\u003e4 个\u003c/strong\u003e是逆势型。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e \u003cstrong\u003e但「打板」并不因此就是好风格\u003c/strong\u003e——133 个打板型席位\nD5 中位 \u003cstrong\u003e-0.18%\u003c/strong\u003e，均值 -0.39%，\u003cstrong\u003e整体也是负的\u003c/strong\u003e。\n只有少数打板席位（华源证券深圳分公司 87.5% 打板、D5 +8.31%）\n很突出，但它们是\u003cstrong\u003e幸存者\u003c/strong\u003e，不能反推\"打板能赚\"。\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e这一条我一开始写错了：先看到华源 +8.31% 和牡丹江路 -22.94% 的\n对比，就下结论说\"优质席位共同点是打板\"。把 182 个席位全量分组后\n才发现打板组整体为负。\u003cstrong\u003e个例对比不能替代分组统计\u003c/strong\u003e——这正是本\n项目反复踩的同一个坑。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003col start=\"2\" dir=\"auto\"\u003e\n\u003cli\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e \u003cstrong\u003e「最差席位」其实是在接退市股，不是选股差。\u003c/strong\u003e\n该席位 45 笔里 \u003cstrong\u003e24 笔\u003c/strong\u003e买的是退市整理股（立方退×11、长药退×5、\n元道退×3），D10 -31.25%。\u003cstrong\u003e标的会归零\u003c/strong\u003e，把它当\"反面教材的\n选股风格\"学是学错方向的。看板为此单列「退市股」列。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 活跃度口径：\u003ccode\u003eseat_style\u003c/code\u003e 早期按 180 日窗口自定阈值，把华源证券\n（36/180 天）标成「高频」——但它是本项目验证过的\u003cstrong\u003e低频\u003c/strong\u003e优质席位。\n现已统一到\u003cstrong\u003e滚动 60 日、≤2/3-9/≥10\u003c/strong\u003e 的口径，\n与 \u003ccode\u003eactivity_edge\u003c/code\u003e 和 config 常量一致。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e健壮性（长期运行必须处理的事）\u003c/h3\u003e\u003ca id=\"user-content-健壮性长期运行必须处理的事\" class=\"anchor\" aria-label=\"Permalink: 健壮性（长期运行必须处理的事）\" href=\"#健壮性长期运行必须处理的事\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e问题\u003c/th\u003e\n\u003cth\u003e处理\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e节假日重复采集\u003c/td\u003e\n\u003ctd\u003e落盘 \u003ccode\u003eautocollect_attempt\u003c/code\u003e，跨重启也只试一次\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e日志不落盘\u003c/td\u003e\n\u003ctd\u003e\u003ccode\u003e-u\u003c/code\u003e 无缓冲（重定向时默认块缓冲会让日志迟迟不可见）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e并发尾延迟\u003c/td\u003e\n\u003ctd\u003e15s TTL 缓存，20 并发 11.20s → 1.59s\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e缓存内存泄漏\u003c/td\u003e\n\u003ctd\u003e容量上限 48 键，按写入时间淘汰最旧\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e留痕重复写库\u003c/td\u003e\n\u003ctd\u003e\u003ccode\u003ecollect_log\u003c/code\u003e 标记\"今日已记\"，每请求不再重试 INSERT\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e渲染异常\u003c/td\u003e\n\u003ctd\u003e返回 500 + 错误详情页，服务不退出\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e④b 留痕战绩：胜率只能靠记账改进\u003c/h3\u003e\u003ca id=\"user-content-b-留痕战绩胜率只能靠记账改进\" class=\"anchor\" aria-label=\"Permalink: ④b 留痕战绩：胜率只能靠记账改进\" href=\"#b-留痕战绩胜率只能靠记账改进\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e看板有第七栏 —— \u003cstrong\u003e留痕战绩\u003c/strong\u003e。这是\"提高胜率\"唯一的闭环。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e为什么必须有\u003c/strong\u003e：不记账，你只会记得赚钱的那几单，忘掉亏的。\n这是散户最常见的自我欺骗，也是\"感觉最近挺准\"的来源。\n没有 \u003ccode\u003esignal_log\u003c/code\u003e，事后无法区分「信号失效」和「我没照做」。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e看板每次渲染都会自动记账\u003c/strong\u003e（写进 \u003ccode\u003esignal_log\u003c/code\u003e），不依赖你记得手跑。\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 run.py track log      # 手动留痕某日候选\npython3 run.py track fill     # 回填真实行情结果\npython3 run.py track report   # 看战绩\"\u003e\u003cpre\u003epython3 run.py track log      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 手动留痕某日候选\u003c/span\u003e\npython3 run.py track fill     \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 回填真实行情结果\u003c/span\u003e\npython3 run.py track report   \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 看战绩\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003ccode\u003edaily\u003c/code\u003e 里也已接入，采集完自动留痕 + 回填。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e180 个交易日、1,117 条候选的真实战绩\u003c/strong\u003e：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e口径\u003c/th\u003e\n\u003cth\u003e持有期\u003c/th\u003e\n\u003cth\u003en\u003c/th\u003e\n\u003cth\u003e均值\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e中位\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e净收益\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003cth\u003e最差\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e全体（含买不进）\u003c/td\u003e\n\u003ctd\u003eD1\u003c/td\u003e\n\u003ctd\u003e519\u003c/td\u003e\n\u003ctd\u003e+1.70%\u003c/td\u003e\n\u003ctd\u003e+1.69%\u003c/td\u003e\n\u003ctd\u003e+1.30%\u003c/td\u003e\n\u003ctd\u003e58.6%\u003c/td\u003e\n\u003ctd\u003e-14.19%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e全体\u003c/td\u003e\n\u003ctd\u003eD5\u003c/td\u003e\n\u003ctd\u003e506\u003c/td\u003e\n\u003ctd\u003e+5.10%\u003c/td\u003e\n\u003ctd\u003e+3.38%\u003c/td\u003e\n\u003ctd\u003e+4.70%\u003c/td\u003e\n\u003ctd\u003e61.9%\u003c/td\u003e\n\u003ctd\u003e-36.51%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e全体\u003c/td\u003e\n\u003ctd\u003eD10\u003c/td\u003e\n\u003ctd\u003e487\u003c/td\u003e\n\u003ctd\u003e+3.64%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.96%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e+3.24%\u003c/td\u003e\n\u003ctd\u003e48.7%\u003c/td\u003e\n\u003ctd\u003e-41.84%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e剔除买不进\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003eD1\u003c/td\u003e\n\u003ctd\u003e487\u003c/td\u003e\n\u003ctd\u003e+1.03%\u003c/td\u003e\n\u003ctd\u003e+1.21%\u003c/td\u003e\n\u003ctd\u003e+0.63%\u003c/td\u003e\n\u003ctd\u003e55.9%\u003c/td\u003e\n\u003ctd\u003e-14.19%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e剔除买不进\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003eD5\u003c/td\u003e\n\u003ctd\u003e475\u003c/td\u003e\n\u003ctd\u003e+4.42%\u003c/td\u003e\n\u003ctd\u003e+2.96%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+4.02%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e60.2%\u003c/td\u003e\n\u003ctd\u003e-36.51%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e剔除买不进\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003eD10\u003c/td\u003e\n\u003ctd\u003e457\u003c/td\u003e\n\u003ctd\u003e+3.20%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-1.43%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e+2.80%\u003c/td\u003e\n\u003ctd\u003e47.7%\u003c/td\u003e\n\u003ctd\u003e-41.84%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e三个必须看出来的点：\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e买不进会显著拉高统计\u003c/strong\u003e。剔除后 D1 从 +1.70% 掉到 +1.03%，\n净收益只剩 \u003cstrong\u003e+0.63%\u003c/strong\u003e——几乎被跳空吃光。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eD10 中位数为负、均值却为正\u003c/strong\u003e（-1.43% vs +3.20%）。\n\u003cstrong\u003e中位数才代表典型一笔\u003c/strong\u003e：持有到 D10 大部分是亏的，\n靠少数大赢家撑起平均。→ \u003cstrong\u003e不要拉长持有期\u003c/strong\u003e。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eD5 是最优持有期\u003c/strong\u003e：净收益 +4.02%、中位 +2.96%、胜率 60.2%，\n三项同时为正。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 这 6.2% 的买不进比例\u003cstrong\u003e低于\u003c/strong\u003e席位分析里的 27.1%，\n因为留痕用的是 \u003ccode\u003efollow_signals\u003c/code\u003e 的当日候选（已经过滤过涨停），\n与全样本口径不同。两个数字都对，但\u003cstrong\u003e不是同一件事\u003c/strong\u003e，别混用。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e开机自启（可选，但\"长期运行\"建议装）\u003c/h3\u003e\u003ca id=\"user-content-开机自启可选但长期运行建议装\" class=\"anchor\" aria-label=\"Permalink: 开机自启（可选，但\u0026quot;长期运行\u0026quot;建议装）\" href=\"#开机自启可选但长期运行建议装\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e不装的话重启电脑看板就没了。\u003c/strong\u003e 一条命令装好：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"./tools/dash.sh install      # 装 + 立即启动\n./tools/dash.sh autostart    # 查状态\n./tools/dash.sh uninstall    # 卸载\"\u003e\u003cpre\u003e./tools/dash.sh install      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 装 + 立即启动\u003c/span\u003e\n./tools/dash.sh autostart    \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 查状态\u003c/span\u003e\n./tools/dash.sh uninstall    \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 卸载\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e底层是 launchd：\u003ccode\u003eRunAtLoad\u003c/code\u003e（开机自启）+ \u003ccode\u003eKeepAlive\u003c/code\u003e（崩溃自动拉起）\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ccode\u003eThrottleInterval=10\u003c/code\u003e（避免崩溃循环打满 CPU）。\n会写 \u003ccode\u003e~/Library/LaunchAgents/com.chaogu.dashboard.plist\u003c/code\u003e（工作区外），\n所以做成显式命令，\u003cstrong\u003e不偷偷装\u003c/strong\u003e。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e装的时候踩到 4 个坑，都已修\u003c/strong\u003e：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e坑\u003c/th\u003e\n\u003cth\u003e后果\u003c/th\u003e\n\u003cth\u003e修法\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003ePY=\"${PYTHON:-python3}\"\u003c/code\u003e 回退成\u003cstrong\u003e裸命令\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003elaunchd 没有 PATH，\u003cstrong\u003e开机永远起不来\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e强制解析绝对路径并校验可执行\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eplist 模板\u003cstrong\u003e不含 \u003ccode\u003e--autocollect\u003c/code\u003e\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e看板常驻但\u003cstrong\u003e永远显示旧数据\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e模板加 \u003ccode\u003e--autocollect\u003c/code\u003e；\u003ccode\u003eDASH_EXTRA\u003c/code\u003e 覆盖时同步替换\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003eautostart\u003c/code\u003e 用 \u003ccode\u003elaunchctl list\u003c/code\u003e 判断\u003c/td\u003e\n\u003ctd\u003e沙箱下被挡，\u003cstrong\u003e误报\"未安装\"\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e改查 plist 文件是否存在\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e写 \u003ccode\u003e~/Library/LaunchAgents/\u003c/code\u003e 被沙箱\u003cstrong\u003e静默拒绝\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e命令打印\"已安装\"，磁盘上还是\u003cstrong\u003e旧文件\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e复查 plist 内容而非只看输出\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 第 4 个坑最危险：\u003cstrong\u003e命令成功 ≠ 文件写入成功\u003c/strong\u003e。\n修完 bug 后第二次安装其实没落盘，是 \u003ccode\u003eplistlib\u003c/code\u003e 读出 \u003ccode\u003epython3\u003c/code\u003e\n才发现。看板装了自启却起不来时，先核对 plist 内容。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e自动采集的两个致命时序 bug（都已修）\u003c/h3\u003e\u003ca id=\"user-content-自动采集的两个致命时序-bug都已修\" class=\"anchor\" aria-label=\"Permalink: 自动采集的两个致命时序 bug（都已修）\" href=\"#自动采集的两个致命时序-bug都已修\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e这两个 bug 让看板\"看起来在自动更新、实际数据是错的\"，比崩溃更危险：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003ebug\u003c/th\u003e\n\u003cth\u003e症状\u003c/th\u003e\n\u003cth\u003e修法\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e盘中采的数据被当成当日终值\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e2026-09-30 的 \u003ccode\u003elimit_up\u003c/code\u003e/\u003ccode\u003etheme\u003c/code\u003e 是 \u003cstrong\u003e14:58\u003c/strong\u003e 采的（收盘前 2 分钟），\u003ccode\u003eturnover\u003c/code\u003e 状态 ok → 15:30 自动采集判定\"今天已采过\"→ \u003cstrong\u003e直接跳过\u003c/strong\u003e，看板一整天显示盘中未定稿数据且\u003cstrong\u003e不会自愈\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003ccode\u003e_already_collected\u003c/code\u003e 增加**\"采集时刻 \u0026gt;= 15:00\"**要求；盘中记录一律视为未采集\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e龙虎榜永远采不到\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e龙虎榜 \u003cstrong\u003e17:30\u003c/strong\u003e 才披露，15:30 那轮必然拿到 0 行且不重试 → ④栏席位一直停在前一天\u003c/td\u003e\n\u003ctd\u003e新增 \u003cstrong\u003e18:00 晚间补采\u003c/strong\u003e，有界重试（\u003ccode\u003e_LHB_MAX_ATTEMPTS=12\u003c/code\u003e）\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 补采这里我自己也写错过一次：\u003cstrong\u003e0 行时无条件标记 \u003ccode\u003eok\u003c/code\u003e\u003c/strong\u003e，\n于是 15:41 试采拿到 0 行就\"完成\"了，18:00 真正披露时不再补采。\n现在只有 \u003cstrong\u003e真拿到行\u003c/strong\u003e 才记 \u003ccode\u003eok\u003c/code\u003e，否则记 \u003ccode\u003eempty\u003c/code\u003e 继续试，\n并在有上界（避免休市日从 18:00 打到午夜）。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 顺带修了个精度问题：\u003ccode\u003ecollect_log\u003c/code\u003e 主键含 \u003ccode\u003ets\u003c/code\u003e，秒级精度下\n同一秒内的两次标记会\u003cstrong\u003e冲突并被静默吞掉\u003c/strong\u003e，导致重试计数偏小。\n已改为微秒。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e装了自启之后 \u003ccode\u003estop\u003c/code\u003e 会被 launchd 覆盖\u003c/strong\u003e：实测打印\"已停止\"，\n8 秒后进程又被 \u003ccode\u003eKeepAlive\u003c/code\u003e 拉起（pid 变了）。现在 \u003ccode\u003estop\u003c/code\u003e 会显式警告，\n真正停止要用 \u003ccode\u003e./tools/dash.sh uninstall\u003c/code\u003e。\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 看板是\u003cstrong\u003e只读展示\u003c/strong\u003e，不含任何下单功能。它给的是概率优势，\n不是保证——胜率 61% 意味着三次里还有一次多是亏的。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e一、快速开始\u003c/h2\u003e\u003ca id=\"user-content-一快速开始\" class=\"anchor\" aria-label=\"Permalink: 一、快速开始\" href=\"#一快速开始\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"cd /path/to/a-share-observer\n\n# 1) 首次：回填历史（涨停/炸板/题材 + 指数/外围），约 10 分钟\npython3 run.py backfill --days 90\n\n# 2) 回填历史价格（算\u0026quot;赚钱效应\u0026quot;必需），只跑曾涨停的股票，约 5-10 分钟\npython3 run.py prices --scope limitup --days 160\n\n# 3) 重算全部指标\npython3 run.py recompute\n\n# 4) 回填龙虎榜/席位数据（本工具唯一验证有效的信号，约 5 分钟）\npython3 run.py lhb --backfill --start 2026-01-01\n\n# 5) 生成报告\npython3 run.py report --print\"\u003e\u003cpre\u003e\u003cspan class=\"pl-c1\"\u003ecd\u003c/span\u003e /path/to/a-share-observer\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 1) 首次：回填历史（涨停/炸板/题材 + 指数/外围），约 10 分钟\u003c/span\u003e\npython3 run.py backfill --days 90\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 2) 回填历史价格（算\"赚钱效应\"必需），只跑曾涨停的股票，约 5-10 分钟\u003c/span\u003e\npython3 run.py prices --scope limitup --days 160\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 3) 重算全部指标\u003c/span\u003e\npython3 run.py recompute\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 4) 回填龙虎榜/席位数据（本工具唯一验证有效的信号，约 5 分钟）\u003c/span\u003e\npython3 run.py lhb --backfill --start 2026-01-01\n\n\u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 5) 生成报告\u003c/span\u003e\npython3 run.py report --print\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e日常使用（每天收盘后跑一次）：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 run.py daily\npython3 run.py lhb          # 采集当日龙虎榜（盘后才有数据）\npython3 run.py seat         # 席位排行与跟随信号\"\u003e\u003cpre\u003epython3 run.py daily\npython3 run.py lhb          \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 采集当日龙虎榜（盘后才有数据）\u003c/span\u003e\npython3 run.py seat         \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 席位排行与跟随信号\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e报告输出在 \u003ccode\u003ereports/YYYY-MM-DD.md\u003c/code\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e查看数据库状态：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 run.py status\"\u003e\u003cpre\u003epython3 run.py status\u003c/pre\u003e\u003c/div\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e二、核心概念：为什么要看这些指标\u003c/h2\u003e\u003ca id=\"user-content-二核心概念为什么要看这些指标\" class=\"anchor\" aria-label=\"Permalink: 二、核心概念：为什么要看这些指标\" href=\"#二核心概念为什么要看这些指标\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e短线（打板/接力）赚的是\u003cstrong\u003e情绪的钱\u003c/strong\u003e，不是公司的钱。所以判断的重点不是\"这家公司好不好\"，\n而是\"\u003cstrong\u003e现在市场上愿意接力的人多不多，他们赚不赚钱\u003c/strong\u003e\"。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e最重要的一个指标：昨日涨停溢价\u003c/h3\u003e\u003ca id=\"user-content-最重要的一个指标昨日涨停溢价\" class=\"anchor\" aria-label=\"Permalink: 最重要的一个指标：昨日涨停溢价\" href=\"#最重要的一个指标昨日涨停溢价\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"prev_zt_premium = 昨天所有涨停股，今天的平均涨跌幅\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003eprev_zt_premium = 昨天所有涨停股，今天的平均涨跌幅\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e这个数字直接度量\u003cstrong\u003e赚钱效应\u003c/strong\u003e：\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e为正\u003c/strong\u003e：昨天打板的人今天平均赚钱 → 接力意愿强 → 情绪升温\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e为负\u003c/strong\u003e：昨天打板的人今天平均亏钱 → 没人敢接力 → 情绪退潮\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e涨停家数再多，如果昨日涨停今天全亏，那也是退潮。\u003c/strong\u003e\n这是很多新手会误判的地方：只看涨停家数，以为\"市场很热\"。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e指标体系\u003c/h3\u003e\u003ca id=\"user-content-指标体系\" class=\"anchor\" aria-label=\"Permalink: 指标体系\" href=\"#指标体系\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e指标\u003c/th\u003e\n\u003cth\u003e含义\u003c/th\u003e\n\u003cth\u003e怎么用\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e涨停家数\u003c/td\u003e\n\u003ctd\u003e市场做多意愿的广度\u003c/td\u003e\n\u003ctd\u003e高但溢价为负 = 虚假繁荣\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e炸板家数 / 封板率\u003c/td\u003e\n\u003ctd\u003e封板资金的质量\u003c/td\u003e\n\u003ctd\u003e封板率跌破 62% 且高位 → 分歧\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e最高连板\u003c/td\u003e\n\u003ctd\u003e情绪的高度（空间板）\u003c/td\u003e\n\u003ctd\u003e高度坍塌是退潮的强信号\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e连板家数\u003c/td\u003e\n\u003ctd\u003e赚钱效应的持续性\u003c/td\u003e\n\u003ctd\u003e连板家数骤减 = 接力链断裂\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e昨日涨停溢价\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e赚钱效应（核心）\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e转负 = 退潮\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e晋级率\u003c/td\u003e\n\u003ctd\u003e昨涨停→今再涨停的比例\u003c/td\u003e\n\u003ctd\u003e反映接力的成功率\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e跌停家数\u003c/td\u003e\n\u003ctd\u003e亏钱效应的极端表现\u003c/td\u003e\n\u003ctd\u003e骤增 = 恐慌\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e情绪周期阶段\u003c/h3\u003e\u003ca id=\"user-content-情绪周期阶段\" class=\"anchor\" aria-label=\"Permalink: 情绪周期阶段\" href=\"#情绪周期阶段\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e工具把每天的指标合成一个 \u003cstrong\u003e0-100 的情绪温度分\u003c/strong\u003e，再叠加覆盖规则判断阶段：\u003c/p\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"冰点(0-22) → 修复(22-45) → 发酵(45-70) → 高潮(\u0026gt;70) → 退潮\n                                    ↘ 分歧 ↗\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003e冰点(0-22) → 修复(22-45) → 发酵(45-70) → 高潮(\u0026gt;70) → 退潮\n                                    ↘ 分歧 ↗\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e覆盖规则（优先级高于分数）：\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e退潮\u003c/strong\u003e：昨日涨停溢价 ≤ -1.5%\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e分歧\u003c/strong\u003e：最高板 ≥ 4 板，但封板率 \u0026lt; 62%\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e判断阶段的目的是决定\u003cstrong\u003e仓位\u003c/strong\u003e，而不是决定买哪只：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e阶段\u003c/th\u003e\n\u003cth\u003e通常的做法（参考，非建议）\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e冰点\u003c/td\u003e\n\u003ctd\u003e空仓或极轻仓等待，观察谁先起来\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e修复\u003c/td\u003e\n\u003ctd\u003e试错仓，打第一个卡位的龙头\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e发酵\u003c/td\u003e\n\u003ctd\u003e主升段，持有龙头，可加仓\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e高潮\u003c/td\u003e\n\u003ctd\u003e减仓，不追高，准备离场\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e分歧\u003c/td\u003e\n\u003ctd\u003e观察能否二次一致，谨慎\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e退潮\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e空仓\u003c/strong\u003e（最难也最值钱的操作）\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e三、题材分析\u003c/h2\u003e\u003ca id=\"user-content-三题材分析\" class=\"anchor\" aria-label=\"Permalink: 三、题材分析\" href=\"#三题材分析\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e新题材侦测\u003c/h3\u003e\u003ca id=\"user-content-新题材侦测\" class=\"anchor\" aria-label=\"Permalink: 新题材侦测\" href=\"#新题材侦测\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e一个题材满足以下条件会被标为\u003cstrong\u003e新题材\u003c/strong\u003e：\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e今日有涨停，且此前 5 个交易日内没有出现过\u003c/li\u003e\n\u003cli\u003e今日涨停家数 ≥ 2\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e另有\u003cstrong\u003e异动启动\u003c/strong\u003e：老题材但家数从 ≤1 突然跳到 ≥3。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e新题材是短线最值得关注的东西，因为新题材意味着\u003cstrong\u003e新的资金共识正在形成\u003c/strong\u003e，\n而老题材通常已经过了最佳介入点。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e每只股票还附带\u003cstrong\u003e催化原因原文\u003c/strong\u003e（来自同花顺对公开信息的汇总），\n例如某只 4 板股的题材是\"机器人轴承+汽车轴承+湖北国资\"，催化是\"柔性轴承试制完成、送样验证中\"。\n这让你不用自己去翻公告。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e延续性评分（\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 请看下面的实证结论，它不能预测延续）\u003c/h3\u003e\u003ca id=\"user-content-延续性评分️-请看下面的实证结论它不能预测延续\" class=\"anchor\" aria-label=\"Permalink: 延续性评分（⚠️ 请看下面的实证结论，它不能预测延续）\" href=\"#延续性评分️-请看下面的实证结论它不能预测延续\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e题材延续性看起来是判断\"能不能继续做\"的关键，工具用 6 个分项加权评分（0-100）。\n\u003cstrong\u003e但本节的检验表明这个评分预测不成立（见下方 \u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 小节）\u003c/strong\u003e，请先读结论再决定是否使用：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e分项\u003c/th\u003e\n\u003cth\u003e权重\u003c/th\u003e\n\u003cth\u003e含义\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003ebreadth 广度\u003c/td\u003e\n\u003ctd\u003e0.22\u003c/td\u003e\n\u003ctd\u003e今日涨停家数（8 家以上满分）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003etrend 趋势\u003c/td\u003e\n\u003ctd\u003e0.20\u003c/td\u003e\n\u003ctd\u003e相对昨日是放大还是衰减\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eleader 龙头\u003c/td\u003e\n\u003ctd\u003e0.22\u003c/td\u003e\n\u003ctd\u003e龙头的高度（4 板以上满分）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eechelon 梯队\u003c/td\u003e\n\u003ctd\u003e0.16\u003c/td\u003e\n\u003ctd\u003e有几个高度层（有 1板/2板/3板 的完整梯队最好）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eseal 封板质量\u003c/td\u003e\n\u003ctd\u003e0.12\u003c/td\u003e\n\u003ctd\u003e连板股占比\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003esector 板块\u003c/td\u003e\n\u003ctd\u003e0.08\u003c/td\u003e\n\u003ctd\u003e板块指数表现\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e梯队完整\u003c/strong\u003e比单纯家数多更重要：只有一堆首板没有连板，\n说明资金只愿意做一天，不愿意接力。\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 但是：这套评分的预测力经检验是\u003cstrong\u003e不成立的\u003c/strong\u003e\u003c/h4\u003e\u003ca id=\"user-content-️-但是这套评分的预测力经检验是不成立的\" class=\"anchor\" aria-label=\"Permalink: ⚠️ 但是：这套评分的预测力经检验是不成立的\" href=\"#️-但是这套评分的预测力经检验是不成立的\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e上面的权重是\u003cstrong\u003e手工设定\u003c/strong\u003e的，此前从未验证。补做检验后\n（\u003ccode\u003epython3 run.py theme-check\u003c/code\u003e，2026-05-28 ~ 2026-09-30）：\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e个股层面——这才是能不能赚钱的实质——完全没有预测力：\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e口径\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003eSpearman\u003c/th\u003e\n\u003cth\u003e说明\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e全样本\u003c/td\u003e\n\u003ctd\u003e6,131\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.021\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e无预测力\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e训练段\u003c/td\u003e\n\u003ctd\u003e4,257\u003c/td\u003e\n\u003ctd\u003e-0.016\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e留出段\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e1,874\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.029\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e样本外仍为负\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e1 板股分层最能说明问题\u003c/strong\u003e（基准续板率 13.9%）：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e评分\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003e次日续板率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e0-49\u003c/td\u003e\n\u003ctd\u003e711\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e18.4%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e50-59\u003c/td\u003e\n\u003ctd\u003e637\u003c/td\u003e\n\u003ctd\u003e15.4%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e60-69\u003c/td\u003e\n\u003ctd\u003e1,353\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e11.8%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e70-100\u003c/td\u003e\n\u003ctd\u003e1,866\u003c/td\u003e\n\u003ctd\u003e13.2%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e评分越高，续板率反而越低\u003c/strong\u003e（18.4% → 13.2%），控制连板高度后依然如此。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e题材层面只有微弱排序力，且不如直接看涨停家数：\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e特征\u003c/th\u003e\n\u003cth\u003eSpearman\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e复合评分（6 项加权）\u003c/td\u003e\n\u003ctd\u003e+0.055\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e仅\"昨日涨停家数\"\u003c/strong\u003e（\u003ccode\u003eprev_zt\u003c/code\u003e）\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+0.332\u003c/strong\u003e（是复合评分的 \u003cstrong\u003e6 倍\u003c/strong\u003e）\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 别把三个数字混为一谈，它们的\u003cstrong\u003e标签和特征都不同\u003c/strong\u003e：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e特征\u003c/th\u003e\n\u003cth\u003e标签\u003c/th\u003e\n\u003cth\u003e相关\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e昨日家数 \u003ccode\u003eprev_zt\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e未来 1~3 日是否还有涨停\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+0.332\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e当日家数 \u003ccode\u003ezt_count\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e未来 1~3 日是否还有涨停\u003c/td\u003e\n\u003ctd\u003e+0.216\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e当日家数 \u003ccode\u003ezt_count\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e次日涨停家数（连续）\u003c/td\u003e\n\u003ctd\u003e+0.278\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e复合评分\u003c/td\u003e\n\u003ctd\u003e未来 1~3 日是否还有涨停\u003c/td\u003e\n\u003ctd\u003e+0.055\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e看板②栏\u003cstrong\u003e按 \u003ccode\u003eprev_zt\u003c/code\u003e 排序\u003c/strong\u003e（唯一被 \u003ccode\u003evalidate_persistence_score\u003c/code\u003e\n验证过的那个），并用「有效 / 无效」直接标出哪列能用。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003e各分项单独表现暴露了问题所在：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e分项\u003c/th\u003e\n\u003cth\u003eSpearman\u003c/th\u003e\n\u003cth\u003e\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003eechelon 梯队\u003c/td\u003e\n\u003ctd\u003e+0.154\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003ebreadth 广度\u003c/td\u003e\n\u003ctd\u003e+0.138\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eleader 龙头\u003c/td\u003e\n\u003ctd\u003e+0.122\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eseal 封板质量\u003c/td\u003e\n\u003ctd\u003e+0.067\u003c/td\u003e\n\u003ctd\u003e弱\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003etrend 趋势\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.076\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e❌ \u003cstrong\u003e方向为负\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003esector 板块\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.115\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e❌ \u003cstrong\u003e方向为负\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e手工权重把有效信号稀释了，还混进了两个反向分项。\u003c/strong\u003e\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e结论怎么用\u003c/h4\u003e\u003ca id=\"user-content-结论怎么用\" class=\"anchor\" aria-label=\"Permalink: 结论怎么用\" href=\"#结论怎么用\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e不要把评分当作\"延续性预测\"\u003c/strong\u003e，它只是\u003cstrong\u003e题材热度的描述性指标\u003c/strong\u003e。\u003c/li\u003e\n\u003cli\u003e想知道延续性，\u003cstrong\u003e直接看涨停家数\u003c/strong\u003e（尤其是昨日家数）比看这个评分更准。\u003c/li\u003e\n\u003cli\u003e真正的可用信号在\u003cstrong\u003e席位跟随\u003c/strong\u003e（第五节），不在题材评分。\u003c/li\u003e\n\u003cli\u003e这个发现本身值得注意：\u003cstrong\u003e一个看起来合理的多因子加权，\n在验证前完全可能不如单一特征。\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e龙头识别\u003c/h3\u003e\u003ca id=\"user-content-龙头识别\" class=\"anchor\" aria-label=\"Permalink: 龙头识别\" href=\"#龙头识别\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e题材内龙头\u003c/strong\u003e：连板高度优先，其次首封时间早，再次涨幅\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e全市场龙头\u003c/strong\u003e：按高度、首封时间、封单额排序\u003c/li\u003e\n\u003c/ul\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e四、预测模块\u003c/h2\u003e\u003ca id=\"user-content-四预测模块\" class=\"anchor\" aria-label=\"Permalink: 四、预测模块\" href=\"#四预测模块\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e预测的做法是\u003cstrong\u003e历史相似周期匹配\u003c/strong\u003e，刻意做得可解释：\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e把每个交易日表示成一个 7 维特征向量\n（涨停家数、封板率、最高板、连板家数、昨涨停溢价、跌停家数、涨跌比）\u003c/li\u003e\n\u003cli\u003ez-score 标准化后，在历史中找与今天最相似的 K 天（默认 8 天）\u003c/li\u003e\n\u003cli\u003e看这些日子\u003cstrong\u003e次日\u003c/strong\u003e实际发生了什么\u003c/li\u003e\n\u003cli\u003e距离倒数加权平均，得到次日溢价与涨停家数的预测\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp dir=\"auto\"\u003e输出：倾向（偏暖/中性/偏冷）、置信度、预测溢价、预测涨停家数、\n以及相似样本中\"次日赚钱比例\"。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e每次预测都写入数据库\u003c/strong\u003e（\u003ccode\u003eforecast_log\u003c/code\u003e），事后自动回填实际值并统计方向命中率。\n这是这个模块存在的意义：\u003cstrong\u003e让预测可以被证伪\u003c/strong\u003e。\n运行 \u003ccode\u003epython3 run.py forecast\u003c/code\u003e 可以看到累计命中率。\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e说清楚一件事：这预测的是\u003cstrong\u003e情绪的方向\u003c/strong\u003e，不是某只股票的涨跌。\n后者在这个框架里无法可靠预测，工具不会假装可以。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e五、实证发现（用这个工具跑出来的真实结论）\u003c/h2\u003e\u003ca id=\"user-content-五实证发现用这个工具跑出来的真实结论\" class=\"anchor\" aria-label=\"Permalink: 五、实证发现（用这个工具跑出来的真实结论）\" href=\"#五实证发现用这个工具跑出来的真实结论\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e这一节是\u003cstrong\u003e本工具最重要的产出\u003c/strong\u003e。用 2026-05-28 ~ 2026-09-30（88 个交易日）的\n完整涨停板生态数据做检验，结果如下。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.1 情绪周期确实存在，而且可以被量化\u003c/h3\u003e\u003ca id=\"user-content-51-情绪周期确实存在而且可以被量化\" class=\"anchor\" aria-label=\"Permalink: 5.1 情绪周期确实存在，而且可以被量化\" href=\"#51-情绪周期确实存在而且可以被量化\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e88 个交易日的阶段分布：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e阶段\u003c/th\u003e\n\u003cth\u003e天数\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e发酵\u003c/td\u003e\n\u003ctd\u003e28\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e高潮\u003c/td\u003e\n\u003ctd\u003e21\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e修复\u003c/td\u003e\n\u003ctd\u003e19\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e分歧\u003c/td\u003e\n\u003ctd\u003e14\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e冰点\u003c/td\u003e\n\u003ctd\u003e3\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e退潮\u003c/td\u003e\n\u003ctd\u003e3\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e周期切换在数据上非常清晰。例如：\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ccode\u003e2026-07-13\u003c/code\u003e：跌停 \u003cstrong\u003e109\u003c/strong\u003e 家，昨日涨停溢价 \u003cstrong\u003e-2.16%\u003c/strong\u003e → 判定\u003cstrong\u003e退潮\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e2026-07-14\u003c/code\u003e：溢价 \u003cstrong\u003e+7.08%\u003c/strong\u003e → 次日直接转为\u003cstrong\u003e高潮\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e2026-08-19\u003c/code\u003e：跌停 86 家，溢价 -1.87% → \u003cstrong\u003e退潮\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e2026-08-21\u003c/code\u003e：温度 21.8 → \u003cstrong\u003e冰点\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e结论：情绪周期作为\"描述市场状态\"的框架是有效的。\u003c/strong\u003e\n它告诉你在周期的哪个位置，这件事本身有明确的信息量。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.2 但是：次日情绪无法用这些指标预测\u003c/h3\u003e\u003ca id=\"user-content-52-但是次日情绪无法用这些指标预测\" class=\"anchor\" aria-label=\"Permalink: 5.2 但是：次日情绪无法用这些指标预测\" href=\"#52-但是次日情绪无法用这些指标预测\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e这是必须直说的一点。工具对 76 个交易日做了预测，并逐一回验：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e指标\u003c/th\u003e\n\u003cth\u003e数值\u003c/th\u003e\n\u003cth\u003e含义\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e方向命中率\u003c/td\u003e\n\u003ctd\u003e80.0%\u003c/td\u003e\n\u003ctd\u003e看起来很高\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e基准率\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e80.5%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e历史上溢价为正的天数占比\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e相对优势\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.5%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e比\"永远猜偏暖\"还差\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e预测值与实际值相关系数\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.207\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e负相关，即没有预测力\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e平均绝对误差\u003c/td\u003e\n\u003ctd\u003e1.57 个百分点\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e进一步做特征有效性检验：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e今日特征\u003c/th\u003e\n\u003cth\u003e与次日溢价的相关系数\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e连板家数\u003c/td\u003e\n\u003ctd\u003e+0.160\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e温度\u003c/td\u003e\n\u003ctd\u003e+0.121\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e涨停家数\u003c/td\u003e\n\u003ctd\u003e+0.035\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e最高板\u003c/td\u003e\n\u003ctd\u003e-0.031\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e封板率\u003c/td\u003e\n\u003ctd\u003e+0.031\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e溢价自身的滞后自相关：\u003cstrong\u003e+0.138\u003c/strong\u003e（滞后1日）、+0.075（滞后2日）。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e结论：次日赚钱效应与今日各项情绪指标几乎不相关。\u003c/strong\u003e\n换句话说，用\"今天情绪如何\"去推\"明天赚不赚钱\"，在本样本内\u003cstrong\u003e没有可靠信息量\u003c/strong\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e唯一的例外仍然是冰点：温度 \u0026lt; 25 的日子里，次日溢价为正的比例只有 \u003cstrong\u003e57.1%\u003c/strong\u003e、\n次日溢价均值仅 \u003cstrong\u003e+0.16%\u003c/strong\u003e（整体是 80.5% / +1.36%），样本 7 天。\n这个方向符合直觉（冰点期风险明显更高），但样本太小，不足以当成信号。\n其余三个阶段（修复/发酵/高潮）的次日胜率分别是 81.0% / 82.9% / 87.0%，\n\u003cstrong\u003e区分度很低\u003c/strong\u003e。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.3 这对\"能不能学短线\"意味着什么\u003c/h3\u003e\u003ca id=\"user-content-53-这对能不能学短线意味着什么\" class=\"anchor\" aria-label=\"Permalink: 5.3 这对\u0026quot;能不能学短线\u0026quot;意味着什么\" href=\"#53-这对能不能学短线意味着什么\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e能学的是\"识别状态\"，不是\"预测明天\"。\u003c/strong\u003e\n情绪周期框架帮你判断现在处于哪个阶段（这个有信息量），\n但它不告诉你明天涨还是跌（这个没有信息量）。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e高命中率很容易是假象。\u003c/strong\u003e 本工具最初的预测命中率是 86.6%，\n看起来很棒——但基准率是 88.5%，模型实际上\u003cstrong\u003e没有超过\"永远猜涨\"\u003c/strong\u003e。\n任何声称\"胜率 85%\"的短线方法，都要先问：\u003cstrong\u003e基准率是多少？\u003c/strong\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e周期定位的价值在风险控制，不在择时收益。\u003c/strong\u003e\n知道现在是退潮期，价值在于让你\u003cstrong\u003e减少出手\u003c/strong\u003e；\n这和\"预测明天能赚多少\"是完全不同的两件事。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e\"买不进的收益\"是本项目反复踩的同一个坑。\u003c/strong\u003e\n席位信号里买不进占 27.1%，龙头（5板）里买不进占 \u003cstrong\u003e37.7%\u003c/strong\u003e，\n而两者\"看起来的收益\"几乎都来自这些买不到的样本。\n\u003cstrong\u003e任何\"次日买入\"的短线结论，第一件事就是剔除次日涨停的样本。\u003c/strong\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e\"看起来合理\"的多因子加权，验证前不要信。\u003c/strong\u003e\n本工具至少有两处犯过这个错：情绪预测（5.2）和题材延续性评分（5.3b）。\n两者都是\"把几个直觉上相关的指标加权\"，两者验证后都不成立，\n其中一个甚至不如单一特征。\n\u003cstrong\u003e如果你自己搭了一套评分，第一件事应该是像 \u003ccode\u003etheme-check\u003c/code\u003e 那样去验它。\u003c/strong\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e这和\"炒股养家\"那套的差距在哪。\u003c/strong\u003e\n公开流传的心法是：判断周期位置 → 决定仓位 → 选龙头。\n本工具把前两步数据化了，也验证了第一步有效、第二步不可预测。\n第三步（选龙头）依赖的是\u003cstrong\u003e盘中实时信息、资金意图和盘感\u003c/strong\u003e，\n这些东西无法用日线级的历史数据回测出来——\n这也是为什么它难以被完整复制。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e这段话不是要否定短线，而是想把\"能学的部分\"和\"学不来的部分\"分开。\n把学不来的部分误当成能学的，是亏钱最快的路径。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.3a 龙头（高连板）：看起来越高越强，其实赚的全是买不进的\u003c/h3\u003e\u003ca id=\"user-content-53a-龙头高连板看起来越高越强其实赚的全是买不进的\" class=\"anchor\" aria-label=\"Permalink: 5.3a 龙头（高连板）：看起来越高越强，其实赚的全是买不进的\" href=\"#53a-龙头高连板看起来越高越强其实赚的全是买不进的\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e这是\"追龙头\"直觉的直接检验（\u003ccode\u003epython3 run.py leader-check\u003c/code\u003e，6,507 个涨停事件）：\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e第一层：原始收益确实随板数单调上升\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e档位\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003e原始收益\u003c/th\u003e\n\u003cth\u003e控制 beta 后超额\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e1板\u003c/td\u003e\n\u003ctd\u003e4,874\u003c/td\u003e\n\u003ctd\u003e+1.06%\u003c/td\u003e\n\u003ctd\u003e+1.17%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2板\u003c/td\u003e\n\u003ctd\u003e999\u003c/td\u003e\n\u003ctd\u003e+2.23%\u003c/td\u003e\n\u003ctd\u003e+2.18%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e3板\u003c/td\u003e\n\u003ctd\u003e344\u003c/td\u003e\n\u003ctd\u003e+2.19%\u003c/td\u003e\n\u003ctd\u003e+2.19%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e4板\u003c/td\u003e\n\u003ctd\u003e143\u003c/td\u003e\n\u003ctd\u003e+2.54%\u003c/td\u003e\n\u003ctd\u003e+2.57%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e5板\u003c/td\u003e\n\u003ctd\u003e69\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+3.50%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+3.53%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e看起来完全符合\"越高越强\"，而且通过了 beta 控制与样本外分割\n（训练价差 +1.49%、留出 +1.47%）。\u003cstrong\u003e但这是假象。\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e第二层：剔除\"买不进\"之后全部转负\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e涨停股次日往往一字或大幅高开，\u003cstrong\u003e你买不到\u003c/strong\u003e：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e档位\u003c/th\u003e\n\u003cth\u003e买不进占比\u003c/th\u003e\n\u003cth\u003e买不进者收益\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e可买者净超额\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e1板\u003c/td\u003e\n\u003ctd\u003e13.7%\u003c/td\u003e\n\u003ctd\u003e+10.48%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.68%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e41.5%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2板\u003c/td\u003e\n\u003ctd\u003e25.5%\u003c/td\u003e\n\u003ctd\u003e+10.35%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.94%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e39.5%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e3板\u003c/td\u003e\n\u003ctd\u003e30.8%\u003c/td\u003e\n\u003ctd\u003e+10.29%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-1.70%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e33.6%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e4板\u003c/td\u003e\n\u003ctd\u003e32.9%\u003c/td\u003e\n\u003ctd\u003e+10.21%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-1.50%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e42.7%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e≥4板\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-1.10%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e43.8%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e5板\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e37.7%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e+10.00%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.91%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e39.5%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e板数越高，\"买不进\"的比例越高（13.7% → 37.7%），\n而那些买不进的恰恰贡献了约 +10% 的收益。\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e样本外两段一致：≥4板可买净超额 \u003cstrong\u003e训练 -1.19%、留出 -0.96%\u003c/strong\u003e。\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e结论：追龙头不是一个正期望策略。\u003c/strong\u003e\n它看起来赚钱，是因为统计里混入了你根本买不到的样本。\n这条与席位信号是\u003cstrong\u003e同一类偏差\u003c/strong\u003e，但在龙头身上更严重——\n席位买不进 27.1%，5 板龙头买不进 \u003cstrong\u003e37.7%\u003c/strong\u003e。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.3b 题材延续性评分：又一个\"看起来合理但验证不成立\"的例子\u003c/h3\u003e\u003ca id=\"user-content-53b-题材延续性评分又一个看起来合理但验证不成立的例子\" class=\"anchor\" aria-label=\"Permalink: 5.3b 题材延续性评分：又一个\u0026quot;看起来合理但验证不成立\u0026quot;的例子\" href=\"#53b-题材延续性评分又一个看起来合理但验证不成立的例子\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e详见第三节的 \u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 小节。要点：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e口径\u003c/th\u003e\n\u003cth\u003e结果\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e个股层面（次日是否续板）\u003c/td\u003e\n\u003ctd\u003eSpearman \u003cstrong\u003e-0.021\u003c/strong\u003e（训练 -0.016 / 留出 -0.029）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e1 板股：评分 0-49 vs 70-100\u003c/td\u003e\n\u003ctd\u003e续板率 \u003cstrong\u003e18.4% → 13.2%\u003c/strong\u003e（\u003cstrong\u003e反向\u003c/strong\u003e）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e题材层面：复合评分\u003c/td\u003e\n\u003ctd\u003e+0.055\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e题材层面：仅\"昨日涨停家数\"\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+0.332\u003c/strong\u003e（\u003cstrong\u003e6 倍\u003c/strong\u003e）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e分项 trend / sector\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.076 / -0.115\u003c/strong\u003e（方向为负）\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e手工设定的 6 项加权，不如一个单一特征，还混进了两个反向分项。\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e这两个失败（5.2 情绪预测、5.3b 题材评分）指向同一个教训：\n\u003cstrong\u003e在本样本内，凡是\"用今天的横截面状态推明天\"的尝试，都没有可靠信息量。\u003c/strong\u003e\n唯一经得起检验的，是\"跟着有历史战绩的席位买\"（5.4）。\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.4 但是：席位数据是例外——它真的有效\u003c/h3\u003e\u003ca id=\"user-content-54-但是席位数据是例外它真的有效\" class=\"anchor\" aria-label=\"Permalink: 5.4 但是：席位数据是例外——它真的有效\" href=\"#54-但是席位数据是例外它真的有效\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e上面说\"次日不可预测\"，指的是\u003cstrong\u003e情绪指标\u003c/strong\u003e。龙虎榜的\u003cstrong\u003e席位数据\u003c/strong\u003e是另一回事，\n它经过样本外验证后\u003cstrong\u003e仍然有正优势\u003c/strong\u003e，这是本工具目前唯一站得住的信号。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e数据依据：2026-01-05 ~ 2026-09-28，180 个交易日。\n口径统一定义：\u003cstrong\u003e去重后\u003c/strong\u003e（\u003ccode\u003eseat_buy_uniq\u003c/code\u003e × \u003ccode\u003ebillboard_uniq\u003c/code\u003e）、\u003cstrong\u003e已剔除聚合标签\u003c/strong\u003e、且次日收益非空的买方记录 = \u003cstrong\u003e46,923 条\u003c/strong\u003e。早期文档里的 57,991 / 68,355 / 7万 / 5.8万 是去重前后、是否含聚合、是否要求 d1 非空三种口径的混合值，现已统一。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e东财给每个席位-个股一个\"3日胜率\"（\u003ccode\u003eRISE_PROBABILITY_3DAY\u003c/code\u003e），它是真的：\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e席位胜率档\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003e次日收益均值\u003c/th\u003e\n\u003cth\u003e次日为正\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u0026lt; 35%\u003c/td\u003e\n\u003ctd\u003e13,992\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-1.84%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e37.2%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e35-40%\u003c/td\u003e\n\u003ctd\u003e6,125\u003c/td\u003e\n\u003ctd\u003e-0.46%\u003c/td\u003e\n\u003ctd\u003e44.4%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e40-45%\u003c/td\u003e\n\u003ctd\u003e15,249\u003c/td\u003e\n\u003ctd\u003e+0.27%\u003c/td\u003e\n\u003ctd\u003e48.0%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e45-50%\u003c/td\u003e\n\u003ctd\u003e8,669\u003c/td\u003e\n\u003ctd\u003e+0.45%\u003c/td\u003e\n\u003ctd\u003e49.3%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e50-60%\u003c/td\u003e\n\u003ctd\u003e8,443\u003c/td\u003e\n\u003ctd\u003e+1.21%\u003c/td\u003e\n\u003ctd\u003e54.1%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e≥ 60%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e5,513\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+3.56%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e67.1%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e相关系数 \u003cstrong\u003e+0.187\u003c/strong\u003e，分档\u003cstrong\u003e完全单调\u003c/strong\u003e。而且这不是\"高胜率席位恰好买了强势股\"——\n控制当日涨幅后，在\u003cstrong\u003e每一个涨幅分层内部\u003c/strong\u003e效果都成立\n（涨停层：胜率\u0026lt;40% 为 +0.29%，胜率≥50% 为 +3.18%）。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e剔除大盘后才能看清真相——\"上榜=利空\"只对低胜率席位成立：\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e席位胜率档\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003eD1 超额\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003eD5 超额\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003eD10 超额\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u0026lt; 40%\u003c/td\u003e\n\u003ctd\u003e20,238\u003c/td\u003e\n\u003ctd\u003e-1.34%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-4.21%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e-5.59%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e40-50%\u003c/td\u003e\n\u003ctd\u003e24,022\u003c/td\u003e\n\u003ctd\u003e+0.35%\u003c/td\u003e\n\u003ctd\u003e-0.96%\u003c/td\u003e\n\u003ctd\u003e-2.07%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e50-60%\u003c/td\u003e\n\u003ctd\u003e8,464\u003c/td\u003e\n\u003ctd\u003e+1.20%\u003c/td\u003e\n\u003ctd\u003e+0.68%\u003c/td\u003e\n\u003ctd\u003e-1.02%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e≥ 60%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e5,542\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+3.51%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+6.70%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+5.88%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e（超额 = 个股收益 − 同期上证涨幅。不做这个减法会得出错误结论：\n全样本上榜股 D5 绝对收益 -1.24%，看起来\"上榜就是利空\"，\n但同期大盘也跌 -0.13%，且高胜率组实际是 \u003cstrong\u003e+6.70%\u003c/strong\u003e。）\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e两个关键点：\u003c/strong\u003e\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e龙虎榜不能整体看多或看空，必须看\"是谁在买\"。\u003c/strong\u003e\n低胜率席位（大多是散户扎堆的营业部）上榜后 D5 超额 \u003cstrong\u003e-4.21%\u003c/strong\u003e；\n高胜率席位是 \u003cstrong\u003e+6.70%\u003c/strong\u003e。整体平均接近零，完全掩盖了这两极。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e高胜率席位的优势不衰减，D5 达峰。\u003c/strong\u003e\n这与\"一日游\"脉冲完全不同——说明跟的是中期逻辑，可持有数日。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e更关键的是它通过了样本外检验：\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e组别\u003c/th\u003e\n\u003cth\u003e样本内\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e样本外\u003c/strong\u003e\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003eTOP 10% 席位\u003c/td\u003e\n\u003ctd\u003e+4.27%（胜率 69.4%）\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+1.85%（胜率 55.8%）\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eBOTTOM 10% 席位\u003c/td\u003e\n\u003ctd\u003e-2.71%（胜率 34.1%）\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-1.93%（胜率 38.1%）\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e全体基准\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003ctd\u003e-0.26%（胜率 45.8%）\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e席位排名的样本内 vs 样本外\u003cstrong\u003e秩相关 +0.40\u003c/strong\u003e —— 说明这是\u003cstrong\u003e真实的席位能力差异\u003c/strong\u003e，\n不是 140 个席位里挑出来的噪声（对比：情绪指标的滞后自相关只有 +0.14）。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e实测有效的席位（本地样本 ≥20 次）\u003c/strong\u003e\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e席位\u003c/th\u003e\n\u003cth\u003e次数\u003c/th\u003e\n\u003cth\u003e次日均值\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e华源证券深圳分公司\u003c/td\u003e\n\u003ctd\u003e52\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+5.76%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e75.0%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e国泰海通成都龙腾东路\u003c/td\u003e\n\u003ctd\u003e49\u003c/td\u003e\n\u003ctd\u003e+4.32%\u003c/td\u003e\n\u003ctd\u003e75.5%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e长城证券西北分公司\u003c/td\u003e\n\u003ctd\u003e69\u003c/td\u003e\n\u003ctd\u003e+5.31%\u003c/td\u003e\n\u003ctd\u003e58.0%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e中信建投杭州庆春路\u003c/td\u003e\n\u003ctd\u003e73\u003c/td\u003e\n\u003ctd\u003e+3.56%\u003c/td\u003e\n\u003ctd\u003e64.4%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e长江证券上海分公司\u003c/td\u003e\n\u003ctd\u003e57\u003c/td\u003e\n\u003ctd\u003e+3.56%\u003c/td\u003e\n\u003ctd\u003e70.2%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e反向指标（跟了会亏）\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003ccode\u003e招商证券上海牡丹江路\u003c/code\u003e：-8.93%，胜率 26.0%。\n另外东财把 \u003ccode\u003e自然人\u003c/code\u003e / \u003ccode\u003e中小投资者\u003c/code\u003e / \u003ccode\u003e机构\u003c/code\u003e / \u003ccode\u003e沪股通\u003c/code\u003e 这类\u003cstrong\u003e聚合标签\u003c/strong\u003e混在席位列表里，\n它们的次日收益是 \u003cstrong\u003e-4% ~ -5%、胜率 27%\u003c/strong\u003e —— \u003cstrong\u003e散户扎堆上榜本身就是强反向信号\u003c/strong\u003e。\n本工具在排行和报告里已自动排除这些标签。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e统计显著性（置换检验）\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e光看秩相关 +0.40 还不够——122 个席位的排名在有限样本下本就会有非零相关。\n对\"各席位真实水平相同\"这一零假设做 2000 次置换检验：\u003c/p\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"python3 run.py seat --permute\n  观测秩相关 +0.4003\n  p 值 0.0015  -\u0026gt; 显著\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003epython3 run.py seat --permute\n  观测秩相关 +0.4003\n  p 值 0.0015  -\u0026gt; 显著\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e即只有 \u003cstrong\u003e0.15%\u003c/strong\u003e 的概率能靠随机噪声碰巧得到这么强的持续性。\n\u003cstrong\u003e这是本工具唯一通过完整统计检验的信号\u003c/strong\u003e（对比：情绪指标的自相关仅 +0.14）。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e成本敏感性\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e短线交易的真实成本会吃掉大部分弱信号。按往返 0.40%\n（印花税+佣金+过户费 0.10%，双边滑点 0.30%）计算：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e胜率档\u003c/th\u003e\n\u003cth\u003e毛收益\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e净收益\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e结论\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e40-45%\u003c/td\u003e\n\u003ctd\u003e+0.27%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.13%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e由盈转亏\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e45-50%\u003c/td\u003e\n\u003ctd\u003e+0.45%\u003c/td\u003e\n\u003ctd\u003e+0.05%\u003c/td\u003e\n\u003ctd\u003e几乎打平\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e50-60%\u003c/td\u003e\n\u003ctd\u003e+1.21%\u003c/td\u003e\n\u003ctd\u003e+0.81%\u003c/td\u003e\n\u003ctd\u003e勉强为正\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e≥ 60%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e+3.56%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+3.16%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e有实际意义\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e所以阈值必须定在 50% 以上\u003c/strong\u003e（本工具默认 \u003ccode\u003eSEAT_MIN_REP_PROB = 50\u003c/code\u003e）。\n40-45% 档看起来\"正收益\"，扣成本后是亏的。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e五层验证：一个信号要经过多少关才算可信\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e这是本工具对待所有结论的标准流程。席位信号是目前\u003cstrong\u003e唯一全部通过\u003c/strong\u003e的：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e#\u003c/th\u003e\n\u003cth\u003e检验\u003c/th\u003e\n\u003cth\u003e结果\u003c/th\u003e\n\u003cth\u003e通过\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e1\u003c/td\u003e\n\u003ctd\u003e分档单调性\u003c/td\u003e\n\u003ctd\u003e6 档完全单调（-1.84% → +3.56%）\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2\u003c/td\u003e\n\u003ctd\u003e混淆因素控制\u003c/td\u003e\n\u003ctd\u003e控制当日涨幅后，每个分层内仍成立\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e3\u003c/td\u003e\n\u003ctd\u003e样本外持续性\u003c/td\u003e\n\u003ctd\u003e秩相关 +0.40，TOP 席位样本外 +1.85%\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e4\u003c/td\u003e\n\u003ctd\u003e置换检验\u003c/td\u003e\n\u003ctd\u003ep = 0.0015（2000 次置换）\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e5\u003c/td\u003e\n\u003ctd\u003e逐月稳定性\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e9/9 个月为正\u003c/strong\u003e；对照组在零附近震荡\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e置换检验\u003c/strong\u003e（\u003ccode\u003erun.py seat --permute\u003c/code\u003e）回答\"122 个席位里挑最好的，\n会不会只是运气\"。零假设是\"所有席位真实水平相同\"，把每席位样本内外\n均值随机交换 2000 次，只有 \u003cstrong\u003e0.15%\u003c/strong\u003e 能碰巧达到 +0.40 的秩相关。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e逐月稳定性\u003c/strong\u003e（\u003ccode\u003erun.py seat --monthly\u003c/code\u003e）排除\"靠某一段行情\"：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e月份\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003eD1 均值\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003cth\u003e\u003c/th\u003e\n\u003cth\u003e月份\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003eD1 均值\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e2026-01\u003c/td\u003e\n\u003ctd\u003e507\u003c/td\u003e\n\u003ctd\u003e+4.59%\u003c/td\u003e\n\u003ctd\u003e71.0%\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e2026-06\u003c/td\u003e\n\u003ctd\u003e478\u003c/td\u003e\n\u003ctd\u003e+3.52%\u003c/td\u003e\n\u003ctd\u003e69.5%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2026-02\u003c/td\u003e\n\u003ctd\u003e230\u003c/td\u003e\n\u003ctd\u003e+4.61%\u003c/td\u003e\n\u003ctd\u003e80.4%\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e2026-07\u003c/td\u003e\n\u003ctd\u003e358\u003c/td\u003e\n\u003ctd\u003e+5.33%\u003c/td\u003e\n\u003ctd\u003e74.0%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2026-03\u003c/td\u003e\n\u003ctd\u003e304\u003c/td\u003e\n\u003ctd\u003e+3.91%\u003c/td\u003e\n\u003ctd\u003e69.4%\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e2026-08\u003c/td\u003e\n\u003ctd\u003e241\u003c/td\u003e\n\u003ctd\u003e+5.45%\u003c/td\u003e\n\u003ctd\u003e76.8%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2026-04\u003c/td\u003e\n\u003ctd\u003e476\u003c/td\u003e\n\u003ctd\u003e+4.85%\u003c/td\u003e\n\u003ctd\u003e74.8%\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e2026-09\u003c/td\u003e\n\u003ctd\u003e198\u003c/td\u003e\n\u003ctd\u003e+2.77%\u003c/td\u003e\n\u003ctd\u003e65.7%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e2026-05\u003c/td\u003e\n\u003ctd\u003e479\u003c/td\u003e\n\u003ctd\u003e+4.26%\u003c/td\u003e\n\u003ctd\u003e72.4%\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e排除了前视偏差嫌疑\u003c/strong\u003e：阈值扫描显示收益随阈值单调上升（≥80% 时\nD5 仍 +8.95%），这不寻常，所以专门查了三件事：\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ccode\u003erep_prob\u003c/code\u003e 与\u003cstrong\u003e当日涨幅\u003c/strong\u003e的相关仅 \u003cstrong\u003e+0.041\u003c/strong\u003e → 不是由当日涨跌反推的\u003c/li\u003e\n\u003cli\u003e同一席位同一天买多只股时，\u003cstrong\u003e43% 的情况 \u003ccode\u003erep_prob\u003c/code\u003e 不同\u003c/strong\u003e\n→ 它含个股维度信息，不是纯席位统计\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e独立验证\u003c/strong\u003e：完全不用 \u003ccode\u003erep_prob\u003c/code\u003e，只用席位过去 60 天的真实战绩，\n跟随组 D1 +0.33% vs 不跟随组 -0.63%，\u003cstrong\u003e价差 +0.97%\u003c/strong\u003e\n→ 席位身份本身携带信息，两套证据互相印证\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e风险画像：均值会骗人，必须看中位数和尾部\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e上表的\"均值\"是\u003cstrong\u003e毛收益\u003c/strong\u003e。真正决定能否活下来的是分布形状\n（\u003ccode\u003erun.py seat --risk\u003c/code\u003e，口径：排除涨停、可执行）：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e阈值\u003c/th\u003e\n\u003cth\u003e期\u003c/th\u003e\n\u003cth\u003e样本\u003c/th\u003e\n\u003cth\u003e均值\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e中位数\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e5% 分位\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e最差\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e≥50%\u003c/td\u003e\n\u003ctd\u003eD1\u003c/td\u003e\n\u003ctd\u003e4,589\u003c/td\u003e\n\u003ctd\u003e+0.73%\u003c/td\u003e\n\u003ctd\u003e+0.42%\u003c/td\u003e\n\u003ctd\u003e-9.98%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-88.77%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e52.2%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e≥50%\u003c/td\u003e\n\u003ctd\u003eD10\u003c/td\u003e\n\u003ctd\u003e4,302\u003c/td\u003e\n\u003ctd\u003e-0.09%\u003c/td\u003e\n\u003ctd\u003e-2.77%\u003c/td\u003e\n\u003ctd\u003e-28.10%\u003c/td\u003e\n\u003ctd\u003e-97.05%\u003c/td\u003e\n\u003ctd\u003e43.9%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e≥50%\u003c/td\u003e\n\u003ctd\u003eD20\u003c/td\u003e\n\u003ctd\u003e4,112\u003c/td\u003e\n\u003ctd\u003e-3.41%\u003c/td\u003e\n\u003ctd\u003e-8.15%\u003c/td\u003e\n\u003ctd\u003e-38.72%\u003c/td\u003e\n\u003ctd\u003e-97.49%\u003c/td\u003e\n\u003ctd\u003e34.7%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e≥70%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003eD1\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e1,295\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+2.70%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+2.37%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-6.28%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-17.39%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e64.7%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e≥70%\u003c/td\u003e\n\u003ctd\u003eD5\u003c/td\u003e\n\u003ctd\u003e1,235\u003c/td\u003e\n\u003ctd\u003e+8.44%\u003c/td\u003e\n\u003ctd\u003e+5.57%\u003c/td\u003e\n\u003ctd\u003e-12.61%\u003c/td\u003e\n\u003ctd\u003e-96.57%\u003c/td\u003e\n\u003ctd\u003e70.6%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e≥70%\u003c/td\u003e\n\u003ctd\u003eD20\u003c/td\u003e\n\u003ctd\u003e1,102\u003c/td\u003e\n\u003ctd\u003e+5.00%\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-0.95%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e-32.46%\u003c/td\u003e\n\u003ctd\u003e-97.49%\u003c/td\u003e\n\u003ctd\u003e47.5%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e三个必须看清的点：\u003c/strong\u003e\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e50% 阈值只适合 D1。\u003c/strong\u003e 持有到 D10 均值转负、中位数 -2.77%，\n到 D20 中位数 \u003cstrong\u003e-8.15%\u003c/strong\u003e。放宽阈值 + 拉长持有 = 亏钱。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e≥70% 档的尾部风险好得多\u003c/strong\u003e：D1 最差 -17.39%，而 ≥50% 档是 \u003cstrong\u003e-88.77%\u003c/strong\u003e\n（那是踩到退市/连续跌停）。\u003cstrong\u003e风险差异比收益差异更重要。\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eD5 以上均值被少数暴涨股拉高\u003c/strong\u003e。≥70% 档 D20 均值 +5.00% 但中位数\n\u003cstrong\u003e-0.95%\u003c/strong\u003e——\"典型的一笔是亏的，靠个别翻倍股拉平均\"。\n这种分布下\u003cstrong\u003e重仓长持非常危险\u003c/strong\u003e，也解释了为什么短线必须快进快出。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e外部独立证据：哪些被印证，哪些有冲突\u003c/strong\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e联网调研检索了公开复现与学术文献。\u003cstrong\u003e必须如实区分\u003c/strong\u003e——不能只挑支持的：\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e✅ \u003cstrong\u003e被独立印证\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e聚合标签必须剔除\u003c/strong\u003e：独立复现同样列出\"自然人/中小投资者/机构/沪股通/\n交易单元\"为非席位合成类别，判据是\"同时出现在买卖两榜\"——与本项目\n发现的 -4%~-5%、胜率 27% 完全对应。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e成本量级 0.2-0.4%\u003c/strong\u003e：外部复现给 0.2-0.4%，本项目用 0.4%（上沿，偏保守）。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e一字板买不进\u003c/strong\u003e：外部复现给\"一字板 10cm 次日 +4.21%、20cm +8.75%，\n但成交发生在隔夜排队者之间，超额属于中签者而非追价者\"——与本项目\n\"24.1% 买不进、高估 2.91%\" 是同一现象。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e龙虎榜 T 日 17:30 后披露\u003c/strong\u003e：任何以 T 日收盘为入场价的回测都含前视偏差。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e \u003cstrong\u003e与公开结论冲突\u003c/strong\u003e（必须保留，不作裁决）\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e一份 169 个交易日的独立复现发现：\u003cstrong\u003e上榜次数越多，后续超额越差\u003c/strong\u003e\n（正超额席位占比从 \u0026lt;15 次档的 36.2% 单调降至 \u0026gt;150 次档的 11.6%）。\n这与本项目的\"席位能力可持续（秩相关 +0.40）\"存在张力。\n\u003cstrong\u003e可能的解释\u003c/strong\u003e：两者口径不同——它按\"活跃度\"排序（高频霸榜多是通道/量化\n资金），本项目按\"平台胜率\"排序。但这一矛盾\u003cstrong\u003e尚未解决\u003c/strong\u003e，不应忽视。\u003c/li\u003e\n\u003cli\u003e学术侧 2017 年对外经贸硕士论文：\"龙虎榜上榜事件不产生超额收益，\n反而产生负异常收益；仅净买入占比 \u0026gt;10% 的子集有正异常收益。\"\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003e❌ \u003cstrong\u003e未能外部证真\u003c/strong\u003e\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e本项目最核心的结论——席位能力样本外秩相关 +0.40——在公开文献与\n公开复现中找不到任何对应佐证\u003c/strong\u003e。检索\"龙虎榜 营业部 排名 样本外\"\n只返回数据页面与新闻稿，无任何时间序列持续性检验。\n这是方法学空白点，本项目的 +0.40 属目前唯一可得估计。\u003c/li\u003e\n\u003cli\u003e平台 \u003ccode\u003eRISE_PROBABILITY_3DAY\u003c/code\u003e 字段名精确检索\u003cstrong\u003e返回零结果\u003c/strong\u003e，\n官方页面仅说明它是\"上榜后 N 天平均涨幅/上涨概率\"，属\u003cstrong\u003e滚动事后描述统计\u003c/strong\u003e，\n未披露窗口长度、最小样本量、剔除规则，也未声明为样本外估计。\u003c/li\u003e\n\u003c/ul\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e结论：本项目的方法学\u003cstrong\u003e并非全无根基\u003c/strong\u003e（多重检验、成本、可执行性都有外部\n支撑），但\u003cstrong\u003e核心发现未被外部独立复现\u003c/strong\u003e。在使用时请把这一点计入不确定性。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e5.5 第二个维度：席位活跃度（并且它解决了一个外部矛盾）\u003c/h3\u003e\u003ca id=\"user-content-55-第二个维度席位活跃度并且它解决了一个外部矛盾\" class=\"anchor\" aria-label=\"Permalink: 5.5 第二个维度：席位活跃度（并且它解决了一个外部矛盾）\" href=\"#55-第二个维度席位活跃度并且它解决了一个外部矛盾\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e联网调研发现一份公开复现的结论与本节\u003cstrong\u003e看似冲突\u003c/strong\u003e：它发现\n\"上榜次数越多，后续超额越差\"（正超额席位占比从 \u0026lt;15 次档 36.2% 单调降到\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e150 次档 11.6%），而本节说\"席位能力可持续\"。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003e用本地数据分解后，\u003cstrong\u003e两者都对，只是条件不同\u003c/strong\u003e：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e高胜率席位（rep_prob≥60）内部\u003c/th\u003e\n\u003cth\u003e事件\u003c/th\u003e\n\u003cth\u003eD1 均值\u003c/th\u003e\n\u003cth\u003eD5 均值\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e活跃度 1-15 次\u003c/td\u003e\n\u003ctd\u003e3,099\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+4.10%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+8.99%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e70.6%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e活跃度 15-30 次\u003c/td\u003e\n\u003ctd\u003e834\u003c/td\u003e\n\u003ctd\u003e+3.20%\u003c/td\u003e\n\u003ctd\u003e+5.57%\u003c/td\u003e\n\u003ctd\u003e63.3%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e活跃度 30-120 次\u003c/td\u003e\n\u003ctd\u003e1,161\u003c/td\u003e\n\u003ctd\u003e+2.90%\u003c/td\u003e\n\u003ctd\u003e+3.56%\u003c/td\u003e\n\u003ctd\u003e63.7%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e活跃度 \u0026gt;120 次\u003c/td\u003e\n\u003ctd\u003e419\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+2.14%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+2.31%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e57.8%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e控制住 \u003ccode\u003erep_prob\u003c/code\u003e 之后，活跃度确实是单调反向的。\u003c/strong\u003e 外部按活跃度排序\n看到负相关（因为高频席位大多是低胜率），本节按 \u003ccode\u003erep_prob\u003c/code\u003e 排序看到正相关\n——两个维度\u003cstrong\u003e独立且可叠加\u003c/strong\u003e。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e用\u003cstrong\u003e滚动窗口\u003c/strong\u003e（只看过去 60 个交易日，无未来信息）在可执行口径下实测：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e组合\u003c/th\u003e\n\u003cth\u003e可买样本\u003c/th\u003e\n\u003cth\u003eD1 净\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003eD5 净\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e胜率\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e高胜率（基准）\u003c/td\u003e\n\u003ctd\u003e4,025\u003c/td\u003e\n\u003ctd\u003e+0.26%\u003c/td\u003e\n\u003ctd\u003e+2.54%\u003c/td\u003e\n\u003ctd\u003e54.9%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e+ 低频（≤2 次）\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e1,899\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+5.40%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e60.8%\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e+ 中频（3-9 次）\u003c/td\u003e\n\u003ctd\u003e1,041\u003c/td\u003e\n\u003ctd\u003e-0.29%\u003c/td\u003e\n\u003ctd\u003e+0.95%\u003c/td\u003e\n\u003ctd\u003e49.2%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e+ \u003cstrong\u003e高频（≥10 次）\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e616\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e-2.11%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e48.2%\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e非高胜率\u003c/td\u003e\n\u003ctd\u003e37,337\u003c/td\u003e\n\u003ctd\u003e-2.46%\u003c/td\u003e\n\u003ctd\u003e-5.03%\u003c/td\u003e\n\u003ctd\u003e36.1%\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e并且通过了诚实协议\u003c/strong\u003e（训练段选活跃度上限，留出段测量）：\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e上限\u003c/th\u003e\n\u003cth\u003e训练段 D5净\u003c/th\u003e\n\u003cth\u003e\u003cstrong\u003e留出段 D5净\u003c/strong\u003e\u003c/th\u003e\n\u003cth\u003e留出 n\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e≤1\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e+5.95%\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e—\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e≤2\u003c/td\u003e\n\u003ctd\u003e+6.00%\u003c/td\u003e\n\u003ctd\u003e+5.40%\u003c/td\u003e\n\u003ctd\u003e408\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e不限\u003c/td\u003e\n\u003ctd\u003e+2.79%\u003c/td\u003e\n\u003ctd\u003e+3.22%\u003c/td\u003e\n\u003ctd\u003e801\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eD5 净收益从 +2.71% 提升到 +5.40%，翻倍，且两段一致。\u003c/strong\u003e\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 但注意：这是\u003cstrong\u003e在样本期内\u003c/strong\u003e观察到的第二个维度。即使通过了留出检验，\n每多叠加一个维度，过拟合风险就上升一层。已用 Deflated Sharpe / PBO\n做过拟合校正，\u003cstrong\u003eDSR 0.9757 通过、PBO 0.0000 很稳健\u003c/strong\u003e——\n两个指标结论相反，说明\"档位单调\"可信但\"最高档最优\"不可过度自信\n（详见局限第 9 条）。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e必须知道的局限性\u003c/strong\u003e\u003c/p\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e龙虎榜是盘后披露的\u003c/strong\u003e，你只能\u003cstrong\u003e次日\u003c/strong\u003e买入。而上表中的\"次日收益\"是\n\u003ccode\u003e上榜日收盘 → 次日收盘\u003c/code\u003e，\u003cstrong\u003e包含了次日跳空\u003c/strong\u003e，那部分你吃不到。\n因此报告里的跟随候选\u003cstrong\u003e默认排除涨停股\u003c/strong\u003e（涨停股次日往往一字或大幅高开）。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e样本期只有 2026 年 1~9 月\u003c/strong\u003e，未覆盖完整牛熊。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003ccode\u003eRISE_PROBABILITY_3DAY\u003c/code\u003e 不是每个席位都有，缺失时无法评估。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e这是\u003cstrong\u003e统计优势，不是保证\u003c/strong\u003e。胜率 67% 意味着\u003cstrong\u003e三次里还有一次亏\u003c/strong\u003e。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e对成本高度敏感\u003c/strong\u003e：往返成本每增加 0.1%，净收益同幅下降。\n本工具的 0.40% 假设对高频短线偏乐观，实际券商佣金差异会显著影响结论。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e高胜率席位的 D5 超额达峰，但\u003cstrong\u003e样本期只有 9 个月\u003c/strong\u003e，\n虽逐月为正，仍未覆盖完整牛熊。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e不要人为叠加过滤条件\u003c/strong\u003e。实测把\"本地历史为正\"叠加到 \u003ccode\u003erep_prob\u0026gt;=60\u003c/code\u003e\n上，D1 净收益从 +3.16% \u003cstrong\u003e降到\u003c/strong\u003e +2.16%，三条件叠加更是变成 -0.10%。\n平台指标的信息量大于简单历史均值，加过滤只会缩样本、引噪声。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e\u003ccode\u003erep_prob\u0026gt;=70\u003c/code\u003e 的收益不衰减，这可能是真信号，也可能是数据商\n用了较长窗口的历史统计造成的乐观偏差\u003c/strong\u003e——目前无法完全排除。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e多重检验校正是\"接近但未通过\"，必须如实说明\u003c/strong\u003e。已实现\nDeflated Sharpe Ratio 与回测过拟合概率（PBO/CSCV），\n把\"扫了 9 个阈值\"视为 9 次尝试来校正选择偏差：\u003c/p\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"python3 run.py seat --overfit\n  各策略 Sharpe: -0.29 ... +1.15（横截面标准差 0.53）\n  期望最大 Sharpe（纯选择偏差）SR0 = +0.8036\n  实际最优 Sharpe                = +1.1543（近似）\n  DSR = 0.9757  -\u0026gt;  通过（阈值 0.95）\n  PBO = 0.0000（252 个 CSCV 分割），样本外中位排名 1.000\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003epython3 run.py seat --overfit\n  各策略 Sharpe: -0.29 ... +1.15（横截面标准差 0.53）\n  期望最大 Sharpe（纯选择偏差）SR0 = +0.8036\n  实际最优 Sharpe                = +1.1543（近似）\n  DSR = 0.9757  -\u0026gt;  通过（阈值 0.95）\n  PBO = 0.0000（252 个 CSCV 分割），样本外中位排名 1.000\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e两个指标给出相反信号\u003c/strong\u003e：DSR 说\"最优策略的优势只比纯运气好一点点\"，\nPBO 说\"样本内挑出的最优策略在样本外仍排第一，选择非常稳健\"。\n解释：阈值越高收益越高是\u003cstrong\u003e单调\u003c/strong\u003e的，所以挑哪个都不会挑错（PBO 低）；\n但\"最高档比次高档好多少\"确实在噪声范围内（DSR 未过）。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cg-emoji class=\"g-emoji\" alias=\"warning\"\u003e⚠️\u003c/g-emoji\u003e 该计算以 \u003ccode\u003ed5_adj\u003c/code\u003e 按周聚合，\u003cstrong\u003e存在重叠持仓与自相关\u003c/strong\u003e，会系统性\n抬高 Sharpe 显著性，所以应看方向而非绝对数值。\n另：文献提示稳健性分数与前瞻表现可能无关（一项预注册测试得\nSpearman rho = 0.013，p = 0.40），\u003cstrong\u003e验证层本身也不是万能的\u003c/strong\u003e。\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e核心发现未被外部独立复现\u003c/strong\u003e。检索\"龙虎榜 营业部 排名 样本外\"\n无任何对应研究；平台字段名精确检索返回零结果。\n本节结论目前只有本地证据支撑。\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ol\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e结论：情绪周期告诉你\"现在处于什么状态\"（有用，但不能预测明天）；\n席位数据告诉你\"谁在买、他历史战绩如何\"（这个\u003cstrong\u003e能\u003c/strong\u003e带来正期望）。\n前者是地图，后者是导航。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e五之二、席位分析怎么用\u003c/h2\u003e\u003ca id=\"user-content-五之二席位分析怎么用\" class=\"anchor\" aria-label=\"Permalink: 五之二、席位分析怎么用\" href=\"#五之二席位分析怎么用\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e📖 \u003cstrong\u003e可执行规则、风险控制与每日流程见\n\u003ca href=\"/dongdonglog/a-share-observer/blob/main/docs/%E5%B8%AD%E4%BD%8D%E8%B7%9F%E9%9A%8F%E6%93%8D%E4%BD%9C%E6%89%8B%E5%86%8C.md\"\u003edocs/席位跟随操作手册.md\u003c/a\u003e\u003c/strong\u003e —— 本文是结论与证据，\n手册是落地操作。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e先跑自检（强烈建议）\u003c/h3\u003e\u003ca id=\"user-content-先跑自检强烈建议\" class=\"anchor\" aria-label=\"Permalink: 先跑自检（强烈建议）\" href=\"#先跑自检强烈建议\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e统计设施本身也可能有 bug，所以有已知答案检验：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 tools/test_stats.py     # 14 项数值自检（PSR/DSR/PBO/正态函数）\npython3 tools/validate_dim.py all   # 校验 heavy-research 维度报告契约\"\u003e\u003cpre\u003epython3 tools/test_stats.py     \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 14 项数值自检（PSR/DSR/PBO/正态函数）\u003c/span\u003e\npython3 tools/validate_dim.py all   \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 校验 heavy-research 维度报告契约\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e自检内容：纯噪声下 PSR 应服从 U(0,1)、DSR 应不显著、PBO 应≈0.5；\n有一个明显更优策略时 PBO 应→0。\u003cstrong\u003e这些断言曾抓出我自己写错的测试期望\u003c/strong\u003e\n（原以为单次 PSR 应≈0.5，实际它服从均匀分布）。\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"python3 run.py lhb --date 2026-09-29          # 采集某日龙虎榜\npython3 run.py lhb --backfill --start 2026-01-01   # 回填历史\npython3 run.py seat                            # 跟随收益矩阵 + 席位排行\npython3 run.py seat --validate                 # 样本外持续性检验（最重要）\npython3 run.py seat --follow --date 2026-09-29 # 当日跟随候选\npython3 run.py seat --permute                 # 置换检验（p=0.0015）\npython3 run.py seat --walkforward             # 滚动前向（不用平台指标）\npython3 run.py seat --monthly --min-prob 70   # 逐月稳定性\npython3 run.py seat --compare                 # 各策略净收益对比\npython3 run.py seat --risk --min-prob 70      # 收益分布与尾部风险\npython3 run.py seat --executable              # 真实可执行收益（剔除买不进的）\npython3 run.py seat --honest                  # 诚实协议：前段选阈值、后段测量\npython3 run.py seat --activity                # 席位活跃度第二维度\npython3 run.py seat --overfit                 # 过拟合校正（DSR + PBO）\npython3 run.py seat --seat \u0026quot;华源证券股份有限公司深圳分公司\u0026quot;   # 单个席位画像\"\u003e\u003cpre\u003epython3 run.py lhb --date 2026-09-29          \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 采集某日龙虎榜\u003c/span\u003e\npython3 run.py lhb --backfill --start 2026-01-01   \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 回填历史\u003c/span\u003e\npython3 run.py seat                            \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 跟随收益矩阵 + 席位排行\u003c/span\u003e\npython3 run.py seat --validate                 \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 样本外持续性检验（最重要）\u003c/span\u003e\npython3 run.py seat --follow --date 2026-09-29 \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 当日跟随候选\u003c/span\u003e\npython3 run.py seat --permute                 \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 置换检验（p=0.0015）\u003c/span\u003e\npython3 run.py seat --walkforward             \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 滚动前向（不用平台指标）\u003c/span\u003e\npython3 run.py seat --monthly --min-prob 70   \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 逐月稳定性\u003c/span\u003e\npython3 run.py seat --compare                 \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 各策略净收益对比\u003c/span\u003e\npython3 run.py seat --risk --min-prob 70      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 收益分布与尾部风险\u003c/span\u003e\npython3 run.py seat --executable              \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 真实可执行收益（剔除买不进的）\u003c/span\u003e\npython3 run.py seat --honest                  \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 诚实协议：前段选阈值、后段测量\u003c/span\u003e\npython3 run.py seat --activity                \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 席位活跃度第二维度\u003c/span\u003e\npython3 run.py seat --overfit                 \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 过拟合校正（DSR + PBO）\u003c/span\u003e\npython3 run.py seat --seat \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e华源证券股份有限公司深圳分公司\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e   \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e 单个席位画像\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003ccode\u003eseat --follow\u003c/code\u003e 默认只列出\u003cstrong\u003e席位胜率 ≥60% 且非涨停\u003c/strong\u003e的候选，\n这是\"最接近可执行\"的保守口径。\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e六、数据源与已知的坑\u003c/h2\u003e\u003ca id=\"user-content-六数据源与已知的坑\" class=\"anchor\" aria-label=\"Permalink: 六、数据源与已知的坑\" href=\"#六数据源与已知的坑\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e数据\u003c/th\u003e\n\u003cth\u003e来源\u003c/th\u003e\n\u003cth\u003e历史可用\u003c/th\u003e\n\u003cth\u003e说明\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e涨停池（含连板/换手/封单/首末封板时间）\u003c/td\u003e\n\u003ctd\u003e同花顺\u003c/td\u003e\n\u003ctd\u003e✅ 约 6 个月\u003c/td\u003e\n\u003ctd\u003e主力数据源\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e炸板池\u003c/td\u003e\n\u003ctd\u003e同花顺\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e题材板块 + 题材归因 + 催化原文\u003c/td\u003e\n\u003ctd\u003e同花顺\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e\u003ccode\u003eblock_top\u003c/code\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e连板梯队\u003c/td\u003e\n\u003ctd\u003e同花顺\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e跌停池\u003c/td\u003e\n\u003ctd\u003e东方财富\u003c/td\u003e\n\u003ctd\u003e❌ 仅当日\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e全市场行情快照\u003c/td\u003e\n\u003ctd\u003e东方财富\u003c/td\u003e\n\u003ctd\u003e❌ 仅当日\u003c/td\u003e\n\u003ctd\u003e用于涨跌家数\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e概念/行业板块排行\u003c/td\u003e\n\u003ctd\u003e东方财富\u003c/td\u003e\n\u003ctd\u003e❌ 仅当日\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e指数 / 外围市场\u003c/td\u003e\n\u003ctd\u003e东方财富\u003c/td\u003e\n\u003ctd\u003e✅ 走日K\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e历史价格\u003c/td\u003e\n\u003ctd\u003e东方财富日K\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e用于回填赚钱效应\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e财经快讯\u003c/td\u003e\n\u003ctd\u003e新浪财经\u003c/td\u003e\n\u003ctd\u003e滚动\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e日K（备选）\u003c/td\u003e\n\u003ctd\u003e腾讯 / 新浪\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e东财限流时自动切换\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e个股/板块日K\u003c/td\u003e\n\u003ctd\u003e东方财富\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e龙虎榜个股明细\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e东方财富 \u003ccode\u003edatacenter-web\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e✅ 到 2015\u003c/td\u003e\n\u003ctd\u003e\u003cstrong\u003e自带 D1/D2/D5/D10/D20/D30 前向涨幅\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e席位买卖明细\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e东方财富 \u003ccode\u003edatacenter-web\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e含席位3日胜率 \u003ccode\u003eRISE_PROBABILITY_3DAY\u003c/code\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003cstrong\u003e活跃席位榜\u003c/strong\u003e\u003c/td\u003e\n\u003ctd\u003e东方财富 \u003ccode\u003edatacenter-web\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e✅\u003c/td\u003e\n\u003ctd\u003e全库约 136 万行\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e龙虎榜走的是 \u003ccode\u003edatacenter-web.eastmoney.com\u003c/code\u003e，与行情接口 \u003ccode\u003epush2.eastmoney.com\u003c/code\u003e\n\u003cstrong\u003e不同域\u003c/strong\u003e——前者实测\u003cstrong\u003e未被限流\u003c/strong\u003e，后者经常限流。这是席位数据能稳定回填的原因。\n注意 \u003ccode\u003epageSize\u003c/code\u003e 上限是 \u003cstrong\u003e500\u003c/strong\u003e（传 1000 会被静默截断为 500），\n且 \u003ccode\u003eresult: null\u003c/code\u003e 既表示空集也表示限流，代码里做了区分。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch3 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e踩过的坑（都在代码注释里标了）\u003c/h3\u003e\u003ca id=\"user-content-踩过的坑都在代码注释里标了\" class=\"anchor\" aria-label=\"Permalink: 踩过的坑（都在代码注释里标了）\" href=\"#踩过的坑都在代码注释里标了\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e东财 \u003ccode\u003edate\u003c/code\u003e 参数是假的\u003c/strong\u003e。给涨停池传历史日期，它会静默返回当天数据。\n所以历史回填必须走同花顺，否则会把今天的数据写到过去日期上造成污染。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e东财 clist 的 \u003ccode\u003epz\u003c/code\u003e 上限是 100\u003c/strong\u003e，传 200 会被服务端直接断连。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e东财会限流\u003c/strong\u003e，返回 \u003ccode\u003e{\"rc\":0,\"data\":null}\u003c/code\u003e 而不是报错。必须把它当\"重试\"而非\"无数据\"。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003eConnection: close\u003c/code\u003e 会大幅提高失败率\u003c/strong\u003e。改用 keep-alive 连接复用后，\n全市场 59 页的失败页从 ~15 页降到 0。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e日K的 \u003ccode\u003ef58\u003c/code\u003e 是振幅不是涨跌幅\u003c/strong\u003e，\u003ccode\u003ef59\u003c/code\u003e 才是。搞错会让所有涨幅数据失真。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e同花顺涨停池 \u003ccode\u003elimit\u003c/code\u003e 上限 200\u003c/strong\u003e，超过报错。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e同花顺 \u003ccode\u003ehigh_days_value\u003c/code\u003e 的编码是 \u003ccode\u003e(板数 \u0026lt;\u0026lt; 16) | 天数\u003c/code\u003e\u003c/strong\u003e，\n与东财 \u003ccode\u003elbc\u003c/code\u003e（连板数）交叉验证 19/20 一致。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp dir=\"auto\"\u003e龙虎榜/席位相关的坑：\u003c/p\u003e\n\u003col start=\"8\" dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e席位明细报表不含股票名称\u003c/strong\u003e。\u003ccode\u003eRPT_BILLBOARD_DAILYDETAILSBUY\u003c/code\u003e 的字段里\n只有 \u003ccode\u003eSECURITY_CODE\u003c/code\u003e/\u003ccode\u003eSECUCODE\u003c/code\u003e，没有 \u003ccode\u003eSECURITY_NAME_ABBR\u003c/code\u003e。\n早期代码读这个字段拿到全 \u003ccode\u003eNone\u003c/code\u003e，导致报告里股票名显示为 \u003ccode\u003e—\u003c/code\u003e。\n现在由 \u003ccode\u003e_backfill_names()\u003c/code\u003e 从 \u003ccode\u003ebillboard\u003c/code\u003e 自动回填。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003epageSize\u003c/code\u003e 上限是 500\u003c/strong\u003e。传 1000 会被服务端静默截断为 500 而不报错，\n分页时若不按实际返回数推进就会漏数据。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003eresult: null\u003c/code\u003e 既表示\"空集\"也表示\"被限流\"\u003c/strong\u003e，两者无法从响应区分。\n代码里对\"当天（尚未披露）返回空\"与\"限流\"分别处理。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e涨停判定必须按板块\u003c/strong\u003e。主板 9.5%、创业板/科创板 19.5%、北交所 29%，\n另有 ST 股 5%。早期 \u003ccode\u003efollow_signals\u003c/code\u003e 硬编码 \u003ccode\u003epct \u0026gt;= 9.5\u003c/code\u003e，\n会把科创板 +9.5% 的\u003cstrong\u003e非涨停\u003c/strong\u003e股票误当成涨停而排除。\n现已复用 \u003ccode\u003ecollect._limit_threshold()\u003c/code\u003e。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e同一股票同日可能有多个上榜原因\u003c/strong\u003e（实测 \u003cstrong\u003e13.4%\u003c/strong\u003e 的\n\u003ccode\u003e(trade_date, code)\u003c/code\u003e 有多行，因为 \u003ccode\u003ebillboard\u003c/code\u003e 主键含 \u003ccode\u003ereason\u003c/code\u003e）。\n直接 JOIN 会让这些股票被重复计数，实测把可执行样本的\nD1 从 +1.880% 拉偏到 +1.768%。现提供 \u003ccode\u003ebillboard_uniq\u003c/code\u003e /\n\u003ccode\u003eseat_buy_uniq\u003c/code\u003e 两个去重视图，所有统计都走视图。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eST 股的涨跌停不是板块标准值\u003c/strong\u003e。主板 ST 是 \u003cstrong\u003e±5%\u003c/strong\u003e，\n创业板/科创板 ST 仍是 ±20%，北交所 ST 仍是 ±30%。\n早期代码对 ST 一律按板块标准值处理，导致主板 ST 的 +5% 涨停\n被判为\"未涨停\"而混入\"可执行\"样本——而 ST 的 D1 均值 \u003cstrong\u003e-1.38%\u003c/strong\u003e，\n显著差于非 ST 的 -0.10%，属实质性污染。\n经验验证：ST 记录的涨幅峰值在 5.0%（主板）与 20.0%（创业科创）。\n现已由 \u003ccode\u003e_limit_threshold(code, is_st=...)\u003c/code\u003e 与 \u003ccode\u003eseat._thr()\u003c/code\u003e 处理。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003e机构专用\u003c/code\u003e 曾经不在聚合标签里\u003c/strong\u003e——它是本地数据中\u003cstrong\u003e出现最多\u003c/strong\u003e的\n聚合标签（6,400 次），却漏在 \u003ccode\u003eAGGREGATE_LABELS\u003c/code\u003e 之外，泄漏进了\n报告 9.2 的净买入排行。同时 \u003ccode\u003efollow_signals\u003c/code\u003e \u003cstrong\u003e完全不做聚合过滤\u003c/strong\u003e，\n导致 9.1\"跟随候选\"与 9.2\"排除聚合\"两节口径相反：\n\u003cstrong\u003e最该被排除的（聚合席位是强反向指标）反而没被排除在跟随候选之外。\u003c/strong\u003e\n实测全库 180 个交易日共 \u003cstrong\u003e256 条\u003c/strong\u003e聚合记录会混入候选，现已 0 条。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eST 判定曾在 3 个函数中恒失效\u003c/strong\u003e——\u003ccode\u003e_thr\u003c/code\u003e 依赖 \u003ccode\u003e\"ST\" in name\u003c/code\u003e，\n但 \u003ccode\u003erisk_profile\u003c/code\u003e / \u003ccode\u003eexecutable_estimate\u003c/code\u003e / \u003ccode\u003ethreshold_sweep\u003c/code\u003e 的\nSELECT 不含 \u003ccode\u003es.name\u003c/code\u003e，\u003ccode\u003er.get(\"name\")\u003c/code\u003e 恒为 None，于是 ST 股按 9.5%\n而非 4.8% 判\"未涨停\"，\u003cstrong\u003e把买不进的真涨停 ST 股放进了可执行样本\u003c/strong\u003e。\n而这三个函数正是产出\"可执行口径\"结论的地方，失效方向是让收益偏乐观。\n修复后\"买不进\"占比从 23.7% 升到 \u003cstrong\u003e27.1%\u003c/strong\u003e。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e配置项\"看似生效实则只是文案\"\u003c/strong\u003e——\u003ccode\u003eseat.py\u003c/code\u003e 原本用自己的字面量\n\u003ccode\u003eDEFAULT_DAYS=180\u003c/code\u003e / \u003ccode\u003eMIN_SEAT_TRADES=20\u003c/code\u003e，与 \u003ccode\u003econfig\u003c/code\u003e 里的值\n\u003cstrong\u003e恰好相等因而掩盖了断链\u003c/strong\u003e。改 \u003ccode\u003econfig.SEAT_MIN_TRADES\u003c/code\u003e 后，\n\u003ccode\u003erun.py\u003c/code\u003e 的表头文案会跟着变，\u003cstrong\u003e但筛选逻辑不变\u003c/strong\u003e。\n现已改为从 config 读取，单一来源。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003erun.py lhb --backfill\u003c/code\u003e 必崩\u003c/strong\u003e——\u003ccode\u003elhb.backfill\u003c/code\u003e 调用\n\u003ccode\u003etrading_days(conn, start, end)\u003c/code\u003e（3 个位置参数），而签名是\n\u003ccode\u003e(end=None, count=30)\u003c/code\u003e，抛 \u003ccode\u003eTypeError\u003c/code\u003e。\n\u003cstrong\u003e这解释了为何席位数据一直靠 \u003ccode\u003etools/\u003c/code\u003e 离线导入。\u003c/strong\u003e 已修复。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003erun.py seat\u003c/code\u003e 空库必崩\u003c/strong\u003e——\u003ccode\u003efollowing_edge\u003c/code\u003e 无数据时返回 \u003ccode\u003e[]\u003c/code\u003e，\n而 \u003ccode\u003erun.py\u003c/code\u003e 用 \u003ccode\u003eif r[0]:\u003c/code\u003e 解包，抛 \u003ccode\u003eIndexError\u003c/code\u003e。已改为给出提示。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003ecmd_status\u003c/code\u003e 遗漏全部 3 张龙虎榜表\u003c/strong\u003e——用户看不到席位数据覆盖情况，\n而席位恰恰是唯一验证有效的信号。已补。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e\u003ccode\u003ebillboard\u003c/code\u003e 主键含 \u003ccode\u003ereason\u003c/code\u003e，而 SQL 中 NULL≠NULL\u003c/strong\u003e——\n\u003ccode\u003eON CONFLICT(trade_date,code,reason)\u003c/code\u003e 对 \u003ccode\u003ereason IS NULL\u003c/code\u003e \u003cstrong\u003e永不触发\u003c/strong\u003e，\n连续 upsert 会不断插入新行。当前实际数据 0% 为 NULL（未触发），\n属\u003cstrong\u003e潜在\u003c/strong\u003e风险。，同一席位同一天可能同时出现在买卖两侧，\n查询时必须指定 \u003ccode\u003eside\u003c/code\u003e 否则会重复计数（报告里曾出现同一只股票两行）。\u003c/li\u003e\n\u003c/ol\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e七、数据模型\u003c/h2\u003e\u003ca id=\"user-content-七数据模型\" class=\"anchor\" aria-label=\"Permalink: 七、数据模型\" href=\"#七数据模型\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"daily_market    每日市场快照（涨停数/最高板/涨跌家数/成交额/指数）\nlimit_up        涨停股明细（连板数/换手率/封单额/首末封板时间/开板次数）\nbroken_board    炸板股\nlimit_down      跌停股\ntheme_block     题材板块（涨停家数/连板数/最高板/活跃天数）\ntheme_stock     题材成分股（题材归因 reason / 催化原因 reason_info）\ntheme_daily     题材日聚合（含量化后的延续性分项）\nsector_daily    概念/行业板块行情\nquote_daily     全市场每日行情（算溢价/晋级率/涨跌家数）\nglobal_market   外围市场\nnews            财经快讯\nemotion_daily   计算后的情绪指标（温度/阶段/溢价/晋级率）\nforecast_log    预测记录（含事后回验字段）\ncollect_log     采集日志（每步成败）\nstock_basic     股票名录\nbillboard       龙虎榜个股（含 d1/d5/d10/d20/d30 前向涨幅）\n                ⚠️ 主键含 reason，同股同日可能多行（13.4%）\nbillboard_uniq  【视图】按 (日期,代码) 去重；前向收益取 MIN，金额取 SUM，\n                多个上榜原因合并进 reasons 字段。**统计一律用这个视图**\nseat_trade      席位买卖明细（含席位3日胜率 rep_prob）\n                ⚠️ 主键含 side\nseat_buy_uniq   【视图】仅买方、按 (日期,席位,代码) 去重\nseat_daily      活跃席位榜\"\u003e\u003cpre class=\"notranslate\"\u003e\u003ccode\u003edaily_market    每日市场快照（涨停数/最高板/涨跌家数/成交额/指数）\nlimit_up        涨停股明细（连板数/换手率/封单额/首末封板时间/开板次数）\nbroken_board    炸板股\nlimit_down      跌停股\ntheme_block     题材板块（涨停家数/连板数/最高板/活跃天数）\ntheme_stock     题材成分股（题材归因 reason / 催化原因 reason_info）\ntheme_daily     题材日聚合（含量化后的延续性分项）\nsector_daily    概念/行业板块行情\nquote_daily     全市场每日行情（算溢价/晋级率/涨跌家数）\nglobal_market   外围市场\nnews            财经快讯\nemotion_daily   计算后的情绪指标（温度/阶段/溢价/晋级率）\nforecast_log    预测记录（含事后回验字段）\ncollect_log     采集日志（每步成败）\nstock_basic     股票名录\nbillboard       龙虎榜个股（含 d1/d5/d10/d20/d30 前向涨幅）\n                ⚠️ 主键含 reason，同股同日可能多行（13.4%）\nbillboard_uniq  【视图】按 (日期,代码) 去重；前向收益取 MIN，金额取 SUM，\n                多个上榜原因合并进 reasons 字段。**统计一律用这个视图**\nseat_trade      席位买卖明细（含席位3日胜率 rep_prob）\n                ⚠️ 主键含 side\nseat_buy_uniq   【视图】仅买方、按 (日期,席位,代码) 去重\nseat_daily      活跃席位榜\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e为什么必须有去重视图\u003c/strong\u003e：\u003ccode\u003ebillboard\u003c/code\u003e 主键是\n\u003ccode\u003e(trade_date, code, reason)\u003c/code\u003e，一只股票同日因\"日涨幅达15%\"和\n\"日换手率达20%\"两个原因上榜就会有\u003cstrong\u003e两行\u003c/strong\u003e。若直接\n\u003ccode\u003eseat_trade JOIN billboard\u003c/code\u003e，这只股票的所有席位记录会被\u003cstrong\u003e重复计数\u003c/strong\u003e，\n权重凭空翻倍。实测这会把可执行样本的 D1 从 \u003cstrong\u003e+1.880% 拉偏到 +1.768%\u003c/strong\u003e，\n并让 DSR 从 0.9757（通过）掉到 0.9403（未通过）——\u003cstrong\u003e足以改变结论\u003c/strong\u003e。\n（DSR 随历次缺陷修复从 0.9403 → 0.9679 → 0.9757 逐步上升，\n每次都是修正 bug 而非挑参数，但这个变化轨迹本身值得读者警惕。）\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e数据库是单个 SQLite 文件：\u003ccode\u003edata/chaogu.db\u003c/code\u003e。\u003c/p\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch4 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003esignal_log（看板信号留痕）\u003c/h4\u003e\u003ca id=\"user-content-signal_log看板信号留痕\" class=\"anchor\" aria-label=\"Permalink: signal_log（看板信号留痕）\" href=\"#signal_log看板信号留痕\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e每次看板渲染都会写入当日候选，之后用真实行情回填。\u003c/p\u003e\n\u003cmarkdown-accessiblity-table\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003e列\u003c/th\u003e\n\u003cth\u003e含义\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003esignal_date\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e看板给出信号的日子（\u003cstrong\u003e收盘后\u003c/strong\u003e才可计算）\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003ecode\u003c/code\u003e / \u003ccode\u003ename\u003c/code\u003e / \u003ccode\u003eseat\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e标的与席位\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003erep_prob\u003c/code\u003e / \u003ccode\u003eactivity\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e当时平台胜率、当时 60 日活跃度\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003eentry_close\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e信号日收盘价。\u003cstrong\u003e只是收益基准，不是你成交的价格\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003ed1_ret\u003c/code\u003e / \u003ccode\u003ed5_ret\u003c/code\u003e / \u003ccode\u003ed10_ret\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e次日/5日/10日收盘涨幅%。\u003cstrong\u003eNULL = 未来尚未发生，不是缺失\u003c/strong\u003e\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003e\u003ccode\u003ed1_locked\u003c/code\u003e\u003c/td\u003e\n\u003ctd\u003e次日是否又涨停（1 = 买不进）。诚实性的关键一列\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\u003c/markdown-accessiblity-table\u003e\n\u003cp dir=\"auto\"\u003e主键 \u003ccode\u003e(signal_date, code)\u003c/code\u003e，重复留痕幂等。\n回填\u003cstrong\u003e只填空字段\u003c/strong\u003e，不重写已有值（否则\"新填 N 条\"的计数是假的）。\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp dir=\"auto\"\u003e为什么不用 \u003ccode\u003eseat_trade\u003c/code\u003e 代替：\u003ccode\u003eseat_trade\u003c/code\u003e 是券商披露的\u003cstrong\u003e事后\u003c/strong\u003e数据，\n本表记的是\u003cstrong\u003e当时\u003c/strong\u003e看板看到了什么。时间戳含义不同，混在一起无法审计。\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e八、调参\u003c/h2\u003e\u003ca id=\"user-content-八调参\" class=\"anchor\" aria-label=\"Permalink: 八、调参\" href=\"#八调参\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e所有阈值集中在 \u003ccode\u003echaogu/config.py\u003c/code\u003e，方便按自己的理解校准。\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e席位相关（新增）：\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-python notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"SEAT_MIN_REP_PROB  = 50.0   # 席位3日胜率下限（⚠️ 50 档净收益为负，见下）\nSEAT_STRONG_REP_PROB = 60.0 # \u0026quot;高胜率\u0026quot;档（实测 D5 净 +2.71%）\nSEAT_ELITE_REP_PROB  = 70.0 # \u0026quot;最强\u0026quot;档（实测 D5 净 +5.82%）\nSEAT_MIN_TRADES    = 20     # 席位排名最少样本\nSEAT_EVAL_DAYS     = 180    # 评估窗口（交易日）\"\u003e\u003cpre\u003e\u003cspan class=\"pl-c1\"\u003eSEAT_MIN_REP_PROB\u003c/span\u003e  \u003cspan class=\"pl-c1\"\u003e=\u003c/span\u003e \u003cspan class=\"pl-c1\"\u003e50.0\u003c/span\u003e   \u003cspan class=\"pl-c\"\u003e# 席位3日胜率下限（⚠️ 50 档净收益为负，见下）\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eSEAT_STRONG_REP_PROB\u003c/span\u003e \u003cspan class=\"pl-c1\"\u003e=\u003c/span\u003e \u003cspan class=\"pl-c1\"\u003e60.0\u003c/span\u003e \u003cspan class=\"pl-c\"\u003e# \"高胜率\"档（实测 D5 净 +2.71%）\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eSEAT_ELITE_REP_PROB\u003c/span\u003e  \u003cspan class=\"pl-c1\"\u003e=\u003c/span\u003e \u003cspan class=\"pl-c1\"\u003e70.0\u003c/span\u003e \u003cspan class=\"pl-c\"\u003e# \"最强\"档（实测 D5 净 +5.82%）\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eSEAT_MIN_TRADES\u003c/span\u003e    \u003cspan class=\"pl-c1\"\u003e=\u003c/span\u003e \u003cspan class=\"pl-c1\"\u003e20\u003c/span\u003e     \u003cspan class=\"pl-c\"\u003e# 席位排名最少样本\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eSEAT_EVAL_DAYS\u003c/span\u003e     \u003cspan class=\"pl-c1\"\u003e=\u003c/span\u003e \u003cspan class=\"pl-c1\"\u003e180\u003c/span\u003e    \u003cspan class=\"pl-c\"\u003e# 评估窗口（交易日）\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003e\u003ccode\u003eSEAT_MIN_REP_PROB=50\u003c/code\u003e 是行为警戒线，不是推荐门槛。\u003c/strong\u003e\n50 档的可执行净收益为 D1 \u003cstrong\u003e-0.70%\u003c/strong\u003e、D5 \u003cstrong\u003e-0.50%\u003c/strong\u003e（亏的）。\n它存在的意义是\"低于 50 是明确的反向信号\"。\n实战门槛应用 \u003cstrong\u003e60 或 70\u003c/strong\u003e；\u003ccode\u003e--follow\u003c/code\u003e 默认走 60。\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-python notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"WEIGHTS          # 情绪温度分各指标权重（premium 默认 0.24 最高）\nFALLBACK         # 冷启动时的绝对阈值（历史满 15 天后改用滚动分位数）\nSTAGE_BANDS      # 阶段分数区间\nEBB_PREMIUM      # 退潮判定：溢价低于此值\nDIVERGE_SEAL_RATE# 分歧判定：封板率低于此值\nTHEME_SCORE_WEIGHTS  # 题材延续性各分项权重\nNEW_THEME_MIN_ZT     # 新题材最少涨停家数\nFORECAST_NEIGHBORS   # 相似日邻居数\"\u003e\u003cpre\u003e\u003cspan class=\"pl-c1\"\u003eWEIGHTS\u003c/span\u003e          \u003cspan class=\"pl-c\"\u003e# 情绪温度分各指标权重（premium 默认 0.24 最高）\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eFALLBACK\u003c/span\u003e         \u003cspan class=\"pl-c\"\u003e# 冷启动时的绝对阈值（历史满 15 天后改用滚动分位数）\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eSTAGE_BANDS\u003c/span\u003e      \u003cspan class=\"pl-c\"\u003e# 阶段分数区间\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eEBB_PREMIUM\u003c/span\u003e      \u003cspan class=\"pl-c\"\u003e# 退潮判定：溢价低于此值\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eDIVERGE_SEAL_RATE\u003c/span\u003e\u003cspan class=\"pl-c\"\u003e# 分歧判定：封板率低于此值\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eTHEME_SCORE_WEIGHTS\u003c/span\u003e  \u003cspan class=\"pl-c\"\u003e# 题材延续性各分项权重\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eNEW_THEME_MIN_ZT\u003c/span\u003e     \u003cspan class=\"pl-c\"\u003e# 新题材最少涨停家数\u003c/span\u003e\n\u003cspan class=\"pl-c1\"\u003eFORECAST_NEIGHBORS\u003c/span\u003e   \u003cspan class=\"pl-c\"\u003e# 相似日邻居数\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e九、局限与风险（请认真读）\u003c/h2\u003e\u003ca id=\"user-content-九局限与风险请认真读\" class=\"anchor\" aria-label=\"Permalink: 九、局限与风险（请认真读）\" href=\"#九局限与风险请认真读\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003col dir=\"auto\"\u003e\n\u003cli\u003e\u003cstrong\u003e工具不替你决策\u003c/strong\u003e。它整理数据、计算指标、给出统计参考，\n但买卖是你的决定，盈亏也是你的。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e历史相似不等于未来重演\u003c/strong\u003e。预测模块输出的是\"情绪处于类似位置时历史上通常怎么走\"，\n样本量小（几十到一两百天），且市场结构在变。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eA股短线生态已经和十年前不同\u003c/strong\u003e。量化资金占比大幅提升，\n打板/接力的结构性胜率下降。即使完全复制某个游资前辈的方法，\n在今天的市场里也未必有当时的赔率。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e幸存者偏差\u003c/strong\u003e。成名的游资是幸存者，用同样方法爆仓的人不会出名。\n把成功者当唯一样本会严重高估胜率。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e数据可能有误\u003c/strong\u003e。第三方公开接口，存在延迟、缺失、口径差异。\n跌停家数在历史回填时是\u003cstrong\u003e近似值\u003c/strong\u003e（按板块阈值推算，未剔除 ST）。\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e短线是负和游戏\u003c/strong\u003e。扣掉手续费和冲击成本，多数参与者长期亏损。\u003c/li\u003e\n\u003c/ol\u003e\n\u003chr\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e十、免责声明\u003c/h2\u003e\u003ca id=\"user-content-十免责声明\" class=\"anchor\" aria-label=\"Permalink: 十、免责声明\" href=\"#十免责声明\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e本项目仅用于交易复盘与个人研究，\u003cstrong\u003e不构成任何投资建议\u003c/strong\u003e。\n数据来源于第三方公开接口，可能存在延迟、缺失或错误，请以交易所及券商行情为准。\n短线交易风险极高，请自行承担全部决策后果。\u003c/p\u003e\n\u003c/article\u003e","loaded":true,"timedOut":false,"errorMessage":null,"headerInfo":{"toc":[{"level":1,"text":"A股观察站 (a-share-observer) —— A股市场数据与情绪周期看板","anchor":"a股观察站-a-share-observer--a股市场数据与情绪周期看板","htmlText":"A股观察站 (a-share-observer) —— A股市场数据与情绪周期看板"},{"level":2,"text":"新电脑快速部署","anchor":"新电脑快速部署","htmlText":"新电脑快速部署"},{"level":2,"text":"新版看板（2026-09-30 起）：结论先行 + 一句话生成","anchor":"新版看板2026-09-30-起结论先行--一句话生成","htmlText":"新版看板（2026-09-30 起）：结论先行 + 一句话生成"},{"level":2,"text":"〇、看板（长期驻留，推荐入口）","anchor":"〇看板长期驻留推荐入口","htmlText":"〇、看板（长期驻留，推荐入口）"},{"level":3,"text":"顶部「今日要点」：3 秒看完","anchor":"顶部今日要点3-秒看完","htmlText":"顶部「今日要点」：3 秒看完"},{"level":3,"text":"看板有六栏","anchor":"看板有六栏","htmlText":"看板有六栏"},{"level":3,"text":"四个为\"长期运行\"专门做的设计","anchor":"四个为长期运行专门做的设计","htmlText":"四个为\"长期运行\"专门做的设计"},{"level":3,"text":"怎么学大神：行为画像（run.py style）","anchor":"怎么学大神行为画像runpy-style","htmlText":"怎么学大神：行为画像（run.py style）"},{"level":3,"text":"健壮性（长期运行必须处理的事）","anchor":"健壮性长期运行必须处理的事","htmlText":"健壮性（长期运行必须处理的事）"},{"level":3,"text":"④b 留痕战绩：胜率只能靠记账改进","anchor":"b-留痕战绩胜率只能靠记账改进","htmlText":"④b 留痕战绩：胜率只能靠记账改进"},{"level":3,"text":"开机自启（可选，但\"长期运行\"建议装）","anchor":"开机自启可选但长期运行建议装","htmlText":"开机自启（可选，但\"长期运行\"建议装）"},{"level":3,"text":"自动采集的两个致命时序 bug（都已修）","anchor":"自动采集的两个致命时序-bug都已修","htmlText":"自动采集的两个致命时序 bug（都已修）"},{"level":2,"text":"一、快速开始","anchor":"一快速开始","htmlText":"一、快速开始"},{"level":2,"text":"二、核心概念：为什么要看这些指标","anchor":"二核心概念为什么要看这些指标","htmlText":"二、核心概念：为什么要看这些指标"},{"level":3,"text":"最重要的一个指标：昨日涨停溢价","anchor":"最重要的一个指标昨日涨停溢价","htmlText":"最重要的一个指标：昨日涨停溢价"},{"level":3,"text":"指标体系","anchor":"指标体系","htmlText":"指标体系"},{"level":3,"text":"情绪周期阶段","anchor":"情绪周期阶段","htmlText":"情绪周期阶段"},{"level":2,"text":"三、题材分析","anchor":"三题材分析","htmlText":"三、题材分析"},{"level":3,"text":"新题材侦测","anchor":"新题材侦测","htmlText":"新题材侦测"},{"level":3,"text":"延续性评分（⚠️ 请看下面的实证结论，它不能预测延续）","anchor":"延续性评分️-请看下面的实证结论它不能预测延续","htmlText":"延续性评分（⚠️ 请看下面的实证结论，它不能预测延续）"},{"level":4,"text":"⚠️ 但是：这套评分的预测力经检验是不成立的","anchor":"️-但是这套评分的预测力经检验是不成立的","htmlText":"⚠️ 但是：这套评分的预测力经检验是不成立的"},{"level":4,"text":"结论怎么用","anchor":"结论怎么用","htmlText":"结论怎么用"},{"level":3,"text":"龙头识别","anchor":"龙头识别","htmlText":"龙头识别"},{"level":2,"text":"四、预测模块","anchor":"四预测模块","htmlText":"四、预测模块"},{"level":2,"text":"五、实证发现（用这个工具跑出来的真实结论）","anchor":"五实证发现用这个工具跑出来的真实结论","htmlText":"五、实证发现（用这个工具跑出来的真实结论）"},{"level":3,"text":"5.1 情绪周期确实存在，而且可以被量化","anchor":"51-情绪周期确实存在而且可以被量化","htmlText":"5.1 情绪周期确实存在，而且可以被量化"},{"level":3,"text":"5.2 但是：次日情绪无法用这些指标预测","anchor":"52-但是次日情绪无法用这些指标预测","htmlText":"5.2 但是：次日情绪无法用这些指标预测"},{"level":3,"text":"5.3 这对\"能不能学短线\"意味着什么","anchor":"53-这对能不能学短线意味着什么","htmlText":"5.3 这对\"能不能学短线\"意味着什么"},{"level":3,"text":"5.3a 龙头（高连板）：看起来越高越强，其实赚的全是买不进的","anchor":"53a-龙头高连板看起来越高越强其实赚的全是买不进的","htmlText":"5.3a 龙头（高连板）：看起来越高越强，其实赚的全是买不进的"},{"level":3,"text":"5.3b 题材延续性评分：又一个\"看起来合理但验证不成立\"的例子","anchor":"53b-题材延续性评分又一个看起来合理但验证不成立的例子","htmlText":"5.3b 题材延续性评分：又一个\"看起来合理但验证不成立\"的例子"},{"level":3,"text":"5.4 但是：席位数据是例外——它真的有效","anchor":"54-但是席位数据是例外它真的有效","htmlText":"5.4 但是：席位数据是例外——它真的有效"},{"level":3,"text":"5.5 第二个维度：席位活跃度（并且它解决了一个外部矛盾）","anchor":"55-第二个维度席位活跃度并且它解决了一个外部矛盾","htmlText":"5.5 第二个维度：席位活跃度（并且它解决了一个外部矛盾）"},{"level":2,"text":"五之二、席位分析怎么用","anchor":"五之二席位分析怎么用","htmlText":"五之二、席位分析怎么用"},{"level":3,"text":"先跑自检（强烈建议）","anchor":"先跑自检强烈建议","htmlText":"先跑自检（强烈建议）"},{"level":2,"text":"六、数据源与已知的坑","anchor":"六数据源与已知的坑","htmlText":"六、数据源与已知的坑"},{"level":3,"text":"踩过的坑（都在代码注释里标了）","anchor":"踩过的坑都在代码注释里标了","htmlText":"踩过的坑（都在代码注释里标了）"},{"level":2,"text":"七、数据模型","anchor":"七数据模型","htmlText":"七、数据模型"},{"level":4,"text":"signal_log（看板信号留痕）","anchor":"signal_log看板信号留痕","htmlText":"signal_log（看板信号留痕）"},{"level":2,"text":"八、调参","anchor":"八调参","htmlText":"八、调参"},{"level":2,"text":"九、局限与风险（请认真读）","anchor":"九局限与风险请认真读","htmlText":"九、局限与风险（请认真读）"},{"level":2,"text":"十、免责声明","anchor":"十免责声明