ts = {\u003cspan class=\"hljs-string\"\u003e\u0026quot;2\u0026quot;\u003c/span\u003e:\u003cspan class=\"hljs-number\"\u003e1\u003c/span\u003e, \u003cspan class=\"hljs-string\"\u003e\u0026quot;4\u0026quot;\u003c/span\u003e:-\u003cspan class=\"hljs-number\"\u003e1\u003c/span\u003e}\n\u003c/code\u003e\u003c/pre\u003e\n\n        \u003cdiv class=\"yfm-code-floating\"\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button yfm-code-button yfm-wrapping-button\" tabindex=\"-1\" type=\"button\" aria-label=\"Toggle line wrapping\" aria-pressed=\"false\" data-tabindex=\"0\"\u003e\n            \u003cspan class=\"g-button__icon\"\u003e\n            \u003cspan class=\"g-button__icon-inner\"\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"16\" height=\"16\" class=\"g-icon\" fill=\"currentColor\" stroke=\"none\" aria-hidden=\"true\"\u003e\n                \u003csvg class=\"yfm-code-icon yfm-wrapping-icon\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"\u003e\n                    \u003cpath fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M2.47 11.28a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 1.06L4.81 10H9a3.25 3.25 0 0 0 0-6.5H8A.75.75 0 0 1 8 2h1a4.75 4.75 0 1 1 0 9.5H4.81l1.72 1.72a.75.75 0 1 1-1.06 1.06z\" clip-rule=\"evenodd\"\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n            \u003c/span\u003e\n            \u003c/span\u003e\n        \u003c/button\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button  yfm-code-button yfm-clipboard-button\" aria-label=\"Copy\"\u003e\n                \u003cspan class=\"g-button__icon g-clipboard-button__icon\"\u003e\n                \u003cspan class=\"g-button__icon-inner\"\u003e\n                \u003csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" class=\"yfm-code-icon yfm-clipboard-icon\" data-animation=\"2833\"\u003e\n                    \u003cpath\n                        fill=\"currentColor\"\n                        d=\"M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z\"\n                    /\u003e\n                    \u003cpath\n                        stroke=\"currentColor\"\n                        fill=\"transparent\"\n                        stroke-width=\"1.5\"\n                        d=\"M9.5 13l3 3l5 -5\"\n                        visibility=\"hidden\"\n                    \u003e\n                        \u003canimate\n                            id=\"visibileAnimation-2833\"\n                            attributeName=\"visibility\"\n                            from=\"hidden\"\n                            to=\"visible\"\n                            dur=\"0.2s\"\n                            fill=\"freeze\"\n                            begin=\"\"\n                        /\u003e\n                        \u003canimate\n                            id=\"hideAnimation-2833\"\n                            attributeName=\"visibility\"\n                            from=\"visible\"\n                            to=\"hidden\"\n                            dur=\"1s\"\n                            begin=\"visibileAnimation-2833.end+1\"\n                            fill=\"freeze\"\n                        /\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n                \u003c/span\u003e\n                \u003c/span\u003e\n            \u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e\u003c/details\u003e\u003cp\u003eare identical, given that the name of the feature indexed 2 is \u003cq\u003eFeature2\u003c/q\u003e and the name of the feature indexed 4 is \u003cq\u003eFeature4\u003c/q\u003e.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eType\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003elist of strings\u003c/li\u003e\n\u003cli\u003estring\u003c/li\u003e\n\u003cli\u003edict\u003c/li\u003e\n\u003cli\u003elist\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cstrong\u003eDefault value\u003c/strong\u003e\u003c/p\u003e\n\u003cdetails class=\"yfm-cut\"\u003e\u003csummary class=\"yfm-cut-title\"\u003ePython package, R package\u003c/summary\u003e\u003cdiv class=\"yfm-cut-content\"\u003e\u003cp\u003eNone\u003c/p\u003e\n\u003c/div\u003e\u003c/details\u003e\u003cdetails class=\"yfm-cut\"\u003e\u003csummary class=\"yfm-cut-title\"\u003eCommand-line\u003c/summary\u003e\u003cdiv class=\"yfm-cut-content\"\u003e\u003cp\u003eOmmited\u003c/p\u003e\n\u003c/div\u003e\u003c/details\u003e\u003cp\u003e\u003cstrong\u003eSupported processing units\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eCPU\u003c/p\u003e\n\u003ch2 id=\"feature_weights\"\u003e\u003ca href=\"en/references/training-parameters/common#feature_weights\" class=\"yfm-anchor yfm-clipboard-anchor\" aria-hidden=\"true\"\u003e\u003c/a\u003efeature_weights\u003c/h2\u003e\n\u003cp\u003eCommand-line: \u003ccode class=\"yfm-clipboard-inline-code\" role=\"button\" tabindex='0' id=\"inline-code-id-t8iej00s\"\u003e--feature-weights\u003c/code\u003e\u003c/p\u003e\n\u003ch4 id=\"description45\"\u003e\u003ca href=\"en/references/training-parameters/common#description45\" class=\"yfm-anchor yfm-clipboard-anchor\" aria-hidden=\"true\"\u003e\u003c/a\u003eDescription\u003c/h4\u003e\n\u003c!-- source: en/_includes/work_src/reusage/cli__feature-weight__desc__intro.md --\u003e\n\u003cp\u003ePer-feature multiplication weights used when choosing the best split. The score of each candidate is multiplied by the weights of features from the current split.\u003c/p\u003e\n\u003cp\u003eNon-negative float values are supported for each weight.\u003c/p\u003e\n\u003cp\u003eSupported formats for setting the value of this parameter:\u003c/p\u003e\n\u003c!-- endsource: en/_includes/work_src/reusage/cli__feature-weight__desc__intro.md --\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003c!-- source: en/_includes/work_src/reusage/cli__feature-weight__desc__weight-for-each-feature.md --\u003e\n\u003cp\u003eSet the multiplication weight for each feature as a string (the number of features is n).\u003c/p\u003e\n\u003cp\u003eFormat\u003c/p\u003e\n\n    \u003cdiv class=\"yfm-code-floating-container\"\u003e\n        \u003cpre\u003e\u003ccode class=\"hljs\"\u003e\u0026quot;(\u0026lt;feature-weight_0\u0026gt;,\u0026lt;feature-weight_2\u0026gt;,..,\u0026lt;feature-weight_n-1\u0026gt;)\u0026quot;\n\u003c/code\u003e\u003c/pre\u003e\n\n        \u003cdiv class=\"yfm-code-floating\"\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button yfm-code-button yfm-wrapping-button\" tabindex=\"-1\" type=\"button\" aria-label=\"Toggle line wrapping\" aria-pressed=\"false\" data-tabindex=\"0\"\u003e\n            \u003cspan class=\"g-button__icon\"\u003e\n            \u003cspan class=\"g-button__icon-inner\"\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"16\" height=\"16\" class=\"g-icon\" fill=\"currentColor\" stroke=\"none\" aria-hidden=\"true\"\u003e\n                \u003csvg class=\"yfm-code-icon yfm-wrapping-icon\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"\u003e\n                    \u003cpath fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M2.47 11.28a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 1.06L4.81 10H9a3.25 3.25 0 0 0 0-6.5H8A.75.75 0 0 1 8 2h1a4.75 4.75 0 1 1 0 9.5H4.81l1.72 1.72a.75.75 0 1 1-1.06 1.06z\" clip-rule=\"evenodd\"\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n            \u003c/span\u003e\n            \u003c/span\u003e\n        \u003c/button\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button  yfm-code-button yfm-clipboard-button\" aria-label=\"Copy\"\u003e\n                \u003cspan class=\"g-button__icon g-clipboard-button__icon\"\u003e\n                \u003cspan class=\"g-button__icon-inner\"\u003e\n                \u003csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" class=\"yfm-code-icon yfm-clipboard-icon\" data-animation=\"2924\"\u003e\n                    \u003cpath\n                        fill=\"currentColor\"\n                        d=\"M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z\"\n                    /\u003e\n                    \u003cpath\n                        stroke=\"currentColor\"\n                        fill=\"transparent\"\n                        stroke-width=\"1.5\"\n                        d=\"M9.5 13l3 3l5 -5\"\n                        visibility=\"hidden\"\n                    \u003e\n                        \u003canimate\n                            id=\"visibileAnimation-2924\"\n                            attributeName=\"visibility\"\n                            from=\"hidden\"\n                            to=\"visible\"\n                            dur=\"0.2s\"\n                            fill=\"freeze\"\n                            begin=\"\"\n                        /\u003e\n                        \u003canimate\n                            id=\"hideAnimation-2924\"\n                            attributeName=\"visibility\"\n                            from=\"visible\"\n                            to=\"hidden\"\n                            dur=\"1s\"\n                            begin=\"visibileAnimation-2924.end+1\"\n                            fill=\"freeze\"\n                        /\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n                \u003c/span\u003e\n                \u003c/span\u003e\n            \u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003cdiv class=\"yfm-note yfm-accent-info\" note-type=\"info\"\u003e\u003cp class=\"yfm-note-title\"\u003eNote\u003c/p\u003e\n\u003cdiv class=\"yfm-note-content\"\u003e\u003cp\u003eSpaces between values are not allowed.\u003c/p\u003e\n\u003c/div\u003e\u003c/div\u003e\u003cp\u003eValues should be passed as a parenthesized string of comma-separated values. Multiplication weights equal to 1 at the end of the list may be dropped.\u003c/p\u003e\n\u003c!-- endsource: en/_includes/work_src/reusage/cli__feature-weight__desc__weight-for-each-feature.md --\u003e\n\u003cp\u003eIn this\u003c/p\u003e\n\u003cdetails class=\"yfm-cut\"\u003e\u003csummary class=\"yfm-cut-title\"\u003eexample\u003c/summary\u003e\u003cdiv class=\"yfm-cut-content\"\u003e\n    \u003cdiv class=\"yfm-code-floating-container\"\u003e\n        \u003cpre\u003e\u003ccode class=\"hljs\"\u003efeature_weights = \u0026quot;(0.1,1,3)\u0026quot;\n\u003c/code\u003e\u003c/pre\u003e\n\n        \u003cdiv class=\"yfm-code-floating\"\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button yfm-code-button yfm-wrapping-button\" tabindex=\"-1\" type=\"button\" aria-label=\"Toggle line wrapping\" aria-pressed=\"false\" data-tabindex=\"0\"\u003e\n            \u003cspan class=\"g-button__icon\"\u003e\n            \u003cspan class=\"g-button__icon-inner\"\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"16\" height=\"16\" class=\"g-icon\" fill=\"currentColor\" stroke=\"none\" aria-hidden=\"true\"\u003e\n                \u003csvg class=\"yfm-code-icon yfm-wrapping-icon\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"\u003e\n                    \u003cpath fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M2.47 11.28a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 1.06L4.81 10H9a3.25 3.25 0 0 0 0-6.5H8A.75.75 0 0 1 8 2h1a4.75 4.75 0 1 1 0 9.5H4.81l1.72 1.72a.75.75 0 1 1-1.06 1.06z\" clip-rule=\"evenodd\"\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n            \u003c/span\u003e\n            \u003c/span\u003e\n        \u003c/button\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button  yfm-code-button yfm-clipboard-button\" aria-label=\"Copy\"\u003e\n                \u003cspan class=\"g-button__icon g-clipboard-button__icon\"\u003e\n                \u003cspan class=\"g-button__icon-inner\"\u003e\n                \u003csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" class=\"yfm-code-icon yfm-clipboard-icon\" data-animation=\"2947\"\u003e\n                    \u003cpath\n                        fill=\"currentColor\"\n                        d=\"M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z\"\n                    /\u003e\n                    \u003cpath\n                        stroke=\"currentColor\"\n                        fill=\"transparent\"\n                        stroke-width=\"1.5\"\n                        d=\"M9.5 13l3 3l5 -5\"\n                        visibility=\"hidden\"\n                    \u003e\n                        \u003canimate\n                            id=\"visibileAnimation-2947\"\n                            attributeName=\"visibility\"\n                            from=\"hidden\"\n                            to=\"visible\"\n                            dur=\"0.2s\"\n                            fill=\"freeze\"\n                            begin=\"\"\n                        /\u003e\n                        \u003canimate\n                            id=\"hideAnimation-2947\"\n                            attributeName=\"visibility\"\n                            from=\"visible\"\n                            to=\"hidden\"\n                            dur=\"1s\"\n                            begin=\"visibileAnimation-2947.end+1\"\n                            fill=\"freeze\"\n                        /\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n                \u003c/span\u003e\n                \u003c/span\u003e\n            \u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e\u003c/details\u003e\u003cp\u003ethe multiplication weight is set to 0.1, 1 and 3 for the first, second and third features respectively. The multiplication weight for all other features is set to 1.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003c!-- source: en/_includes/work_src/reusage/cli__feature-weight__formats__individually-for-required-features.md --\u003e\n\u003cp\u003eSet the multiplication weight individually for each explicitly specified feature as a string (the number of features is n).\u003c/p\u003e\n\u003cp\u003eFormat\u003c/p\u003e\n\n    \u003cdiv class=\"yfm-code-floating-container\"\u003e\n        \u003cpre\u003e\u003ccode class=\"hljs\"\u003e\u0026quot;\u0026lt;feature index or name\u0026gt;:\u0026lt;weight\u0026gt;, .., \u0026lt;feature index or name\u0026gt;:\u0026lt;weight\u0026gt;\u0026quot;\n\u003c/code\u003e\u003c/pre\u003e\n\n        \u003cdiv class=\"yfm-code-floating\"\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button yfm-code-button yfm-wrapping-button\" tabindex=\"-1\" type=\"button\" aria-label=\"Toggle line wrapping\" aria-pressed=\"false\" data-tabindex=\"0\"\u003e\n            \u003cspan class=\"g-button__icon\"\u003e\n            \u003cspan class=\"g-button__icon-inner\"\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"16\" height=\"16\" class=\"g-icon\" fill=\"currentColor\" stroke=\"none\" aria-hidden=\"true\"\u003e\n                \u003csvg class=\"yfm-code-icon yfm-wrapping-icon\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 16 16\"\u003e\n                    \u003cpath fill=\"currentColor\" fill-rule=\"evenodd\" d=\"M2.47 11.28a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 1.06L4.81 10H9a3.25 3.25 0 0 0 0-6.5H8A.75.75 0 0 1 8 2h1a4.75 4.75 0 1 1 0 9.5H4.81l1.72 1.72a.75.75 0 1 1-1.06 1.06z\" clip-rule=\"evenodd\"\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n            \u003c/span\u003e\n            \u003c/span\u003e\n        \u003c/button\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button  yfm-code-button yfm-clipboard-button\" aria-label=\"Copy\"\u003e\n                \u003cspan class=\"g-button__icon g-clipboard-button__icon\"\u003e\n                \u003cspan class=\"g-button__icon-inner\"\u003e\n                \u003csvg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" class=\"yfm-code-icon yfm-clipboard-icon\" data-animation=\"2962\"\u003e\n                    \u003cpath\n                        fill=\"currentColor\"\n                        d=\"M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z\"\n                    /\u003e\n                    \u003cpath\n                        stroke=\"currentColor\"\n                        fill=\"transparent\"\n                        stroke-width=\"1.5\"\n                        d=\"M9.5 13l3 3l5 -5\"\n                        visibility=\"hidden\"\n                    \u003e\n                        \u003canimate\n                            id=\"visibileAnimation-2962\"\n                            attributeName=\"visibility\"\n                            from=\"hidden\"\n                            to=\"visible\"\n                            dur=\"0.2s\"\n                            fill=\"freeze\"\n                            begin=\"\"\n                        /\u003e\n                        \u003canimate\n                            id=\"hideAnimation-2962\"\n                            attributeName=\"visibility\"\n                            from=\"visible\"\n                            to=\"hidden\"\n                            dur=\"1s\"\n                            begin=\"visibileAnimation-2962.end+1\"\n                            fill=\"freeze\"\n                        /\u003e\n                    \u003c/path\u003e\n                \u003c/svg\u003e\n                \u003c/span\u003e\n                \u003c/span\u003e\n            \u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003cdiv class=\"yfm-note yfm-accent-info\" note-type=\"info\"\u003e\u003cp class=\"yfm-note-title\"\u003eNote\u003c/p\u003e\n\u003cdiv class=\"yfm-note-content\"\u003e\u003cp\u003eSpaces between values are not allowed.\u003c/p\u003e\n\u003c/div\u003e\u003c/div\u003e\u003c!-- endsource: en/_includes/work_src/reusage/cli__feature-weight__formats__individually-for-required-features.md --\u003e\n\u003cdetails class=\"yfm-cut\"\u003e\u003csummary class=\"yfm-cut-title\"\u003eThese examples\u003c/summary\u003e\u003cdiv class=\"yfm-cut-content\"\u003e\n    \u003cdiv class=\"yfm-code-floating-container\"\u003e\n        \u003cpre\u003e\u003ccode class=\"hljs\"\u003efeature_weights = \u0026quot;2:1.1,4:0.1\u0026quot;\n\u003c/code\u003e\u003c/pre\u003e\n\n        \u003cdiv class=\"yfm-code-floating\"\u003e\n            \u003cbutton role=\"button\" class=\"g-button g-button_view_flat g-button_size_m g-button_pin_round-round g-md-viewer-code-button yfm-code-button yfm-wrapping-button\" tabindex=\"-1\" type=\"button\" aria-label=\"Toggle line wrapping\" aria-pressed=\"false\" data-tabindex=\"0\"\u003e\n            \u003cspan class=\"g-button__icon\"\u003e\n            \u003cspan class=\"g-button__icon-inner\"\u003e\u003csvg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"16\" height=\"16\" class=\"g-i