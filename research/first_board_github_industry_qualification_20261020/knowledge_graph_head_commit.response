9ad1e2018f75","html_url":"https://github.com/lemonhu/stock-knowledge-graph/commit/2f66723041e25764c736449565bc9ad1e2018f75"},{"sha":"8d9a43398be0a84a9c3449fd20115339e724e908","url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/commits/8d9a43398be0a84a9c3449fd20115339e724e908","html_url":"https://github.com/lemonhu/stock-knowledge-graph/commit/8d9a43398be0a84a9c3449fd20115339e724e908"}],"stats":{"total":38182,"additions":17145,"deletions":21037},"files":[{"sha":"779ad5c5b186984d57d830e2bfe0c72e9eafa58a","filename":"README.md","status":"modified","additions":12,"deletions":1,"changes":13,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/README.md","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/README.md","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/contents/README.md?ref=83d9e2ac5f86893d27c7e0a5cd48307327969e65","patch":"@@ -124,13 +124,24 @@ df = ts.get_concept_classified()\n ## 任务5：利用上面的csv文件生成数据库\n \n ```shell\n-neo4j_home$ bin/neo4j-admin import --nodes executive.csv --nodes stock.csv -- nodes concept.csv --nodes industry.csv --relationships executive_stock.csv --relationships stock_industry.csv -- relationships stock_concept.csv\n+neo4j_home$ bin/neo4j-admin import --id-type=STRING --nodes executive.csv --nodes stock.csv --nodes concept.csv --nodes industry.csv --relationships executive_stock.csv --relationships stock_industry.csv --relationships stock_concept.csv\n ```\n \n 这个命令会把所有的数据导入到Neo4j中，数据默认存放在 graph.db 文件夹里。如果graph.db文件夹之前已经有数据存在，则可以选择先删除再执行命令。\n \n 把Neo4j服务重启之后，就可以通过`localhost:7474`观察到知识图谱了。\n \n+注意：这些csv要放到``~/.config/Neo4j Desktop/Application/neo4jDatabases/database-xxxx/installation-4.0.4``下，即与bin文件夹同级，否则需要绝对路径\n+\n+简单查询命令\n+\n+```bash\n+# 查询node\n+MATCH (n:Concept) RETURN n LIMIT 25\n+# 查询relationship\n+MATCH p=()-[r:industry_of]->() RETURN p LIMIT 100\n+```\n+\n ## 任务6：基于构建好的知识图谱，通过编写Cypher语句回答如下问题\n \n (1) 有多少个公司目前是属于“ST”类型的?"},{"sha":"a5c0dfdd22495a5de9ed888857170db4d8270896","filename":"data/import/concept.csv","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fconcept.csv","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fconcept.csv","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/contents/data%2Fimport%2Fconcept.csv?ref=83d9e2ac5f86893d27c7e0a5cd48307327969e65","patch":"@@ -1,4 +1,4 @@\n-concept_id:ID,name,:LABEL\r\n+concept_id:ID(Concept),name,:LABEL\r\n 75e96079eda9b8f8ff26ec4d25a0dfc3,成渝特区,Concept\r\n 83ee0bcb7f4d04367e8834b88995bd8a,氢燃料,Concept\r\n f1507f026988192110407ff48aebefa9,触摸屏,Concept\r"},{"sha":"5715732262468079007ccc3f0916e5391f0e8d2c","filename":"data/import/executive.csv","status":"modified","additions":1,"deletions":3904,"changes":3905,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fexecutive.csv","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fexecutive.csv","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/contents/data%2Fimport%2Fexecutive.csv?ref=83d9e2ac5f86893d27c7e0a5cd48307327969e65"},{"sha":"1075ff3214d5da24346586b3af4be479d190c089","filename":"data/import/executive_stock.csv","status":"modified","additions":10498,"deletions":10498,"changes":20996,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fexecutive_stock.csv","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fexecutive_stock.csv","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/contents/data%2Fimport%2Fexecutive_stock.csv?ref=83d9e2ac5f86893d27c7e0a5cd48307327969e65"},{"sha":"8f05baa62cb597081f242cd273881fce17ce15b8","filename":"data/import/industry.csv","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Findustry.csv","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Findustry.csv","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/contents/data%2Fimport%2Findustry.csv?ref=83d9e2ac5f86893d27c7e0a5cd48307327969e65","patch":"@@ -1,4 +1,4 @@\n-industry_id:ID,name,:LABEL\r\n+industry_id:ID(Industry),name,:LABEL\r\n 2212c3e783d2b83a8532d98eeba1c4b2,仪器仪表,Industry\r\n a2c6239da6b189ac41964eb35e313bb3,商业百货,Industry\r\n 3159a3474b29d95f46fa54b4ed7387c2,玻璃行业,Industry\r"},{"sha":"b20d9b033cd110c4b026677e715b3f856956b717","filename":"data/import/stock.csv","status":"modified","additions":1305,"deletions":1305,"changes":2610,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fstock.csv","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fstock.csv","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/contents/data%2Fimport%2Fstock.csv?ref=83d9e2ac5f86893d27c7e0a5cd48307327969e65"},{"sha":"8793cde327784bab439a36e44bd2129c1ca69392","filename":"data/import/stock_concept.csv","status":"modified","additions":4083,"deletions":4083,"changes":8166,"blob_url":"https://github.com/lemonhu/stock-knowledge-graph/blob/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fstock_concept.csv","raw_url":"https://github.com/lemonhu/stock-knowledge-graph/raw/83d9e2ac5f86893d27c7e0a5cd48307327969e65/data%2Fimport%2Fstock_concept.csv","contents_url":"https://api.github.com/repos/lemonhu/stock-knowledge-graph/conte