            }
            if (isIOS) {
                try {
                    var url = 'tgbiosapp://?type=live&liveSeq=' + liveSeq
                    window.location.href = url;
                    setTimeout(function () {
                        window.location = 'https://m.tgb.cn/downloadApp';
                    }, timeOut)
                } catch (e) {
                }
            }
        } else if (contentType == "WL") {
            var url = wlSrc + '';
            window.location = url;
        } else {
            //五种类型以外
            if (isAndroid) {
                try {
                    var url = 'taoguba://app/open';
                    window.location = url;
                    setTimeout(function () {
                        window.location = 'https://m.tgb.cn/downloadApp';
                    }, timeOut)
                } catch (e) {

                }
            }
            if (isIOS) {
                try {
                    var url = 'tgbiosapp://?type=home';
                    window.location.href = url;
                    setTimeout(function () {
                        window.location = 'https://m.tgb.cn/downloadApp';
                    }, timeOut)
                } catch (e) {
                }
            }
        }
}
</script>


