    //添加好友验证
    function addFriendInfo(postDate, source, bodySubject) {
        var getName = $.trim(window.currentFollowUserName || $('.HeadInfo_name').first().text() || $('.Mboke_username').text());
        if (!getName) {
            showMessage("接收用户为空，请刷新后重试!");
            return;
        }
        var msgText = document.getElementById("sendtxtcontent").value;
        var url = "/addFriendInfo?recvUserName=" + encodeURIComponent(getName) + "&msgText=" + encodeURIComponent(msgText);
        XMLHttp.sendReq("get", url, "", function (obj) {
            var str = obj.dto;
            $('.yzBox').hide();
            if (str == 1) {
                showMessage("发送成功!");
                $('.yzBox').hide();
            } else if (str == 0) {
                showMessage("失败，请重试!");
            } else if (str == 2) {
                showMessage("您的关注已经超过2000个，无法再加。");
            }
        });
    }

