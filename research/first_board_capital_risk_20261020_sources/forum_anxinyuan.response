function getCode() {
    /*不能去调用checkMoble函数,调用的话,还是会发送出去*/
    if (document.getElementById("mobile").value == "") {
        alert("手机号不能为空");
        return;
    } else if (!isPhone(document.getElementById("mobile").value)) {
        alert("请输入正确的手机号");
        return;
    }
    var mobile = document.getElementById("mobile").value;
    $.ajax({
        type: "get",
        url: "/sendMobileCode",
        data: {"mobile": mobile, "userID": 0},
        cache: "false",
        dataType: "json",
        success: function (data) {
            if (data.status){
                judgeTimes(data.dto);
                if (data.dto >= 1 && data.dto <= 10) {
                    document.getElementById("maxMobildeGetCodeCount").innerHTML = "您今天还有" + data.dto + "次获取验证码的机会";
                }else {
                    document.getElementById("maxMobildeGetCodeCount").innerHTML = "您今天获取验证码的机会已用完";
                    $('#getCodeBtn').attr('disabled', 'disabled').css('color', '#ccc').css('background', 'none');
                }
            }else{
                document.getElementById("maxMobildeGetCodeCount").innerHTML = data.errorMessage;
            }
        }
    });
}
