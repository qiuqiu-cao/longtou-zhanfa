    function formatDate(date) {
        date = date.replace(/-/g, "");
        date = date.replace(/:/g, "");
        date = date.replace(" ", "");
        return whichDate(date);
    }

    function whichDate(data) {
        var date = data;
        var year = date.substring(0, 4);
        var month = date.substring(4, 6);
        var day = date.substring(6, 8);
        var h = date.substring(8, 10);
        var s = date.substring(10, 12)
        var d1 = new Date(year + '/' + month + '/' + day);
        var dd = new Date();
        var y = dd.getFullYear();
        var m = dd.getMonth() + 1;
        var d = dd.getDate();
        var d2 = new Date(y + '/' + m + '/' + d);
        var iday = parseInt(d1 - d2) / 1000 / 60 / 60 / 24;
        var str = "";
        if (iday == 0) {
            str = "今天 " + h + ":" + s + "";
        }
        if (iday == 1) {
            str = "明天 " + h + ":" + s + "";
        }
        if (iday == 2) {
            str = "后天 " + h + ":" + s + "";
        }
        if (iday > 2) {
            str = month + "/" + day + " " + h + ":" + s + "";
        }
        return str;
    }

