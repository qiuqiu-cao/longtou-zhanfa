    //根据股票代码判断前缀

    function changeTwoDecimal_f(x) {
        var f_x = parseFloat(x);
        if (isNaN(f_x)) {
            alert('function:changeTwoDecimal->parameter error');
            return false;
        }
        var f_x = Math.round(x * 100) / 100;
        var s_x = f_x.toString();
        var pos_decimal = s_x.indexOf('.');
        if (pos_decimal < 0) {
            pos_decimal = s_x.length;
            s_x += '.';
        }
        while (s_x.length <= pos_decimal + 2) {
            s_x += '0';
        }
        return s_x;
    }




    aboutArticle();
    var topicsessionUserID = 0;

    function aboutArticle() {
        $.ajax({
            url: '/getRelationArticle',
            type: 'get',
            data: {
                'userID': topicCreatorId,
                'topicID': topicContentId
            },
            success: function (response) {
                if (response.status) {
                    var str = '';
                    if (topicsessionUserID == 0) {
                        if (response.dto == null || response.dto.length == 0) {
                            return
                        }
                        var arr = response.dto;
                        for (var i = 0; i < arr.length; i++) {
                            str += madearticlejson(arr, i, 'related');
                        }
                        $('#aboutArticles').html(str);
                        $('.xgwzContainer').show();
                    } else {
                        var arr = response.dto;
                        var arrLength = response.dto.relatedList.length + response.dto.userBaseList.length + response.dto.itemBaseList.length;
                        sessionStorage.setItem("localAtticles", JSON.stringify(response.dto));
                        if (arrLength > 0) {
                            if (arrLength > 3) {
                                madearticlePage('Y');
                            } else {
                                madearticlePage('N');
                                madearticlePage('N');
                                madearticlePage('N');
                            }
                        } else {
                            return;
                        }
                    }

                }
            }
        })
    }

