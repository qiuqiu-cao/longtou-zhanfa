            let timeOutDateTime = Date.now();
            if ((timeOutDateTime - loadDateTime) < 5000 ){
            	window.open('https://m.tgb.cn/downloadApp');
            }
        },600);


    }
    if(isIOS) {
    	 let loadDateTime = Date.now();
