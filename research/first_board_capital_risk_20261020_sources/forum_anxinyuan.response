        if (!subject) {
            subject = topicContentTitle;
        }
        //$("img.lazy").lazyload();
        //图片延迟加载
        function loadImage(el, fn) {
            var img = new Image();
            var src = el.getAttribute('data-original');
            img.src = src;
            img.onload = function () {
                if (!!el.parent) {
                    el.parent.replaceChild(img, el);
                } else {
                    el.src = src;
                }
                fn ? fn() : null;
            }
        }

        //判断某个元素是否在可见的屏幕内
        function elementInViewport(el) {
            var rect = el.getBoundingClientRect();
            return (
                rect.top >= 0
                && rect.left >= 0
                && rect.top <= (window.innerHeight || document.documentElement.clientHeight)
            )
        }

        //一边滚动一边加载图片
        function processScroll() {
            try {
                for (var i = 0; i < images.length; i++) {
                    if (elementInViewport(images[i])) {
                        loadImage(images[i], function () {
                            images.splice(i, i);              //加载完图片就从图片数组中删除
                        });
                    }
                }
                ;
            } catch (e) {
                showMessage("processScroll:" + e);
            }
        }

        //初始化一个图片数组
        var images = new Array();
        var query = document.querySelectorAll('img.lazy');
        for (var i = 0; i < query.length; i++) {
            if (images[i] != query[i]) {
                images.push(query[i]);
            }
        }
        ;
        processScroll();
        addEventListener('scroll', processScroll);
        if (videoID) {
            if ("" != shuoID) {
                var videoModal = "<div class=\"videoMsg\" style=\"margin-top: 5px;position: relative;\" align=\"center\" onclick=\"goToVideoView('" + shuoID + "')\">" +
                    "<div class=\"videoImg\" style=\"height: 50rem;overflow: hidden;background: #000;width: 98%;\">" +
                    "<img data-type='contentImage' class=\"video\" src=\"https://image.tgb.cn" + img + "_760w.png\" style=\"height: 100%;\">" +
                    "<img class=\"videoOpen\" src=\"https://js.tgb.cn/weex/assets/img/icon_video_play_n.png\" style=\"position: absolute;\">" +
                    "</div>" +
                    "</div>" +
                    "<div style=\"margin: 0 1%;padding: 5px 0;background: #f0f0f0;position: relative;\">";
                if (sessionUserID != userID) {
                    videoModal += "<div style=\"padding-left: 3%;text-align: left;height: 11rem;\">" +
                        "<a href=\"/blog/" + userID + "\" style=\"display: block;width: 40rem;height: 8rem;overflow: hidden;float: left;color: #000;line-height: 8rem;white-space: nowrap;text-overflow: ellipsis;\">" +
                        "<img src='https://image.tgb.cn/img/" + portrait + "_60wh.png' style=\"width: 8rem;height: 8rem;border-radius: 10rem;float: left;margin-right: 2rem;\">" + userName + "" +
                        "</a>" +
                        "<span class=\"addFocus right\" onclick=\"addGoodFriend('" + userName + "')\" style=\"margin-right: 2rem;\">+关注 </span>" +
                        "</div>";
                }
                videoModal += "<div style=\"padding-left: 3%;text-align: left;width: 75%;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;\" onclick=\"goToVideoView('" + shuoID + "')\">" + subject + "</div>" +
                    "<span style=\"position: absolute;bottom: 3px;right: 10px;\" onclick=\"goToVideoView('" + shuoID + "')\">&gt;</span>" +
                    "</div>";
                $("#id_" + videoID).html(videoModal);
            } else {
                $("#id_" + videoID).html("<div class=\"videoTitle\" align=\"center\" style=\"font-size: 14px; width: 560px; background-color: rgb(239, 239, 239); color: rgb(153, 153, 153); text-align: center; border-radius: 10px; margin-top: 10px;\"><span>该视频已被删除</span></div>");
            }

        }
        $(".videoOpen").css("left", $(".videoImg").width() / 2 - $(".videoOpen").width() / 2).css("top", $(".videoImg").height() / 2 - $(".videoOpen").height() / 2);
        // if(document.cookie.indexOf("mPopup") == -1 && sessionUserID == 0){//看帖页弹出层广告
