                $('#wxtopic').hide();
                $('.tzitem_text').addClass('hideText');
                $('.tzitem_bot').removeClass('fixBot');
                $('.tzitem_bot').attr('data-open', 'false');
                $('.tzitem_hide').find('img').attr('src', 'https://css.tgb.cn/images/mNew/zhankai.png');
