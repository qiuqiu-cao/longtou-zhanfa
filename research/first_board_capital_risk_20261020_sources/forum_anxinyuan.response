//上拉与下拉切换头部
 var HstartY ;
var HendY ;
document.addEventListener('touchstart',function(event){
 HstartY = event.touches[0].pageY ;
},false) 
 document.addEventListener('touchend',function(event){
 HendY = event.changedTouches[0].pageY ;
 var isOver = HendY - HstartY;
 if(isOver > 0 && search_status== 'true'){
     //下滑状态
    $('#openApp').show();
 }else if(isOver < 0){
     $('#openApp').hide(); 
 }
},false);
appInfo();
function downloadApp(){
    if (ua.match(/MicroMessenger/i) == 'micromessenger') {
        window.open('https://a.app.qq.com/o/simple.jsp?pkgname=com.taoguba.app');
    }else{
        window.location='https://m.tgb.cn/downloadApp';
    }
}
function appInfo(){
	var url="/appUserInfo?userID=" + 0;
	var local_img = localStorage.getItem("local_img" + 0);
	if(local_img){
		$('.Mheader_user').css('background-image','url('+local_img+')');
	}else{
        var data={};
        asyncFunAsyncCrossPost(url,data,function(obj){
            var jsonObj = obj.dto;
            var Himg
            if(jsonObj.pr=='img/user_icon_60.png'){
                Himg = 'https://image.tgb.cn/img/user_icon_60.png_60wh.png';
            }else{
                Himg = 'https://image.tgb.cn/img/' + jsonObj.pr +'_60wh.png';
            }

            $('.Mheader_user').css('background-image','url('+Himg+')');
            localStorage.setItem("local_img" + 0,Himg);
        });
	}

}
