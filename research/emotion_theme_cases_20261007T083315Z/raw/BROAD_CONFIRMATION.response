          __NEXT_DATA__ = {"props":{"isServer":true,"store":{},"initialState":{"showTopBanner":true,"activeNav":"tele","loadingBar":0,"stockUp":[],"refer_list":[],"one_data":{"data":{}},"imagePreview":"","errno":0,"deep_details":{"id":1807455,"short_title":"","title":"收评：沪指涨4.15%创4年多来最大单日涨幅 两市成交额超9700亿","author":"","assocFastFact":{"fid":0,"fast_fact_content":"","article_id":0,"article_title":"","imgs":"","slogan":""},"brief":"【收评：沪指涨4.15%创4年多以来最大单日涨幅 两市成交额超9700亿】财联社9月24日电，市场全天放量大涨，三大指数均涨超4%，沪指创2020年7月6日以来最大单日涨幅。沪深两市今日成交额9713亿，较上个交易日放量4203亿。盘面上，大金融股全线爆发，太平洋、首创证券、弘业期货、九鼎投资等10余股涨停，东方财富涨超10%。白酒股午后大涨，皇台酒业涨停，贵州茅台涨超8%。钢铁股震荡走强，中南股份、新钢股份、安阳钢铁、八一钢铁等近10股涨停。新能源赛道股展开反弹，德方纳米、龙蟠科技、弘元绿能、TCL中环等涨停。总体上个股涨多跌少，全市场超5100只个股上涨。板块方面，多元金融、钢铁、证券、白","guide_text":"","type":-1,"content":"【收评：沪指涨4.15%创4年多来最大单日涨幅 两市成交额超9700亿】财联社9月24日电，市场全天放量大涨，三大指数均涨超4%，沪指创2020年7月6日以来最大单日涨幅。沪深两市今日成交额9713亿，较上个交易日放量4203亿。盘面上，大金融股全线爆发，太平洋、首创证券、弘业期货、九鼎投资等10余股涨停，东方财富涨超10%。白酒股午后大涨，皇台酒业涨停，贵州茅台涨超8%。钢铁股震荡走强，中南股份、新钢股份、安阳钢铁、八一钢铁等近10股涨停。新能源赛道股展开反弹，德方纳米、龙蟠科技、弘元绿能、TCL中环等涨停。总体上个股涨多跌少，全市场超5100只个股上涨。板块方面，多元金融、钢铁、证券、白酒等板块涨幅居前，无下跌板块。截至收盘，沪指涨4.15%，深成指涨4.36%，创业板指涨5.54%。","remark":"","column_id":-1,"is_top":0,"img":"https://img.cls.cn/images/20240924/N6u81qE09X.png","imgs":[],"deny_comment":0,"comment_num":145,"ctime":1727161400,"abstract":"","sort_score":1727161400,"status":1,"audio_url":"","article_id":1807455,"shareurl":"https://api3.cls.cn/share/article/1807455?os=\u0026sv=8.4.4\u0026app=cailianpress","share_img":"https://img.cls.cn/share/roll.png","share_num":3732,"cate_name":"","schema":"","collection":0,"bottom_tips":"财联社声明：文章内容仅供参考，不构成投资建议。投资者据此操作，风险自担。","recommend":1,"level":"B","reading_num":3186892,"column_name":"","bottom_btn":{"btn_icon":"","tips":"","schema":""},"topics":[],"plate_list":[],"images":["https://img.cls.cn/images/20240924/N6u81qE09X.png"],"has_img":1,"sub_titles":null,"is_explain":-1,"is_ad":0,"ad":{"id":0,"title":"","img":"","url":"","monitorUrl":"","video_url":"","adTag":"","fullScreen":0,"type":0},"recomm