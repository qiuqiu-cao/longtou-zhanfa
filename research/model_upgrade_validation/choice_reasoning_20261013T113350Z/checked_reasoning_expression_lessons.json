  "lessons": [
    {
      "source_id": "tgb_cycle",
      "anchor": {
        "offset": 631,
        "text": "而补涨龙启动于龙头主升中的分歧。"
      },
      "thinking_to_check": "低位启动之前先核对旧高位当前阶段；主升分歧与退潮切换使用不同假设。",
      "expression_to_apply": "先说明当前环境，再说明个股所处位置及待确认身份，不把“低位”直接写成“补涨龙”。",
      "unverified_claims_not_imported": "七板等固定门槛、顶点天数、唯一赢家和仓位建议",
      "reviewed_at": "2026-10-13T11:37:11.285285+00:00",
      "author_market_examples_not_labels": true
    },
    {
      "source_id": "eastmoney_expression",
      "anchor": {
        "offset": 461,
        "text": "但强一天不能定主线"
      },
      "thinking_to_check": "主题首次走强后继续检查分歧、连续梯队和竞争方向。",
      "expression_to_apply": "用“候选—支持—反证—明日确认”表述，避免单日直接确认主线。",
      "unverified_claims_not_imported": "单篇资金流入及作者判定的真实主线身份",
      "reviewed_at": "2026-10-13T11:37:11.285285+00:00",
      "author_market_examples_not_labels": true
    },
    {
      "source_id": "eastmoney_expression",
      "anchor": {
        "offset": 1585,
        "text": "早盘竞价强弱 + 开盘承接力度"
      },
      "thinking_to_check": "事前分别声明竞价和开盘条件，观察只在真实时点追加。",
      "expression_to_apply": "把理由写成明确可被证伪的条件；弱路径也保留，不在结果后挑解释。",
      "unverified_claims_not_imported": "连续分歧必回流、反弹必离场或绝对四板上限",
      "reviewed_at": "2026-10-13T11:37:11.285285+00:00",
      "author_market_examples_not_labels": true
    },
    {
      "source_id": "eastmoney_expression",
      "anchor": {
        "offset": 1500,
        "text": "对兴业科技、宿迁联盛等同题材梯队没有带动性"
      },
      "thinking_to_check": "个股独立价格强与主题带动身份分别核对。",
      "expression_to_apply": "“价格恢复可观察；带动与身份未核”两句话分开，缺字段如实说缺。",
      "unverified_claims_not_imported": "作者案例的抱团龙/总龙等命名不作为身份真值",
      "reviewed_at": "2026-10-13T11:37:11.285285+00:00",
      "author_market_examples_not_labels": true
    }
