    function isPhone(str) {
        return (/^[1][345789][0-9]{9}$/).test(str);
    }

    function judgeTimes(data) {
        if (data > 0) {
            var time = 60;
            $('#getCodeBtn').html(time + "s后重新发送");
            var sendCodeTime = setInterval(function () {
                time = time - 1;
                $('#getCodeBtn').html(time + "s后重新发送").css("fontSize", "3.2rem");
                $("#getCodeBtn").attr("disabled", true);
                //清除定时器
                if (time == 0) {
                    clearInterval(sendCodeTime);
                    $('#getCodeBtn').removeAttr('disabled').html('获取验证码');
                    $("#getCodeBtn").attr("disabled", false);
                }
            }, 1000)
        } else {
            $('#getCodeBtn').attr('disabled', 'disabled').css(
                'background-color', '#ddd');
        }
    }

