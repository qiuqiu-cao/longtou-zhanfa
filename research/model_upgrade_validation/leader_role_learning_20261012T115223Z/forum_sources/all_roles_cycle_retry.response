<script type="text/javascript">
    wwwDomain = "https:\/\/www.tgb.cn"
    wwwDomainPath = "https:\/\/www.tgb.cn";
    String.prototype.trim = function () {
        return this.replace(/(^\s*)|(\s*$)/g, "");
    }
    var topicID = 8696276;
    var newTopicID = "2uGlwJ2RrKz";
    var blockID = 5;
    var topicCreatorId = 9150428;
    var topicCreatorName = "\u9752\u886B\u4E00\u5C11\u5E74";
    var topicContentId = 8696276;
    var topicContentTitle = "\u60C5\u7EEA\u5468\u671F\u9F99\u7A7A\u9F99\uFF08\u5EFF\u4E09\uFF09\u00B7\u5927\u5C40\u89C2\uFF1A\u7AD9\u5728\u5C71\u9876\u4FEF\u77B0\u6574\u4E2A\u60C5\u7EEA\u5468\u671F";
    var topicContentType = 5;

    function init() {
        if (blockID == 20009) {
            var url = "tgb.cn" + "/voteState?topicID=" + topicID;
            XMLHttp.sendReq("get", url, "", getReVoteRecord);
        }
    }

    function AddUseful(rid, num, topic, giotype, entry, msgtype, flag) {
        var pageNum = 0;
        gioType = giotype;
        gioEntery = entry;
        msgType = msgtype;
        Rid = rid;
        if (flag == 'F') {
            //showMessage("您还没有登陆，请登录后再点赞");
            window.location.href = "https:\/\/sso.tgb.cn\/" + 'm/login/index?url=https://m.' + "tgb.cn" + '/a/' + "2uGlwJ2RrKz";
            return;
        }
        if (flag == 'T') {
            showMessage("您还没有手机验证，请验证后再点赞");
            return;
        }
        var url = "mAddUsefulT?rid=" + rid + "&num=" + num + "&flag=" + topic + "&topicID=" + 8696276 +"&pageNum=" + pageNum;
        XMLHttp.sendReq("get", url, "", getUseful);
    }

    Winload();

    function Winload() {
        var url = window.location.href;
        if (url.indexOf('hotTopic') > -1) {
            _czc.push(['_trackEvent', '热文推荐']);
        }
    }

    function getUseful(obj) {

        var insertFlag = obj.dto;
        var str = insertFlag.value;
        if (str != "error") {
            if (str == "lock") {
                var lockend = insertFlag.lockend;
                alert("抱歉由于您涉及恶意点赞行为，暂时不能点赞, 解除时间为：" + lockend);
            } else if (str == "999999") {
                alert("您投票速度太快了，请休息30秒以后再投票吧！");
            } else if (str == "999998") {
                alert("您不能投自己的票，让其他用户帮您投吧！");
            } else if (str != "0") {
                var topic = insertFlag.flag;
                if (topic == "T" || topic == "R") {
                    //document.getElementById("topicUseful").innerHTML = "已赞";
                    alert("赞成功！");
                    gioMLikeSuccess(msgType, Rid, gioType, gioEntery)
                    var zanNum1 = $('#' + insertFlag.id).text();
                    zanNum2 = Number(zanNum1) + 1;
                    $('#' + insertFlag.id).text(zanNum2);
                    $('#' + insertFlag.id).parent().css('background-color', '#ffb648');
                    $('.plzan').css('background', 'none');
                }
            } else {
                alert("您已赞过了");
                return;
            }
        } else {
            alert("发生错误，请您联系股天乐");
            return;
        }
    }
    function topicSubmit(flag) {
        if (!flag) {
            document.getElementById("firstFlag").value = "N";
        }
        var frm = document.forms["newReplyAction"];
        document.getElementById("s_content_0").value = edit.getText();

        frm.submit();
        //原创与非原创未加
    }



    function addMyCol(favID, flag) {
        var loginUserId = $('#messageData').attr('data-userid');
        if (flag == 'F' || loginUserId == 0 || loginUserId == undefined || loginUserId == null || loginUserId == '') {
            showMessage("您还没有登陆，请登录后再收藏");
            return;
        }
        if (flag == 'T') {
            showMessage("您还没有手机验证，请验证后再收藏");
            return;
        }

        var url = "/mAddFavorite?rid=" + favID;
        XMLHttp.sendReq("get", url, "", getReturnAddfav);
    }

    window.onload = function () {
        if (topicContentType == 1) {
            researchDetailView();
            intoTopicView();
        }
        var type = "";
        if (type != "") {
            $('html, body').animate({
                scrollTop: $('.plTitle').offset().top // 获取目标元素相对于文档顶部的距离并设置为滚动位置
            }, 'fast');
        }
    }

    //访问个股研究正文埋点事件
    function researchDetailView() {
        var body = {}
        body.creator_id_var = topicCreatorId;
        body.creatorName_var = topicCreatorName;
        body.content_id_var = topicContentId;
        body.contentTitle_var = topicContentTitle;
        if (getReferrerName() == '-') {
            body.entryPage_var = 'm端主页帖子列表';
            body.entryFunction_var = "研股列表页";
        }
        body.entryFunction_var = "m端个人博客页";
        var authorid = topicCreatorId;
        var data = getFansLevel(loginUserID, authorid);
        var fansLevel = data.fansRankName;
        if (fansLevel == "-") {
            var userStatus = "非粉丝";
        } else {
            var userStatus = "粉丝";
        }
        body.userStatus_var = userStatus;
        body.userLevel_var = fansLevel;
        gioMessage('researchDetailView', body);
    }

    //个股研究点击股票连接埋点
    function clickStockGio(stockCode, stockName) {
        var localUserid = loginUserID;
        var body = {}
        body.creator_id_var = topicCreatorId;
        body.creatorName_var = topicCreatorName;
        body.shares_id_var = stockCode;
        body.sharesrName_var = stockName;
        body.content_id_var = topicContentId;
        body.contentTitle_var = topicContentTitle;
        var data = getFansLevel(topicCreatorId, loginUserID);
        var fansLevel = data.fansRankName;
        if (fansLevel == "-") {
            body.userStatus_var = "非粉丝";
        } else {
            body.userStatus_var = "粉丝";
        }
        body.userLevel_var = fansLevel;
        gioMessage("researchSharesClick", body);
    }

    //浏览主帖页埋点
    function intoTopicView() {
        var body = {}
        body.creator_id_var = topicCreatorId;
        body.creatorName_var = topicCreatorName;
        body.content_id_var = topicContentId;
        body.contentTitle_var = topicContentTitle;
        body.entryPage_var = getReferrerName();
        body.entryFunction_var = "浏览主帖页";
        gioMessage("mainPageView", body);
    }


    function getReturnAddfav(obj) {
        var insertFlag = obj.dto.root;
        var existValue = insertFlag.value;
        if (existValue == 0) {
            alert("您已经收藏过了!");
        } else if (existValue == "error") {
            alert("发生错误，请您联系股天乐!");
        } else {
            $('.collectBtn').css('color', '#ff9900');
            $('.collectimg').attr('src', 'https://css.tgb.cn/images/mNew/yishoucang.png');
            alert("收藏成功！");
            //gio收藏成功 -- start
            var body = {};
            body.creator_id_var = topicCreatorId;
            body.creatorName_var = topicCreatorName;
            body.content_id_var = topicContentId;
            body.contentType_var = "主帖";
            body.contentTitle_var = topicContentTitle;
            var fansData = getFansLevel(topicCreatorId, sessionUserID);
            if (fansData.fansLevel != "") {
                body.userStatus_var = "粉丝";
                body.userLevel_var = fansData.fansRankName;
            } else {
                body.userStatus_var = "非粉丝";
                body.userLevel_var = "-";
            }
            gioMessage("collectSuccess", body);
            //gio收藏成功 -- end
        }
    }

    function reonsubmit(a) {
        var textValue = document.getElementById("content_body").value;
        if (textValue.trim() == "") {
            alert("回复内容不能为空！");
            return false;
        }
        localStorage.setItem("replyValue", textValue);
        if (0 == 0) {
            return;
        }
        localStorage.clear();
        document.getElementById("submit1").disabled = true;
        gioMCommentSuccess("zt", $("input[name='userID']").val(), $("#userName").val(), $("input[name='topicID']").val(), '主帖', $("input[name='subject']").val())
        document.getElementById('newReplyAction').submit();
    }

    function Open100(str) {
        if (confirm("你确认要提交???")) {
            window.event.returnValue = true;
            document.forms[0].submit();
        } else {
            window.event.returnValue = false;
        }
    }

    isWeiXin();

    function isWeiXin() {
        var ua = window.navigator.userAgent.toLowerCase();
        if (ua.match(/MicroMessenger/i) == 'micromessenger') {
            $("#gzh2").show();
        } else {
            return false;
        }
    }
</script>
