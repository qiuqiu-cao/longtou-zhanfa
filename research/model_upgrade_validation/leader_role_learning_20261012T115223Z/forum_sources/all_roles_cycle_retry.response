    function wxshouqi() {
        zhankai_status = 'true';
        $('#wxtopic').hide();
        $('.tzitem_text').removeClass('hideText');
        var overH = $('.isover').offset().top;
        var bodyH = document.body.offsetHeight;
        if (overH > bodyH || overH == bodyH) {
            $('.tzitem_bot').addClass('fixBot');
            $('.tzitem_bot').attr('data-open', 'true');
        }
        $('.tzitem_hide').find('img').attr('src', 'https://css.tgb.cn/images/mNew/shouqi.png');
        $('.tzitem_hide').find('span').text('收起');
    }

    function openArticle() {
        zhankai_status = 'true';
        $('#wxtopic').hide();
        $('.tzitem_text').removeClass('hideText');
        var overH = $('.isover').offset().top;
        var bodyH = document.body.offsetHeight;
        if (overH > bodyH || overH == bodyH) {
            $('.tzitem_bot').addClass('fixBot');
            $('.tzitem_bot').attr('data-open', 'true');
        }
        $('.tzitem_hide').find('img').attr('src', 'https://css.tgb.cn/images/mNew/shouqi.png');
        $('.tzitem_hide').find('span').text('收起');
