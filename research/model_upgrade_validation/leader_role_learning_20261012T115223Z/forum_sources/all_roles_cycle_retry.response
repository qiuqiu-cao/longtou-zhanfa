                    var url = 'tgbiosapp://?type=live&liveSeq=' + liveSeq
                    window.location.href = url;
                    setTimeout(function () {
                        window.location = 'https://m.tgb.cn/downloadApp';
                    }, timeOut)
                } catch (e) {
