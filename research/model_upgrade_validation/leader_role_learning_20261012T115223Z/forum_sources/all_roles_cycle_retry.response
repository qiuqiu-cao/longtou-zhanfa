            body.userLevel_var = "-";
        }
        gioMessage("backAPPClick", body);
    }

    $('.tzitem_hide').click(function () {
        if (ua.match(/MicroMessenger/i) == 'micromessenger') {
            if (zhankai_status == 'false') {
                zhankai_status = 'true';
                $('#wxtopic').show();
                $('.tzitem_text').removeClass('hideText');
                var overH = $('.isover').offset().top;
                var bodyH = document.body.offsetHeight;
                if (overH > bodyH || overH == bodyH) {
                    $('.tzitem_bot').addClass('fixBot');
                    $('.tzitem_bot').attr('data-open', 'true');
                }
                $('.tzitem_hide').find('img').attr('src', 'https://css.tgb.cn/images/mNew/shouqi.png');
                $('.tzitem_hide').find('span').text('收起');
            } else if (zhankai_status == 'true') {

                $('#wxtopic').hide();
                $('.tzitem_text').addClass('hideText');
                $('.tzitem_bot').removeClass('fixBot');
                $('.tzitem_bot').attr('data-open', 'false');
                $('.tzitem_hide').find('img').attr('src', 'https://css.tgb.cn/images/mNew/zhankai.png');
                $('.tzitem_hide').find('span').text('展开');
                zhankai_status = 'false';
                $('html, body').animate({scrollTop: $('.Pagetitle').offset().top}, 500)
            }
        } else {

            if (zhankai_status == 'true') {
                $('.tzitem_text').addClass('hideText');
                $('.tzitem_bot').removeClass('fixBot');
                $('.tzitem_bot').attr('data-open', 'false');
                $('.tzitem_hide').find('img').attr('src', 'https://css.tgb.cn/images/mNew/zhankai.png');
                $('.tzitem_hide').find('span').text('展开');
                zhankai_status = 'false';
                $('html, body').animate({scrollTop: $('.Pagetitle').offset().top}, 500)
            } else {
                openArticle();
            }
        }
    })
    var bodyH = $(window).height();
    $(window).scroll(function () {

        var isopen = $('.tzitem_bot').attr('data-open');
        var overH = $('.isover').offset().top;
        var over2 = $(window).scrollTop();
        if (bodyH + over2 > overH) {
            if (isopen == 'true') {
                $('.tzitem_bot').removeClass('fixBot');
            }
        } else {
            if ($('.tzitem_bot').hasClass('fixBot')) {

            } else {
                if (isopen == 'true') {
                    $('.tzitem_bot').addClass('fixBot');
                }
            }
        }

    })





    //添加好友验证
    function addFriendInfo(postDate, source, bodySubject) {
        var getName = $.trim(window.currentFollowUserName || $('.HeadInfo_name').first().text() || $('.Mboke_username').text());
        if (!getName) {
            showMessage("接收用户为空，请刷新后重试!");
            return;
        }
        var msgText = document.getElementById("sendtxtcontent").value;
        var url = "/addFriendInfo?recvUserName=" + encodeURIComponent(getName) + "&msgText=" + encodeURIComponent(msgText);
        XMLHttp.sendReq("get", url, "", function (obj) {
            var str = obj.dto;
            $('.yzBox').hide();
            if (str == 1) {
                showMessage("发送成功!");
                $('.yzBox').hide();
            } else if (str == 0) {
                showMessage("失败，请重试!");
            } else if (str == 2) {
                showMessage("您的关注已经超过2000个，无法再加。");
            }
        });
    }

    //给下默认值看看
   function toappTopic(){
