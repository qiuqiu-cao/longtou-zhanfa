            }
        } else if (contentType == "WL") {
            var url = wlSrc + '';
            window.location = url;
        } else {
            //五种类型以外
            if (isAndroid) {
                try {
                    var url = 'taoguba://app/open';
                    window.location = url;
                    setTimeout(function () {
                        window.location = 'https://m.tgb.cn/downloadApp';
