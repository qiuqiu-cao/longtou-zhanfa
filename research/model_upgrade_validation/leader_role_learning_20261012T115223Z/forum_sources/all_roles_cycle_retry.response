function dianJi2(){
    //重新获取一遍，线上的不知道为啥被复写了
    var u = navigator.userAgent;
    var isAndroid = u.indexOf('Android') > -1 || u.indexOf('Linux') > -1; //g
    var isIOS = !!u.match(/\(i[^;]+;( U;)? CPU.+Mac OS X/); //ios终端
    if (ua.match(/MicroMessenger/i) == 'micromessenger') {
        document.getElementById("LingQuChengGongWeiXin").style.display="block";
        document.getElementById("huMen").style.display="block";
        var btnTC = document.getElementById('launch-btnTC');
        //修改下载链接
        $("#xiazaiapp").removeAttr("onclick")
        $("#xiazaiapp").attr("onclick", "window.open('https://a.app.qq.com/o/simple.jsp?pkgname=com.taoguba.app')")
        if (isAndroid) {
            var JsonStr = JSON.stringify(urlObj);
            btnTC.setAttribute("extinfo", JsonStr);
        }
        if (isIOS) {
            var iosJson = iosJsonWX;
            var iosJson2 = JSON.stringify(iosJson);
            btnTC.setAttribute("extinfo", iosJson2);
        }
    } else {
        document.getElementById("LingQuChengGong").style.display="block";
        document.getElementById("huMen").style.display="block";
    }
    btnHead.addEventListener('launch', function (e) {

    });
    btnHead.addEventListener('error', function (e) {
        //启动失败跳转应用市场
        window.open('https://a.app.qq.com/o/simple.jsp?pkgname=com.taoguba.app');
    });
}

function showMessage(msg){
      if($('#message').length === 0){
          $('body').append('<div id="message"></div>');
      }
	  $('#message').show().text(msg);
	  setTimeout(function(){
		  $('#message').hide(); 
	  },2000)
}
// 判断是否登录
function isLogin(){
