<script type="text/javascript">
function initCalcSize(){
    var bodyWidth = document.documentElement.clientWidth;
    var bodySize = (bodyWidth<768?1: (768/bodyWidth)) + 'vw';
    $('html').css('font-size',bodySize)
    // console.log('width',bodySize);
}
//首次加载是计算
initCalcSize();

function loadAppId(callback) {
    $.ajax({
        url: "/getAppID",
        type: "GET",
        dataType: "json",
        success: function (res) {
            if (res.code === 200) {
                callback && callback(res.appID);
            } else {
                console.error("获取AppID失败:", res);
            }
        },
        error: function (err) {
            console.error("Ajax错误:", err);
        }
    });
}

loadAppId(function(appid) {
    $("#launch-btn").attr("appid", appid);
});


