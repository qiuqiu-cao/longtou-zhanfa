{"sha":"37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","node_id":"C_kwDOTxcenNoAKDM3YThjMWJiM2UyZTljYWJlYjExZjk0ZGJlZjUwYThiOTU1ZjE5NDg","commit":{"author":{"name":"jundizhou","email":"jundizhou@users.noreply.github.com","date":"2026-09-30T15:11:05Z"},"committer":{"name":"jundizhou","email":"jundizhou@users.noreply.github.com","date":"2026-09-30T15:11:05Z"},"message":"fix: keep reasoning effort labels readable on Windows\n\nPython pipes decoded stdin with the ANSI code page (GBK on zh-CN),\nmojibake-ing the UTF-8 labels passed to the reasoning describe bridge\nand poisoning the 30-day capability cache. Force UTF-8 stdio in the\nlauncher, default PYTHONUTF8/PYTHONIOENCODING for managed Python child\nprocesses, and bump the capability cache version to drop bad entries.","tree":{"sha":"2e67343696c5875aee8e45198ec0304f8636810b","url":"https://api.github.com/repos/jundizhou/easy-stock/git/trees/2e67343696c5875aee8e45198ec0304f8636810b"},"url":"https://api.github.com/repos/jundizhou/easy-stock/git/commits/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/jundizhou/easy-stock/commits/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","html_url":"https://github.com/jundizhou/easy-stock/commit/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","comments_url":"https://api.github.com/repos/jundizhou/easy-stock/commits/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/comments","author":{"login":"jundizhou","id":92794317,"node_id":"U_kgDOBYftzQ","avatar_url":"https://avatars.githubusercontent.com/u/92794317?v=4","gravatar_id":"","url":"https://api.github.com/users/jundizhou","html_url":"https://github.com/jundizhou","followers_url":"https://api.github.com/users/jundizhou/followers","following_url":"https://api.github.com/users/jundizhou/following{/other_user}","gists_url":"https://api.github.com/users/jundizhou/gists{/gist_id}","starred_url":"https://api.github.com/users/jundizhou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jundizhou/subscriptions","organizations_url":"https://api.github.com/users/jundizhou/orgs","repos_url":"https://api.github.com/users/jundizhou/repos","events_url":"https://api.github.com/users/jundizhou/events{/privacy}","received_events_url":"https://api.github.com/users/jundizhou/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"jundizhou","id":92794317,"node_id":"U_kgDOBYftzQ","avatar_url":"https://avatars.githubusercontent.com/u/92794317?v=4","gravatar_id":"","url":"https://api.github.com/users/jundizhou","html_url":"https://github.com/jundizhou","followers_url":"https://api.github.com/users/jundizhou/followers","following_url":"https://api.github.com/users/jundizhou/following{/other_user}","gists_url":"https://api.github.com/users/jundizhou/gists{/gist_id}","starred_url":"https://api.github.com/users/jundizhou/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jundizhou/subscriptions","organizations_url":"https://api.github.com/users/jundizhou/orgs","repos_url":"https://api.github.com/users/jundizhou/repos","events_url":"https://api.github.com/users/jundizhou/events{/privacy}","received_events_url":"https://api.github.com/users/jundizhou/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"73632da6d24c8f1fa1655a6fd52cd4d54d46e92a","url":"https://api.github.com/repos/jundizhou/easy-stock/commits/73632da6d24c8f1fa1655a6fd52cd4d54d46e92a","html_url":"https://github.com/jundizhou/easy-stock/commit/73632da6d24c8f1fa1655a6fd52cd4d54d46e92a"}],"stats":{"total":55,"additions":54,"deletions":1},"files":[{"sha":"e2c47bb3a1d0fcc106c026f41a5227963e22e2fe","filename":"backend/internal/agent/reasoning.go","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/jundizhou/easy-stock/blob/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Freasoning.go","raw_url":"https://github.com/jundizhou/easy-stock/raw/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Freasoning.go","contents_url":"https://api.github.com/repos/jundizhou/easy-stock/contents/backend%2Finternal%2Fagent%2Freasoning.go?ref=37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","patch":"@@ -252,7 +252,7 @@ type capabilityCacheEntry struct {\n \tModels        map[string]ReasoningCapability `json:\"models\"`\n }\n \n-const reasoningCapabilityVersion = 4\n+const reasoningCapabilityVersion = 5\n \n type CapabilityGateway interface {\n \tResolveModelCapabilities(baseURL, apiMode string, models map[string]json.RawMessage) (map[string]ReasoningCapability, error)"},{"sha":"984dd817fbb0c89ca7c01062a163d489826f33d1","filename":"backend/internal/agent/reasoning_launcher.py","status":"modified","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/jundizhou/easy-stock/blob/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Freasoning_launcher.py","raw_url":"https://github.com/jundizhou/easy-stock/raw/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Freasoning_launcher.py","contents_url":"https://api.github.com/repos/jundizhou/easy-stock/contents/backend%2Finternal%2Fagent%2Freasoning_launcher.py?ref=37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","patch":"@@ -162,6 +162,14 @@ def supported(self, requested_model):\n \n \n def main():\n+    # Windows pipes default stdio to the ANSI code page (GBK on zh-CN), but the\n+    # Go host always writes UTF-8. Reconfigure before the first stdin read.\n+    for stream in (sys.stdin, sys.stdout, sys.stderr):\n+        if stream is not None and hasattr(stream, \"reconfigure\"):\n+            try:\n+                stream.reconfigure(encoding=\"utf-8\")\n+            except (OSError, ValueError):\n+                pass\n     if len(sys.argv) > 1 and sys.argv[1] == \"describe\":\n         request = json.load(sys.stdin)\n         result = {}"},{"sha":"c48199e464ac68a664e6c208cb2ff0d7a8824bed","filename":"backend/internal/agent/reasoning_launcher_test.py","status":"modified","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/jundizhou/easy-stock/blob/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Freasoning_launcher_test.py","raw_url":"https://github.com/jundizhou/easy-stock/raw/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Freasoning_launcher_test.py","contents_url":"https://api.github.com/repos/jundizhou/easy-stock/contents/backend%2Finternal%2Fagent%2Freasoning_launcher_test.py?ref=37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","patch":"@@ -1,4 +1,8 @@\n \"\"\"Integration tests against bundled Hermes transports; no network or SDK patches.\"\"\"\n+import json\n+import os\n+import subprocess\n+import sys\n import unittest\n import reasoning_launcher as bridge\n from providers import get_provider_profile, register_provider\n@@ -27,6 +31,21 @@ def request(self, effort, **overrides):\n         transport = ResponsesApiTransport() if self.config['api_mode'] == 'codex_responses' else ChatCompletionsTransport()\n         return transport.build_kwargs(self.config['model'], [{'role':'user','content':'hi'}], **params)\n \n+    def test_describe_pipes_keep_utf8_chinese_labels(self):\n+        # Windows pipes decode stdin with the ANSI code page (GBK) unless the\n+        # launcher reconfigures stdio; the Go host always writes UTF-8.\n+        request = {\"config\": {\"model\": \"m\", \"base_url\": \"https://x.example/v1\", \"api_mode\": \"chat_completions\"},\n+                   \"models\": [{\"model\": \"m\", \"supplement\": {\"options\": [{\"value\": \"low\", \"label\": \"低\"}, {\"value\": \"max\", \"label\": \"最大\"}],\n+                                                            \"default\": \"max\", \"source\": \"official\", \"wire\": \"openai_chat\"}}]}\n+        env = {k: v for k, v in os.environ.items() if k not in (\"PYTHONUTF8\", \"PYTHONIOENCODING\")}\n+        script = \"import sys; sys.argv = ['reasoning_launcher', 'describe']; import reasoning_launcher; reasoning_launcher.main()\"\n+        run = subprocess.run([sys.executable, \"-c\", script], input=json.dumps(request).encode(\"utf-8\"),\n+                             capture_output=True, env=env,\n+                             cwd=os.path.dirname(os.path.abspath(bridge.__file__)))\n+        self.assertEqual(run.returncode, 0, run.stderr.decode(\"utf-8\", \"replace\"))\n+        labels = {o[\"value\"]: o[\"label\"] for o in json.loads(run.stdout.decode(\"utf-8\"))[\"m\"][\"options\"]}\n+        self.assertEqual(labels, {\"low\": \"低\", \"max\": \"最大\"})\n+\n     def test_deepseek_alias_native_translation(self):\n         self.assertEqual(self.configure('deepseek-chat', 'https://api.deepseek.com/v1'), ['none','low','medium','high','max'])\n         body = self.request('max')"},{"sha":"67204e086b86b76ad2984ba0b91fb10dd0340d01","filename":"backend/internal/agent/runtime.go","status":"modified","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/jundizhou/easy-stock/blob/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Fruntime.go","raw_url":"https://github.com/jundizhou/easy-stock/raw/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Fruntime.go","contents_url":"https://api.github.com/repos/jundizhou/easy-stock/contents/backend%2Finternal%2Fagent%2Fruntime.go?ref=37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","patch":"@@ -1295,6 +1295,15 @@ func hermesEnvironment(base []string, home, workDir, binDir string) []string {\n \tvalues = setEnv(values, \"PYTHONNOUSERSITE\", \"1\")\n \tvalues = setEnv(values, \"PYTHONUNBUFFERED\", \"1\")\n \tvalues = setEnv(values, \"NO_COLOR\", \"1\")\n+\t// Python stdio and pipes follow the ANSI code page on Windows (GBK on\n+\t// zh-CN) while this app speaks UTF-8. Same defaults hermes_bootstrap sets\n+\t// for its own children; an explicit user setting still wins.\n+\tif environmentValue(base, \"PYTHONUTF8\") == \"\" {\n+\t\tvalues = setEnv(values, \"PYTHONUTF8\", \"1\")\n+\t}\n+\tif environmentValue(base, \"PYTHONIOENCODING\") == \"\" {\n+\t\tvalues = setEnv(values, \"PYTHONIOENCODING\", \"utf-8\")\n+\t}\n \tif strings.TrimSpace(home) != \"\" {\n \t\tvalues = setEnv(values, \"AGENT_BROWSER_PROFILE\", filepath.Join(home, \"browser-profile\"))\n \t}"},{"sha":"fbb35ec33b4f8ccd6550b66a96ae3e084a11488b","filename":"backend/internal/agent/runtime_test.go","status":"modified","additions":17,"deletions":0,"changes":17,"blob_url":"https://github.com/jundizhou/easy-stock/blob/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Fruntime_test.go","raw_url":"https://github.com/jundizhou/easy-stock/raw/37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948/backend%2Finternal%2Fagent%2Fruntime_test.go","contents_url":"https://api.github.com/repos/jundizhou/easy-stock/contents/backend%2Finternal%2Fagent%2Fruntime_test.go?ref=37a8c1bb3e2e9cabeb11f94dbef50a8b955f1948","patch":"@@ -297,6 +297,23 @@ func TestHermesEnvironmentIncludesWorkspaceNodeBin(t *testing.T) {\n \t}\n }\n \n+func TestHermesEnvironmentDefaultsPythonToUTF8(t *testing.T) {\n+\tvalues := hermesEnvironment([]string{\"PATH=/usr/bin\"}, t.TempDir(), \"\", \"\")\n+\tif got := envValue(values, \"PYTHONUTF8\"); got != \"1\" {\n+\t\tt.Fatalf(\"PYTHONUTF8 = %q, want 1\", got)\n+\t}\n+\tif got := envValue(values, \"PYTHONIOENCODING\"); got != \"utf-8\" {\n+\t\tt.Fatalf(\"PYTHONIOENCODING = %q, want utf-8\", got)\n+\t}\n+\tvalues = hermesEnvironment([]string{\"PATH=/usr/bin\", \"PYTHONUTF8=0\", \"PYTHONIOENCODING=gbk\"}, t.TempDir(), \"\", \"\")\n+\tif got := envValue(values, \"PYTHONUTF8\"); got != \"0\" {\n+\t\tt.Fatalf(\"PYTHONUTF8 = %q, want user setting 0\", got)\n+\t}\n+\tif got := envValue(values, \"PYTHONIOENCODING\"); got != \"gbk\" {\n+\t\tt.Fatalf(\"PYTHONIOENCODING = %q, want user setting gbk\", got)\n+\t}\n+}\n+\n func TestRuntimePythonUsesStandaloneWindowsInterpreter(t *testing.T) {\n \troot := filepath.Join(\"runtime\", \"hermes\")\n \tif got := runtimePythonForOS(root, \"windows\"); got != filepath.Join(root, \"python\", \"python.exe\") {"}]}