000, 1.76, 0.42, 6.09, 1.52, -0.54, 386430568.89, \\\"\\\", 0, 6573200, 4000000, 1.76, 4.17, 1.86], [\\\"520790\\\", \\\"港股通互联网ETF兴业\\\", 0.849, 6.39, 43522999, 2.44, 3412400, 4000000, 1, 12.9, -1.51, -16.02, -13.19, 341361675, \\\"\\\", 0, 3412400, 4000000, 1, 6.39, -0.13], [\\\"516510\\\", \\\"云计算ETF易方达\\\", 1.76, 6.22, 272812741, 1.74, 53781900, 31000000, 2.17, -0.06, 5.71, 1.15, -0.68, 2571166400, \\\"\\\", 0, 53781900, 31000000, 2.17, 4.08, 1.6], [\\\"515400\\\", \\\"大数据ETF富国\\\", 0.904, 6.1, 240171043, 2.55, 98439000, 110000000, 7.41, -0.33, 6.35, -7.57, -9.05, 1440642785.6, \\\"\\\", 0, 98439000, 110000000, 7.41, -3.73, 1.05], [\\\"159792\\\", \\\"港股通互联网ETF富国\\\", 0.595, 6.06, 6593254486, 2.59, 1591603800, 2654000000, 4.52, 13.33, -0.83, -16.78, -31.61, 36502568866.01, \\\"\\\", 0, 1591603800, 2654000000, 4.52, -29.42, 0.63], [\\\"560660\\\", \\\"云计算50ETF新华\\\", 1.164, 6.01, 28489659, 2.84, 6894000, 6000000, 4.48, -1.1, 5.34, 6.3, 11.28, 162887832, \\\"\\\", 0, 6894000, 6000000, 4.48, 15.25, 1.17], [\\\"513160\\\", \\\"港股科技ETF银华\\\", 0.989, 6, 682666157, 1.83, 34534500, 35000000, 1.03, 5.21, -0.2, -1.2, -19.33, 3394435217.7, \\\"\\\", 0, 34534500, 35000000, 1.03, -16.82, 0.39], [\\\"159040\\\", \\\"港股通互联网ETF鹏华\\\", 1.101, 5.97, 48254129, 2.8, -5607000, -5000000, -5.08, 12.12, 15.05, 15.05, 15.05, 102922676.79, \\\"\\\", 0, -5607000, -5000000, -5.08, 5.97, -0.56], [\\\"516000\\\", \\\"大数据ETF华夏\\\", 0.99, 5.88, 44725551, 1.59, 4904000, 5000000, 1.42, -0.3, 6.34, -6.69, -8.25, 353286450, \\\"\\\", 0, 4904000, 5000000, 1.42, -2.65, 0.95], [\\\"159890\\\", \\\"云计算ETF招商\\\", 1.789, 5.86, 63651202, 2.43, 12383000, 7000000, 2.97, -0.33, 5.73, 1.59, -0.28, 433994740.83, \\\"\\\", 0, 12383000, 7000000, 2.97, 4.56, 1.02], [\\\"520650\\\", \\\"港股通互联网ETF南方\\\", 0.618, 5.82, 194771168, 1.36, -623100, -1000000, -0.05, 12.98, -1.12, -17.05, -31.33, 1206184590, \\\"\\\", 0, -62\",\n+    \"timestamp\": \"2026-07-09 13:49:19\"\n+  },\n+  {\n+    \"api_name\": \"get_stock_call_auction_tick\",\n+    \"category\": \"竞价\",\n+    \"params\": \"stock_code=000001, date=2026-07-08\",\n+    \"status\": \"empty\",\n+    \"error_msg\": \"\",\n+    \"data_count\": 0,\n+    \"data_sample\": \"{}\",\n+    \"timestamp\": \"2026-07-09 13:49:21\"\n+  }\n+]\n\\ No newline at end of file"},{"sha":"39749a3c677f87111b4e8aa0ebae89a6dd99e6ab","filename":"scripts/backfill_history.py","status":"added","additions":296,"deletions":0,"changes":296,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fbackfill_history.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fbackfill_history.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fbackfill_history.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,296 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL数据看板 - 蚂蚁搬家式历史数据补全\n+设计原则:\n+1. 模拟真人操作: 每次API调用间隔2-8秒随机延迟\n+2. 单线程: 不用多线程(真人不会并发)\n+3. 每天最多补2天历史数据 + 当日新数据\n+4. 先补当日, 再补历史(从最近往前补)\n+5. 记录补全日志, 可追踪进度\n+\"\"\"\n+import sys\n+from pathlib import Path\n+import random\n+import time\n+import sqlite3\n+import requests\n+import uuid\n+from datetime import datetime, timedelta\n+\n+_SCRIPT_DIR = Path(__file__).parent.resolve()\n+_PROJECT_ROOT = _SCRIPT_DIR.parent\n+sys.path.insert(0, str(_PROJECT_ROOT / 'lib'))\n+sys.path.insert(0, r'D:\\trae\\traeworkspace\\kpl')\n+\n+import pandas as pd\n+import warnings\n+warnings.filterwarnings('ignore')\n+from kaipanla_crawler import KaipanlaCrawler\n+\n+DB_PATH = _PROJECT_ROOT / 'data' / 'kpl_dashboard.db'\n+KPL_FILE = Path(r'<YOUR_HOME>\\.trae-cn\\attachments\\6a4aff607bc6d9ac89e12170\\bc2b5462-4380-4706-aa8b-27f4e6514b06_开盘啦4月22日板块分类20260706.xlsx')\n+\n+# 蚂蚁搬家参数\n+DAYS_PER_RUN = 2          # 每次运行补2天历史\n+MIN_DELAY = 2.0           # 最小延迟(秒)\n+MAX_DELAY = 8.0           # 最大延迟(秒)\n+BATCH_PAUSE = 30          # 每补完1天, 暂停30秒\n+JITTER = 0.5              # 额外随机抖动\n+\n+\n+def human_delay():\n+    \"\"\"模拟真人操作间隔\"\"\"\n+    delay = random.uniform(MIN_DELAY, MAX_DELAY) + random.uniform(0, JITTER)\n+    time.sleep(delay)\n+\n+\n+def get_all_trading_days(start='2026-01-01'):\n+    \"\"\"获取从start到今天的所有交易日\"\"\"\n+    days = []\n+    current = datetime.strptime(start, '%Y-%m-%d')\n+    end = datetime.now()\n+    while current <= end:\n+        if current.weekday() < 5:\n+            days.append(current.strftime('%Y-%m-%d'))\n+        current += timedelta(days=1)\n+    return days\n+\n+\n+def get_missing_dates(conn):\n+    \"\"\"获取缺失的板块强度日期\"\"\"\n+    existing = set(r[0] for r in conn.execute(\"SELECT DISTINCT date FROM sector_strength\").fetchall())\n+    all_days = get_all_trading_days()\n+    missing = [d for d in all_days if d not in existing]\n+    # 从最近往前补\n+    missing.reverse()\n+    return missing\n+\n+\n+def get_all_sectors(conn):\n+    \"\"\"获取所有板块列表\"\"\"\n+    rows = conn.execute(\"SELECT sector_code, sector_name FROM sector_list\").fetchall()\n+    # 去重(同代码取第一个)\n+    seen = {}\n+    for code, name in rows:\n+        if code not in seen:\n+            seen[code] = name\n+    return list(seen.items())\n+\n+\n+def backfill_one_day(crawler, conn, date, sectors):\n+    \"\"\"补全一天的历史数据\"\"\"\n+    success = 0\n+    fail = 0\n+    total = len(sectors)\n+\n+    for i, (code, name) in enumerate(sectors):\n+        try:\n+            result = crawler.get_sector_strength(code, date)\n+            if result.get('success'):\n+                strength = float(result['strength'])\n+                conn.execute(\"INSERT OR REPLACE INTO sector_strength VALUES(?,?,?,?)\",\n+                             (date, code, name, strength))\n+                success += 1\n+            else:\n+                conn.execute(\"INSERT OR REPLACE INTO sector_strength VALUES(?,?,?,?)\",\n+                             (date, code, name, 0.0))\n+                success += 1\n+        except:\n+            fail += 1\n+\n+        # 每10个板块提交一次\n+        if (i + 1) % 10 == 0:\n+            conn.commit()\n+\n+        # 模拟真人延迟\n+        human_delay()\n+\n+        # 进度报告\n+        if (i + 1) % 50 == 0:\n+            print(f\"    {date}: {i+1}/{total} ({success}成功, {fail}失败)\")\n+\n+    conn.commit()\n+    return success, fail\n+\n+\n+def log_progress(conn, date, success, fail, duration):\n+    \"\"\"记录补全日志\"\"\"\n+    conn.execute(\"\"\"\n+    CREATE TABLE IF NOT EXISTS backfill_log (\n+        date TEXT, success INTEGER, fail INTEGER, duration REAL, timestamp TEXT\n+    )\n+    \"\"\")\n+    conn.execute(\"INSERT INTO backfill_log VALUES(?,?,?,?,?)\",\n+                 (date, success, fail, duration, datetime.now().strftime('%Y-%m-%d %H:%M:%S')))\n+    conn.commit()\n+\n+\n+def backfill_stock_mapping(target_dates):\n+    \"\"\"回填涨停个股历史映射数据 (数据源: 东方财富涨停池API)\"\"\"\n+    HEADERS = {'User-Agent': 'Mozilla/5.0', 'Referer': 'https://quote.eastmoney.com/'}\n+    conn = sqlite3.connect(str(DB_PATH))\n+    total_success = 0\n+    total_fail = 0\n+\n+    for date in target_dates:\n+        existing = conn.execute(\n+            \"SELECT COUNT(*) FROM stock_mapping_history WHERE date = ?\", (date,)\n+        ).fetchone()[0]\n+        if existing > 0:\n+            print(f\"  {date}: 已有{existing}条记录，跳过\")\n+            continue\n+\n+        print(f\"  {date}: 采集中...\")\n+        try:\n+            url = \"http://push2ex.eastmoney.com/getTopicZTPool\"\n+            params = {\n+                'ut': '7eea3edcaed734bea9cbfc24409ed989',\n+                'dpt': 'wz.ztzt',\n+                'date': date.replace('-', ''),\n+                'sort': 'fbt:asc',\n+                'page': 1, 'pagesize': 100,\n+            }\n+            resp = requests.get(url, params=params, headers=HEADERS, timeout=10)\n+            data = resp.json()\n+            if data.get('rc') != 0:\n+                print(f\"  {date}: API返回异常 rc={data.get('rc')}\")\n+                total_fail += 1\n+                human_delay()\n+                continue\n+\n+            pool = data.get('data', {}).get('pool', [])\n+            count = 0\n+            for stock in pool:\n+                stock_code = stock.get('c', '')\n+                stock_name = stock.get('n', '')\n+                consecutive = stock.get('lbc', 1)\n+                reason = stock.get('hybk', '')\n+                seal = stock.get('fund', 0) or 0\n+                change_pct = stock.get('zttj', {}).get('days', 0)\n+                conn.execute(\"\"\"\n+                    INSERT OR REPLACE INTO stock_mapping_history\n+                    (date, stock_code, stock_name, consecutive, limit_up_reason, seal_amount, change_pct)\n+                    VALUES (?, ?, ?, ?, ?, ?, ?)\n+                \"\"\", (date, stock_code, stock_name, consecutive, reason, seal, change_pct))\n+                count += 1\n+            conn.commit()\n+            print(f\"  {date}: 采集{count}条\")\n+            total_success += count\n+            human_delay()\n+        except Exception as e:\n+            print(f\"  {date}: 错误 {e}\")\n+            total_fail += 1\n+\n+    conn.close()\n+    return total_success, total_fail\n+\n+\n+def main():\n+    print(f\"{'='*70}\")\n+    print(f\"KPL历史数据蚂蚁搬家式补全 | {datetime.now().strftime('%Y-%m-%d %H:%M')}\")\n+    print(f\"策略: 每次补{DAYS_PER_RUN}天, 单线程, 间隔{MIN_DELAY}-{MAX_DELAY}秒随机延迟\")\n+    print(f\"{'='*70}\")\n+\n+    conn = sqlite3.connect(DB_PATH)\n+    crawler = KaipanlaCrawler()\n+\n+    # 确保板块列表已加载\n+    count = conn.execute(\"SELECT COUNT(*) FROM sector_list\").fetchone()[0]\n+    if count == 0 and KPL_FILE.exists():\n+        print(\"\\n[0] 加载板块列表...\")\n+        df = pd.read_excel(KPL_FILE, sheet_name='Sheet1')\n+        for _, row in df.iterrows():\n+            conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\",\n+                         (str(row['板块代码']), row['板块名称'], float(row['强度']), 'excel'))\n+        conn.commit()\n+        print(f\"    已加载 {len(df)} 个板块\")\n+\n+    # 获取缺失日期\n+    missing = get_missing_dates(conn)\n+    print(f\"\\n[状态] 缺失 {len(missing)} 天板块强度数据\")\n+    if missing:\n+        print(f\"  最近缺失: {missing[0]}\")\n+        print(f\"  最远缺失: {missing[-1]}\")\n+\n+    if not missing:\n+        print(\"\\n  所有历史数据已补全! 仅维护当日数据。\")\n+        conn.close()\n+        return\n+\n+    # 取今天要补的日期\n+    to_fill = missing[:DAYS_PER_RUN]\n+    print(f\"\\n[计划] 本次补全 {len(to_fill)} 天: {to_fill}\")\n+\n+    sectors = get_all_sectors(conn)\n+    print(f\"  板块数: {len(sectors)}\")\n+    print(f\"  预计耗时: {len(sectors) * len(to_fill) * (MIN_DELAY+MAX_DELAY)/2 / 60:.0f}分钟\")\n+    print()\n+\n+    total_success = 0\n+    total_fail = 0\n+    t_start = time.time()\n+\n+    for day_idx, date in enumerate(to_fill):\n+        print(f\"\\n[{day_idx+1}/{len(to_fill)}] 补全 {date}...\")\n+        t_day = time.time()\n+        success, fail = backfill_one_day(crawler, conn, date, sectors)\n+        duration = time.time() - t_day\n+\n+        log_progress(conn, date, success, fail, duration)\n+        total_success += success\n+        total_fail += fail\n+\n+        print(f\"  完成: {success}成功, {fail}失败, 耗时{duration/60:.1f}分钟\")\n+\n+        # 每天之间暂停\n+        if day_idx < len(to_fill) - 1:\n+            pause = BATCH_PAUSE + random.uniform(0, 10)\n+            print(f\"  暂停 {pause:.0f}秒 (模拟休息)...\")\n+            time.sleep(pause)\n+\n+    total_duration = time.time() - t_start\n+    remaining = len(missing) - len(to_fill)\n+\n+    print(f\"\\n{'='*70}\")\n+    print(f\"本次补全完成\")\n+    print(f\"{'='*70}\")\n+    print(f\"  补全: {len(to_fill)}天 ({total_success}成功, {total_fail}失败)\")\n+    print(f\"  耗时: {total_duration/60:.1f}分钟\")\n+    print(f\"  剩余: {remaining}天\")\n+    if remaining > 0:\n+        days_to_finish = remaining // DAYS_PER_RUN\n+        print(f\"  预计还需: {days_to_finish}次运行 (~{days_to_finish}个交易日)\")\n+    else:\n+        print(f\"  所有历史数据已补全!\")\n+\n+    # 查看补全日志\n+    print(f\"\\n  补全日志(最近5条):\")\n+    logs = conn.execute(\"SELECT * FROM backfill_log ORDER BY timestamp DESC LIMIT 5\").fetchall()\n+    for log in logs:\n+        print(f\"    {log[4]} | {log[0]} | {log[1]}成功 {log[2]}失败 | {log[3]/60:.1f}分钟\")\n+\n+    conn.close()\n+\n+    # === 涨停个股历史回填 ===\n+    print(f\"\\n{'='*70}\")\n+    print(\"涨停个股历史数据回填\")\n+    print(f\"{'='*70}\")\n+\n+    all_dates = get_all_trading_days('2026-06-01')\n+    conn2 = sqlite3.connect(str(DB_PATH))\n+    existing_dates = set(r[0] for r in conn2.execute(\"SELECT DISTINCT date FROM stock_mapping_history\").fetchall())\n+    conn2.close()\n+    missing_stock_dates = [d for d in all_dates if d not in existing_dates]\n+\n+    if missing_stock_dates:\n+        print(f\"需回填 {len(missing_stock_dates)} 天: {missing_stock_dates[:5]}...\")\n+        to_fill_stock = missing_stock_dates[:5]  # 每次最多5天\n+        print(f\"本次回填 {len(to_fill_stock)} 天\")\n+        s, f = backfill_stock_mapping(to_fill_stock)\n+        print(f\"涨停个股回填完成: {s}条成功, {f}天失败\")\n+    else:\n+        print(\"涨停个股历史数据已完整，无需回填\")\n+\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"b539bc8c6ee96336ad321831315668eb0d02263a","filename":"scripts/backfill_ladder.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fbackfill_ladder.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fbackfill_ladder.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fbackfill_ladder.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,32 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"回填连板梯队数据(ladder_data)到4月1日\"\"\"\n+import sys\n+from pathlib import Path\n+import sqlite3\n+from datetime import datetime\n+\n+PROJECT_ROOT = Path(__file__).parent.parent\n+sys.path.insert(0, str(PROJECT_ROOT / 'scripts'))\n+sys.path.insert(0, str(PROJECT_ROOT / 'lib'))\n+\n+DB = PROJECT_ROOT / 'data' / 'kpl_dashboard.db'\n+\n+def main():\n+    conn = sqlite3.connect(DB)\n+    existing = set(r[0] for r in conn.execute(\"SELECT date FROM ladder_data\").fetchall())\n+    all_dates = sorted([r[0] for r in conn.execute(\"SELECT DISTINCT date FROM sector_strength ORDER BY date\").fetchall()])\n+    missing = [d for d in all_dates if d not in existing]\n+    print(f\"已有: {len(existing)}天, 缺失: {len(missing)}天\")\n+    if not missing:\n+        print(\"全部已完成!\")\n+        conn.close()\n+        return\n+    from kpl_common import download_ladder_data\n+    count = download_ladder_data(conn, missing)\n+    print(f\"回填完成: {count}天\")\n+    after = set(r[0] for r in conn.execute(\"SELECT date FROM ladder_data\").fetchall())\n+    print(f\"现在总计: {len(after)}天\")\n+    conn.close()\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"49945e480b233600c3ec7ae2b6b91b549e9fdb20","filename":"scripts/backfill_stock_history.py","status":"added","additions":128,"deletions":0,"changes":128,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fbackfill_stock_history.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fbackfill_stock_history.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fbackfill_stock_history.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,128 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+涨停个股历史明细补全脚本\n+补全 stock_mapping_history 表中缺失的日期数据(4月1日~7月15日)\n+使用 get_sector_ranking API获取历史涨停股详情(含封板时间、涨停原因等)\n+采用\"蚂蚁搬家\"策略: 单线程 + 2-8秒随机延迟\n+\"\"\"\n+import sys\n+import time\n+import random\n+import sqlite3\n+from pathlib import Path\n+from datetime import datetime, timedelta\n+\n+_PROJECT_ROOT = Path(__file__).parent.parent\n+sys.path.insert(0, str(_PROJECT_ROOT / 'scripts'))\n+sys.path.insert(0, str(_PROJECT_ROOT / 'lib'))\n+\n+from kpl_common import init_db, init_emotion_tables, fetch_sector_sentiment, update_stock_mapping_history, update_sector_stock_mapping\n+\n+DB_PATH = _PROJECT_ROOT / 'data' / 'kpl_dashboard.db'\n+\n+\n+def get_trading_days(start='2026-04-01', end='2026-07-15'):\n+    \"\"\"获取交易日(排除周末)\"\"\"\n+    days = []\n+    current = datetime.strptime(start, '%Y-%m-%d')\n+    end_dt = datetime.strptime(end, '%Y-%m-%d')\n+    while current <= end_dt:\n+        if current.weekday() < 5:\n+            days.append(current.strftime('%Y-%m-%d'))\n+        current += timedelta(days=1)\n+    return days\n+\n+\n+def main():\n+    conn = sqlite3.connect(str(DB_PATH))\n+    init_emotion_tables(conn)\n+\n+    # 0. 清空旧的stock_mapping_history数据(旧数据缺少sector_code/first_limit_time等字段)\n+    old_count = conn.execute(\"SELECT COUNT(*) FROM stock_mapping_history\").fetchone()[0]\n+    if old_count > 0:\n+        print(f\"清空旧的stock_mapping_history数据: {old_count}行(旧数据缺少sector_code/time等字段)\")\n+        conn.execute(\"DELETE FROM stock_mapping_history\")\n+        conn.commit()\n+\n+    # 1. 获取所有交易日(4/1~7/15)\n+    all_trading_days = get_trading_days('2026-04-01', '2026-07-15')\n+    print(f\"交易日总数: {len(all_trading_days)}天 ({all_trading_days[0]} ~ {all_trading_days[-1]})\")\n+\n+    # 2. 检查sector_sentiment已有日期\n+    ss_dates = set(r[0] for r in conn.execute(\n+        \"SELECT DISTINCT date FROM sector_sentiment\"\n+    ).fetchall())\n+    print(f\"sector_sentiment已有: {len(ss_dates)}天\")\n+\n+    # 3. 所有日期都需下载(填充stock_mapping_history)\n+    dates_to_download = all_trading_days\n+    print(f\"本次将下载: {len(dates_to_download)}天\")\n+    print(f\"  前5天: {dates_to_download[:5]}\")\n+    print(f\"  后5天: {dates_to_download[-5:]}\")\n+\n+    # 4. 逐日下载(蚂蚁搬家策略)\n+    total_sentiment = 0\n+    total_stocks = 0\n+    total_fail = 0\n+\n+    for i, date in enumerate(dates_to_download):\n+        print(f\"\\n[{i+1}/{len(dates_to_download)}] 下载 {date}...\")\n+        try:\n+            sentiment_records, stock_records = fetch_sector_sentiment(date)\n+\n+            if sentiment_records:\n+                conn.executemany(\n+                    \"INSERT OR REPLACE INTO sector_sentiment VALUES(?,?,?,?,?)\",\n+                    sentiment_records\n+                )\n+                conn.commit()\n+                total_sentiment += len(sentiment_records)\n+\n+            if stock_records:\n+                update_stock_mapping_history(conn, stock_records)\n+                update_sector_stock_mapping(conn, stock_records)\n+                total_stocks += len(stock_records)\n+\n+            if sentiment_records or stock_records:\n+                print(f\"  完成: {len(sentiment_records)}板块, {len(stock_records)}只个股\")\n+            else:\n+                print(f\"  无数据(可能非交易日或API异常)\")\n+                total_fail += 1\n+\n+        except Exception as e:\n+            print(f\"  错误: {str(e)[:80]}\")\n+            total_fail += 1\n+\n+        # 蚂蚁搬家: 2-8秒随机延迟\n+        if i < len(dates_to_download) - 1:\n+            delay = random.uniform(2, 8)\n+            print(f\"  等待 {delay:.1f}秒...\")\n+            time.sleep(delay)\n+\n+    # 5. 统计结果\n+    print(f\"\\n{'='*50}\")\n+    print(f\"补全完成!\")\n+    print(f\"  下载天数: {len(dates_to_download)}\")\n+    print(f\"  失败天数: {total_fail}\")\n+    print(f\"  板块记录: {total_sentiment}\")\n+    print(f\"  个股记录: {total_stocks}\")\n+\n+    # 6. 验证\n+    final_dates = set(r[0] for r in conn.execute(\n+        \"SELECT DISTINCT date FROM stock_mapping_history\"\n+    ).fetchall())\n+    print(f\"\\nstock_mapping_history最终: {len(final_dates)}天\")\n+    if final_dates:\n+        print(f\"  日期范围: {min(final_dates)} ~ {max(final_dates)}\")\n+        # 显示最近5天的数据量\n+        recent = conn.execute(\n+            \"SELECT date, COUNT(*) FROM stock_mapping_history GROUP BY date ORDER BY date DESC LIMIT 5\"\n+        ).fetchall()\n+        for d, cnt in recent:\n+            print(f\"  {d}: {cnt}只\")\n+\n+    conn.close()\n+\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"7548e76bd3b24ea0c4219f93e2bc971d8bd72b50","filename":"scripts/daily_maintenance.py","status":"added","additions":67,"deletions":0,"changes":67,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fdaily_maintenance.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fdaily_maintenance.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fdaily_maintenance.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,67 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL数据看板 - 每日定时维护 (蚂蚁搬家式)\n+执行顺序:\n+1. 获取当日新数据(板块强度+新高+沪深300)\n+2. 蚂蚁搬家补全2天历史数据\n+3. 刷新看板\n+运行时间: 每个交易日17:30 (收盘后)\n+\"\"\"\n+import sys\n+from pathlib import Path\n+import time\n+import random\n+\n+_SCRIPT_DIR = Path(__file__).parent.resolve()\n+_PROJECT_ROOT = _SCRIPT_DIR.parent\n+sys.path.insert(0, str(_SCRIPT_DIR))\n+\n+# 直接调用各子模块\n+from kpl_data_collector import main as collect_today\n+from backfill_history import main as backfill\n+from gen_dashboard import main as gen_html\n+\n+\n+def main():\n+    print(f\"{'='*70}\")\n+    print(f\"KPL每日定时维护 | {time.strftime('%Y-%m-%d %H:%M')}\")\n+    print(f\"{'='*70}\")\n+\n+    # Step 1: 获取当日新数据(增量)\n+    print(\"\\n>>> Step 1: 获取当日新数据...\")\n+    try:\n+        collect_today()\n+    except Exception as e:\n+        print(f\"  当日数据获取失败: {e}\")\n+\n+    # 随机休息\n+    pause = random.uniform(10, 30)\n+    print(f\"\\n  休息 {pause:.0f}秒...\")\n+    time.sleep(pause)\n+\n+    # Step 2: 蚂蚁搬家补全历史\n+    print(\"\\n>>> Step 2: 蚂蚁搬家补全历史数据...\")\n+    try:\n+        backfill()\n+    except Exception as e:\n+        print(f\"  历史补全失败: {e}\")\n+\n+    # 随机休息\n+    pause = random.uniform(5, 15)\n+    print(f\"\\n  休息 {pause:.0f}秒...\")\n+    time.sleep(pause)\n+\n+    # Step 3: 刷新看板\n+    print(\"\\n>>> Step 3: 生成最新看板...\")\n+    try:\n+        gen_html()\n+    except Exception as e:\n+        print(f\"  看板生成失败: {e}\")\n+\n+    print(f\"\\n{'='*70}\")\n+    print(f\"每日维护完成 | {time.strftime('%Y-%m-%d %H:%M')}\")\n+    print(f\"{'='*70}\")\n+\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"86a7525f27e41fe9737b29123f1bacbe75dbc8a2","filename":"scripts/download_history.py","status":"added","additions":301,"deletions":0,"changes":301,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fdownload_history.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fdownload_history.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fdownload_history.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,301 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL数据看板 - 历史数据下载 (可手动运行, 支持灵活选择)\n+支持: 日期范围、数据种类、下载方式(快速/蚂蚁搬家)\n+\n+用法示例:\n+  # 交互模式 (推荐, 会有提示引导)\n+  python download_history.py\n+\n+  # 命令行模式 - 下载2026年1-3月全部数据(蚂蚁搬家)\n+  python download_history.py --start 2026-01-01 --end 2026-03-31 --type all --mode slow\n+\n+  # 命令行模式 - 只下载板块强度(快速模式)\n+  python download_history.py --start 2026-01-01 --end 2026-03-31 --type strength --mode fast\n+\n+  # 命令行模式 - 只下载沪深300\n+  python download_history.py --start 2026-01-01 --end 2026-03-31 --type hs300\n+\n+  # 命令行模式 - 只补全缺失数据\n+  python download_history.py --fill-missing --mode slow\n+\n+数据种类:\n+  all       - 全部(板块强度+新高+板块新高+沪深300)\n+  strength  - 仅板块强度\n+  newhigh   - 仅百日新高(全市场+板块)\n+  hs300     - 仅沪深300\n+\n+下载方式:\n+  fast  - 多线程快速(8线程, ~28次/秒, 适合少量数据)\n+  slow  - 蚂蚁搬家(单线程, 2-8秒随机延迟, 模拟真人, 适合大量历史)\n+\"\"\"\n+import sys\n+import time\n+import argparse\n+import random\n+from pathlib import Path\n+from datetime import datetime, timedelta\n+\n+_SCRIPT_DIR = Path(__file__).parent.resolve()\n+_PROJECT_ROOT = _SCRIPT_DIR.parent\n+sys.path.insert(0, str(_SCRIPT_DIR))\n+\n+from kpl_common import *\n+from kaipanla_crawler import KaipanlaCrawler\n+\n+\n+def interactive_mode():\n+    \"\"\"交互式引导用户选择参数\"\"\"\n+    print(f\"\\n{'='*70}\")\n+    print(f\"KPL历史数据下载 - 交互模式\")\n+    print(f\"{'='*70}\")\n+\n+    # 1. 日期范围\n+    print(f\"\\n[1] 选择日期范围\")\n+    today = datetime.now().strftime('%Y-%m-%d')\n+    default_start = '2026-01-01'\n+\n+    # 显示当前数据覆盖情况\n+    conn = init_db()\n+    existing = get_existing_dates(conn, 'sector_strength')\n+    if existing:\n+        sorted_dates = sorted(existing)\n+        print(f\"  当前已有数据: {sorted_dates[0]} ~ {sorted_dates[-1]} ({len(sorted_dates)}天)\")\n+        missing = [d for d in get_all_trading_days(default_start, today) if d not in existing]\n+        print(f\"  缺失: {len(missing)}天\")\n+    conn.close()\n+\n+    start_date = input(f\"  起始日期 (回车=默认{default_start}): \").strip() or default_start\n+    end_date = input(f\"  结束日期 (回车=默认{today}): \").strip() or today\n+\n+    # 2. 数据种类\n+    print(f\"\\n[2] 选择数据种类\")\n+    print(f\"  1. 全部 (板块强度+百日新高+板块新高+沪深300)\")\n+    print(f\"  2. 仅板块强度\")\n+    print(f\"  3. 仅百日新高 (全市场+板块级)\")\n+    print(f\"  4. 仅沪深300\")\n+    print(f\"  5. 仅补全缺失数据 (自动检测)\")\n+    type_choice = input(f\"  选择 (回车=1): \").strip() or '1'\n+    data_type = {'1': 'all', '2': 'strength', '3': 'newhigh', '4': 'hs300', '5': 'missing'}.get(type_choice, 'all')\n+\n+    # 3. 下载方式\n+    print(f\"\\n[3] 选择下载方式\")\n+    print(f\"  1. 蚂蚁搬家 (单线程, 2-8秒随机延迟, 模拟真人, 推荐)\")\n+    print(f\"  2. 快速模式 (8线程并发, ~28次/秒, 适合少量数据)\")\n+    mode_choice = input(f\"  选择 (回车=1): \").strip() or '1'\n+    mode = 'slow' if mode_choice == '1' else 'fast'\n+\n+    # 4. 蚂蚁搬家参数(如果选了slow)\n+    days_per_run = 2\n+    min_delay = 2.0\n+    max_delay = 8.0\n+    if mode == 'slow':\n+        print(f\"\\n[4] 蚂蚁搬家参数\")\n+        days_input = input(f\"  本次下载天数 (回车=2): \").strip()\n+        days_per_run = int(days_input) if days_input else 2\n+        delay_input = input(f\"  API间隔范围 (回车=2-8秒): \").strip()\n+        if '-' in delay_input:\n+            parts = delay_input.split('-')\n+            min_delay = float(parts[0])\n+            max_delay = float(parts[1])\n+\n+    # 5. 确认\n+    print(f\"\\n{'='*70}\")\n+    print(f\"确认下载计划:\")\n+    print(f\"  日期范围: {start_date} ~ {end_date}\")\n+    print(f\"  数据种类: {data_type}\")\n+    print(f\"  下载方式: {mode}\")\n+    if mode == 'slow':\n+        print(f\"  本次天数: {days_per_run}\")\n+        print(f\"  API间隔: {min_delay}-{max_delay}秒\")\n+    print(f\"{'='*70}\")\n+    confirm = input(f\"\\n确认开始? (y/n, 回车=y): \").strip().lower() or 'y'\n+    if confirm != 'y':\n+        print(\"已取消\")\n+        return\n+\n+    return start_date, end_date, data_type, mode, days_per_run, min_delay, max_delay\n+\n+\n+def download_strength(conn, sectors, dates, mode, min_delay, max_delay, days_per_run):\n+    \"\"\"下载板块强度\"\"\"\n+    existing = get_existing_dates(conn, 'sector_strength')\n+    missing = [d for d in dates if d not in existing]\n+    if not missing:\n+        print(f\"  板块强度: 所有日期已有, 跳过\")\n+        return\n+\n+    if mode == 'slow':\n+        # 蚂蚁搬家: 限制本次天数\n+        to_fill = missing[:days_per_run]\n+        remaining = len(missing) - len(to_fill)\n+        print(f\"  板块强度: 缺失{len(missing)}天, 本次补{len(to_fill)}天, 剩余{remaining}天\")\n+        print(f\"  日期: {to_fill}\")\n+        t_start = time.time()\n+        success, fail = download_strength_batch(conn, sectors, to_fill,\n+                                                slow_mode=True, min_delay=min_delay, max_delay=max_delay)\n+        elapsed = time.time() - t_start\n+        print(f\"  完成: {success}成功, {fail}失败, 耗时{elapsed/60:.1f}分钟\")\n+        for d in to_fill:\n+            log_action(conn, 'strength', d, success//len(to_fill), fail//len(to_fill), elapsed/len(to_fill))\n+    else:\n+        print(f\"  板块强度: 缺失{len(missing)}天, 快速模式\")\n+        t_start = time.time()\n+        success, fail = download_strength_batch(conn, sectors, missing, max_workers=8)\n+        elapsed = time.time() - t_start\n+        print(f\"  完成: {success}成功, {fail}失败, 耗时{elapsed:.0f}秒\")\n+\n+\n+def download_newhigh(conn, sectors, dates):\n+    \"\"\"下载百日新高(全市场+板块级)\"\"\"\n+    # 全市场(1次API)\n+    print(f\"  全市场百日新高: 1次API调用\")\n+    nh_records = fetch_market_new_high()\n+    for date, total, new in nh_records:\n+        conn.execute(\"INSERT OR REPLACE INTO new_high VALUES(?,?,?)\", (date, total, new))\n+    conn.commit()\n+    print(f\"    已保存 {len(nh_records)} 天\")\n+\n+    # 板块级(每板块1次, 仅缺失板块)\n+    existing_snh = set(r[0] for r in conn.execute(\"SELECT DISTINCT sector_code FROM sector_new_high\").fetchall())\n+    missing = [(c, n) for c, n in sectors if c not in existing_snh]\n+    if not missing:\n+        print(f\"  板块百日新高: 全部已有, 跳过\")\n+    else:\n+        print(f\"  板块百日新高: {len(missing)}板块缺失, 多线程下载\")\n+        success, total = download_sector_new_high_batch(conn, missing)\n+        print(f\"    完成: {success}板块, {total}条\")\n+\n+\n+def download_hs300(conn, start_date, end_date):\n+    \"\"\"下载沪深300\"\"\"\n+    print(f\"  沪深300: {start_date} ~ {end_date}\")\n+    hs300 = fetch_hs300_kline(start_date, end_date)\n+    conn.executemany(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", hs300)\n+    conn.commit()\n+    print(f\"    已保存 {len(hs300)} 条\")\n+\n+\n+def run(start_date, end_date, data_type, mode, days_per_run, min_delay, max_delay):\n+    print(f\"\\n{'='*70}\")\n+    print(f\"KPL历史数据下载 | {datetime.now().strftime('%Y-%m-%d %H:%M')}\")\n+    print(f\"{'='*70}\")\n+    print(f\"  日期范围: {start_date} ~ {end_date}\")\n+    print(f\"  数据种类: {data_type}\")\n+    print(f\"  下载方式: {mode}\")\n+    if mode == 'slow':\n+        print(f\"  本次天数: {days_per_run}, API间隔: {min_delay}-{max_delay}秒\")\n+\n+    conn = init_db()\n+    crawler = KaipanlaCrawler()\n+\n+    # 加载板块列表\n+    sectors_dict, excel_codes = load_sector_list(conn)\n+    if not sectors_dict:\n+        print(\"[错误] 无法加载板块列表\")\n+        return\n+\n+    # 动态发现板块(仅missing模式或all模式)\n+    if data_type in ('all', 'missing'):\n+        trading_days = get_all_trading_days(start_date, end_date)\n+        print(f\"\\n[0] 动态板块发现 ({len(trading_days)}天)\")\n+        extra = discover_extra_sectors(crawler, trading_days, set(sectors_dict.keys()))\n+        if extra:\n+            for code, name in extra.items():\n+                conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\", (code, name, 0, 'dynamic'))\n+                sectors_dict[code] = name\n+            conn.commit()\n+        all_sectors = list(sectors_dict.items())\n+        print(f\"  总板块: {len(all_sectors)}\")\n+    else:\n+        all_sectors = list(sectors_dict.items())\n+\n+    # 获取交易日列表\n+    if data_type == 'missing':\n+        # 自动检测缺失日期\n+        existing = get_existing_dates(conn, 'sector_strength')\n+        all_days = get_all_trading_days(start_date, end_date)\n+        trading_days = [d for d in all_days if d not in existing]\n+        data_type = 'all'\n+        print(f\"\\n  缺失日期: {len(trading_days)}天\")\n+        if not trading_days:\n+            print(\"  无缺失数据!\")\n+            conn.close()\n+            return\n+    else:\n+        trading_days = get_all_trading_days(start_date, end_date)\n+\n+    t_start = time.time()\n+\n+    # 执行下载\n+    if data_type == 'all':\n+        print(f\"\\n[1] 板块强度\")\n+        download_strength(conn, all_sectors, trading_days, mode, min_delay, max_delay, days_per_run)\n+\n+        print(f\"\\n[2] 百日新高\")\n+        download_newhigh(conn, all_sectors, trading_days)\n+\n+        print(f\"\\n[3] 沪深300\")\n+        download_hs300(conn, start_date, end_date)\n+\n+    elif data_type == 'strength':\n+        print(f\"\\n[1] 板块强度\")\n+        download_strength(conn, all_sectors, trading_days, mode, min_delay, max_delay, days_per_run)\n+\n+    elif data_type == 'newhigh':\n+        print(f\"\\n[1] 百日新高\")\n+        download_newhigh(conn, all_sectors, trading_days)\n+\n+    elif data_type == 'hs300':\n+        print(f\"\\n[1] 沪深300\")\n+        download_hs300(conn, start_date, end_date)\n+\n+    # 统计\n+    elapsed = time.time() - t_start\n+    print(f\"\\n{'='*70}\")\n+    print(f\"历史数据下载完成 | 耗时{elapsed/60:.1f}分钟\")\n+    print_db_stats(conn)\n+    print(f\"{'='*70}\")\n+\n+    conn.close()\n+\n+\n+def main():\n+    parser = argparse.ArgumentParser(description='KPL历史数据下载', formatter_class=argparse.RawDescriptionHelpFormatter,\n+        epilog=\"\"\"\n+示例:\n+  python download_history.py                          # 交互模式\n+  python download_history.py --start 2026-01-01 --end 2026-03-31 --type all --mode slow\n+  python download_history.py --fill-missing --mode slow\n+  python download_history.py --start 2026-06-01 --end 2026-06-30 --type strength --mode fast\n+        \"\"\")\n+    parser.add_argument('--start', help='起始日期 YYYY-MM-DD')\n+    parser.add_argument('--end', help='结束日期 YYYY-MM-DD')\n+    parser.add_argument('--type', choices=['all', 'strength', 'newhigh', 'hs300', 'missing'], help='数据种类')\n+    parser.add_argument('--mode', choices=['fast', 'slow'], help='下载方式')\n+    parser.add_argument('--days', type=int, default=2, help='蚂蚁搬家模式每次天数(默认2)')\n+    parser.add_argument('--min-delay', type=float, default=2.0, help='最小延迟秒数(默认2.0)')\n+    parser.add_argument('--max-delay', type=float, default=8.0, help='最大延迟秒数(默认8.0)')\n+    parser.add_argument('--fill-missing', action='store_true', help='自动补全缺失数据')\n+\n+    args = parser.parse_args()\n+\n+    # 如果没有参数, 进入交互模式\n+    if not any([args.start, args.end, args.type, args.fill_missing]):\n+        result = interactive_mode()\n+        if result is None:\n+            return\n+        start_date, end_date, data_type, mode, days_per_run, min_delay, max_delay = result\n+        run(start_date, end_date, data_type, mode, days_per_run, min_delay, max_delay)\n+    else:\n+        # 命令行模式\n+        today = datetime.now().strftime('%Y-%m-%d')\n+        start_date = args.start or '2026-01-01'\n+        end_date = args.end or today\n+        data_type = 'missing' if args.fill_missing else (args.type or 'all')\n+        mode = args.mode or 'slow'\n+        run(start_date, end_date, data_type, mode, args.days, args.min_delay, args.max_delay)\n+\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"6a8dcd18a6d4a89e73d0cf731c5a47fba3e12bfe","filename":"scripts/download_today.py","status":"added","additions":152,"deletions":0,"changes":152,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fdownload_today.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fdownload_today.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fdownload_today.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,152 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL数据看板 - 盘后数据下载 (可手动运行 / 定时任务)\n+功能: 获取当日最新数据 + 刷新看板\n+用法:\n+  手动运行: python download_today.py\n+  定时任务: 每个交易日17:30自动执行\n+\"\"\"\n+import sys\n+import time\n+from pathlib import Path\n+from datetime import datetime, timedelta\n+\n+_SCRIPT_DIR = Path(__file__).parent.resolve()\n+_PROJECT_ROOT = _SCRIPT_DIR.parent\n+sys.path.insert(0, str(_SCRIPT_DIR))\n+\n+from kpl_common import *\n+from kaipanla_crawler import KaipanlaCrawler\n+\n+\n+def run():\n+    print(f\"{'='*70}\")\n+    print(f\"KPL盘后数据下载 | {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n+    print(f\"{'='*70}\")\n+\n+    t_start = time.time()\n+    conn = init_db()\n+    crawler = KaipanlaCrawler()\n+\n+    # 0. 确保板块列表已加载\n+    sectors, excel_codes = load_sector_list(conn)\n+    if not sectors:\n+        print(\"[错误] 无法加载板块列表, 请检查Excel文件\")\n+        return\n+\n+    # 1. 沪深300 K线 (1次调用, 获取最近60天确保覆盖)\n+    print(f\"\\n[1/5] 沪深300日K线\")\n+    today = datetime.now().strftime('%Y-%m-%d')\n+    start = (datetime.now() - timedelta(days=75)).strftime('%Y-%m-%d')\n+    hs300 = fetch_hs300_kline(start, today)\n+    conn.executemany(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", hs300)\n+    conn.commit()\n+    print(f\"  已保存 {len(hs300)} 条\")\n+\n+    # 2. 全市场百日新高 (1次调用)\n+    print(f\"\\n[2/5] 全市场百日新高\")\n+    nh_records = fetch_market_new_high()\n+    for date, total, new in nh_records:\n+        conn.execute(\"INSERT OR REPLACE INTO new_high VALUES(?,?,?)\", (date, total, new))\n+    conn.commit()\n+    print(f\"  已保存 {len(nh_records)} 天\")\n+\n+    # 3. 动态发现额外板块 (仅检查最近3天)\n+    print(f\"\\n[3/5] 动态板块发现\")\n+    nh_dates = sorted([r[0] for r in nh_records])\n+    recent_dates = nh_dates[-3:] if len(nh_dates) >= 3 else nh_dates\n+    extra = discover_extra_sectors(crawler, recent_dates, set(sectors.keys()))\n+    if extra:\n+        for code, name in extra.items():\n+            conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\", (code, name, 0, 'dynamic'))\n+            sectors[code] = name\n+        conn.commit()\n+    all_sectors = list(sectors.items())\n+    print(f\"  总板块: {len(all_sectors)} (Excel:{len(excel_codes)} + 动态:{len(extra)})\")\n+\n+    # 4. 当日板块强度 (多线程快速模式)\n+    existing = get_existing_dates(conn, 'sector_strength')\n+    today_date = nh_dates[-1] if nh_dates else today\n+    if today_date in existing:\n+        print(f\"\\n[4/5] 板块强度: {today_date} 已存在, 跳过\")\n+    else:\n+        print(f\"\\n[4/5] 板块强度: 获取 {today_date} ({len(all_sectors)}板块, 多线程)\")\n+        success, fail = download_strength_batch(conn, all_sectors, [today_date], max_workers=8)\n+        print(f\"  完成: {success}成功, {fail}失败\")\n+\n+    # 5. 板块百日新高 (检查最新日期覆盖率, 不足则全量刷新)\n+    latest_snh_date = conn.execute(\"SELECT MAX(date) FROM sector_new_high\").fetchone()[0]\n+    sector_count_latest = 0\n+    if latest_snh_date:\n+        sector_count_latest = conn.execute(\n+            \"SELECT COUNT(*) FROM sector_new_high WHERE date=?\", (latest_snh_date,)\n+        ).fetchone()[0]\n+\n+    need_refresh = (not latest_snh_date or\n+                    latest_snh_date < today_date or\n+                    sector_count_latest < len(all_sectors) * 0.5)\n+\n+    if need_refresh:\n+        print(f\"\\n[5/5] 板块百日新高: 最新日期{latest_snh_date}覆盖率{sector_count_latest}/{len(all_sectors)}, 全量刷新\")\n+        success, total = download_sector_new_high_batch(conn, all_sectors)\n+        print(f\"  完成: {success}板块, {total}条\")\n+    else:\n+        # 仅补充缺失板块\n+        existing_snh = set(r[0] for r in conn.execute(\"SELECT DISTINCT sector_code FROM sector_new_high\").fetchall())\n+        missing_snh = [(c, n) for c, n in all_sectors if c not in existing_snh]\n+        if not missing_snh:\n+            print(f\"\\n[5/5] 板块百日新高: 最新日期{latest_snh_date}覆盖率充足, 跳过\")\n+        else:\n+            print(f\"\\n[5/5] 板块百日新高: {len(missing_snh)}板块缺失, 增量下载\")\n+            success, total = download_sector_new_high_batch(conn, missing_snh)\n+            print(f\"  完成: {success}板块, {total}条\")\n+\n+    # 6. 市场情绪 + 板块涨跌停 + 涨停个股映射\n+    print(f\"\\n[6/7] 市场情绪 + 板块涨跌停 + 涨停个股\")\n+    init_emotion_tables(conn)\n+    download_market_sentiment(conn)\n+    # 仅下载今日板块涨跌停+个股映射\n+    # 注意: get_sector_ranking(date)不支持历史查询(返回当日数据), 多日下载会覆盖历史数据\n+    today_date_str = datetime.now().strftime('%Y-%m-%d')\n+    n_sec, n_stk = download_sector_sentiment(conn, [today_date_str])\n+    print(f\"  板块涨跌停: {n_sec}条, 个股映射: {n_stk}条\")\n+\n+    # 7. 连板梯队\n+    print(f\"\\n[7/7] 连板梯队数据\")\n+    all_ss_dates = sorted([r[0] for r in conn.execute(\n+        \"SELECT DISTINCT date FROM sector_strength\"\n+    ).fetchall()])\n+    existing_ld = set(r[0] for r in conn.execute(\n+        \"SELECT DISTINCT date FROM ladder_data\"\n+    ).fetchall())\n+    missing_ld = [d for d in all_ss_dates if d not in existing_ld]\n+    if missing_ld:\n+        from kpl_common import download_ladder_data\n+        print(f\"  {len(missing_ld)}天缺失, 下载中...\")\n+        download_ladder_data(conn, missing_ld)\n+        print(f\"  完成\")\n+    else:\n+        print(f\"  已是最新\")\n+\n+    # 统计\n+    elapsed = time.time() - t_start\n+    print(f\"\\n{'='*70}\")\n+    print(f\"盘后数据下载完成 | 耗时{elapsed:.0f}秒\")\n+    print_db_stats(conn)\n+    log_action(conn, 'today', today_date, 1, 0, elapsed)\n+\n+    # 8. 生成看板\n+    print(f\"\\n[8/8] 生成看板HTML...\")\n+    try:\n+        sys.path.insert(0, str(_PROJECT_ROOT / 'src'))\n+        from gen_dashboard import main as gen_html\n+        gen_html()\n+    except Exception as e:\n+        print(f\"  看板生成失败: {e}\")\n+\n+    conn.close()\n+    print(f\"{'='*70}\")\n+\n+\n+if __name__ == '__main__':\n+    run()"},{"sha":"c34871e62468a7fafa0d7317f0d5e7353f03309b","filename":"scripts/fetch_etf_data.py","status":"added","additions":163,"deletions":0,"changes":163,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Ffetch_etf_data.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Ffetch_etf_data.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Ffetch_etf_data.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,163 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+获取主流ETF日K线数据并存入数据库\n+覆盖: 芯片/算力/通信/AI/机器人/医药\n+\"\"\"\n+import sys\n+import json\n+import time\n+import sqlite3\n+import requests\n+from pathlib import Path\n+from datetime import datetime, timedelta\n+\n+PROJECT = Path(r'D:\\trae\\traeworkspace\\kpl-dashboard')\n+sys.path.insert(0, str(PROJECT / 'scripts'))\n+DB_PATH = PROJECT / 'data' / 'kpl_dashboard.db'\n+\n+# 主流ETF列表 (代码, 名称, 对应板块)\n+ETF_LIST = [\n+    ('512760', '芯片ETF',     '芯片'),\n+    ('515880', '通信ETF',     '通信/算力'),\n+    ('159819', '人工智能ETF', 'AI应用'),\n+    ('562500', '机器人ETF',   '机器人/物理AI'),\n+    ('512010', '医药ETF',     '医药'),\n+    ('515980', 'AI ETF',      'AI应用(备选)'),\n+]\n+\n+def fetch_etf_kline(etf_code, days=400):\n+    \"\"\"通过东方财富API获取ETF日K线数据\"\"\"\n+    # 东财ETF代码格式: 1.512760 (沪市前缀1) 或 0.159819 (深市前缀0)\n+    if etf_code.startswith('5'):\n+        secid = f\"1.{etf_code}\"\n+    else:\n+        secid = f\"0.{etf_code}\"\n+    \n+    url = \"https://push2his.eastmoney.com/api/qt/stock/kline/get\"\n+    params = {\n+        \"secid\": secid,\n+        \"fields1\": \"f1,f2,f3,f4,f5,f6\",\n+        \"fields2\": \"f51,f52,f53,f54,f55,f56,f57,f58\",  # date,open,close,high,low,vol,amount,pct\n+        \"klt\": \"101\",  # 日K\n+        \"fqt\": \"1\",    # 前复权\n+        \"end\": \"20500101\",\n+        \"lmt\": str(days),\n+    }\n+    headers = {\"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\"}\n+    \n+    try:\n+        r = requests.get(url, params=params, headers=headers, timeout=15,\n+                        proxies={'http': None, 'https': None})\n+        data = r.json()\n+        klines = data.get('data', {}).get('klines', [])\n+        if not klines:\n+            print(f\"  {etf_code}: 无K线数据\")\n+            return []\n+        \n+        records = []\n+        for line in klines:\n+            parts = line.split(',')\n+            date = parts[0]\n+            open_p = float(parts[1])\n+            close = float(parts[2])\n+            high = float(parts[3])\n+            low = float(parts[4])\n+            vol = float(parts[5])\n+            amount = float(parts[6])\n+            pct = float(parts[7]) if len(parts) > 7 else 0.0\n+            records.append((date, etf_code, open_p, close, high, low, vol, amount, pct))\n+        \n+        return records\n+    except Exception as e:\n+        print(f\"  {etf_code} 东财API失败: {str(e)[:60]}\")\n+        # 备选: 新浪API\n+        return fetch_etf_kline_sina(etf_code, days)\n+\n+\n+def fetch_etf_kline_sina(etf_code, days=90):\n+    \"\"\"新浪API获取ETF K线 (备选)\"\"\"\n+    url = f\"https://quotes.sina.cn/cn/api/jsonp_v2.php/var%20_k=/CN_MarketDataService.getKLineData?symbol={etf_code}&scale=240&ma=no&datalen={days}\"\n+    headers = {\"User-Agent\": \"Mozilla/5.0\"}\n+    try:\n+        r = requests.get(url, headers=headers, timeout=15,\n+                        proxies={'http': None, 'https': None})\n+        text = r.text\n+        start = text.index('[')\n+        end = text.rindex(']') + 1\n+        data = json.loads(text[start:end])\n+        records = []\n+        for item in data:\n+            date = item['day']\n+            records.append((\n+                date, etf_code,\n+                float(item['open']), float(item['close']),\n+                float(item['high']), float(item['low']),\n+                float(item['volume']), 0.0,\n+                float(item.get('percent', 0))\n+            ))\n+        return records\n+    except Exception as e:\n+        print(f\"  {etf_code} 新浪API也失败: {str(e)[:60]}\")\n+        return []\n+\n+\n+def init_etf_table(conn):\n+    \"\"\"创建ETF K线表\"\"\"\n+    conn.execute(\"\"\"\n+        CREATE TABLE IF NOT EXISTS etf_kline (\n+            date TEXT, etf_code TEXT, open REAL, close REAL,\n+            high REAL, low REAL, volume REAL, amount REAL, pct_chg REAL,\n+            PRIMARY KEY (date, etf_code)\n+        )\n+    \"\"\")\n+    # ETF元信息表\n+    conn.execute(\"\"\"\n+        CREATE TABLE IF NOT EXISTS etf_list (\n+            etf_code TEXT PRIMARY KEY, etf_name TEXT, sector TEXT\n+        )\n+    \"\"\")\n+    conn.commit()\n+\n+\n+def main():\n+    conn = sqlite3.connect(str(DB_PATH))\n+    init_etf_table(conn)\n+    \n+    # 存储ETF元信息\n+    for code, name, sector in ETF_LIST:\n+        conn.execute(\"INSERT OR REPLACE INTO etf_list VALUES(?,?,?)\", (code, name, sector))\n+    conn.commit()\n+    \n+    print(f\"{'='*60}\")\n+    print(f\"ETF K线数据采集 | {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n+    print(f\"{'='*60}\")\n+    print(f\"ETF列表: {len(ETF_LIST)}只\")\n+    for code, name, sector in ETF_LIST:\n+        print(f\"  {code} {name} -> {sector}\")\n+    print()\n+    \n+    total = 0\n+    for code, name, sector in ETF_LIST:\n+        print(f\"获取 {code} {name}...\")\n+        records = fetch_etf_kline(code, days=400)\n+        if records:\n+            conn.executemany(\"INSERT OR REPLACE INTO etf_kline VALUES(?,?,?,?,?,?,?,?,?)\", records)\n+            conn.commit()\n+            total += len(records)\n+            print(f\"  已保存 {len(records)} 条 (最新: {records[-1][0]})\")\n+        time.sleep(0.5)\n+    \n+    print(f\"\\n总计: {total} 条ETF K线数据\")\n+    \n+    # 验证\n+    print(f\"\\n数据验证:\")\n+    for code, name, sector in ETF_LIST:\n+        row = conn.execute(\"SELECT COUNT(*), MIN(date), MAX(date) FROM etf_kline WHERE etf_code=?\", (code,)).fetchone()\n+        print(f\"  {code} {name}: {row[0]}条 ({row[1]} ~ {row[2]})\")\n+    \n+    conn.close()\n+    print(f\"\\n完成!\")\n+\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"11b5ef41556c90f867baa3e3c34720fa69142c86","filename":"scripts/gen_api_report.py","status":"added","additions":359,"deletions":0,"changes":359,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fgen_api_report.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fgen_api_report.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fgen_api_report.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,359 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+生成 KPL API 全接口验证报告 HTML（表格展示版）\n+每个API的数据案例以表格字段形式展示，不显示原始JSON\n+\"\"\"\n+import json\n+import html\n+from pathlib import Path\n+from datetime import datetime\n+\n+_PROJECT_ROOT = Path(__file__).parent.parent.resolve()\n+json_path = _PROJECT_ROOT / 'scripts' / 'api_verify_results.json'\n+\n+with open(json_path, 'r', encoding='utf-8') as f:\n+    results = json.load(f)\n+\n+now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n+time_tag = datetime.now().strftime('%Y%m%d-%H%M')\n+\n+total = len(results)\n+success_list = [r for r in results if r['status'] == 'success']\n+empty_list = [r for r in results if r['status'] == 'empty']\n+error_list = [r for r in results if r['status'] == 'error']\n+\n+categories = {}\n+for r in results:\n+    cat = r['category']\n+    if cat not in categories:\n+        categories[cat] = []\n+    categories[cat].append(r)\n+\n+status_colors = {'success': '#10b981', 'empty': '#f59e0b', 'error': '#ef4444'}\n+status_labels = {'success': '成功', 'empty': '空数据', 'error': '失败'}\n+status_icons = {'success': '✓', 'empty': '○', 'error': '✗'}\n+\n+\n+def parse_sample(data_sample):\n+    \"\"\"解析数据样本，返回表格行\"\"\"\n+    if not data_sample:\n+        return None\n+\n+    try:\n+        parsed = json.loads(data_sample)\n+    except:\n+        # 非JSON，尝试解析字符串\n+        return {'type': 'text', 'content': str(data_sample)[:1000]}\n+\n+    # DataFrame格式\n+    if isinstance(parsed, dict) and parsed.get('type') == 'DataFrame':\n+        columns = parsed.get('columns', [])\n+        rows = parsed.get('sample_rows', [])\n+        total_rows = parsed.get('total_rows', 0)\n+        return {'type': 'table', 'columns': columns, 'rows': rows, 'total': total_rows}\n+\n+    # 列表格式\n+    if isinstance(parsed, list):\n+        if len(parsed) == 0:\n+            return None\n+        # 尝试提取字段\n+        if isinstance(parsed[0], dict):\n+            columns = list(parsed[0].keys())\n+            rows = parsed\n+            return {'type': 'table', 'columns': columns, 'rows': rows, 'total': len(parsed)}\n+        else:\n+            return {'type': 'list', 'items': parsed[:10], 'total': len(parsed)}\n+\n+    # 字典格式 - 展开为键值对表格\n+    if isinstance(parsed, dict):\n+        # 检查是否包含嵌套列表\n+        flat_rows = []\n+        nested_key = None\n+        nested_items = None\n+        for k, v in parsed.items():\n+            if isinstance(v, list) and len(v) > 0:\n+                if isinstance(v[0], dict):\n+                    nested_key = k\n+                    nested_items = v\n+                elif isinstance(v[0], list) and len(v) > 1:\n+                    nested_key = k\n+                    nested_items = v\n+\n+        # 如果有嵌套列表数据，优先展示\n+        if nested_items and isinstance(nested_items[0], dict):\n+            columns = list(nested_items[0].keys())\n+            return {'type': 'table', 'columns': columns, 'rows': nested_items[:5], 'total': len(nested_items)}\n+        elif nested_items and isinstance(nested_items[0], list):\n+            # 原始数据列表，取前5条\n+            return {'type': 'raw_table', 'items': nested_items[:5], 'total': len(nested_items)}\n+\n+        # 展开为键值对\n+        rows = []\n+        for k, v in parsed.items():\n+            val_str = format_value(v)\n+            rows.append({'字段': k, '值': val_str})\n+        return {'type': 'table', 'columns': ['字段', '值'], 'rows': rows, 'total': len(rows)}\n+\n+    return {'type': 'text', 'content': str(parsed)[:1000]}\n+\n+\n+def format_value(val):\n+    \"\"\"格式化值为可读字符串\"\"\"\n+    if val is None:\n+        return '-'\n+    if isinstance(val, (int, float)):\n+        if isinstance(val, float) and abs(val) > 1e8:\n+            return f\"{val/1e8:.2f}亿\"\n+        return str(val)\n+    if isinstance(val, list):\n+        if len(val) == 0:\n+            return '[]'\n+        if len(val) <= 3:\n+            return str(val)\n+        return f\"[{len(val)}项] {str(val[:3])[:200]}...\"\n+    if isinstance(val, dict):\n+        items = list(val.items())[:3]\n+        return '{' + ', '.join(f'\"{k}\": {str(v)[:50]}' for k, v in items) + ('...' if len(val) > 3 else '') + '}'\n+    return str(val)[:200]\n+\n+\n+def render_table(parsed):\n+    \"\"\"渲染数据表格HTML\"\"\"\n+    if not parsed:\n+        return ''\n+\n+    if parsed['type'] == 'table':\n+        columns = parsed['columns']\n+        rows = parsed['rows']\n+        total = parsed.get('total', len(rows))\n+        limit = min(len(rows), 5)\n+\n+        html_str = f'<div class=\"data-table-wrap\">'\n+        html_str += f'<div class=\"table-meta\">共 {total} 条记录，展示前 {limit} 条</div>'\n+        html_str += '<table class=\"data-table\"><thead><tr>'\n+        for col in columns:\n+            html_str += f'<th>{html.escape(str(col))}</th>'\n+        html_str += '</tr></thead><tbody>'\n+        for row in rows[:limit]:\n+            html_str += '<tr>'\n+            for col in columns:\n+                val = row.get(col, '') if isinstance(row, dict) else ''\n+                val_str = format_value(val)\n+                html_str += f'<td>{html.escape(val_str)}</td>'\n+            html_str += '</tr>'\n+        html_str += '</tbody></table></div>'\n+        return html_str\n+\n+    if parsed['type'] == 'raw_table':\n+        items = parsed['items']\n+        total = parsed.get('total', len(items))\n+        html_str = f'<div class=\"data-table-wrap\">'\n+        html_str += f'<div class=\"table-meta\">共 {total} 条记录，展示前 {len(items)} 条</div>'\n+        html_str += '<table class=\"data-table\"><tbody>'\n+        for i, item in enumerate(items):\n+            html_str += f'<tr><td class=\"row-num\">{i+1}</td>'\n+            if isinstance(item, list):\n+                for cell in item[:8]:\n+                    html_str += f'<td>{html.escape(format_value(cell))}</td>'\n+            else:\n+                html_str += f'<td>{html.escape(format_value(item))}</td>'\n+            html_str += '</tr>'\n+        html_str += '</tbody></table></div>'\n+        return html_str\n+\n+    if parsed['type'] == 'list':\n+        items = parsed['items']\n+        total = parsed.get('total', len(items))\n+        html_str = f'<div class=\"data-table-wrap\">'\n+        html_str += f'<div class=\"table-meta\">共 {total} 项，展示前 {len(items)} 项</div>'\n+        html_str += '<table class=\"data-table\"><tbody>'\n+        for i, item in enumerate(items):\n+            html_str += f'<tr><td class=\"row-num\">{i+1}</td><td>{html.escape(format_value(item))}</td></tr>'\n+        html_str += '</tbody></table></div>'\n+        return html_str\n+\n+    if parsed['type'] == 'text':\n+        return f'<div class=\"data-text\">{html.escape(parsed[\"content\"])}</div>'\n+\n+    return ''\n+\n+\n+html_parts = []\n+html_parts.append(f'''<!DOCTYPE html>\n+<html lang=\"zh-CN\">\n+<head>\n+<meta charset=\"UTF-8\">\n+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+<meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n+<title>KPL API 全接口验证报告</title>\n+<style>\n+* {{ margin: 0; padding: 0; box-sizing: border-box; }}\n+body {{ font-family: 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif; background: #0f172a; color: #e2e8f0; padding: 20px; }}\n+.container {{ max-width: 1400px; margin: 0 auto; }}\n+header {{ text-align: center; padding: 30px 0; border-bottom: 1px solid #334155; margin-bottom: 30px; }}\n+header h1 {{ font-size: 28px; color: #f8fafc; margin-bottom: 8px; }}\n+header .meta {{ color: #94a3b8; font-size: 14px; }}\n+.summary {{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 30px; }}\n+.card {{ background: #1e293b; border-radius: 12px; padding: 20px; text-align: center; border: 1px solid #334155; }}\n+.card .num {{ font-size: 36px; font-weight: 700; }}\n+.card .label {{ font-size: 14px; color: #94a3b8; margin-top: 4px; }}\n+.card.total .num {{ color: #818cf8; }}\n+.card.success .num {{ color: #10b981; }}\n+.card.empty .num {{ color: #f59e0b; }}\n+.card.error .num {{ color: #ef4444; }}\n+.token-info {{ background: #1e293b; border-radius: 12px; padding: 20px; margin-bottom: 30px; border: 1px solid #334155; }}\n+.token-info h3 {{ color: #f8fafc; margin-bottom: 12px; font-size: 16px; }}\n+.token-info table {{ width: 100%; border-collapse: collapse; }}\n+.token-info td {{ padding: 8px 12px; border-bottom: 1px solid #334155; font-size: 14px; }}\n+.token-info td:first-child {{ color: #94a3b8; width: 120px; }}\n+.token-info td:last-child {{ font-family: 'Courier New', monospace; color: #a5b4fc; word-break: break-all; }}\n+.cat-section {{ margin-bottom: 40px; }}\n+.cat-title {{ font-size: 20px; font-weight: 600; color: #f8fafc; margin-bottom: 16px; padding-left: 12px; border-left: 4px solid #818cf8; }}\n+.api-card {{ background: #1e293b; border-radius: 12px; padding: 20px; margin-bottom: 16px; border: 1px solid #334155; transition: border-color 0.2s; }}\n+.api-card:hover {{ border-color: #818cf8; }}\n+.api-header {{ display: flex; align-items: center; gap: 12px; margin-bottom: 12px; flex-wrap: wrap; }}\n+.api-name {{ font-size: 16px; font-weight: 600; color: #f8fafc; font-family: 'Courier New', monospace; }}\n+.api-status {{ display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 600; }}\n+.api-params {{ font-size: 13px; color: #94a3b8; font-family: 'Courier New', monospace; }}\n+.api-count {{ font-size: 13px; color: #a5b4fc; }}\n+.api-error {{ background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 8px 12px; margin-top: 8px; font-size: 13px; color: #fca5a5; }}\n+.api-desc {{ font-size: 13px; color: #94a3b8; margin-top: 4px; }}\n+.data-table-wrap {{ margin-top: 12px; overflow-x: auto; }}\n+.table-meta {{ font-size: 12px; color: #64748b; margin-bottom: 8px; }}\n+.data-table {{ width: 100%; border-collapse: collapse; font-size: 13px; }}\n+.data-table th {{ background: #334155; color: #e2e8f0; padding: 8px 12px; text-align: left; border: 1px solid #475569; white-space: nowrap; font-weight: 600; }}\n+.data-table td {{ padding: 8px 12px; border: 1px solid #334155; color: #cbd5e1; vertical-align: top; max-width: 300px; overflow: hidden; text-overflow: ellipsis; }}\n+.data-table tbody tr:nth-child(even) {{ background: rgba(30,41,59,0.5); }}\n+.data-table tbody tr:hover {{ background: rgba(129,140,248,0.1); }}\n+.data-table .row-num {{ color: #64748b; text-align: center; font-weight: 600; width: 40px; }}\n+.data-text {{ background: #0f172a; border-radius: 8px; padding: 16px; margin-top: 12px; font-size: 13px; color: #93c5fd; word-break: break-all; }}\n+.no-data {{ margin-top: 12px; padding: 12px; text-align: center; color: #64748b; font-size: 14px; background: #0f172a; border-radius: 8px; }}\n+.timestamp {{ font-size: 12px; color: #64748b; margin-top: 8px; text-align: right; }}\n+footer {{ text-align: center; padding: 30px 0; color: #64748b; font-size: 13px; border-top: 1px solid #334155; margin-top: 40px; }}\n+</style>\n+</head>\n+<body>\n+<div class=\"container\">\n+<header>\n+<h1>KPL API 全接口验证报告</h1>\n+<div class=\"meta\">更新时间: {now} | 测试日期: 2026-07-08 | Token: ea7dc4aae58b4ec8e8d34b4b688995dc</div>\n+</header>\n+\n+<div class=\"token-info\">\n+<h3>验证凭证（Charles 抓包获取）</h3>\n+<table>\n+<tr><td>Token</td><td>ea7dc4aae58b4ec8e8d34b4b688995dc</td></tr>\n+<tr><td>UserID</td><td>7542928</td></tr>\n+<tr><td>DeviceID</td><td>f1e55aa5-c574-329d-b52d-ca0edece2c9a</td></tr>\n+<tr><td>旧Token</td><td>0daffcf404348e2fb714795ba5bdff02 (已过期, error 1020)</td></tr>\n+</table>\n+</div>\n+\n+<div class=\"summary\">\n+<div class=\"card total\"><div class=\"num\">{total}</div><div class=\"label\">总接口数</div></div>\n+<div class=\"card success\"><div class=\"num\">{len(success_list)}</div><div class=\"label\">成功</div></div>\n+<div class=\"card empty\"><div class=\"num\">{len(empty_list)}</div><div class=\"label\">空数据</div></div>\n+<div class=\"card error\"><div class=\"num\">{len(error_list)}</div><div class=\"label\">失败</div></div>\n+</div>\n+''')\n+\n+api_descriptions = {\n+    'get_daily_data': '获取每日涨停数据（历史）',\n+    'get_new_high_data': '获取百日新高数据',\n+    'get_market_sentiment': '市场情绪：涨跌停家数、涨跌家数',\n+    'get_market_index': '主要指数行情（上证/深证/创业板/科创50）',\n+    'get_limit_up_ladder': '连板梯队：一板/二板/三板/高度板/连板率',\n+    'get_sharp_withdrawal': '大幅回撤股列表',\n+    'get_sector_ranking': '板块排名：涨停板块及成分股详情',\n+    'get_consecutive_limit_up': '连板股：最高连板数、连板梯队',\n+    'get_sector_limit_up_ladder': '板块涨停梯队：各板块涨停股及炸板股',\n+    'get_market_limit_up_ladder': '全市场连板梯队：1板~7板+炸板股',\n+    'get_historical_broken_limit_up': '历史炸板股：回撤幅度、主力资金',\n+    'get_sector_capital_data': '板块资金数据',\n+    'get_sector_strength_ndays': 'N日板块强度：涨停数+涨停股票',\n+    'get_sector_strength': '单板块实时强度',\n+    'get_multiple_sectors_strength': '多板块批量强度',\n+    'get_sector_strength_history': '板块历史强度数据',\n+    'get_realtime_market_mood': '实时市场情绪：涨跌停家数',\n+    'get_realtime_actual_limit_up_down': '实时实际涨跌停数',\n+    'get_realtime_board_stocks': '实时涨停股：涨停原因/封单/主力/概念',\n+    'get_realtime_all_boards_stocks': '全部连板股（一板~五板）',\n+    'get_board_stocks_count_and_list': '涨停股数量及列表',\n+    'get_realtime_index_trend': '实时指数趋势（涨停指数等）',\n+    'get_realtime_index_list': '实时主要指数列表',\n+    'get_realtime_sharp_withdrawal': '实时大幅回撤股',\n+    'get_realtime_rise_fall_analysis': '涨跌分析：涨停/跌停/炸板/破板数',\n+    'get_sector_intraday': '板块分时数据',\n+    'get_sector_volume_turnover': '板块成交量/成交额',\n+    'get_stock_intraday': '个股分时数据',\n+    'get_stock_big_order_intraday': '个股大单分时数据',\n+    'get_index_intraday': '指数分时数据',\n+    'get_plate_news': '板块要闻',\n+    'get_longhubang_stock_list': '龙虎榜上榜个股列表',\n+    'get_longhubang_stock_detail': '龙虎榜个股详情',\n+    'get_longhubang_dataframe': '龙虎榜完整数据表',\n+    'get_sector_constituent_stocks': '板块成分股列表',\n+    'get_sector_all_stocks': '板块全部股票（含核心股）',\n+    'get_sector_bidding_anomaly': '竞价异常股',\n+    'get_etf_ranking': 'ETF排名',\n+    'get_all_etf_ranking': '全部ETF排名',\n+    'get_stock_call_auction_tick': '个股竞价Tick数据',\n+}\n+\n+for cat_name, cat_results in categories.items():\n+    cat_success = len([r for r in cat_results if r['status'] == 'success'])\n+    cat_total = len(cat_results)\n+    html_parts.append(f'<div class=\"cat-section\">')\n+    html_parts.append(f'<div class=\"cat-title\">{html.escape(cat_name)} ({cat_success}/{cat_total})</div>')\n+\n+    for r in cat_results:\n+        color = status_colors.get(r['status'], '#64748b')\n+        icon = status_icons.get(r['status'], '?')\n+        label = status_labels.get(r['status'], r['status'])\n+\n+        count_text = f'{r[\"data_count\"]}条数据' if r['data_count'] > 0 else ''\n+        desc = api_descriptions.get(r['api_name'], '')\n+\n+        html_parts.append(f'''\n+<div class=\"api-card\">\n+<div class=\"api-header\">\n+<span class=\"api-status\" style=\"background: {color}22; color: {color};\">{icon} {label}</span>\n+<span class=\"api-name\">{html.escape(r['api_name'])}</span>\n+<span class=\"api-params\">{html.escape(r['params'])}</span>\n+<span class=\"api-count\">{count_text}</span>\n+</div>\n+<div class=\"api-desc\">{html.escape(desc)}</div>\n+''')\n+\n+        if r.get('error_msg'):\n+            html_parts.append(f'<div class=\"api-error\">错误: {html.escape(r[\"error_msg\"])}</div>')\n+\n+        # 解析并渲染数据表格\n+        parsed = parse_sample(r.get('data_sample', ''))\n+        if parsed:\n+            html_parts.append(render_table(parsed))\n+        elif r['status'] == 'success':\n+            html_parts.append('<div class=\"no-data\">接口返回成功，但无结构化数据样本</div>')\n+        elif r['status'] == 'empty':\n+            html_parts.append('<div class=\"no-data\">无数据返回</div>')\n+\n+        html_parts.append(f'<div class=\"timestamp\">{html.escape(r[\"timestamp\"])}</div>')\n+        html_parts.append('</div>')\n+\n+    html_parts.append('</div>')\n+\n+html_parts.append(f'''\n+<footer>\n+KPL API 全接口验证报告 | 生成时间: {now}<br>\n+Token来源: Charles SSL 抓包 | Token: ea7dc4aae58b4ec8e8d34b4b688995dc | UserID: 7542928\n+</footer>\n+</div>\n+</body>\n+</html>''')\n+\n+output_path = _PROJECT_ROOT / 'output' / f'KPL_API接口验证报告_{time_tag}.html'\n+with open(output_path, 'w', encoding='utf-8') as f:\n+    f.write('\\n'.join(html_parts))\n+\n+print(f\"报告已生成: {output_path}\")\n+print(f\"总接口: {total} | 成功: {len(success_list)} | 空数据: {len(empty_list)} | 失败: {len(error_list)}\")"},{"sha":"c5c4c5ed9b60180b0eeb22c49804c900ab32a73f","filename":"scripts/init_ai_analysis_table.py","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Finit_ai_analysis_table.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Finit_ai_analysis_table.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Finit_ai_analysis_table.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,36 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+初始化 ai_analysis_cache 表\n+用法: python scripts/init_ai_analysis_table.py\n+\"\"\"\n+import sqlite3\n+from pathlib import Path\n+\n+DB_PATH = Path(__file__).parent.parent / 'data' / 'kpl_dashboard.db'\n+\n+def init_ai_analysis_table():\n+    conn = sqlite3.connect(str(DB_PATH))\n+    conn.executescript(\"\"\"\n+    CREATE TABLE IF NOT EXISTS ai_analysis_cache (\n+        id INTEGER PRIMARY KEY AUTOINCREMENT,\n+        chart_id TEXT NOT NULL,\n+        chart_title TEXT NOT NULL,\n+        analysis_date TEXT NOT NULL,\n+        data_hash TEXT,\n+        analysis_text TEXT,\n+        summary TEXT,\n+        confidence REAL DEFAULT 0,\n+        agent_name TEXT,\n+        analysis_mode TEXT,\n+        created_at TEXT NOT NULL,\n+        updated_at TEXT,\n+        UNIQUE(chart_id, analysis_date, data_hash)\n+    );\n+    CREATE INDEX IF NOT EXISTS idx_ai_cache_chart_date ON ai_analysis_cache(chart_id, analysis_date);\n+    \"\"\")\n+    conn.commit()\n+    conn.close()\n+    print(\"ai_analysis_cache 表创建成功\")\n+\n+if __name__ == '__main__':\n+    init_ai_analysis_table()"},{"sha":"c4d0d3b1f1f37b6765dd45c7b1889d8ab2cb8a7e","filename":"scripts/kpl_common.py","status":"added","additions":1048,"deletions":0,"changes":1048,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fkpl_common.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fkpl_common.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fkpl_common.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,1048 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL数据看板 - 共享工具模块\n+提供数据库初始化、API调用、板块列表管理等公共函数\n+\"\"\"\n+import sys\n+from pathlib import Path\n+import sqlite3\n+import requests\n+import uuid\n+import time\n+import random\n+import pandas as pd\n+import warnings\n+from datetime import datetime, timedelta\n+from concurrent.futures import ThreadPoolExecutor, as_completed\n+warnings.filterwarnings('ignore')\n+\n+_SCRIPT_DIR = Path(__file__).parent.resolve()\n+_PROJECT_ROOT = _SCRIPT_DIR.parent\n+sys.path.insert(0, str(_PROJECT_ROOT / 'lib'))\n+\n+from kaipanla_crawler import KaipanlaCrawler\n+\n+DB_PATH = _PROJECT_ROOT / 'data' / 'kpl_dashboard.db'\n+KPL_FILE = Path(r'<YOUR_HOME>\\.trae-cn\\attachments\\6a4aff607bc6d9ac89e12170\\bc2b5462-4380-4706-aa8b-27f4e6514b06_开盘啦4月22日板块分类20260706.xlsx')\n+HEADERS = {'User-Agent': 'Mozilla/5.0', 'Referer': 'https://quote.eastmoney.com/'}\n+\n+KPL_API_URL = \"https://apphis.longhuvip.com/w1/api/index.php\"\n+KPL_HEADERS = {\n+    \"Content-Type\": \"application/x-www-form-urlencoded; charset=UTF-8\",\n+    \"User-Agent\": \"Dalvik/2.1.0 (Linux; U; Android 9; 23116PN5BC Build/PQ3A.190605.01141736)\",\n+    \"Host\": \"apphis.longhuvip.com\",\n+    \"Connection\": \"Keep-Alive\",\n+    \"Accept-Encoding\": \"gzip\",\n+}\n+\n+\n+def init_db():\n+    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n+    conn = sqlite3.connect(DB_PATH)\n+    conn.executescript(\"\"\"\n+    CREATE TABLE IF NOT EXISTS sector_list (\n+        sector_code TEXT, sector_name TEXT, kpl_strength REAL,\n+        source TEXT DEFAULT 'excel',\n+        PRIMARY KEY (sector_code, sector_name)\n+    );\n+    CREATE TABLE IF NOT EXISTS sector_strength (\n+        date TEXT, sector_code TEXT, sector_name TEXT, strength REAL,\n+        PRIMARY KEY (date, sector_code)\n+    );\n+    CREATE TABLE IF NOT EXISTS new_high (\n+        date TEXT PRIMARY KEY,\n+        total_high INTEGER,\n+        daily_new INTEGER\n+    );\n+    CREATE TABLE IF NOT EXISTS sector_new_high (\n+        date TEXT, sector_code TEXT, sector_name TEXT,\n+        total_high INTEGER, daily_new INTEGER,\n+        PRIMARY KEY (date, sector_code)\n+    );\n+    CREATE TABLE IF NOT EXISTS hs300_kline (\n+        date TEXT PRIMARY KEY, open REAL, close REAL, high REAL, low REAL,\n+        volume REAL, pct_chg REAL\n+    );\n+    CREATE TABLE IF NOT EXISTS backfill_log (\n+        date TEXT, success INTEGER, fail INTEGER, duration REAL, timestamp TEXT\n+    );\n+    CREATE TABLE IF NOT EXISTS ai_analysis_cache (\n+        id INTEGER PRIMARY KEY AUTOINCREMENT,\n+        chart_id TEXT NOT NULL,\n+        chart_title TEXT NOT NULL,\n+        analysis_date TEXT NOT NULL,\n+        data_hash TEXT,\n+        analysis_text TEXT,\n+        summary TEXT,\n+        confidence REAL DEFAULT 0,\n+        agent_name TEXT,\n+        analysis_mode TEXT,\n+        created_at TEXT NOT NULL,\n+        updated_at TEXT,\n+        UNIQUE(chart_id, analysis_date, data_hash)\n+    );\n+    CREATE INDEX IF NOT EXISTS idx_ai_cache_chart_date ON ai_analysis_cache(chart_id, analysis_date);\n+    \"\"\")\n+    conn.commit()\n+    return conn\n+\n+\n+def load_sector_list(conn):\n+    \"\"\"加载板块列表(Excel + 数据库中的动态板块)\"\"\"\n+    sectors = {}\n+    codes = set()\n+\n+    # 1. 从Excel加载\n+    if KPL_FILE.exists():\n+        df = pd.read_excel(KPL_FILE, sheet_name='Sheet1')\n+        for _, row in df.iterrows():\n+            code = str(row['板块代码'])\n+            name = row['板块名称']\n+            conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\",\n+                         (code, name, float(row['强度']), 'excel'))\n+            codes.add(code)\n+            if code not in sectors:\n+                sectors[code] = name\n+        conn.commit()\n+    else:\n+        print(\"  [警告] Excel板块列表文件不存在, 仅使用数据库中的板块\")\n+\n+    # 2. 补充数据库中的动态板块(非Excel来源)\n+    db_sectors = conn.execute(\"SELECT sector_code, sector_name FROM sector_list WHERE source != 'excel'\").fetchall()\n+    for code, name in db_sectors:\n+        if code not in sectors:\n+            sectors[code] = name\n+            codes.add(code)\n+\n+    return sectors, codes\n+\n+\n+def get_all_sectors(conn):\n+    \"\"\"获取所有板块(去重)\"\"\"\n+    rows = conn.execute(\"SELECT sector_code, sector_name FROM sector_list\").fetchall()\n+    seen = {}\n+    for code, name in rows:\n+        if code not in seen:\n+            seen[code] = name\n+    return list(seen.items())\n+\n+\n+def get_existing_dates(conn, table):\n+    try:\n+        return set(r[0] for r in conn.execute(f\"SELECT DISTINCT date FROM {table}\").fetchall())\n+    except:\n+        return set()\n+\n+\n+def get_all_trading_days(start='2026-01-01', end=None):\n+    \"\"\"获取指定范围内的交易日(排除周末)\"\"\"\n+    from datetime import datetime, timedelta\n+    days = []\n+    current = datetime.strptime(start, '%Y-%m-%d')\n+    end_dt = datetime.strptime(end, '%Y-%m-%d') if end else datetime.now()\n+    while current <= end_dt:\n+        if current.weekday() < 5:\n+            days.append(current.strftime('%Y-%m-%d'))\n+        current += timedelta(days=1)\n+    return days\n+\n+\n+def _fetch_hs300_eastmoney(start_date, end_date):\n+    \"\"\"东方财富API获取沪深300\"\"\"\n+    url = \"http://48.push2his.eastmoney.com/api/qt/stock/kline/get\"\n+    params = {\n+        \"secid\": \"1.000300\",\n+        \"fields1\": \"f1,f2,f3,f4,f5,f6\",\n+        \"fields2\": \"f51,f52,f53,f54,f55,f56,f57\",\n+        \"klt\": \"101\", \"fqt\": \"0\",\n+        \"beg\": start_date.replace(\"-\", \"\"),\n+        \"end\": end_date.replace(\"-\", \"\"),\n+    }\n+    r = requests.get(url, params=params, headers=HEADERS, timeout=15)\n+    data = r.json()\n+    klines = data.get(\"data\", {}).get(\"klines\", [])\n+    result = []\n+    for k in klines:\n+        row = k.split(',')\n+        result.append((row[0], float(row[1]), float(row[2]), float(row[3]),\n+                      float(row[4]), float(row[5]), float(row[6]) if len(row) > 6 else 0))\n+    return result\n+\n+\n+def _fetch_hs300_sina(datalen=400):\n+    \"\"\"新浪API获取沪深300日K线 (最多返回datalen条)\"\"\"\n+    url = \"https://quotes.sina.cn/cn/api/json_v2.php/CN_MarketDataService.getKLineData\"\n+    params = {\"symbol\": \"sh000300\", \"scale\": \"240\", \"ma\": \"no\", \"datalen\": str(datalen)}\n+    r = requests.get(url, params=params, headers={\"User-Agent\": \"Mozilla/5.0\"}, timeout=15)\n+    data = r.json()\n+    result = []\n+    for item in data:\n+        result.append((\n+            item[\"day\"],\n+            float(item[\"open\"]),\n+            float(item[\"close\"]),\n+            float(item[\"high\"]),\n+            float(item[\"low\"]),\n+            float(item[\"volume\"]),\n+            0.0,\n+        ))\n+    return result\n+\n+\n+def _fetch_hs300_tencent(datalen=400):\n+    \"\"\"腾讯API获取沪深300日K线\"\"\"\n+    url = \"https://web.ifzq.gtimg.cn/appstock/app/fqkline/get\"\n+    params = {\"param\": f\"sh000300,day,,,{datalen},qfq\"}\n+    r = requests.get(url, params=params, headers={\"User-Agent\": \"Mozilla/5.0\"}, timeout=15)\n+    data = r.json()\n+    day_data = data.get(\"data\", {}).get(\"sh000300\", {}).get(\"day\", [])\n+    if not day_data:\n+        day_data = data.get(\"data\", {}).get(\"sh000300\", {}).get(\"qfqday\", [])\n+    result = []\n+    for row in day_data:\n+        result.append((\n+            row[0], float(row[1]), float(row[2]), float(row[3]),\n+            float(row[4]), float(row[5]), 0.0,\n+        ))\n+    return result\n+\n+\n+def fetch_hs300_kline(start_date, end_date, retries=3):\n+    \"\"\"获取沪深300日K线 (多源回退: 东财→新浪→腾讯, 确保可靠性)\"\"\"\n+    start_compact = start_date.replace(\"-\", \"\")\n+    end_compact = end_date.replace(\"-\", \"\")\n+\n+    # 源1: 东方财富 (带重试)\n+    for attempt in range(retries):\n+        try:\n+            result = _fetch_hs300_eastmoney(start_date, end_date)\n+            if result:\n+                return result\n+            break\n+        except Exception as e:\n+            if attempt < retries - 1:\n+                wait = (attempt + 1) * 3\n+                print(f\"    沪深300东财失败(第{attempt+1}次), {wait}秒后重试: {str(e)[:50]}\")\n+                time.sleep(wait)\n+            else:\n+                print(f\"    沪深300东财失败, 切换备选源: {str(e)[:60]}\")\n+\n+    # 源2: 新浪\n+    try:\n+        print(\"    尝试新浪API...\")\n+        result = _fetch_hs300_sina(datalen=400)\n+        filtered = [r for r in result if start_compact <= r[0].replace(\"-\", \"\") <= end_compact]\n+        if filtered:\n+            print(f\"    新浪API成功: {len(filtered)}条\")\n+            return filtered\n+    except Exception as e:\n+        print(f\"    新浪API失败: {str(e)[:60]}\")\n+\n+    # 源3: 腾讯\n+    try:\n+        print(\"    尝试腾讯API...\")\n+        result = _fetch_hs300_tencent(datalen=400)\n+        filtered = [r for r in result if start_compact <= r[0].replace(\"-\", \"\") <= end_compact]\n+        if filtered:\n+            print(f\"    腾讯API成功: {len(filtered)}条\")\n+            return filtered\n+    except Exception as e:\n+        print(f\"    腾讯API失败: {str(e)[:60]}\")\n+\n+    print(\"    所有数据源均失败!\")\n+    return []\n+\n+\n+def fetch_hs300_realtime():\n+    \"\"\"获取沪深300实时行情(盘中可用)\n+    返回: (date, open, close, high, low, volume, pct_chg) 或 None\n+    \"\"\"\n+    today = datetime.now().strftime('%Y-%m-%d')\n+    # 新浪实时行情\n+    try:\n+        url = \"https://hq.sinajs.cn/list=sh000300\"\n+        r = requests.get(url, headers={\"Referer\": \"https://finance.sina.com.cn\", \"User-Agent\": \"Mozilla/5.0\"}, timeout=10)\n+        r.encoding = 'gbk'\n+        parts = r.text.split(',')\n+        if len(parts) >= 6:\n+            open_price = float(parts[1]) if parts[1] else 0\n+            close_price = float(parts[3]) if parts[3] else 0\n+            high = float(parts[4]) if parts[4] else 0\n+            low = float(parts[5]) if parts[5] else 0\n+            volume = float(parts[8]) if len(parts) > 8 and parts[8] else 0\n+            yesterday = float(parts[2]) if parts[2] else 0\n+            pct_chg = ((close_price - yesterday) / yesterday * 100) if yesterday else 0\n+            if close_price > 0:\n+                return (today, open_price, close_price, high, low, volume, pct_chg)\n+    except Exception as e:\n+        print(f\"    新浪实时HS300失败: {str(e)[:50]}\")\n+\n+    # 腾讯实时行情\n+    try:\n+        url = \"https://qt.gtimg.cn/q=sh000300\"\n+        r = requests.get(url, headers={\"User-Agent\": \"Mozilla/5.0\"}, timeout=10)\n+        text = r.text.strip()\n+        parts = text.split('~')\n+        if len(parts) >= 35:\n+            close_price = float(parts[3]) if parts[3] else 0\n+            open_price = float(parts[5]) if parts[5] else 0\n+            high = float(parts[33]) if parts[33] else 0\n+            low = float(parts[34]) if parts[34] else 0\n+            yesterday = float(parts[4]) if parts[4] else 0\n+            volume = float(parts[6]) if parts[6] else 0\n+            pct_chg = float(parts[32]) if parts[32] else 0\n+            if close_price > 0:\n+                return (today, open_price, close_price, high, low, volume, pct_chg)\n+    except Exception as e:\n+        print(f\"    腾讯实时HS300失败: {str(e)[:50]}\")\n+\n+    return None\n+\n+\n+def fetch_market_new_high():\n+    \"\"\"获取全市场百日新高 (1次API返回360天历史)\"\"\"\n+    data = {\n+        \"a\": \"GetDayNewHigh_W28\", \"st\": \"360\", \"c\": \"StockNewHigh\",\n+        \"PhoneOSNew\": \"1\", \"DeviceID\": str(uuid.uuid4()),\n+        \"VerSion\": \"5.21.0.2\", \"Index\": \"0\",\n+        \"GroupID\": \"ALL\", \"apiv\": \"w42\", \"Type\": \"0_0_0_0_0\"\n+    }\n+    r = requests.post(KPL_API_URL, data=data, headers=KPL_HEADERS, verify=False,\n+                      proxies={'http': None, 'https': None}, timeout=60)\n+    result = r.json()\n+    x_data = result.get(\"x\", [])\n+    records = []\n+    for item in x_data:\n+        parts = item.split(\"_\")\n+        if len(parts) >= 3:\n+            date_str = parts[0]\n+            total_high = int(parts[1])\n+            daily_new = int(parts[2])\n+            formatted = f\"{date_str[:4]}-{date_str[4:6]}-{date_str[6:8]}\"\n+            records.append((formatted, total_high, daily_new))\n+    return records\n+\n+\n+def fetch_sector_new_high(args):\n+    \"\"\"获取单个板块百日新高 (1次API返回360天历史)\"\"\"\n+    sector_code, sector_name = args\n+    try:\n+        data = {\n+            \"a\": \"GetDayNewHigh_W28\", \"st\": \"360\", \"c\": \"StockNewHigh\",\n+            \"PhoneOSNew\": \"1\", \"DeviceID\": str(uuid.uuid4()),\n+            \"VerSion\": \"5.21.0.2\", \"Index\": \"0\",\n+            \"GroupID\": sector_code, \"apiv\": \"w42\", \"Type\": \"0_0_0_0_0\"\n+        }\n+        r = requests.post(KPL_API_URL, data=data, headers=KPL_HEADERS, verify=False,\n+                          proxies={'http': None, 'https': None}, timeout=60)\n+        result = r.json()\n+        x_data = result.get(\"x\", [])\n+        records = []\n+        for item in x_data:\n+            parts = item.split(\"_\")\n+            if len(parts) >= 3:\n+                date_str = parts[0]\n+                total_high = int(parts[1])\n+                daily_new = int(parts[2])\n+                formatted = f\"{date_str[:4]}-{date_str[4:6]}-{date_str[6:8]}\"\n+                records.append((formatted, sector_code, sector_name, total_high, daily_new))\n+        return records\n+    except:\n+        return []\n+\n+\n+def fetch_one_sector_strength(args):\n+    \"\"\"获取单个板块单日强度\"\"\"\n+    sector_code, sector_name, date = args\n+    try:\n+        crawler = KaipanlaCrawler()\n+        result = crawler.get_sector_strength(sector_code, date)\n+        if result.get('success'):\n+            return (date, sector_code, sector_name, float(result['strength']))\n+        else:\n+            return (date, sector_code, sector_name, 0.0)\n+    except:\n+        return (date, sector_code, sector_name, 0.0)\n+\n+\n+def fetch_one_sector_strength_slow(args, min_delay=2.0, max_delay=8.0):\n+    \"\"\"获取单个板块单日强度 (带随机延迟, 模拟真人)\"\"\"\n+    sector_code, sector_name, date = args\n+    try:\n+        crawler = KaipanlaCrawler()\n+        result = crawler.get_sector_strength(sector_code, date)\n+        time.sleep(random.uniform(min_delay, max_delay))\n+        if result.get('success'):\n+            return (date, sector_code, sector_name, float(result['strength']))\n+        else:\n+            return (date, sector_code, sector_name, 0.0)\n+    except:\n+        return (date, sector_code, sector_name, 0.0)\n+\n+\n+def discover_extra_sectors(crawler, trading_dates, existing_codes):\n+    \"\"\"通过get_sector_ranking发现Excel中没有的板块\"\"\"\n+    extra_sectors = {}\n+    skipped = set()\n+    for date in trading_dates:\n+        try:\n+            ranking = crawler.get_sector_ranking(date=date)\n+            if isinstance(ranking, dict) and 'sectors' in ranking:\n+                for sec in ranking['sectors']:\n+                    code = str(sec.get('sector_code', ''))\n+                    name = sec.get('sector_name', '')\n+                    if not code or code == '0' or code == 'None':\n+                        skipped.add(code)\n+                        continue\n+                    if code not in existing_codes and code not in extra_sectors and code not in skipped:\n+                        extra_sectors[code] = name\n+                        print(f\"    发现额外板块: {name}({code}) [来源: {date}]\")\n+        except:\n+            pass\n+        time.sleep(0.15)\n+    return extra_sectors\n+\n+\n+def download_strength_batch(conn, sectors, dates, max_workers=8, slow_mode=False, min_delay=2.0, max_delay=8.0):\n+    \"\"\"批量下载板块强度数据\n+    slow_mode=False: 多线程快速模式(适合当日数据)\n+    slow_mode=True: 单线程+随机延迟(蚂蚁搬家, 适合历史补全)\n+    \"\"\"\n+    tasks = [(code, name, date) for date in dates for code, name in sectors]\n+    success = 0\n+    fail = 0\n+\n+    if slow_mode:\n+        # 蚂蚁搬家模式: 单线程 + 随机延迟\n+        for i, task in enumerate(tasks):\n+            result = fetch_one_sector_strength_slow(task, min_delay, max_delay)\n+            if result:\n+                conn.execute(\"INSERT OR REPLACE INTO sector_strength VALUES(?,?,?,?)\", result)\n+                success += 1\n+            else:\n+                fail += 1\n+            if (i + 1) % 10 == 0:\n+                conn.commit()\n+            if (i + 1) % 50 == 0:\n+                print(f\"    进度: {i+1}/{len(tasks)} ({success}成功)\")\n+    else:\n+        # 快速模式: 多线程\n+        with ThreadPoolExecutor(max_workers=max_workers) as executor:\n+            futures = {executor.submit(fetch_one_sector_strength, task): task for task in tasks}\n+            for i, future in enumerate(as_completed(futures)):\n+                result = future.result()\n+                if result:\n+                    conn.execute(\"INSERT OR REPLACE INTO sector_strength VALUES(?,?,?,?)\", result)\n+                    success += 1\n+                else:\n+                    fail += 1\n+                if (i + 1) % 200 == 0:\n+                    conn.commit()\n+                    speed = success / (time.time() or 1)\n+                    print(f\"    进度: {i+1}/{len(tasks)}\")\n+\n+    conn.commit()\n+    return success, fail\n+\n+\n+def download_sector_new_high_batch(conn, sectors, max_workers=8):\n+    \"\"\"批量下载板块百日新高(每板块1次API返回全量历史)\"\"\"\n+    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n+        futures = {executor.submit(fetch_sector_new_high, task): task for task in sectors}\n+        success = 0\n+        total = 0\n+        for i, future in enumerate(as_completed(futures)):\n+            records = future.result()\n+            if records:\n+                conn.executemany(\"INSERT OR REPLACE INTO sector_new_high VALUES(?,?,?,?,?)\", records)\n+                success += 1\n+                total += len(records)\n+            if (i + 1) % 50 == 0:\n+                conn.commit()\n+                print(f\"    进度: {i+1}/{len(sectors)}\")\n+    conn.commit()\n+    return success, total\n+\n+\n+def log_action(conn, action, date, success, fail, duration):\n+    \"\"\"记录操作日志\"\"\"\n+    conn.execute(\"\"\"\n+    CREATE TABLE IF NOT EXISTS backfill_log (\n+        date TEXT, success INTEGER, fail INTEGER, duration REAL, timestamp TEXT\n+    )\n+    \"\"\")\n+    conn.execute(\"INSERT INTO backfill_log VALUES(?,?,?,?,?)\",\n+                 (date, success, fail, duration, time.strftime('%Y-%m-%d %H:%M:%S')))\n+    conn.commit()\n+\n+\n+def print_db_stats(conn):\n+    \"\"\"打印数据库统计\"\"\"\n+    sl = conn.execute(\"SELECT COUNT(*) FROM sector_list\").fetchone()[0]\n+    ss = conn.execute(\"SELECT COUNT(*) FROM sector_strength\").fetchone()[0]\n+    sd = conn.execute(\"SELECT COUNT(DISTINCT date) FROM sector_strength\").fetchone()[0]\n+    nh = conn.execute(\"SELECT COUNT(*) FROM new_high\").fetchone()[0]\n+    snh = conn.execute(\"SELECT COUNT(*) FROM sector_new_high\").fetchone()[0]\n+    hs = conn.execute(\"SELECT COUNT(*) FROM hs300_kline\").fetchone()[0]\n+    print(f\"  板块列表: {sl} | 板块强度: {ss}条({sd}天) | 新高: {nh}天 | 板块新高: {snh}条 | 沪深300: {hs}条\")\n+\n+\n+# ===== 情绪分析数据采集 =====\n+\n+def init_emotion_tables(conn):\n+    \"\"\"创建情绪分析相关表\"\"\"\n+    conn.executescript(\"\"\"\n+    CREATE TABLE IF NOT EXISTS market_sentiment (\n+        date TEXT PRIMARY KEY,\n+        limit_up INTEGER, actual_limit_up INTEGER,\n+        limit_down INTEGER, actual_limit_down INTEGER,\n+        rise_count INTEGER, fall_count INTEGER, flat_count INTEGER,\n+        blown_limit_up INTEGER, blown_rate REAL,\n+        premium REAL\n+    );\n+    CREATE TABLE IF NOT EXISTS sector_sentiment (\n+        date TEXT, sector_code TEXT, sector_name TEXT,\n+        limit_up_count INTEGER, limit_down_count INTEGER,\n+        PRIMARY KEY (date, sector_code)\n+    );\n+    CREATE TABLE IF NOT EXISTS sector_stock_mapping (\n+        sector_code TEXT, sector_name TEXT,\n+        stock_code TEXT, stock_name TEXT,\n+        first_seen TEXT, last_seen TEXT,\n+        limit_up_count INTEGER DEFAULT 1,\n+        max_consecutive INTEGER DEFAULT 1,\n+        last_consecutive INTEGER DEFAULT 1,\n+        limit_up_reason TEXT,\n+        concepts TEXT,\n+        seal_amount REAL DEFAULT 0,\n+        main_net_inflow REAL DEFAULT 0,\n+        circulating_mv REAL DEFAULT 0,\n+        total_mv REAL DEFAULT 0,\n+        limit_up_price REAL DEFAULT 0,\n+        change_pct REAL DEFAULT 0,\n+        PRIMARY KEY (sector_code, stock_code)\n+    );\n+    CREATE TABLE IF NOT EXISTS ladder_data (\n+        date TEXT PRIMARY KEY,\n+        first_board INTEGER DEFAULT 0,\n+        second_board INTEGER DEFAULT 0,\n+        third_board INTEGER DEFAULT 0,\n+        high_board INTEGER DEFAULT 0,\n+        consecutive_rate REAL DEFAULT 0,\n+        one_word_board INTEGER DEFAULT 0,\n+        limit_up_count INTEGER DEFAULT 0\n+    );\n+    \"\"\")\n+    # 兼容旧表: 补充新增列(如果表已存在但没有这些列)\n+    for col, typ in [('seal_amount', 'REAL'), ('main_net_inflow', 'REAL'),\n+                      ('circulating_mv', 'REAL'), ('total_mv', 'REAL'),\n+                      ('limit_up_price', 'REAL'), ('change_pct', 'REAL'),\n+                      ('first_limit_time', 'TEXT')]:\n+        try:\n+            conn.execute(f\"ALTER TABLE sector_stock_mapping ADD COLUMN {col} {typ} DEFAULT 0\")\n+        except:\n+            pass\n+    # ladder_data 表新增 max_consecutive 列\n+    try:\n+        conn.execute(\"ALTER TABLE ladder_data ADD COLUMN max_consecutive INTEGER DEFAULT 0\")\n+    except:\n+        pass\n+\n+    # 涨停个股历史明细表(按日期存储, 含封板时间)\n+    conn.execute(\"\"\"\n+        CREATE TABLE IF NOT EXISTS stock_mapping_history (\n+            date TEXT, sector_code TEXT, sector_name TEXT,\n+            stock_code TEXT, stock_name TEXT,\n+            consecutive INTEGER DEFAULT 1,\n+            limit_up_reason TEXT,\n+            concepts TEXT,\n+            seal_amount REAL DEFAULT 0,\n+            main_net_inflow REAL DEFAULT 0,\n+            circulating_mv REAL DEFAULT 0,\n+            total_mv REAL DEFAULT 0,\n+            limit_up_price REAL DEFAULT 0,\n+            change_pct REAL DEFAULT 0,\n+            first_limit_time TEXT,\n+            last_limit_time TEXT,\n+            PRIMARY KEY (date, sector_code, stock_code)\n+        )\n+    \"\"\")\n+    conn.commit()\n+\n+\n+def fetch_one_sector_strength_realtime(args):\n+    \"\"\"获取单个板块实时强度(盘中, 不传date走实时端点)\"\"\"\n+    sector_code, sector_name = args\n+    try:\n+        crawler = KaipanlaCrawler()\n+        result = crawler.get_sector_strength(sector_code)\n+        if result.get('success'):\n+            return (result.get('date', ''), sector_code, sector_name, float(result['strength']))\n+        return None\n+    except:\n+        return None\n+\n+\n+def download_strength_realtime(conn, sectors, max_workers=3):\n+    \"\"\"批量下载今日盘中实时板块强度(降低并发避免限流)\"\"\"\n+    today = datetime.now().strftime('%Y-%m-%d')\n+    tasks = [(c, n) for c, n in sectors]\n+    success = 0\n+    fail = 0\n+    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n+        futures = {executor.submit(fetch_one_sector_strength_realtime, task): task for task in tasks}\n+        for i, future in enumerate(as_completed(futures)):\n+            result = future.result()\n+            if result:\n+                conn.execute(\"INSERT OR REPLACE INTO sector_strength VALUES(?,?,?,?)\", result)\n+                success += 1\n+            else:\n+                fail += 1\n+            if (i + 1) % 50 == 0:\n+                conn.commit()\n+                print(f\"    进度: {i+1}/{len(tasks)} ({success}成功)\")\n+    conn.commit()\n+    print(f\"    完成: {success}成功, {fail}失败 (共{len(tasks)})\")\n+    return success, fail\n+\n+\n+def fetch_market_sentiment_batch():\n+    \"\"\"获取市场情绪数据(涨跌停+溢价), 一次API返回~10天历史\n+    使用 get_realtime_rise_fall_analysis()\n+    \"\"\"\n+    try:\n+        crawler = KaipanlaCrawler()\n+        result = crawler.get_realtime_rise_fall_analysis()\n+        if not result or not result.get('raw_data'):\n+            return []\n+\n+        records = []\n+        for row in result['raw_data']:\n+            # row格式: [涨停数, 跌停数, 破板数, 炸板数, 炸板率, 昨日涨停今表现, 日期]\n+            if len(row) >= 7:\n+                date_str = str(row[6])\n+                if len(date_str) == 10 and '-' in date_str:\n+                    formatted = date_str\n+                elif len(date_str) == 8:\n+                    formatted = f\"{date_str[:4]}-{date_str[4:6]}-{date_str[6:8]}\"\n+                else:\n+                    continue\n+                records.append((\n+                    formatted,\n+                    int(row[0]),  # limit_up\n+                    int(row[0]),  # actual_limit_up (same)\n+                    int(row[1]),  # limit_down\n+                    int(row[1]),  # actual_limit_down (same)\n+                    0, 0, 0,      # rise/fall/flat - 从其他API获取\n+                    int(row[3]) if len(row) > 3 else 0,  # blown_limit_up (炸板数)\n+                    float(row[4]) if len(row) > 4 else 0,  # blown_rate\n+                    float(row[5]) if len(row) > 5 else 0,  # premium (昨日涨停今表现)\n+                ))\n+        return records\n+    except Exception as e:\n+        print(f\"  获取市场情绪失败: {str(e)[:100]}\")\n+        return []\n+\n+\n+def fetch_market_sentiment_history(dates):\n+    \"\"\"批量获取历史市场情绪(逐日, 使用get_market_sentiment)\n+    dates: 日期列表\n+    \"\"\"\n+    crawler = KaipanlaCrawler()\n+    records = []\n+    for date in dates:\n+        try:\n+            df = crawler.get_market_sentiment(date=date)\n+            if df is not None and len(df) > 0:\n+                row = df.iloc[0].to_dict()\n+                records.append((\n+                    date,\n+                    int(row.get('涨停数', 0)),\n+                    int(row.get('实际涨停', 0)),\n+                    int(row.get('跌停数', 0)),\n+                    int(row.get('实际跌停', 0)),\n+                    int(row.get('上涨家数', 0)),\n+                    int(row.get('下跌家数', 0)),\n+                    int(row.get('平盘家数', 0)),\n+                    0, 0.0, 0.0  # 炸板率和溢价从rise_fall_analysis获取\n+                ))\n+        except:\n+            pass\n+        time.sleep(0.2)\n+    return records\n+\n+\n+def _safe_consecutive(val):\n+    \"\"\"安全转换连板天数为整数, 处理'首板'等字符串\"\"\"\n+    if val is None:\n+        return 1\n+    if isinstance(val, int):\n+        return max(val, 1)\n+    s = str(val).strip()\n+    if not s:\n+        return 1\n+    try:\n+        return max(int(s), 1)\n+    except ValueError:\n+        # '首板' → 1, '二板' → 2, '三板' → 3, etc.\n+        cn_map = {'首板': 1, '二板': 2, '三板': 3, '四板': 4, '五板': 5, '六板': 6, '七板': 7, '八板': 8, '九板': 9}\n+        return cn_map.get(s, 1)\n+\n+\n+def fetch_sector_sentiment(date):\n+    \"\"\"获取某日全部涨停个股 + 板块涨跌停数据\n+    今日: get_realtime_board_stocks (全部涨停股) + get_sector_ranking (板块统计)\n+    历史日期: 仅 get_sector_ranking (返回日期对应的涨停股详情)\n+    返回: (sentiment_records, stock_records)\n+    stock_records格式: 15字段, 末尾为first_limit_time\n+    \"\"\"\n+    crawler = KaipanlaCrawler()\n+    sentiment_records = []\n+    stock_records = []\n+\n+    today = datetime.now().strftime('%Y-%m-%d')\n+    is_today = (date == today)\n+\n+    # === 1. get_sector_ranking: 板块统计 + 涨停股详情(含封板时间/涨停原因/概念) ===\n+    ranking_lookup = {}  # stock_code → stock_info dict\n+    try:\n+        ranking = crawler.get_sector_ranking(date=date)\n+        if isinstance(ranking, dict) and 'sectors' in ranking:\n+            for sec in ranking['sectors']:\n+                code = str(sec.get('sector_code', ''))\n+                name = sec.get('sector_name', '')\n+                if not code or code == '0' or code == 'None':\n+                    continue\n+                stocks = sec.get('stocks', [])\n+                limit_up_count = len(stocks) if stocks else int(sec.get('limit_up_count', 0))\n+                sentiment_records.append((date, code, name, limit_up_count, 0))\n+                for stock in stocks:\n+                    sc = stock.get('股票代码', '')\n+                    if sc:\n+                        ranking_lookup[sc] = {\n+                            'sector_code': code,\n+                            'sector_name': name,\n+                            'stock_name': stock.get('股票名称', ''),\n+                            'reason': stock.get('涨停原因', ''),\n+                            'concepts': stock.get('概念标签', ''),\n+                            'consecutive': _safe_consecutive(stock.get('连板天数', 1)),\n+                            'seal_amount': stock.get('封单额', 0),\n+                            'main_net_inflow': stock.get('主力资金', 0),\n+                            'circulating_mv': stock.get('流通市值', 0),\n+                            'total_mv': stock.get('总市值', 0),\n+                            'limit_up_price': stock.get('涨停价', 0),\n+                            'first_limit_time': stock.get('首次封板时间', ''),\n+                        }\n+            print(f\"  ranking({date}): {len(sentiment_records)}板块, {len(ranking_lookup)}只\")\n+    except Exception as e:\n+        print(f\"  get_sector_ranking失败({date}): {str(e)[:80]}\")\n+\n+    if is_today:\n+        # === 今日: 补充get_realtime_board_stocks获取更完整的涨停股 ===\n+        all_stocks = []\n+        for bt in range(1, 6):\n+            try:\n+                stocks = crawler.get_realtime_board_stocks(board_type=bt)\n+                all_stocks.extend(stocks)\n+                time.sleep(0.2)\n+            except Exception as e:\n+                print(f\"  get_realtime_board_stocks({bt})失败: {str(e)[:60]}\")\n+        print(f\"  board_stocks: {len(all_stocks)}只涨停股\")\n+\n+        # 合并: 以board_stocks为主, 用ranking补充板块信息和封板时间\n+        for s in all_stocks:\n+            sc = s.get('stock_code', '')\n+            sn = s.get('stock_name', '')\n+            if not sc:\n+                continue\n+            reason = s.get('limit_up_reason', '')\n+            concepts = s.get('concepts', '')\n+            consec = _safe_consecutive(s.get('consecutive_days', 1))\n+            first_limit_time = ''\n+\n+            if sc in ranking_lookup:\n+                r = ranking_lookup[sc]\n+                sec_code = r['sector_code']\n+                sec_name = r['sector_name']\n+                if r['reason']:\n+                    reason = r['reason']\n+                if r['concepts']:\n+                    concepts = r['concepts']\n+                first_limit_time = r.get('first_limit_time', '')\n+                if r['stock_name']:\n+                    sn = r['stock_name']\n+            else:\n+                sec_code = s.get('sector_code', '') or 'ALL_LU'\n+                sec_name = reason if reason else '全市场涨停'\n+\n+            if sec_code and sec_code not in [r[1] for r in sentiment_records]:\n+                sentiment_records.append((date, sec_code, sec_name, 0, 0))\n+\n+            stock_records.append((\n+                sec_code, sec_name, sc, sn, date, consec, reason, concepts,\n+                float(s.get('seal_amount', 0) or 0),\n+                float(s.get('main_net_inflow', 0) or 0),\n+                float(s.get('circulating_market_cap', 0) or 0),\n+                float(s.get('total_market_cap', 0) or 0),\n+                float(s.get('limit_up_price', 0) or 0),\n+                float(s.get('change_pct', 0) or 0),\n+                first_limit_time,\n+            ))\n+\n+        # 补充ranking中有但board_stocks中没有的股票\n+        existing_codes = set(s[2] for s in stock_records)\n+        for sc, r in ranking_lookup.items():\n+            if sc not in existing_codes:\n+                stock_records.append((\n+                    r['sector_code'], r['sector_name'], sc, r['stock_name'],\n+                    date, _safe_consecutive(r.get('consecutive', 1)), r['reason'], r['concepts'],\n+                    float(r.get('seal_amount', 0) or 0),\n+                    float(r.get('main_net_inflow', 0) or 0),\n+                    float(r.get('circulating_mv', 0) or 0),\n+                    float(r.get('total_mv', 0) or 0),\n+                    float(r.get('limit_up_price', 0) or 0),\n+                    0,\n+                    r.get('first_limit_time', ''),\n+                ))\n+    else:\n+        # === 历史日期: 仅使用get_sector_ranking的数据 ===\n+        for sc, r in ranking_lookup.items():\n+            stock_records.append((\n+                r['sector_code'], r['sector_name'], sc, r['stock_name'],\n+                date, _safe_consecutive(r.get('consecutive', 1)), r['reason'], r['concepts'],\n+                float(r.get('seal_amount', 0) or 0),\n+                float(r.get('main_net_inflow', 0) or 0),\n+                float(r.get('circulating_mv', 0) or 0),\n+                float(r.get('total_mv', 0) or 0),\n+                float(r.get('limit_up_price', 0) or 0),\n+                0,\n+                r.get('first_limit_time', ''),\n+            ))\n+\n+    return sentiment_records, stock_records\n+\n+\n+def update_sector_stock_mapping(conn, stock_records):\n+    \"\"\"更新板块-个股映射表(增量累积, 同日不重复计数, 实时字段每日覆盖)\"\"\"\n+    for rec in stock_records:\n+        # 兼容14字段(旧)和15字段(新, 含first_limit_time)格式\n+        if len(rec) >= 15:\n+            (sector_code, sector_name, stock_code, stock_name, date, consecutive,\n+             limit_up_reason, concepts, seal_amount, main_net_inflow,\n+             circulating_mv, total_mv, limit_up_price, change_pct, first_limit_time) = rec[:15]\n+        elif len(rec) == 14:\n+            (sector_code, sector_name, stock_code, stock_name, date, consecutive,\n+             limit_up_reason, concepts, seal_amount, main_net_inflow,\n+             circulating_mv, total_mv, limit_up_price, change_pct) = rec\n+            first_limit_time = ''\n+        else:\n+            sector_code, sector_name, stock_code, stock_name, date, consecutive, limit_up_reason, concepts = rec\n+            seal_amount = main_net_inflow = circulating_mv = total_mv = limit_up_price = change_pct = 0\n+            first_limit_time = ''\n+\n+        existing = conn.execute(\n+            \"SELECT first_seen, limit_up_count, max_consecutive, last_seen FROM sector_stock_mapping WHERE sector_code=? AND stock_code=?\",\n+            (sector_code, stock_code)\n+        ).fetchone()\n+        if existing:\n+            first_seen, old_count, old_max, last_seen = existing\n+            # 同日不重复计数\n+            new_count = old_count if last_seen == date else old_count + 1\n+            new_max = max(old_max, consecutive)\n+            conn.execute(\n+                \"\"\"UPDATE sector_stock_mapping SET sector_name=?, last_seen=?, limit_up_count=?, \n+                   max_consecutive=?, last_consecutive=?, limit_up_reason=?, concepts=?,\n+                   seal_amount=?, main_net_inflow=?, circulating_mv=?, total_mv=?, \n+                   limit_up_price=?, change_pct=?, first_limit_time=?\n+                   WHERE sector_code=? AND stock_code=?\"\"\",\n+                (sector_name, date, new_count, new_max, consecutive, limit_up_reason, concepts,\n+                 seal_amount, main_net_inflow, circulating_mv, total_mv, limit_up_price, change_pct,\n+                 first_limit_time, sector_code, stock_code)\n+            )\n+        else:\n+            conn.execute(\n+                \"\"\"INSERT INTO sector_stock_mapping \n+                   (sector_code, sector_name, stock_code, stock_name, first_seen, last_seen,\n+                    limit_up_count, max_consecutive, last_consecutive, limit_up_reason, concepts,\n+                    seal_amount, main_net_inflow, circulating_mv, total_mv, limit_up_price, change_pct, first_limit_time)\n+                   VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)\"\"\",\n+                (sector_code, sector_name, stock_code, stock_name, date, date,\n+                 1, consecutive, consecutive, limit_up_reason, concepts,\n+                 seal_amount, main_net_inflow, circulating_mv, total_mv, limit_up_price, change_pct, first_limit_time)\n+            )\n+    conn.commit()\n+\n+\n+def update_stock_mapping_history(conn, stock_records):\n+    \"\"\"写入涨停个股历史明细表(按日期覆盖)\"\"\"\n+    for rec in stock_records:\n+        if len(rec) >= 15:\n+            (sector_code, sector_name, stock_code, stock_name, date, consecutive,\n+             limit_up_reason, concepts, seal_amount, main_net_inflow,\n+             circulating_mv, total_mv, limit_up_price, change_pct, first_limit_time) = rec[:15]\n+        elif len(rec) == 14:\n+            (sector_code, sector_name, stock_code, stock_name, date, consecutive,\n+             limit_up_reason, concepts, seal_amount, main_net_inflow,\n+             circulating_mv, total_mv, limit_up_price, change_pct) = rec\n+            first_limit_time = ''\n+        else:\n+            continue\n+\n+        conn.execute(\"\"\"\n+            INSERT OR REPLACE INTO stock_mapping_history\n+            (date, sector_code, sector_name, stock_code, stock_name, consecutive,\n+             limit_up_reason, concepts, seal_amount, main_net_inflow,\n+             circulating_mv, total_mv, limit_up_price, change_pct, first_limit_time, last_limit_time)\n+            VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)\n+        \"\"\", (date, sector_code, sector_name, stock_code, stock_name, consecutive,\n+              limit_up_reason, concepts, seal_amount, main_net_inflow,\n+              circulating_mv, total_mv, limit_up_price, change_pct, first_limit_time, first_limit_time))\n+    conn.commit()\n+\n+\n+def download_sector_sentiment(conn, dates):\n+    \"\"\"下载板块涨跌停数据 + 板块-个股映射 + 涨停个股历史明细\"\"\"\n+    init_emotion_tables(conn)\n+    total = 0\n+    total_stocks = 0\n+    for date in dates:\n+        sentiment_records, stock_records = fetch_sector_sentiment(date)\n+        if sentiment_records:\n+            conn.executemany(\"INSERT OR REPLACE INTO sector_sentiment VALUES(?,?,?,?,?)\", sentiment_records)\n+            conn.commit()\n+            total += len(sentiment_records)\n+        if stock_records:\n+            update_sector_stock_mapping(conn, stock_records)\n+            update_stock_mapping_history(conn, stock_records)\n+            total_stocks += len(stock_records)\n+        if sentiment_records or stock_records:\n+            print(f\"  {date}: {len(sentiment_records)}板块, {len(stock_records)}条个股映射\")\n+        time.sleep(0.3)\n+    return total, total_stocks\n+\n+\n+def download_market_sentiment(conn):\n+    \"\"\"下载市场情绪数据(涨跌停+溢价)\"\"\"\n+    init_emotion_tables(conn)\n+    # 1. 从rise_fall_analysis获取最近10天数据\n+    records = fetch_market_sentiment_batch()\n+    if records:\n+        conn.executemany(\"INSERT OR REPLACE INTO market_sentiment VALUES(?,?,?,?,?,?,?,?,?,?,?)\", records)\n+        conn.commit()\n+        print(f\"  市场情绪: {len(records)}天 (rise_fall_analysis)\")\n+\n+    # 2. 补充今日实时数据(get_realtime_market_mood)\n+    #    注意: 只UPDATE涨跌家数, 不覆盖炸板率/溢价(来自rise_fall_analysis)\n+    try:\n+        crawler = KaipanlaCrawler()\n+        rt = crawler.get_realtime_market_mood()\n+        if rt:\n+            today = datetime.now().strftime('%Y-%m-%d')\n+            existing = conn.execute(\n+                \"SELECT blown_limit_up, blown_rate, premium FROM market_sentiment WHERE date=?\",\n+                (today,)\n+            ).fetchone()\n+\n+            lu = int(rt.get('涨停家数', 0))\n+            ld = int(rt.get('跌停家数', 0))\n+            rise = int(rt.get('上涨家数', 0))\n+            fall = int(rt.get('下跌家数', 0))\n+\n+            if existing:\n+                # 已有数据(来自rise_fall_analysis), 只更新涨跌家数, 保留炸板率/溢价\n+                conn.execute(\"\"\"UPDATE market_sentiment SET\n+                    limit_up=?, actual_limit_up=?, limit_down=?, actual_limit_down=?,\n+                    rise_count=?, fall_count=?\n+                    WHERE date=?\"\"\",\n+                    (lu, lu, ld, ld, rise, fall, today))\n+            else:\n+                # 无数据, 需要从其他API获取炸板率和溢价\n+                blown_count = 0\n+                blown_rate = 0.0\n+                premium = 0.0\n+                # 从get_historical_broken_limit_up获取今日炸板数\n+                try:\n+                    broken_stocks = crawler.get_historical_broken_limit_up(date=today)\n+                    if broken_stocks:\n+                        blown_count = len(broken_stocks)\n+                        if lu + blown_count > 0:\n+                            blown_rate = round(blown_count / (lu + blown_count) * 100, 2)\n+                except Exception as e2:\n+                    print(f\"  获取炸板数失败: {str(e2)[:60]}\")\n+                # 从get_realtime_index_trend获取昨日涨停今表现(溢价)\n+                try:\n+                    zt_data = crawler.get_realtime_index_trend(stock_id=\"801900\", time=\"15:00\")\n+                    if zt_data:\n+                        premium = round(zt_data.get(\"change_pct\", 0.0), 2)\n+                except Exception as e2:\n+                    print(f\"  获取溢价失败: {str(e2)[:60]}\")\n+\n+                conn.execute(\"\"\"INSERT OR REPLACE INTO market_sentiment \n+                    (date, limit_up, actual_limit_up, limit_down, actual_limit_down, \n+                     rise_count, fall_count, flat_count, blown_limit_up, blown_rate, premium)\n+                    VALUES(?,?,?,?,?,?,?,?,?,?,?)\"\"\",\n+                    (today, lu, lu, ld, ld, rise, fall, 0, blown_count, blown_rate, premium))\n+            conn.commit()\n+            print(f\"  今日实时: 涨停{lu} 跌停{ld} 上涨{rise} 下跌{fall}\")\n+    except Exception as e:\n+        print(f\"  获取今日实时情绪失败: {str(e)[:80]}\")\n+\n+    # 3. 补充涨跌家数(从get_market_sentiment, 仅UPDATE不覆盖已有字段)\n+    need_rise_fall = [r[0] for r in conn.execute(\n+        \"SELECT date FROM market_sentiment WHERE rise_count = 0 AND date < ?\", \n+        (datetime.now().strftime('%Y-%m-%d'),)\n+    ).fetchall()]\n+    if need_rise_fall:\n+        print(f\"  补充涨跌家数: {len(need_rise_fall)}天\")\n+        hist_records = fetch_market_sentiment_history(need_rise_fall[-30:])\n+        for r in hist_records:\n+            conn.execute(\"UPDATE market_sentiment SET rise_count=?, fall_count=?, flat_count=? WHERE date=?\",\n+                         (r[5], r[6], r[7], r[0]))\n+            if conn.total_changes == 0:\n+                conn.execute(\"INSERT OR REPLACE INTO market_sentiment VALUES(?,?,?,?,?,?,?,?,?,?,?)\", r)\n+        conn.commit()\n+        print(f\"  补充完成: {len(hist_records)}天\")\n+\n+    return len(records)\n+\n+\n+def download_ladder_data(conn, dates):\n+    \"\"\"下载连板梯队数据(一板/二板/三板/高度板/连板率/一字板)\"\"\"\n+    crawler = KaipanlaCrawler()\n+    count = 0\n+    for date in dates:\n+        try:\n+            df = crawler.get_limit_up_ladder(date=date)\n+            if df is not None and len(df) > 0:\n+                r = df.iloc[0]\n+                first_board = int(r.get('一板', 0))\n+                second_board = int(r.get('二板', 0))\n+                third_board = int(r.get('三板', 0))\n+                high_board = int(r.get('高度板', 0))\n+                consec_rate = float(r.get('连板率(%)', 0))\n+                \n+                # 一字板 = 涨停数 - 实际涨停 (from get_market_sentiment)\n+                one_word = 0\n+                limit_up = 0\n+                try:\n+                    ms = crawler.get_market_sentiment(date=date)\n+                    if ms is not None and len(ms) > 0:\n+                        limit_up = int(ms.iloc[0].get('涨停数', 0))\n+                        actual_lu = int(ms.iloc[0].get('实际涨停', 0))\n+                        one_word = limit_up - actual_lu\n+                except:\n+                    pass\n+                \n+                conn.execute(\"\"\"INSERT OR REPLACE INTO ladder_data \n+                    (date, first_board, second_board, third_board, high_board, \n+                     consecutive_rate, one_word_board, limit_up_count)\n+                    VALUES (?,?,?,?,?,?,?,?)\"\"\",\n+                    (date, first_board, second_board, third_board, high_board,\n+                     consec_rate, one_word, limit_up))\n+                count += 1\n+        except Exception as e:\n+            print(f\"  ladder_data {date} failed: {str(e)[:60]}\")\n+        time.sleep(0.3)\n+    conn.commit()\n+    print(f\"  ladder_data: {count} days updated\")\n+    return count"},{"sha":"e27d6cb99469cd0aa84b9863348ec89b61dc7464","filename":"scripts/kpl_data_collector.py","status":"added","additions":349,"deletions":0,"changes":349,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fkpl_data_collector.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fkpl_data_collector.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fkpl_data_collector.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,349 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL数据看板 - 数据采集 v7 (3个月数据版)\n+获取2026-04-01到2026-07-06约3个月的交易日数据\n+\"\"\"\n+import sys\n+from pathlib import Path\n+# 自动定位项目lib目录\n+_SCRIPT_DIR = Path(__file__).parent.resolve()\n+_PROJECT_ROOT = _SCRIPT_DIR.parent\n+sys.path.insert(0, str(_PROJECT_ROOT / 'lib'))\n+sys.path.insert(0, r'D:\\trae\\traeworkspace\\kpl')  # 兼容旧路径\n+import sqlite3\n+import time\n+import requests\n+import pandas as pd\n+import uuid\n+from datetime import datetime, timedelta\n+from concurrent.futures import ThreadPoolExecutor, as_completed\n+import warnings\n+warnings.filterwarnings('ignore')\n+from kaipanla_crawler import KaipanlaCrawler\n+\n+DB_PATH = Path(r'd:\\trae\\traeworkspace\\kpl-dashboard\\data\\kpl_dashboard.db')\n+KPL_FILE = Path(r'<YOUR_HOME>\\.trae-cn\\attachments\\6a4aff607bc6d9ac89e12170\\bc2b5462-4380-4706-aa8b-27f4e6514b06_开盘啦4月22日板块分类20260706.xlsx')\n+HEADERS = {'User-Agent': 'Mozilla/5.0', 'Referer': 'https://quote.eastmoney.com/'}\n+START_DATE = '2026-04-01'\n+END_DATE = '2026-07-06'\n+MAX_WORKERS = 8\n+\n+KPL_API_URL = \"https://apphis.longhuvip.com/w1/api/index.php\"\n+KPL_HEADERS = {\n+    \"Content-Type\": \"application/x-www-form-urlencoded; charset=UTF-8\",\n+    \"User-Agent\": \"Dalvik/2.1.0 (Linux; U; Android 9; 23116PN5BC Build/PQ3A.190605.01141736)\",\n+    \"Host\": \"apphis.longhuvip.com\",\n+    \"Connection\": \"Keep-Alive\",\n+    \"Accept-Encoding\": \"gzip\",\n+}\n+\n+\n+def init_db():\n+    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\n+    conn = sqlite3.connect(DB_PATH)\n+    conn.executescript(\"\"\"\n+    CREATE TABLE IF NOT EXISTS sector_list (\n+        sector_code TEXT, sector_name TEXT, kpl_strength REAL,\n+        source TEXT DEFAULT 'excel',\n+        PRIMARY KEY (sector_code, sector_name)\n+    );\n+    CREATE TABLE IF NOT EXISTS sector_strength (\n+        date TEXT, sector_code TEXT, sector_name TEXT, strength REAL,\n+        PRIMARY KEY (date, sector_code)\n+    );\n+    CREATE TABLE IF NOT EXISTS new_high (\n+        date TEXT PRIMARY KEY,\n+        total_high INTEGER,\n+        daily_new INTEGER\n+    );\n+    CREATE TABLE IF NOT EXISTS sector_new_high (\n+        date TEXT, sector_code TEXT, sector_name TEXT,\n+        total_high INTEGER, daily_new INTEGER,\n+        PRIMARY KEY (date, sector_code)\n+    );\n+    CREATE TABLE IF NOT EXISTS hs300_kline (\n+        date TEXT PRIMARY KEY, open REAL, close REAL, high REAL, low REAL,\n+        volume REAL, pct_chg REAL\n+    );\n+    \"\"\")\n+    conn.commit()\n+    return conn\n+\n+\n+def get_trading_dates_in_range(nh_records):\n+    \"\"\"从新高数据中获取指定日期范围内的交易日\"\"\"\n+    dates = sorted([r[0] for r in nh_records])\n+    filtered = [d for d in dates if START_DATE <= d <= END_DATE]\n+    return filtered\n+\n+\n+def fetch_hs300_kline(start_date, end_date):\n+    url = \"http://48.push2his.eastmoney.com/api/qt/stock/kline/get\"\n+    params = {\n+        \"secid\": \"1.000300\",\n+        \"fields1\": \"f1,f2,f3,f4,f5,f6\",\n+        \"fields2\": \"f51,f52,f53,f54,f55,f56,f57\",\n+        \"klt\": \"101\", \"fqt\": \"0\",\n+        \"beg\": start_date.replace(\"-\", \"\"),\n+        \"end\": end_date.replace(\"-\", \"\"),\n+    }\n+    r = requests.get(url, params=params, headers=HEADERS, timeout=15)\n+    data = r.json()\n+    klines = data.get(\"data\", {}).get(\"klines\", [])\n+    result = []\n+    for k in klines:\n+        row = k.split(',')\n+        result.append((row[0], float(row[1]), float(row[2]), float(row[3]),\n+                      float(row[4]), float(row[5]), float(row[6]) if len(row) > 6 else 0))\n+    return result\n+\n+\n+def fetch_market_new_high():\n+    data = {\n+        \"a\": \"GetDayNewHigh_W28\", \"st\": \"360\", \"c\": \"StockNewHigh\",\n+        \"PhoneOSNew\": \"1\", \"DeviceID\": str(uuid.uuid4()),\n+        \"VerSion\": \"5.21.0.2\", \"Index\": \"0\",\n+        \"GroupID\": \"ALL\", \"apiv\": \"w42\", \"Type\": \"0_0_0_0_0\"\n+    }\n+    r = requests.post(KPL_API_URL, data=data, headers=KPL_HEADERS, verify=False,\n+                      proxies={'http': None, 'https': None}, timeout=60)\n+    result = r.json()\n+    x_data = result.get(\"x\", [])\n+    records = []\n+    for item in x_data:\n+        parts = item.split(\"_\")\n+        if len(parts) >= 3:\n+            date_str = parts[0]\n+            total_high = int(parts[1])\n+            daily_new = int(parts[2])\n+            formatted = f\"{date_str[:4]}-{date_str[4:6]}-{date_str[6:8]}\"\n+            records.append((formatted, total_high, daily_new))\n+    return records\n+\n+\n+def fetch_sector_new_high(args):\n+    sector_code, sector_name = args\n+    try:\n+        data = {\n+            \"a\": \"GetDayNewHigh_W28\", \"st\": \"360\", \"c\": \"StockNewHigh\",\n+            \"PhoneOSNew\": \"1\", \"DeviceID\": str(uuid.uuid4()),\n+            \"VerSion\": \"5.21.0.2\", \"Index\": \"0\",\n+            \"GroupID\": sector_code, \"apiv\": \"w42\", \"Type\": \"0_0_0_0_0\"\n+        }\n+        r = requests.post(KPL_API_URL, data=data, headers=KPL_HEADERS, verify=False,\n+                          proxies={'http': None, 'https': None}, timeout=60)\n+        result = r.json()\n+        x_data = result.get(\"x\", [])\n+        records = []\n+        for item in x_data:\n+            parts = item.split(\"_\")\n+            if len(parts) >= 3:\n+                date_str = parts[0]\n+                total_high = int(parts[1])\n+                daily_new = int(parts[2])\n+                formatted = f\"{date_str[:4]}-{date_str[4:6]}-{date_str[6:8]}\"\n+                records.append((formatted, sector_code, sector_name, total_high, daily_new))\n+        return records\n+    except:\n+        return []\n+\n+\n+def fetch_one_sector_strength(args):\n+    sector_code, sector_name, date = args\n+    try:\n+        crawler = KaipanlaCrawler()\n+        result = crawler.get_sector_strength(sector_code, date)\n+        if result.get('success'):\n+            return (date, sector_code, sector_name, float(result['strength']))\n+        else:\n+            return (date, sector_code, sector_name, 0.0)\n+    except:\n+        return (date, sector_code, sector_name, 0.0)\n+\n+\n+def discover_extra_sectors(crawler, trading_dates, existing_codes):\n+    extra_sectors = {}\n+    skipped = set()\n+    for date in trading_dates:\n+        try:\n+            ranking = crawler.get_sector_ranking(date=date)\n+            if isinstance(ranking, dict) and 'sectors' in ranking:\n+                for sec in ranking['sectors']:\n+                    code = str(sec.get('sector_code', ''))\n+                    name = sec.get('sector_name', '')\n+                    if not code or code == '0' or code == 'None':\n+                        if code not in skipped:\n+                            skipped.add(code)\n+                        continue\n+                    if code not in existing_codes and code not in extra_sectors and code not in skipped:\n+                        extra_sectors[code] = name\n+                        print(f\"    发现额外板块: {name}({code}) [来源: {date}]\")\n+        except Exception as e:\n+            pass\n+        time.sleep(0.15)\n+    return extra_sectors\n+\n+\n+def main():\n+    print(f\"{'='*80}\")\n+    print(f\"KPL数据看板 - 数据采集 v7 (3个月数据) | {datetime.now().strftime('%Y-%m-%d %H:%M')}\")\n+    print(f\"日期范围: {START_DATE} ~ {END_DATE}\")\n+    print(f\"{'='*80}\")\n+\n+    conn = init_db()\n+    crawler = KaipanlaCrawler()\n+\n+    # 检查现有数据\n+    existing_strength_dates = set()\n+    try:\n+        rows = conn.execute(\"SELECT DISTINCT date FROM sector_strength\").fetchall()\n+        existing_strength_dates = set(r[0] for r in rows)\n+    except:\n+        pass\n+    total_existing = conn.execute(\"SELECT COUNT(*) FROM sector_strength\").fetchone()[0]\n+    print(f\"\\n[状态] 已有板块强度: {len(existing_strength_dates)}天 ({total_existing}条)\")\n+\n+    # 0. 加载Excel板块列表\n+    print(f\"\\n[0] 加载精选板块列表\")\n+    df_kpl = pd.read_excel(KPL_FILE, sheet_name='Sheet1')\n+    excel_codes = set()\n+    excel_sectors = {}\n+    for _, row in df_kpl.iterrows():\n+        code = str(row['板块代码'])\n+        name = row['板块名称']\n+        conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\",\n+                     (code, name, float(row['强度']), 'excel'))\n+        excel_codes.add(code)\n+        if code not in excel_sectors:\n+            excel_sectors[code] = name\n+    conn.commit()\n+    print(f\"    Excel: {len(df_kpl)} 行, {len(excel_codes)} 个唯一代码\")\n+\n+    # 1. 沪深300 K线\n+    print(f\"\\n[1] 沪深300日K线 ({START_DATE} ~ {END_DATE})\")\n+    hs300 = fetch_hs300_kline(START_DATE, END_DATE)\n+    conn.executemany(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", hs300)\n+    conn.commit()\n+    print(f\"    已保存 {len(hs300)} 条K线\")\n+\n+    # 2. 全市场百日新高\n+    print(f\"\\n[2] 全市场百日新高 (1次API调用)\")\n+    nh_records = fetch_market_new_high()\n+    for date, total, new in nh_records:\n+        conn.execute(\"INSERT OR REPLACE INTO new_high VALUES(?,?,?)\", (date, total, new))\n+    conn.commit()\n+    trading_dates = get_trading_dates_in_range(nh_records)\n+    print(f\"    已保存 {len(nh_records)} 天数据\")\n+    print(f\"    目标交易日({len(trading_dates)}天): {trading_dates[0]} ~ {trading_dates[-1]}\")\n+\n+    # 3. 动态发现额外板块 (检查全部交易日)\n+    print(f\"\\n[3] 动态发现额外板块 (检查全部{len(trading_dates)}个交易日)\")\n+    extra_sectors = discover_extra_sectors(crawler, trading_dates, excel_codes)\n+    if extra_sectors:\n+        for code, name in extra_sectors.items():\n+            conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\",\n+                         (code, name, 0, 'dynamic'))\n+        conn.commit()\n+        print(f\"    发现 {len(extra_sectors)} 个额外板块\")\n+    else:\n+        print(f\"    未发现额外板块\")\n+\n+    all_sectors = dict(excel_sectors)\n+    all_sectors.update(extra_sectors)\n+    print(f\"    总板块数: {len(all_sectors)}\")\n+\n+    # 4. 板块百日新高\n+    existing_snh_codes = set()\n+    try:\n+        existing_snh_codes = set(r[0] for r in conn.execute(\"SELECT DISTINCT sector_code FROM sector_new_high\").fetchall())\n+    except:\n+        pass\n+    missing_snh = [(code, name) for code, name in all_sectors.items() if code not in existing_snh_codes]\n+\n+    if not missing_snh:\n+        print(f\"\\n[4] 板块百日新高: 全部已有, 跳过\")\n+    else:\n+        print(f\"\\n[4] 板块百日新高 ({len(missing_snh)}板块)\")\n+        t_start = time.time()\n+        success_count = 0\n+        total_records = 0\n+        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:\n+            futures = {executor.submit(fetch_sector_new_high, task): task for task in missing_snh}\n+            for i, future in enumerate(as_completed(futures)):\n+                records = future.result()\n+                if records:\n+                    conn.executemany(\"INSERT OR REPLACE INTO sector_new_high VALUES(?,?,?,?,?)\", records)\n+                    success_count += 1\n+                    total_records += len(records)\n+                if (i + 1) % 50 == 0:\n+                    conn.commit()\n+                    print(f\"    进度: {i+1}/{len(missing_snh)}\")\n+        conn.commit()\n+        print(f\"    完成! {success_count}板块, {total_records}条, 耗时{time.time()-t_start:.0f}秒\")\n+\n+    # 5. 板块强度 (增量)\n+    missing_dates = [d for d in trading_dates if d not in existing_strength_dates]\n+\n+    if not missing_dates:\n+        print(f\"\\n[5] 板块强度: 所有日期已有, 跳过\")\n+    else:\n+        total_calls = len(missing_dates) * len(all_sectors)\n+        print(f\"\\n[5] 板块强度: {len(missing_dates)}天 x {len(all_sectors)}板块 = {total_calls}次调用\")\n+        print(f\"    {MAX_WORKERS}线程并发...\")\n+\n+        tasks = []\n+        for date in missing_dates:\n+            for code, name in all_sectors.items():\n+                tasks.append((code, name, date))\n+\n+        success_count = 0\n+        t_start = time.time()\n+\n+        with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:\n+            futures = {executor.submit(fetch_one_sector_strength, task): task for task in tasks}\n+            for i, future in enumerate(as_completed(futures)):\n+                result = future.result()\n+                if result:\n+                    conn.execute(\"INSERT OR REPLACE INTO sector_strength VALUES(?,?,?,?)\", result)\n+                    success_count += 1\n+                if (i + 1) % 500 == 0:\n+                    conn.commit()\n+                    elapsed = time.time() - t_start\n+                    speed = (i + 1) / elapsed\n+                    remaining = (len(tasks) - i - 1) / speed\n+                    print(f\"    进度: {i+1}/{len(tasks)} ({speed:.0f}次/秒, 剩余{remaining:.0f}s)\")\n+\n+        conn.commit()\n+        elapsed = time.time() - t_start\n+        print(f\"    完成! {success_count}条, 耗时{elapsed:.0f}秒\")\n+\n+    # 6. 统计\n+    print(f\"\\n{'='*60}\")\n+    print(f\"采集完成统计\")\n+    print(f\"{'='*60}\")\n+    total_s = conn.execute(\"SELECT COUNT(*) FROM sector_strength\").fetchone()[0]\n+    dates_s = conn.execute(\"SELECT COUNT(DISTINCT date) FROM sector_strength\").fetchone()[0]\n+    sectors_s = conn.execute(\"SELECT COUNT(DISTINCT sector_code) FROM sector_strength\").fetchone()[0]\n+    sl_s = conn.execute(\"SELECT COUNT(*) FROM sector_list\").fetchone()[0]\n+    sl_dynamic = conn.execute(\"SELECT COUNT(*) FROM sector_list WHERE source='dynamic'\").fetchone()[0]\n+    nh_s = conn.execute(\"SELECT COUNT(*) FROM new_high\").fetchone()[0]\n+    snh_s = conn.execute(\"SELECT COUNT(*) FROM sector_new_high\").fetchone()[0]\n+    kl_s = conn.execute(\"SELECT COUNT(*) FROM hs300_kline\").fetchone()[0]\n+    print(f\"    板块列表: {sl_s}个 (Excel:{sl_s-sl_dynamic} + 动态:{sl_dynamic})\")\n+    print(f\"    板块强度: {total_s}条 ({dates_s}天 x {sectors_s}板块)\")\n+    print(f\"    百日新高: {nh_s}天\")\n+    print(f\"    板块新高: {snh_s}条\")\n+    print(f\"    沪深300: {kl_s}条\")\n+\n+    # 验证\n+    row = conn.execute(\"SELECT strength FROM sector_strength WHERE sector_code='801572' AND date='2026-07-06'\").fetchone()\n+    if row:\n+        print(f\"\\n    验证 中报增长(801572) 7月6日: {row[0]}\")\n+\n+    conn.close()\n+    print(f\"\\n数据库: {DB_PATH}\")\n+    print(f\"{'='*60}\")\n+\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"939165572154621cf7bc1b2ec7ed639a8ab566d7","filename":"scripts/verify_all_apis.py","status":"added","additions":297,"deletions":0,"changes":297,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fverify_all_apis.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/scripts%2Fverify_all_apis.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/scripts%2Fverify_all_apis.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,297 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL API 全接口验证脚本\n+逐个测试所有API接口，采集示例数据，生成验证报告\n+\"\"\"\n+import sys\n+import os\n+import json\n+import time\n+import warnings\n+from pathlib import Path\n+from datetime import datetime, timedelta\n+\n+warnings.filterwarnings('ignore')\n+\n+_PROJECT_ROOT = Path(__file__).parent.parent.resolve()\n+sys.path.insert(0, str(_PROJECT_ROOT / 'lib'))\n+sys.path.insert(0, str(_PROJECT_ROOT / 'scripts'))\n+\n+from kaipanla_crawler import KaipanlaCrawler\n+\n+# 测试日期: 最近一个交易日\n+TODAY = datetime.now().strftime('%Y-%m-%d')\n+YESTERDAY = (datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')\n+TEST_DATE = '2026-07-08'  # 用确定的日期测试\n+TEST_SECTOR_CODE = '11000'  # 算力板块\n+TEST_SECTOR_NAME = '算力'\n+TEST_STOCK_CODE = '000001'  # 平安银行\n+TEST_PLATE_ID = '3038'  # 人工智能概念\n+\n+# 结果存储\n+results = []\n+\n+def add_result(api_name, category, params, status, data_sample, error_msg='', data_count=0):\n+    \"\"\"添加测试结果\"\"\"\n+    results.append({\n+        'api_name': api_name,\n+        'category': category,\n+        'params': params,\n+        'status': status,\n+        'error_msg': error_msg,\n+        'data_count': data_count,\n+        'data_sample': data_sample,\n+        'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n+    })\n+    status_icon = '✅' if status == 'success' else '❌'\n+    print(f\"  {status_icon} {api_name}: {status} ({data_count}条数据)\" + (f\" - {error_msg[:80]}\" if error_msg else \"\"))\n+\n+def truncate_data(data, max_items=5):\n+    \"\"\"截取数据样本\"\"\"\n+    if data is None:\n+        return None\n+    if isinstance(data, list):\n+        items = data[:max_items]\n+        return json.dumps(items, ensure_ascii=False, default=str)[:2000]\n+    if isinstance(data, dict):\n+        # 只保留前几个key\n+        keys = list(data.keys())[:max_items]\n+        truncated = {k: data[k] for k in keys if k in data}\n+        return json.dumps(truncated, ensure_ascii=False, default=str)[:2000]\n+    try:\n+        import pandas as pd\n+        if isinstance(data, pd.DataFrame):\n+            if len(data) == 0:\n+                return '{\"type\": \"DataFrame\", \"rows\": 0}'\n+            rows = data.head(max_items).to_dict(orient='records')\n+            return json.dumps({\n+                'type': 'DataFrame',\n+                'total_rows': len(data),\n+                'columns': list(data.columns),\n+                'sample_rows': rows\n+            }, ensure_ascii=False, default=str)[:2000]\n+    except:\n+        pass\n+    return str(data)[:2000]\n+\n+def test_api(api_name, category, params_desc, func, *args, **kwargs):\n+    \"\"\"测试单个API\"\"\"\n+    try:\n+        result = func(*args, **kwargs)\n+        if result is None:\n+            add_result(api_name, category, params_desc, 'empty', '', '返回None')\n+            return\n+        if isinstance(result, list):\n+            if len(result) == 0:\n+                add_result(api_name, category, params_desc, 'empty', '[]', '返回空列表')\n+            else:\n+                add_result(api_name, category, params_desc, 'success', truncate_data(result), '', len(result))\n+        elif isinstance(result, dict):\n+            if result.get('success') is False:\n+                add_result(api_name, category, params_desc, 'error', '', str(result.get('error', '未知错误')))\n+            elif not result:\n+                add_result(api_name, category, params_desc, 'empty', '{}')\n+            else:\n+                add_result(api_name, category, params_desc, 'success', truncate_data(result), '')\n+        else:\n+            try:\n+                import pandas as pd\n+                if isinstance(result, pd.DataFrame):\n+                    if len(result) == 0:\n+                        add_result(api_name, category, params_desc, 'empty', '{\"type\":\"DataFrame\",\"rows\":0}')\n+                    else:\n+                        add_result(api_name, category, params_desc, 'success', truncate_data(result), '', len(result))\n+                    return\n+            except:\n+                pass\n+            if result:\n+                add_result(api_name, category, params_desc, 'success', truncate_data(result), '')\n+            else:\n+                add_result(api_name, category, params_desc, 'empty', str(result))\n+    except Exception as e:\n+        add_result(api_name, category, params_desc, 'error', '', str(e)[:200])\n+\n+def main():\n+    print(f\"KPL API 全接口验证脚本\")\n+    print(f\"测试日期: {TEST_DATE}, 当前时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\")\n+    print(f\"Token: ea7dc4aae58b4ec8e8d34b4b688995dc\")\n+    print(f\"UserID: 7542928\")\n+    print(f\"{'='*80}\")\n+\n+    crawler = KaipanlaCrawler()\n+\n+    # ===== 1. 历史数据类 =====\n+    print(f\"\\n【1. 历史数据类】\")\n+    test_api('get_daily_data', '历史数据', f'date={TEST_DATE}', crawler.get_daily_data, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_new_high_data', '历史数据', f'end_date={TEST_DATE}', crawler.get_new_high_data, TEST_DATE)\n+    time.sleep(1)\n+\n+    # ===== 2. 市场情绪类 =====\n+    print(f\"\\n【2. 市场情绪类】\")\n+    test_api('get_market_sentiment', '市场情绪', f'date={TEST_DATE}', crawler.get_market_sentiment, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_market_index', '市场情绪', f'date={TEST_DATE}', crawler.get_market_index, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_limit_up_ladder', '市场情绪', f'date={TEST_DATE}', crawler.get_limit_up_ladder, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_sharp_withdrawal', '市场情绪', f'date={TEST_DATE}', crawler.get_sharp_withdrawal, TEST_DATE)\n+    time.sleep(1)\n+\n+    # ===== 3. 板块排名类 =====\n+    print(f\"\\n【3. 板块排名类】\")\n+    test_api('get_sector_ranking', '板块排名', f'date={TEST_DATE}', crawler.get_sector_ranking, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_consecutive_limit_up', '板块排名', f'date={TEST_DATE}', crawler.get_consecutive_limit_up, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_sector_limit_up_ladder', '板块排名', f'date={TEST_DATE}', crawler.get_sector_limit_up_ladder, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_market_limit_up_ladder', '板块排名', f'date={TEST_DATE}', crawler.get_market_limit_up_ladder, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_historical_broken_limit_up', '板块排名', f'date={TEST_DATE}', crawler.get_historical_broken_limit_up, TEST_DATE)\n+    time.sleep(1)\n+\n+    # ===== 4. 板块资金/强度类 =====\n+    print(f\"\\n【4. 板块资金/强度类】\")\n+    test_api('get_sector_capital_data', '板块资金', f'sector_code={TEST_SECTOR_CODE}, date={TEST_DATE}',\n+             crawler.get_sector_capital_data, TEST_SECTOR_CODE, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_sector_strength_ndays', '板块强度', f'end_date={TEST_DATE}, num_days=7',\n+             crawler.get_sector_strength_ndays, TEST_DATE, 7)\n+    time.sleep(1)\n+\n+    test_api('get_sector_strength', '板块强度', f'sector_code={TEST_SECTOR_CODE}',\n+             crawler.get_sector_strength, TEST_SECTOR_CODE)\n+    time.sleep(1)\n+\n+    test_api('get_multiple_sectors_strength', '板块强度', f'sector_codes=[{TEST_SECTOR_CODE}]',\n+             crawler.get_multiple_sectors_strength, [TEST_SECTOR_CODE])\n+    time.sleep(1)\n+\n+    test_api('get_sector_strength_history', '板块强度', f'sector_code={TEST_SECTOR_CODE}, start={YESTERDAY}, end={TODAY}',\n+             crawler.get_sector_strength_history, TEST_SECTOR_CODE, YESTERDAY, TODAY)\n+    time.sleep(1)\n+\n+    # ===== 5. 实时行情类 =====\n+    print(f\"\\n【5. 实时行情类】\")\n+    test_api('get_realtime_market_mood', '实时行情', '', crawler.get_realtime_market_mood)\n+    time.sleep(1)\n+\n+    test_api('get_realtime_actual_limit_up_down', '实时行情', '', crawler.get_realtime_actual_limit_up_down)\n+    time.sleep(1)\n+\n+    test_api('get_realtime_board_stocks', '实时行情', 'board_type=1 (首板)', crawler.get_realtime_board_stocks, 1)\n+    time.sleep(1)\n+\n+    test_api('get_realtime_all_boards_stocks', '实时行情', '', crawler.get_realtime_all_boards_stocks)\n+    time.sleep(1)\n+\n+    test_api('get_board_stocks_count_and_list', '实时行情', 'board_type=1', crawler.get_board_stocks_count_and_list, 1)\n+    time.sleep(1)\n+\n+    test_api('get_realtime_index_trend', '实时行情', 'stock_id=801900, time=15:00', crawler.get_realtime_index_trend, \"801900\", \"15:00\")\n+    time.sleep(1)\n+\n+    test_api('get_realtime_index_list', '实时行情', '', crawler.get_realtime_index_list)\n+    time.sleep(1)\n+\n+    test_api('get_realtime_sharp_withdrawal', '实时行情', '', crawler.get_realtime_sharp_withdrawal)\n+    time.sleep(1)\n+\n+    test_api('get_realtime_rise_fall_analysis', '实时行情', '', crawler.get_realtime_rise_fall_analysis)\n+    time.sleep(1)\n+\n+    # ===== 6. 盘中分时类 =====\n+    print(f\"\\n【6. 盘中分时类】\")\n+    test_api('get_sector_intraday', '盘中分时', f'sector_code={TEST_SECTOR_CODE}, date={TEST_DATE}',\n+             crawler.get_sector_intraday, TEST_SECTOR_CODE, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_sector_volume_turnover', '盘中分时', f'sector_code={TEST_SECTOR_CODE}, date={TEST_DATE}',\n+             crawler.get_sector_volume_turnover, TEST_SECTOR_CODE, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_stock_intraday', '盘中分时', f'stock_code={TEST_STOCK_CODE}, date={TEST_DATE}',\n+             crawler.get_stock_intraday, TEST_STOCK_CODE, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_stock_big_order_intraday', '盘中分时', f'stock_code={TEST_STOCK_CODE}, date={TEST_DATE}',\n+             crawler.get_stock_big_order_intraday, TEST_STOCK_CODE, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_index_intraday', '盘中分时', f'index_code=SH000001, date={TEST_DATE}',\n+             crawler.get_index_intraday, \"SH000001\", TEST_DATE)\n+    time.sleep(1)\n+\n+    # ===== 7. 板块要闻/热榜类 =====\n+    print(f\"\\n【7. 板块要闻/热榜类】\")\n+    test_api('get_plate_news', '板块要闻', f'plate_id={TEST_PLATE_ID}', crawler.get_plate_news, TEST_PLATE_ID)\n+    time.sleep(1)\n+\n+    # THS热榜使用selenium, 跳过\n+    # test_api('get_ths_hot_rank', '板块要闻', '', crawler.get_ths_hot_rank)\n+\n+    # ===== 8. 龙虎榜类 =====\n+    print(f\"\\n【8. 龙虎榜类】\")\n+    test_api('get_longhubang_stock_list', '龙虎榜', f'date={TEST_DATE}', crawler.get_longhubang_stock_list, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_longhubang_stock_detail', '龙虎榜', f'stock_code={TEST_STOCK_CODE}, date={TEST_DATE}',\n+             crawler.get_longhubang_stock_detail, TEST_STOCK_CODE, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_longhubang_dataframe', '龙虎榜', f'date={TEST_DATE}', crawler.get_longhubang_dataframe, TEST_DATE)\n+    time.sleep(1)\n+\n+    # ===== 9. 成分股类（需要Token的接口） =====\n+    print(f\"\\n【9. 成分股类（需要Token）】\")\n+    test_api('get_sector_constituent_stocks', '成分股', f'plate_id={TEST_PLATE_ID}, date={TEST_DATE}',\n+             crawler.get_sector_constituent_stocks, TEST_PLATE_ID, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_sector_all_stocks', '成分股', f'plate_id={TEST_PLATE_ID}, date={TEST_DATE}',\n+             crawler.get_sector_all_stocks, TEST_PLATE_ID, TEST_DATE, 1, 1)  # max_pages=1\n+    time.sleep(1)\n+\n+    # ===== 10. 竞价异常/ETF类 =====\n+    print(f\"\\n【10. 竞价异常/ETF类】\")\n+    test_api('get_sector_bidding_anomaly', '竞价异常', f'date={TEST_DATE}', crawler.get_sector_bidding_anomaly, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_etf_ranking', 'ETF', f'date={TEST_DATE}', crawler.get_etf_ranking, TEST_DATE)\n+    time.sleep(1)\n+\n+    test_api('get_all_etf_ranking', 'ETF', f'date={TEST_DATE}, max_pages=1', crawler.get_all_etf_ranking, TEST_DATE, 1, 1)\n+    time.sleep(1)\n+\n+    test_api('get_stock_call_auction_tick', '竞价', f'stock_code={TEST_STOCK_CODE}, date={TEST_DATE}',\n+             crawler.get_stock_call_auction_tick, TEST_STOCK_CODE, TEST_DATE)\n+\n+    # ===== 汇总 =====\n+    print(f\"\\n{'='*80}\")\n+    total = len(results)\n+    success = len([r for r in results if r['status'] == 'success'])\n+    empty = len([r for r in results if r['status'] == 'empty'])\n+    error = len([r for r in results if r['status'] == 'error'])\n+    print(f\"总计: {total}个API | 成功: {success} | 空数据: {empty} | 失败: {error}\")\n+\n+    # 保存结果JSON\n+    output_dir = _PROJECT_ROOT / 'scripts'\n+    json_path = output_dir / 'api_verify_results.json'\n+    with open(json_path, 'w', encoding='utf-8') as f:\n+        json.dump(results, f, ensure_ascii=False, indent=2, default=str)\n+    print(f\"\\n结果已保存: {json_path}\")\n+\n+    return results\n+\n+if __name__ == '__main__':\n+    main()"},{"sha":"b47d9027251400ba732955cbc11445016a44c50c","filename":"server.py","status":"added","additions":551,"deletions":0,"changes":551,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/server.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/server.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/server.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,551 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+KPL深度透视看板 - Web服务器\n+提供看板页面 + 数据下载API + 盘中刷新 + 自动收盘下载\n+用法: python server.py  然后浏览器打开 http://localhost:5000\n+\"\"\"\n+import sys\n+import os\n+import json\n+import sqlite3\n+import threading\n+import time\n+from pathlib import Path\n+from datetime import datetime, timedelta\n+from flask import Flask, request, jsonify, send_file\n+\n+PROJECT_ROOT = Path(__file__).parent.resolve()\n+sys.path.insert(0, str(PROJECT_ROOT / 'scripts'))\n+sys.path.insert(0, str(PROJECT_ROOT / 'src'))\n+\n+app = Flask(__name__)\n+\n+DB_PATH = PROJECT_ROOT / 'data' / 'kpl_dashboard.db'\n+OUTPUT_DIR = PROJECT_ROOT / 'output'\n+\n+# ===== 下载任务状态 =====\n+_download_status = {\n+    'running': False,\n+    'progress': '',\n+    'error': '',\n+    'finished_at': None,\n+}\n+_status_lock = threading.Lock()\n+\n+# ===== 盘中刷新状态 =====\n+_intraday_config = {\n+    'enabled': False,\n+    'interval_min': 5,  # 刷新间隔(分钟)\n+}\n+_intraday_lock = threading.Lock()\n+_intraday_timer = None\n+\n+# ===== 自动收盘下载状态 =====\n+_auto_close_enabled = False\n+_auto_close_lock = threading.Lock()\n+_auto_close_timer = None\n+\n+\n+def get_db_stats():\n+    \"\"\"获取数据库统计(含时间范围)\"\"\"\n+    if not DB_PATH.exists():\n+        return {'error': '数据库不存在'}\n+    conn = sqlite3.connect(DB_PATH)\n+    try:\n+        # 板块强度时间范围\n+        ss_range = conn.execute(\"SELECT MIN(date), MAX(date) FROM sector_strength\").fetchone()\n+        # 百日新高时间范围\n+        nh_range = conn.execute(\"SELECT MIN(date), MAX(date) FROM new_high\").fetchone()\n+        # 板块新高时间范围\n+        snh_range = conn.execute(\"SELECT MIN(date), MAX(date) FROM sector_new_high\").fetchone()\n+        # 沪深300时间范围\n+        hs_range = conn.execute(\"SELECT MIN(date), MAX(date) FROM hs300_kline\").fetchone()\n+\n+        stats = {\n+            'sector_list': conn.execute(\"SELECT COUNT(*) FROM sector_list\").fetchone()[0],\n+            'sector_strength': conn.execute(\"SELECT COUNT(*) FROM sector_strength\").fetchone()[0],\n+            'strength_dates': conn.execute(\"SELECT COUNT(DISTINCT date) FROM sector_strength\").fetchone()[0],\n+            'strength_start': ss_range[0] or '-',\n+            'strength_end': ss_range[1] or '-',\n+            'new_high': conn.execute(\"SELECT COUNT(*) FROM new_high\").fetchone()[0],\n+            'nh_start': nh_range[0] or '-',\n+            'nh_end': nh_range[1] or '-',\n+            'sector_new_high': conn.execute(\"SELECT COUNT(*) FROM sector_new_high\").fetchone()[0],\n+            'snh_start': snh_range[0] or '-',\n+            'snh_end': snh_range[1] or '-',\n+            'hs300': conn.execute(\"SELECT COUNT(*) FROM hs300_kline\").fetchone()[0],\n+            'hs300_start': hs_range[0] or '-',\n+            'hs300_end': hs_range[1] or '-',\n+            'latest_strength_date': ss_range[1] or '-',\n+            'latest_nh_date': nh_range[1] or '-',\n+            'latest_hs300_date': hs_range[1] or '-',\n+        }\n+        # 板块新高覆盖率\n+        latest_snh = snh_range[1]\n+        if latest_snh:\n+            stats['latest_snh_date'] = latest_snh\n+            stats['snh_coverage'] = conn.execute(\n+                \"SELECT COUNT(*) FROM sector_new_high WHERE date=?\", (latest_snh,)\n+            ).fetchone()[0]\n+        else:\n+            stats['latest_snh_date'] = '-'\n+            stats['snh_coverage'] = 0\n+    except Exception as e:\n+        stats = {'error': str(e)}\n+    conn.close()\n+    return stats\n+\n+\n+def get_missing_strength_dates(conn, start_date, end_date):\n+    \"\"\"获取指定范围内缺失的板块强度日期\"\"\"\n+    existing = set(r[0] for r in conn.execute(\"SELECT DISTINCT date FROM sector_strength\").fetchall())\n+    all_days = get_trading_days(start_date, end_date)\n+    return [d for d in all_days if d not in existing]\n+\n+\n+def get_trading_days(start_date, end_date):\n+    \"\"\"获取交易日列表(排除周末)\"\"\"\n+    days = []\n+    current = datetime.strptime(start_date, '%Y-%m-%d')\n+    end_dt = datetime.strptime(end_date, '%Y-%m-%d')\n+    while current <= end_dt:\n+        if current.weekday() < 5:\n+            days.append(current.strftime('%Y-%m-%d'))\n+        current += timedelta(days=1)\n+    return days\n+\n+\n+def run_download_task(task_type, target_date=None, start_date=None, end_date=None):\n+    \"\"\"在后台线程中执行下载任务\"\"\"\n+    global _download_status\n+    with _status_lock:\n+        if _download_status['running']:\n+            return False, '已有下载任务正在运行'\n+        _download_status['running'] = True\n+        _download_status['progress'] = '开始下载...'\n+        _download_status['error'] = ''\n+\n+    def worker():\n+        global _download_status\n+        try:\n+            from kpl_common import (init_db, load_sector_list, fetch_hs300_kline,\n+                                   fetch_hs300_realtime, fetch_market_new_high, download_strength_batch,\n+                                   download_sector_new_high_batch, discover_extra_sectors,\n+                                   get_existing_dates, print_db_stats,\n+                                   download_strength_realtime, download_market_sentiment,\n+                                   download_sector_sentiment, init_emotion_tables,\n+                                   download_ladder_data)\n+            from kaipanla_crawler import KaipanlaCrawler\n+\n+            conn = init_db()\n+            crawler = KaipanlaCrawler()\n+\n+            if task_type == 'latest':\n+                # ===== 一键下载: 从最新已有日期到今天, 下载所有缺失的收盘数据 =====\n+                _set_progress('加载板块列表...')\n+                sectors, excel_codes = load_sector_list(conn)\n+                if not sectors:\n+                    raise Exception('无法加载板块列表')\n+\n+                # 沪深300\n+                _set_progress('获取沪深300...')\n+                today = datetime.now().strftime('%Y-%m-%d')\n+                hs_start = (datetime.now() - timedelta(days=75)).strftime('%Y-%m-%d')\n+                hs300 = fetch_hs300_kline(hs_start, today)\n+                conn.executemany(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", hs300)\n+                conn.commit()\n+\n+                # 全市场百日新高(1次API返回360天)\n+                _set_progress('获取百日新高...')\n+                nh = fetch_market_new_high()\n+                for d, t, n in nh:\n+                    conn.execute(\"INSERT OR REPLACE INTO new_high VALUES(?,?,?)\", (d, t, n))\n+                conn.commit()\n+                nh_dates = sorted([r[0] for r in nh])\n+\n+                # 动态板块发现\n+                _set_progress('动态板块发现...')\n+                recent = nh_dates[-3:] if len(nh_dates) >= 3 else nh_dates\n+                extra = discover_extra_sectors(crawler, recent, set(sectors.keys()))\n+                if extra:\n+                    for c, n in extra.items():\n+                        conn.execute(\"INSERT OR REPLACE INTO sector_list VALUES(?,?,?,?)\", (c, n, 0, 'dynamic'))\n+                        sectors[c] = n\n+                    conn.commit()\n+                all_sectors = list(sectors.items())\n+\n+                # 找出所有缺失的板块强度日期(从最新已有到今天)\n+                existing = get_existing_dates(conn, 'sector_strength')\n+                today_date = nh_dates[-1] if nh_dates else today\n+\n+                # 从新高数据中获取交易日列表, 筛选出缺失的强度日期\n+                all_trading = [d for d in nh_dates if d >= '2026-04-01']\n+                missing_dates = [d for d in all_trading if d not in existing]\n+\n+                if missing_dates:\n+                    _set_progress(f'下载板块强度: {len(missing_dates)}天缺失 ({missing_dates[0]}~{missing_dates[-1]})')\n+                    s, f = download_strength_batch(conn, all_sectors, missing_dates, max_workers=8)\n+                    _set_progress(f'板块强度完成: {s}成功')\n+                else:\n+                    _set_progress('板块强度已是最新')\n+\n+                # 刷新板块百日新高(全量, 因为API返回360天历史)\n+                _set_progress('刷新板块百日新高...')\n+                s, t = download_sector_new_high_batch(conn, all_sectors)\n+                _set_progress(f'板块新高完成: {s}板块 {t}条')\n+\n+                # 市场情绪数据(涨跌停+溢价)\n+                _set_progress('获取市场情绪数据...')\n+                init_emotion_tables(conn)\n+                n = download_market_sentiment(conn)\n+                _set_progress(f'市场情绪: {n}天')\n+\n+                # 板块涨跌停+个股映射(最近3天)\n+                _set_progress('获取板块涨跌停+个股映射...')\n+                recent_dates = sorted([r[0] for r in conn.execute(\"SELECT DISTINCT date FROM market_sentiment ORDER BY date DESC LIMIT 3\").fetchall()])\n+                n_sec, n_stk = download_sector_sentiment(conn, recent_dates)\n+                _set_progress(f'板块涨跌停: {n_sec}条, 个股映射: {n_stk}条')\n+\n+                # 连板梯队数据(补充缺失日期)\n+                _set_progress('获取连板梯队数据...')\n+                all_ss_dates = sorted([r[0] for r in conn.execute(\"SELECT DISTINCT date FROM sector_strength\").fetchall()])\n+                existing_ld = set(r[0] for r in conn.execute(\"SELECT DISTINCT date FROM ladder_data\").fetchall())\n+                missing_ld = [d for d in all_ss_dates if d not in existing_ld]\n+                if missing_ld:\n+                    _set_progress(f'连板梯队: {len(missing_ld)}天缺失 ({missing_ld[0]}~{missing_ld[-1]})')\n+                    download_ladder_data(conn, missing_ld)\n+                else:\n+                    _set_progress('连板梯队: 已是最新')\n+\n+            elif task_type == 'range':\n+                # ===== 历史区间下载: 下载指定日期区间内的缺失数据 =====\n+                if not start_date or not end_date:\n+                    raise Exception('未指定日期区间')\n+\n+                _set_progress(f'加载板块列表...')\n+                sectors, excel_codes = load_sector_list(conn)\n+                if not sectors:\n+                    raise Exception('无法加载板块列表')\n+                all_sectors = list(sectors.items())\n+\n+                # 获取该区间内的缺失日期\n+                missing = get_missing_strength_dates(conn, start_date, end_date)\n+                if missing:\n+                    _set_progress(f'下载板块强度: {len(missing)}天缺失 ({missing[0]}~{missing[-1]})')\n+                    s, f = download_strength_batch(conn, all_sectors, missing, max_workers=8)\n+                    _set_progress(f'板块强度完成: {s}成功 {f}失败')\n+                else:\n+                    _set_progress('板块强度: 该区间无缺失数据')\n+\n+                # 沪深300\n+                _set_progress('获取沪深300...')\n+                hs300 = fetch_hs300_kline(start_date, end_date)\n+                if hs300:\n+                    conn.executemany(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", hs300)\n+                    conn.commit()\n+                _set_progress(f'沪深300: {len(hs300)}条')\n+\n+                # 百日新高(1次API返回全量历史, 自动覆盖区间)\n+                _set_progress('获取百日新高...')\n+                nh = fetch_market_new_high()\n+                for d, t, n in nh:\n+                    if start_date <= d <= end_date:\n+                        conn.execute(\"INSERT OR REPLACE INTO new_high VALUES(?,?,?)\", (d, t, n))\n+                conn.commit()\n+                _set_progress(f'百日新高: 已更新')\n+\n+                # 板块百日新高(全量刷新)\n+                _set_progress('刷新板块百日新高...')\n+                s, t = download_sector_new_high_batch(conn, all_sectors)\n+                _set_progress(f'板块新高完成: {s}板块 {t}条')\n+\n+                # 市场情绪\n+                _set_progress('获取市场情绪...')\n+                init_emotion_tables(conn)\n+                download_market_sentiment(conn)\n+\n+                # 板块涨跌停+个股映射\n+                _set_progress('获取板块涨跌停+个股映射...')\n+                range_days = get_trading_days(start_date, end_date)\n+                n_sec, n_stk = download_sector_sentiment(conn, range_days[-5:])  # 最近5天\n+                _set_progress(f'板块涨跌停: {n_sec}条, 个股映射: {n_stk}条')\n+\n+                # 连板梯队数据(整个区间的缺失日期)\n+                _set_progress('获取连板梯队数据...')\n+                existing_ld = set(r[0] for r in conn.execute(\"SELECT DISTINCT date FROM ladder_data\").fetchall())\n+                missing_ld = [d for d in range_days if d not in existing_ld]\n+                if missing_ld:\n+                    _set_progress(f'连板梯队: {len(missing_ld)}天缺失 ({missing_ld[0]}~{missing_ld[-1]})')\n+                    download_ladder_data(conn, missing_ld)\n+                else:\n+                    _set_progress('连板梯队: 已是最新')\n+\n+            elif task_type == 'intraday':\n+                # ===== 盘中刷新: 使用实时端点获取当日数据 =====\n+                today = datetime.now().strftime('%Y-%m-%d')\n+\n+                # 沪深300: 先获取日K线, 再补充今日实时\n+                _set_progress('盘中刷新: 获取沪深300...')\n+                hs_start = (datetime.now() - timedelta(days=10)).strftime('%Y-%m-%d')\n+                hs300 = fetch_hs300_kline(hs_start, today)\n+                if hs300:\n+                    conn.executemany(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", hs300)\n+                # 补充今日实时HS300\n+                rt_hs300 = fetch_hs300_realtime()\n+                if rt_hs300:\n+                    conn.execute(\"INSERT OR REPLACE INTO hs300_kline VALUES(?,?,?,?,?,?,?)\", rt_hs300)\n+                    _set_progress(f'沪深300实时: {rt_hs300[2]:.2f} ({rt_hs300[6]:+.2f}%)')\n+                conn.commit()\n+\n+                # 百日新高(更新已有数据)\n+                _set_progress('盘中刷新: 获取百日新高...')\n+                nh = fetch_market_new_high()\n+                for d, t, n in nh:\n+                    conn.execute(\"INSERT OR REPLACE INTO new_high VALUES(?,?,?)\", (d, t, n))\n+                conn.commit()\n+\n+                # 板块强度 - 使用实时端点(不传date, 走apphwhq)\n+                _set_progress(f'盘中刷新: 下载板块强度(实时)...')\n+                sectors, excel_codes = load_sector_list(conn)\n+                if sectors:\n+                    all_sectors = list(sectors.items())\n+                    s, f = download_strength_realtime(conn, all_sectors, max_workers=3)\n+                    _set_progress(f'板块强度: {s}成功 {f}失败')\n+\n+                # 市场情绪(实时涨跌停+溢价)\n+                _set_progress('盘中刷新: 获取市场情绪...')\n+                init_emotion_tables(conn)\n+                download_market_sentiment(conn)\n+\n+                # 板块涨跌停+个股映射(今日)\n+                _set_progress('盘中刷新: 获取板块涨跌停+个股映射...')\n+                n_sec, n_stk = download_sector_sentiment(conn, [today])\n+                _set_progress(f'板块涨跌停: {n_sec}条, 个股映射: {n_stk}条')\n+\n+                # 连板梯队数据(今日)\n+                _set_progress('盘中刷新: 获取连板梯队数据...')\n+                download_ladder_data(conn, [today])\n+\n+            # 生成看板\n+            _set_progress('生成看板HTML...')\n+            from gen_dashboard import main as gen_html\n+            gen_html()\n+\n+            stats = get_db_stats()\n+            _set_progress(f'完成! 强度:{stats.get(\"strength_start\",\"?\")}~{stats.get(\"strength_end\",\"?\")} 新高:{stats.get(\"nh_start\",\"?\")}~{stats.get(\"nh_end\",\"?\")}')\n+\n+        except Exception as e:\n+            with _status_lock:\n+                _download_status['error'] = str(e)[:200]\n+                _download_status['progress'] = f'错误: {str(e)[:100]}'\n+        finally:\n+            with _status_lock:\n+                _download_status['running'] = False\n+                _download_status['finished_at'] = datetime.now().strftime('%H:%M:%S')\n+\n+    threading.Thread(target=worker, daemon=True).start()\n+    return True, '下载任务已启动'\n+\n+\n+def _set_progress(msg):\n+    global _download_status\n+    with _status_lock:\n+        _download_status['progress'] = msg\n+\n+\n+# ===== 盘中刷新定时器 =====\n+def start_intraday_refresh(interval_min):\n+    \"\"\"启动盘中刷新定时器\"\"\"\n+    global _intraday_timer\n+    stop_intraday_refresh()\n+\n+    with _intraday_lock:\n+        _intraday_config['enabled'] = True\n+        _intraday_config['interval_min'] = interval_min\n+\n+    def intraday_loop():\n+        while True:\n+            with _intraday_lock:\n+                if not _intraday_config['enabled']:\n+                    return\n+                interval = _intraday_config['interval_min']\n+\n+            now = datetime.now()\n+            # 仅在交易日 9:30~15:00 运行\n+            if now.weekday() < 5 and 9 <= now.hour < 15:\n+                # 检查是否在交易时间 (9:30~15:00)\n+                if now.hour == 9 and now.minute < 30:\n+                    pass  # 还没开盘\n+                elif now.hour >= 15:\n+                    pass  # 已收盘\n+                else:\n+                    ok, msg = run_download_task('intraday')\n+                    if ok:\n+                        print(f'[{now.strftime(\"%H:%M\")}] 盘中刷新已触发')\n+\n+            time.sleep(interval * 60)\n+\n+    _intraday_timer = threading.Thread(target=intraday_loop, daemon=True)\n+    _intraday_timer.start()\n+\n+\n+def stop_intraday_refresh():\n+    \"\"\"停止盘中刷新\"\"\"\n+    global _intraday_timer\n+    with _intraday_lock:\n+        _intraday_config['enabled'] = False\n+    _intraday_timer = None\n+\n+\n+# ===== 自动收盘下载定时器 =====\n+def start_auto_close():\n+    \"\"\"启动自动收盘下载(每天15:15检查)\"\"\"\n+    global _auto_close_enabled, _auto_close_timer\n+    with _auto_close_lock:\n+        _auto_close_enabled = True\n+\n+    def auto_close_loop():\n+        while True:\n+            with _auto_close_lock:\n+                if not _auto_close_enabled:\n+                    return\n+\n+            now = datetime.now()\n+            # 每个交易日15:15触发\n+            if now.weekday() < 5 and now.hour == 15 and now.minute >= 15 and now.minute < 16:\n+                # 检查今天是否已经运行过(用文件标记)\n+                marker = PROJECT_ROOT / 'data' / f'.auto_close_{now.strftime(\"%Y%m%d\")}'\n+                if not marker.exists():\n+                    print(f'[{now.strftime(\"%H:%M\")}] 自动收盘下载触发...')\n+                    ok, msg = run_download_task('latest')\n+                    if ok:\n+                        marker.parent.mkdir(parents=True, exist_ok=True)\n+                        marker.touch()\n+\n+            # 每30秒检查一次\n+            time.sleep(30)\n+\n+    _auto_close_timer = threading.Thread(target=auto_close_loop, daemon=True)\n+    _auto_close_timer.start()\n+\n+\n+def stop_auto_close():\n+    \"\"\"停止自动收盘下载\"\"\"\n+    global _auto_close_enabled, _auto_close_timer\n+    with _auto_close_lock:\n+        _auto_close_enabled = False\n+    _auto_close_timer = None\n+\n+\n+# ===== 路由 =====\n+@app.route('/')\n+def index():\n+    \"\"\"返回最新的看板HTML\"\"\"\n+    html_files = sorted(OUTPUT_DIR.glob('A股题材主线深度透视看板_*.html'))\n+    if not html_files:\n+        html_files = sorted(OUTPUT_DIR.glob('KPL深度透视看板_*.html'))\n+    if html_files:\n+        resp = send_file(html_files[-1])\n+        resp.headers['Cache-Control'] = 'no-cache, no-store, must-revalidate'\n+        resp.headers['Pragma'] = 'no-cache'\n+        resp.headers['Expires'] = '0'\n+        return resp\n+    return '<h1>暂无看板</h1><p>请先运行数据下载生成看板</p>', 404\n+\n+\n+@app.route('/api/stats')\n+def api_stats():\n+    \"\"\"获取数据库统计\"\"\"\n+    stats = get_db_stats()\n+    with _intraday_lock:\n+        stats['intraday_enabled'] = _intraday_config['enabled']\n+        stats['intraday_interval'] = _intraday_config['interval_min']\n+    with _auto_close_lock:\n+        stats['auto_close_enabled'] = _auto_close_enabled\n+    return jsonify(stats)\n+\n+\n+@app.route('/api/trading_days')\n+def api_trading_days():\n+    \"\"\"获取交易日列表(用于日期选择)\"\"\"\n+    start = request.args.get('start', '2026-01-01')\n+    end = request.args.get('end', datetime.now().strftime('%Y-%m-%d'))\n+    days = get_trading_days(start, end)\n+\n+    if DB_PATH.exists():\n+        conn = sqlite3.connect(DB_PATH)\n+        existing = set(r[0] for r in conn.execute(\"SELECT DISTINCT date FROM sector_strength\").fetchall())\n+        conn.close()\n+        result = [{'date': d, 'has_data': d in existing} for d in days]\n+    else:\n+        result = [{'date': d, 'has_data': False} for d in days]\n+    return jsonify(result)\n+\n+\n+@app.route('/api/download_latest', methods=['POST'])\n+def api_download_latest():\n+    \"\"\"一键下载最新数据(从最新已有日期到今天, 增量)\"\"\"\n+    ok, msg = run_download_task('latest')\n+    return jsonify({'success': ok, 'message': msg})\n+\n+\n+@app.route('/api/download_range', methods=['POST'])\n+def api_download_range():\n+    \"\"\"下载指定日期区间的缺失数据\"\"\"\n+    data = request.json\n+    start = data.get('start')\n+    end = data.get('end')\n+    if not start or not end:\n+        return jsonify({'success': False, 'message': '未指定日期区间'})\n+    ok, msg = run_download_task('range', start_date=start, end_date=end)\n+    return jsonify({'success': ok, 'message': msg})\n+\n+\n+@app.route('/api/intraday_refresh', methods=['POST'])\n+def api_intraday_refresh():\n+    \"\"\"盘中刷新: 立即刷新一次\"\"\"\n+    ok, msg = run_download_task('intraday')\n+    return jsonify({'success': ok, 'message': msg})\n+\n+\n+@app.route('/api/intraday_toggle', methods=['POST'])\n+def api_intraday_toggle():\n+    \"\"\"开启/关闭盘中自动刷新\"\"\"\n+    data = request.json\n+    enabled = data.get('enabled', False)\n+    interval = data.get('interval', 5)\n+\n+    if enabled:\n+        start_intraday_refresh(interval)\n+        return jsonify({'success': True, 'message': f'盘中刷新已开启, 每{interval}分钟刷新一次'})\n+    else:\n+        stop_intraday_refresh()\n+        return jsonify({'success': True, 'message': '盘中刷新已关闭'})\n+\n+\n+@app.route('/api/auto_close_toggle', methods=['POST'])\n+def api_auto_close_toggle():\n+    \"\"\"开启/关闭自动收盘下载\"\"\"\n+    data = request.json\n+    enabled = data.get('enabled', False)\n+\n+    if enabled:\n+        start_auto_close()\n+        return jsonify({'success': True, 'message': '自动收盘下载已开启, 每交易日15:15自动执行'})\n+    else:\n+        stop_auto_close()\n+        return jsonify({'success': True, 'message': '自动收盘下载已关闭'})\n+\n+\n+@app.route('/api/download_status')\n+def api_download_status():\n+    \"\"\"获取下载状态\"\"\"\n+    with _status_lock:\n+        return jsonify(dict(_download_status))\n+\n+\n+if __name__ == '__main__':\n+    print(f\"KPL深度透视看板服务器\")\n+    print(f\"数据库: {DB_PATH}\")\n+    print(f\"打开浏览器访问: http://localhost:5000\")\n+    app.run(host='0.0.0.0', port=5000, debug=False)"},{"sha":"fcd11cda211720a4d2d96ec67a8276082e647ba2","filename":"src/gen_dashboard.py","status":"added","additions":3098,"deletions":0,"changes":3098,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/src%2Fgen_dashboard.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/src%2Fgen_dashboard.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/src%2Fgen_dashboard.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591"},{"sha":"d5e71865cb9a355e7b4bd1902bd8bdd567163545","filename":"src/gen_limit_up_report.py","status":"added","additions":539,"deletions":0,"changes":539,"blob_url":"https://github.com/HJ2916/kpl-dashboard-public/blob/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/src%2Fgen_limit_up_report.py","raw_url":"https://github.com/HJ2916/kpl-dashboard-public/raw/b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591/src%2Fgen_limit_up_report.py","contents_url":"https://api.github.com/repos/HJ2916/kpl-dashboard-public/contents/src%2Fgen_limit_up_report.py?ref=b2ca64099bbe6e8dbea7b353dbca82f0f8aa6591","patch":"@@ -0,0 +1,539 @@\n+# -*- coding: utf-8 -*-\n+\"\"\"\n+涨停个股深度分析报告 - 数据采集+HTML生成\n+获取过去10日每日涨停股票的全部数据\n+\"\"\"\n+import sys\n+sys.path.insert(0, r'D:\\trae\\traeworkspace\\kpl-dashboard\\lib')\n+sys.path.insert(0, r'D:\\trae\\traeworkspace\\kpl-dashboard\\scripts')\n+\n+import sqlite3\n+import json\n+import time\n+from datetime import datetime, timedelta\n+from kaipanla_crawler import KaipanlaCrawler\n+from pathlib import Path\n+\n+DB = r'D:\\trae\\traeworkspace\\kpl-dashboard\\data\\kpl_dashboard.db'\n+OUTPUT = Path(r'D:\\trae\\traeworkspace\\kpl-dashboard\\output')\n+\n+crawler = KaipanlaCrawler()\n+\n+# 获取过去10个交易日\n+def get_trading_dates():\n+    \"\"\"从数据库获取已有板块强度的最近10个交易日\"\"\"\n+    conn = sqlite3.connect(DB)\n+    dates = [r[0] for r in conn.execute(\n+        \"SELECT DISTINCT date FROM sector_strength ORDER BY date DESC LIMIT 10\"\n+    ).fetchall()]\n+    conn.close()\n+    return sorted(dates)\n+\n+def collect_limit_up_data(dates):\n+    \"\"\"收集每日涨停数据\"\"\"\n+    from datetime import datetime\n+    today_str = datetime.now().strftime('%Y-%m-%d')\n+    all_data = {}\n+    for date in dates:\n+        print(f\"\\n采集 {date} 涨停数据...\")\n+        day_data = {'date': date, 'stocks': [], 'broken': [], 'ladder': {}, 'ranking': []}\n+        is_today = (date == today_str)\n+\n+        # 1. 涨停股数据\n+        if is_today:\n+            # 今日: 用get_realtime_board_stocks获取全部涨停股(含封单/主力/连板等)\n+            print(\"  [今日] 使用get_realtime_board_stocks获取全部涨停股...\")\n+            all_board_stocks = []\n+            for bt in range(1, 6):\n+                try:\n+                    stocks = crawler.get_realtime_board_stocks(board_type=bt)\n+                    all_board_stocks.extend(stocks)\n+                    time.sleep(0.2)\n+                except Exception as e:\n+                    print(f\"  get_realtime_board_stocks({bt})失败: {e}\")\n+\n+            # 按涨停原因分组\n+            reason_groups = {}\n+            for s in all_board_stocks:\n+                reason = s.get('limit_up_reason', '') or '未分类'\n+                if reason not in reason_groups:\n+                    reason_groups[reason] = []\n+                stock = {\n+                    'code': s.get('stock_code', ''),\n+                    'name': s.get('stock_name', ''),\n+                    'limit_up_reason': reason,\n+                    'concepts': s.get('concepts', ''),\n+                    'consecutive': f\"{s.get('consecutive_days', 1)}板\",\n+                    'consecutive_count': s.get('consecutive_days', 1),\n+                    'seal_amount': s.get('seal_amount', 0),\n+                    'main_capital': s.get('main_net_inflow', 0),\n+                    'circulating_mv': s.get('circulating_market_cap', 0),\n+                    'total_mv': s.get('total_market_cap', 0),\n+                    'limit_up_price': s.get('limit_up_price', 0),\n+                    'change_pct': s.get('change_pct', 0),\n+                    'sector_code': s.get('sector_code', ''),\n+                }\n+                reason_groups[reason].append(stock)\n+                day_data['stocks'].append(stock)\n+\n+            for reason, stocks in reason_groups.items():\n+                day_data['ranking'].append({\n+                    'sector_code': stocks[0].get('sector_code', ''),\n+                    'sector_name': reason,\n+                    'stock_count': len(stocks),\n+                    'stocks': stocks\n+                })\n+            print(f\"  涨停板块: {len(day_data['ranking'])}个, 涨停股: {len(day_data['stocks'])}只\")\n+        else:\n+            # 历史日期: 用get_sector_ranking(注意: API返回固定9板块, 非真实历史数据)\n+            try:\n+                ranking = crawler.get_sector_ranking(date=date)\n+                if ranking and ranking.get('sectors'):\n+                    summary = ranking.get('summary', {})\n+                    day_data['summary'] = summary\n+                    for sec in ranking['sectors']:\n+                        sector_info = {\n+                            'sector_code': sec.get('sector_code', ''),\n+                            'sector_name': sec.get('sector_name', ''),\n+                            'stock_count': len(sec.get('stocks', [])),\n+                            'stocks': []\n+                        }\n+                        for s in sec.get('stocks', []):\n+                            stock = {\n+                                'code': s.get('股票代码', ''),\n+                                'name': s.get('股票名称', ''),\n+                                'limit_up_reason': s.get('涨停原因', ''),\n+                                'concepts': s.get('概念标签', ''),\n+                                'consecutive': s.get('连板天数', ''),\n+                                'consecutive_count': s.get('连板次数', ''),\n+                                'theme': s.get('主题', ''),\n+                                'seal_amount': s.get('封单额', 0),\n+                                'main_capital': s.get('主力资金', 0),\n+                                'limit_up_time': s.get('首次封板时间', ''),\n+                                'circulating_mv': s.get('流通市值', 0),\n+                                'total_mv': s.get('总市值', 0),\n+                                'is_first_board': s.get('是否首板', False),\n+                            }\n+                            sector_info['stocks'].append(stock)\n+                            day_data['stocks'].append(stock)\n+                        day_data['ranking'].append(sector_info)\n+                    print(f\"  涨停板块: {len(day_data['ranking'])}个, 涨停股: {len(day_data['stocks'])}只 (历史数据, API限制)\")\n+            except Exception as e:\n+                print(f\"  get_sector_ranking失败: {e}\")\n+\n+        time.sleep(0.5)\n+\n+        # 2. 连板梯队(get_consecutive_limit_up, timeout=8s per call)\n+        try:\n+            ladder = crawler.get_consecutive_limit_up(date=date, timeout=8)\n+            if ladder and ladder.get('ladder'):\n+                day_data['ladder'] = {\n+                    'max_consecutive': ladder.get('max_consecutive', 0),\n+                    'max_stocks': ladder.get('max_consecutive_stocks', []),\n+                    'max_concepts': ladder.get('max_consecutive_concepts', []),\n+                    'ladder': {}\n+                }\n+                for height, stocks in ladder.get('ladder', {}).items():\n+                    day_data['ladder']['ladder'][height] = stocks\n+                print(f\"  连板梯队: 最高{day_data['ladder']['max_consecutive']}板\")\n+        except Exception as e:\n+            print(f\"  get_consecutive_limit_up失败: {e}\")\n+\n+        time.sleep(0.5)\n+\n+        # 3. 炸板股(get_historical_broken_limit_up)\n+        try:\n+            broken = crawler.get_historical_broken_limit_up(date=date)\n+            if broken:\n+                day_data['broken'] = [{\n+                    'code': s.get('stock_code', ''),\n+                    'name': s.get('stock_name', ''),\n+                    'change_pct': s.get('change_pct', 0),\n+                    'limit_up_time': s.get('limit_up_time', ''),\n+                    'open_time': s.get('open_time', ''),\n+                    'yesterday_consecutive': s.get('yesterday_consecutive_text', ''),\n+                    'sector': s.get('sector', ''),\n+                    'main_capital': s.get('main_capital_net', 0),\n+                    'turnover': s.get('turnover_amount', 0),\n+                } for s in broken]\n+                print(f\"  炸板股: {len(day_data['broken'])}只\")\n+        except Exception as e:\n+            print(f\"  get_historical_broken_limit_up失败: {e}\")\n+\n+        time.sleep(0.5)\n+\n+        # 4. 大幅回撤(get_sharp_withdrawal)\n+        try:\n+            withdrawal = crawler.get_sharp_withdrawal(date=date)\n+            if withdrawal is not None and len(withdrawal) > 0:\n+                day_data['withdrawal'] = []\n+                for _, row in withdrawal.iterrows():\n+                    day_data['withdrawal'].append({\n+                        'code': str(row.get('股票代码', '')),\n+                        'name': str(row.get('股票名称', '')),\n+                        'change_pct': float(row.get('当日涨跌幅(%)', 0) or 0),\n+                        'pullback': float(row.get('回撤幅度(%)', 0) or 0),\n+                    })\n+                print(f\"  大幅回撤: {len(day_data['withdrawal'])}只\")\n+        except Exception as e:\n+            print(f\"  get_sharp_withdrawal失败: {e}\")\n+\n+        time.sleep(0.5)\n+\n+        all_data[date] = day_data\n+\n+    return all_data\n+\n+\n+def collect_sector_news(top_sectors, growth_sectors):\n+    \"\"\"获取板块要闻\"\"\"\n+    all_news = {'top': [], 'growth': []}\n+\n+    for label, sectors_list in [('top', top_sectors), ('growth', growth_sectors)]:\n+        for code, name, strength in sectors_list:\n+            print(f\"  获取板块要闻: {name} ({code})\")\n+            try:\n+                result = crawler.get_plate_news(plate_id=code, page_size=15)\n+                if result and result.get('news_list'):\n+                    all_news[label].append({\n+                        'sector_code': code,\n+                        'sector_name': name,\n+                        'strength': strength,\n+                        'news': result['news_list'][:10]\n+                    })\n+                    print(f\"    {len(result['news_list'])}条要闻\")\n+                else:\n+                    all_news[label].append({\n+                        'sector_code': code, 'sector_name': name,\n+                        'strength': strength, 'news': []\n+                    })\n+            except Exception as e:\n+                print(f\"    失败: {e}\")\n+            time.sleep(1)\n+\n+    return all_news\n+\n+\n+def get_top_sectors(conn, today):\n+    \"\"\"获取今日强度前3和增长前3的板块\"\"\"\n+    # 今日强度前3\n+    top3 = conn.execute(\n+        \"SELECT sector_code, sector_name, strength FROM sector_strength WHERE date=? ORDER BY strength DESC LIMIT 3\",\n+        (today,)\n+    ).fetchall()\n+\n+    # 找昨天的日期\n+    yest_date_row = conn.execute(\n+        \"SELECT date FROM sector_strength WHERE date < ? ORDER BY date DESC LIMIT 1\",\n+        (today,)\n+    ).fetchone()\n+    growth3 = []\n+    if yest_date_row:\n+        yesterday = yest_date_row[0]\n+        growth_rows = conn.execute(\"\"\"\n+            SELECT a.sector_code, a.sector_name, (a.strength - b.strength) as growth\n+            FROM sector_strength a\n+            JOIN sector_strength b ON a.sector_code = b.sector_code\n+            WHERE a.date = ? AND b.date = ?\n+            ORDER BY growth DESC LIMIT 3\n+        \"\"\", (today, yesterday)).fetchall()\n+        growth3 = [(r[0], r[1], r[2]) for r in growth_rows]\n+\n+    return top3, growth3\n+\n+\n+def generate_frequent_stocks_html(frequent_stocks):\n+    \"\"\"生成高频涨停个股表格HTML\"\"\"\n+    rows = []\n+    for i, (code, v) in enumerate(frequent_stocks):\n+        if len(v['dates']) < 2:\n+            continue\n+        reasons = ', '.join(v['reasons'])[:50]\n+        concepts = ' '.join(f'<span class=\"tag tag-blue\">{c}</span>' for c in list(v['concepts'])[:5])\n+        sectors = ', '.join(v['sectors'])[:40]\n+        rows.append(f'<tr><td>{i+1}</td><td style=\"color:#0984e3;\">{code}</td><td style=\"color:#fff;\">{v[\"name\"]}</td><td style=\"color:#e74c3c;font-weight:bold;\">{len(v[\"dates\"])}</td><td style=\"color:#fdcb6e;\">{v[\"max_consecutive\"]}板</td><td>{reasons}</td><td>{concepts}</td><td style=\"color:#888;font-size:12px;\">{sectors}</td></tr>')\n+    return ''.join(rows)\n+\n+\n+def generate_html(all_data, news_data, dates):\n+    \"\"\"生成涨停个股分析HTML\"\"\"\n+    today = datetime.now().strftime('%Y-%m-%d')\n+    now_str = datetime.now().strftime('%Y-%m-%d %H:%M:%S')\n+\n+    # 统计汇总\n+    total_stocks = sum(len(d['stocks']) for d in all_data.values())\n+    total_broken = sum(len(d.get('broken', [])) for d in all_data.values())\n+    total_withdrawal = sum(len(d.get('withdrawal', [])) for d in all_data.values())\n+    all_stock_codes = set()\n+    for d in all_data.values():\n+        for s in d['stocks']:\n+            all_stock_codes.add(s['code'])\n+\n+    # 按板块统计\n+    sector_stats = {}\n+    for date, day_data in all_data.items():\n+        for sec in day_data.get('ranking', []):\n+            code = sec['sector_code']\n+            if code not in sector_stats:\n+                sector_stats[code] = {'name': sec['sector_name'], 'days': 0, 'total_stocks': 0}\n+            sector_stats[code]['days'] += 1\n+            sector_stats[code]['total_stocks'] += sec['stock_count']\n+\n+    top_sectors = sorted(sector_stats.items(), key=lambda x: x[1]['total_stocks'], reverse=True)[:15]\n+\n+    # 按涨停原因统计\n+    reason_stats = {}\n+    for date, day_data in all_data.items():\n+        for s in day_data.get('stocks', []):\n+            reason = s.get('limit_up_reason', '未知')\n+            if reason not in reason_stats:\n+                reason_stats[reason] = {'count': 0, 'stocks': set()}\n+            reason_stats[reason]['count'] += 1\n+            reason_stats[reason]['stocks'].add(s['code'])\n+\n+    top_reasons = sorted(reason_stats.items(), key=lambda x: x[1]['count'], reverse=True)[:20]\n+\n+    # 个股统计(出现多次的)\n+    stock_stats = {}\n+    for date, day_data in all_data.items():\n+        for s in day_data.get('stocks', []):\n+            code = s['code']\n+            if code not in stock_stats:\n+                stock_stats[code] = {\n+                    'name': s['name'], 'dates': [], 'reasons': set(),\n+                    'concepts': set(), 'max_consecutive': 0, 'sectors': set()\n+                }\n+            stock_stats[code]['dates'].append(date)\n+            if s.get('limit_up_reason'):\n+                stock_stats[code]['reasons'].add(s['limit_up_reason'])\n+            if s.get('concepts'):\n+                stock_stats[code]['concepts'].update(s['concepts'].split('、'))\n+            consec = s.get('consecutive', '')\n+            if isinstance(consec, str) and '板' in consec:\n+                try:\n+                    n = int(''.join(filter(str.isdigit, consec)))\n+                    stock_stats[code]['max_consecutive'] = max(stock_stats[code]['max_consecutive'], n)\n+                except:\n+                    pass\n+            for sec in day_data.get('ranking', []):\n+                for st in sec.get('stocks', []):\n+                    if st['code'] == code:\n+                        stock_stats[code]['sectors'].add(sec['sector_name'])\n+\n+    # 按出现次数排序\n+    frequent_stocks = sorted(stock_stats.items(), key=lambda x: len(x[1]['dates']), reverse=True)[:30]\n+\n+    html = f\"\"\"<!DOCTYPE html>\n+<html lang=\"zh-CN\">\n+<head>\n+<meta charset=\"UTF-8\">\n+<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n+<title>涨停个股深度分析 {today}</title>\n+<style>\n+* {{ margin: 0; padding: 0; box-sizing: border-box; }}\n+body {{ background: #0d1117; color: #e0e0e0; font-family: 'Microsoft YaHei', sans-serif; padding: 15px; max-width: 1400px; margin: 0 auto; }}\n+h1 {{ color: #fff; font-size: 22px; margin-bottom: 5px; }}\n+h2 {{ color: #00b894; font-size: 18px; margin: 20px 0 10px; padding-bottom: 5px; border-bottom: 2px solid #1e2433; }}\n+h3 {{ color: #fdcb6e; font-size: 15px; margin: 15px 0 8px; }}\n+.meta {{ color: #888; font-size: 12px; margin-bottom: 15px; }}\n+.summary {{ display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; margin-bottom: 20px; }}\n+.summary-card {{ background: #161b22; padding: 12px; border-radius: 6px; border: 1px solid #1e2433; }}\n+.summary-card .num {{ font-size: 24px; font-weight: bold; color: #00b894; }}\n+.summary-card .label {{ font-size: 12px; color: #888; margin-top: 3px; }}\n+table {{ width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 15px; }}\n+th {{ background: #161b22; padding: 8px; text-align: left; color: #aaa; border-bottom: 2px solid #333; position: sticky; top: 0; }}\n+td {{ padding: 6px 8px; border-bottom: 1px solid #1e2433; }}\n+tr:hover {{ background: #111827; }}\n+.tag {{ display: inline-block; background: #1e2433; padding: 2px 6px; border-radius: 3px; font-size: 11px; margin: 1px; }}\n+.tag-red {{ color: #e74c3c; }}\n+.tag-yellow {{ color: #fdcb6e; }}\n+.tag-green {{ color: #2ecc71; }}\n+.tag-blue {{ color: #0984e3; }}\n+.news-item {{ background: #161b22; padding: 10px; border-radius: 4px; margin-bottom: 8px; border-left: 3px solid #00b894; }}\n+.news-title {{ color: #fff; font-size: 14px; margin-bottom: 3px; }}\n+.news-meta {{ color: #666; font-size: 11px; }}\n+.news-content {{ color: #aaa; font-size: 12px; margin-top: 5px; }}\n+.sector-news {{ display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 15px; }}\n+.day-section {{ background: #0f1419; border-radius: 8px; padding: 15px; margin-bottom: 15px; border: 1px solid #1e2433; }}\n+.day-header {{ display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }}\n+.day-date {{ color: #fff; font-size: 16px; font-weight: bold; }}\n+.day-stats {{ color: #888; font-size: 12px; }}\n+.ladder-badge {{ display: inline-block; background: #2d3436; padding: 3px 8px; border-radius: 3px; margin: 2px; font-size: 12px; }}\n+.ladder-badge .height {{ color: #e74c3c; font-weight: bold; }}\n+</style>\n+</head>\n+<body>\n+<h1>涨停个股深度分析</h1>\n+<div class=\"meta\">数据范围: {dates[0]} ~ {dates[-1]} | 更新时间: {now_str} | 数据源: KPL</div>\n+\n+<div class=\"summary\">\n+    <div class=\"summary-card\"><div class=\"num\">{len(dates)}</div><div class=\"label\">交易日</div></div>\n+    <div class=\"summary-card\"><div class=\"num\">{total_stocks}</div><div class=\"label\">涨停总次数</div></div>\n+    <div class=\"summary-card\"><div class=\"num\">{len(all_stock_codes)}</div><div class=\"label\">涨停个股数</div></div>\n+    <div class=\"summary-card\"><div class=\"num\">{total_broken}</div><div class=\"label\">炸板总次数</div></div>\n+    <div class=\"summary-card\"><div class=\"num\">{total_withdrawal}</div><div class=\"label\">大幅回撤次数</div></div>\n+    <div class=\"summary-card\"><div class=\"num\">{len(sector_stats)}</div><div class=\"label\">涉及板块数</div></div>\n+    <div class=\"summary-card\"><div class=\"num\">{len(reason_stats)}</div><div class=\"label\">涨停原因数</div></div>\n+</div>\n+\n+<h2>一、板块要闻</h2>\n+<div class=\"sector-news\">\n+    <div>\n+        <h3>今日强度前3板块要闻</h3>\n+        {generate_news_html(news_data.get('top', []))}\n+    </div>\n+    <div>\n+        <h3>今日增长前3板块要闻</h3>\n+        {generate_news_html(news_data.get('growth', []))}\n+    </div>\n+</div>\n+\n+<h2>二、涨停原因(细分板块)排行</h2>\n+<table>\n+<tr><th>排名</th><th>涨停原因</th><th>涨停次数</th><th>涉及个股</th></tr>\n+{''.join(f'<tr><td>{i+1}</td><td style=\"color:#fdcb6e;\">{name}</td><td style=\"color:#e74c3c;font-weight:bold;\">{v[\"count\"]}</td><td>{len(v[\"stocks\"])}只</td></tr>' for i, (name, v) in enumerate(top_reasons))}\n+</table>\n+\n+<h2>三、板块涨停统计</h2>\n+<table>\n+<tr><th>排名</th><th>板块</th><th>出现天数</th><th>涨停总次数</th></tr>\n+{''.join(f'<tr><td>{i+1}</td><td style=\"color:#00b894;\">{v[\"name\"]}</td><td>{v[\"days\"]}</td><td style=\"color:#e74c3c;font-weight:bold;\">{v[\"total_stocks\"]}</td></tr>' for i, (code, v) in enumerate(top_sectors))}\n+</table>\n+\n+<h2>四、高频涨停个股(出现2次以上)</h2>\n+<table>\n+<tr><th>排名</th><th>代码</th><th>名称</th><th>涨停天数</th><th>最大连板</th><th>涨停原因</th><th>概念标签</th><th>所属板块</th></tr>\n+{generate_frequent_stocks_html(frequent_stocks)}\n+</table>\n+\n+<h2>五、每日涨停详情</h2>\n+{''.join(generate_day_html(date, day_data) for date, day_data in sorted(all_data.items(), reverse=True))}\n+\n+</body>\n+</html>\"\"\"\n+    return html\n+\n+\n+def generate_news_html(news_list):\n+    if not news_list:\n+        return '<div style=\"color:#666;padding:10px;\">暂无要闻数据</div>'\n+    html = ''\n+    for item in news_list:\n+        html += f'<div style=\"margin-bottom:15px;\"><div style=\"color:#00b894;font-weight:bold;margin-bottom:5px;\">{item[\"sector_name\"]} (强度:{item.get(\"strength\",0)})</div>'\n+        if item.get('news'):\n+            for n in item['news'][:5]:\n+                type_color = '#e74c3c' if n.get('type') == 1 else '#0984e3'\n+                type_name = n.get('type_name', '')\n+                html += f'<div class=\"news-item\"><div class=\"news-title\">{n.get(\"title\",\"\")}</div><div class=\"news-meta\">{n.get(\"datetime\",\"\")} | <span style=\"color:{type_color};\">{type_name}</span></div><div class=\"news-content\">{n.get(\"content\",\"\")[:150]}...</div></div>'\n+        else:\n+            html += '<div style=\"color:#555;font-size:12px;padding:5px;\">无要闻</div>'\n+        html += '</div>'\n+    return html\n+\n+\n+def fmt_amt(v):\n+    \"\"\"格式化金额: 亿/万\"\"\"\n+    try:\n+        v = float(v or 0)\n+        if v == 0:\n+            return '-'\n+        if abs(v) >= 1e8:\n+            return f'{v/1e8:.2f}亿'\n+        if abs(v) >= 1e4:\n+            return f'{v/1e4:.1f}万'\n+        return f'{v:.0f}'\n+    except:\n+        return '-'\n+\n+\n+def generate_day_html(date, day_data):\n+    stocks = day_data.get('stocks', [])\n+    broken = day_data.get('broken', [])\n+    withdrawal = day_data.get('withdrawal', [])\n+    ladder = day_data.get('ladder', {})\n+    summary = day_data.get('summary', {})\n+\n+    # 连板梯队\n+    ladder_html = ''\n+    if ladder and ladder.get('ladder'):\n+        for height in sorted(ladder['ladder'].keys(), key=lambda x: int(x) if str(x).isdigit() else 0, reverse=True):\n+            stocks_list = ladder['ladder'][height]\n+            if isinstance(stocks_list, list):\n+                stock_names = ', '.join([f'{s.get(\"股票代码\",\"\")}{s.get(\"股票名称\",\"\")}' if isinstance(s, dict) else str(s) for s in stocks_list[:5]])\n+                ladder_html += f'<span class=\"ladder-badge\"><span class=\"height\">{height}板</span> {stock_names}</span>'\n+\n+    # 涨停股表格(含封单额/主力资金/流通市值等)\n+    stocks_html = ''\n+    if stocks:\n+        stocks.sort(key=lambda x: x.get('consecutive_count', 0), reverse=True)\n+        for s in stocks:\n+            consec = s.get('consecutive', '')\n+            consec_color = '#e74c3c' if ('3' in str(consec) or '4' in str(consec) or '5' in str(consec)) else ('#fdcb6e' if '2' in str(consec) else '#aaa')\n+            concepts_html = ' '.join(f'<span class=\"tag tag-blue\">{c}</span>' for c in s.get('concepts', '').split('、')[:4] if c)\n+            seal = fmt_amt(s.get('seal_amount', 0))\n+            main_cap = fmt_amt(s.get('main_capital', 0))\n+            circ_mv = fmt_amt(s.get('circulating_mv', 0))\n+            main_color = '#e74c3c' if (s.get('main_capital', 0) or 0) > 0 else '#2ecc71'\n+            stocks_html += f'<tr><td style=\"color:#0984e3;\">{s[\"code\"]}</td><td style=\"color:#fff;\">{s[\"name\"]}</td><td style=\"color:{consec_color};font-weight:bold;\">{consec}</td><td style=\"color:#fdcb6e;font-size:12px;\">{s.get(\"limit_up_reason\",\"\")}</td><td>{concepts_html}</td><td style=\"color:#666;font-size:12px;\">{seal}</td><td style=\"color:{main_color};font-size:12px;\">{main_cap}</td><td style=\"color:#888;font-size:12px;\">{circ_mv}</td><td style=\"color:#888;font-size:12px;\">{s.get(\"limit_up_time\",\"\")}</td></tr>'\n+\n+    # 炸板股\n+    broken_html = ''\n+    if broken:\n+        for b in broken[:15]:\n+            broken_html += f'<tr><td style=\"color:#e74c3c;\">{b[\"code\"]}</td><td>{b[\"name\"]}</td><td style=\"color:#e74c3c;\">{b.get(\"change_pct\",0):.2f}%</td><td style=\"color:#888;font-size:12px;\">{b.get(\"limit_up_time\",\"\")}</td><td style=\"color:#888;font-size:12px;\">{b.get(\"open_time\",\"\")}</td><td style=\"color:#888;font-size:12px;\">{b.get(\"yesterday_consecutive\",\"\")}</td><td style=\"color:#888;font-size:12px;\">{b.get(\"sector\",\"\")}</td><td style=\"color:#666;font-size:12px;\">{fmt_amt(b.get(\"main_capital\",0))}</td><td style=\"color:#666;font-size:12px;\">{fmt_amt(b.get(\"turnover\",0))}</td></tr>'\n+\n+    # 大幅回撤股\n+    withdrawal_html = ''\n+    if withdrawal:\n+        for w in withdrawal[:10]:\n+            withdrawal_html += f'<tr><td style=\"color:#fdcb6e;\">{w[\"code\"]}</td><td>{w[\"name\"]}</td><td style=\"color:#e74c3c;\">{w.get(\"change_pct\",0):.2f}%</td><td style=\"color:#e74c3c;font-weight:bold;\">{w.get(\"pullback\",0):.2f}%</td></tr>'\n+\n+    stats_parts = [f'涨停{len(stocks)}只', f'炸板{len(broken)}只']\n+    if withdrawal:\n+        stats_parts.append(f'回撤{len(withdrawal)}只')\n+    if summary:\n+        stats_parts.append(f'{summary.get(\"涨停数\",0)}涨停/{summary.get(\"跌停数\",0)}跌停')\n+\n+    return f\"\"\"\n+<div class=\"day-section\">\n+    <div class=\"day-header\">\n+        <div class=\"day-date\">{date}</div>\n+        <div class=\"day-stats\">{' | '.join(stats_parts)}</div>\n+    </div>\n+    {f'<div style=\"margin-bottom:10px;\"><span style=\"color:#888;font-size:12px;\">连板梯队:</span> {ladder_html}</div>' if ladder_html else ''}\n+    <table>\n+    <tr><th>代码</th><th>名称</th><th>连板</th><th>涨停原因</th><th>概念标签</th><th>封单额</th><th>主力净额</th><th>流通市值</th><th>封板时间</th></tr>\n+    {stocks_html}\n+    </table>\n+    {f'<h3 style=\"color:#e74c3c;\">炸板股 ({len(broken)}只)</h3><table><tr><th>代码</th><th>名称</th><th>涨跌幅</th><th>封板时间</th><th>开板时间</th><th>昨日连板</th><th>板块</th><th>主力净额</th><th>成交额</th></tr>{broken_html}</table>' if broken_html else ''}\n+    {f'<h3 style=\"color:#fdcb6e;\">大幅回撤 ({len(withdrawal)}只)</h3><table><tr><th>代码</th><th>名称</th><th>涨跌幅</th><th>回撤幅度</th></tr>{withdrawal_html}</table>' if withdrawal_html else ''}\n+</div>\"\"\"\n+\n+\n+def main():\n+    dates = get_trading_dates()\n+    print(f\"过去10个交易日: {dates}\")\n+\n+    # 1. 采集涨停数据\n+    all_data = collect_limit_up_data(dates)\n+\n+    # 2. 获取板块要闻\n+    conn = sqlite3.connect(DB)\n+    today = dates[-1]\n+    top3, growth3 = get_top_sectors(conn, today)\n+    print(f\"\\n今日强度前3: {[(n, s) for _, n, s in top3]}\")\n+    print(f\"今日增长前3: {[(n, g) for _, n, g in growth3]}\")\n+    conn.close()\n+\n+    news_data = collect_sector_news(top3, growth3)\n+\n+    # 3. 生成HTML\n+    html = generate_html(all_data, news_data, dates)\n+    _time_tag = datetime.now().strftime('%Y%m%d-%H%M')\n+    html_path = OUTPUT / f'涨停个股深度分析_{_time_tag}.html'\n+    html_path.write_text(html, encoding='utf-8')\n+    print(f\"\\nHTML报告已生成: {html_path}\")\n+    print(f\"文件大小: {html_path.stat().st_size / 1024:.0f}KB\")\n+\n+if __name__ == '__main__':\n+    main()"}]}