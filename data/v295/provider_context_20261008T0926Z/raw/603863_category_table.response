{"version":"9350e5197e3715f5ac16e61557a3db9f","result":{"pages":1,"data":[{"SECUCODE":"603863.SH","SECURITY_CODE":"603863","SECURITY_NAME_ABBR":"松炀资源","BOARD_CODE":"677","BOARD_NAME":"粤港自贸","SELECTED_BOARD_REASON":"公司注册地址位于广东省汕头市澄海区，主要从事环保再生纸的研发、生产和销售。","IS_PRECISE":"1","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0677","DERIVE_BOARD_CODE":"BI0677","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603863.SH","SECURITY_CODE":"603863","SECURITY_NAME_ABBR":"松炀资源","BOARD_CODE":"671","BOARD_NAME":"彩票概念","SELECTED_BOARD_REASON":"2024年年报显示，2024年10月15日，公司分别召开第四届董事会第十八次会议及第四届监事会第十三次会议，审议通过了《关于全资孙公司对外投资暨关联交易的议案》，为更好地贯彻公司战略目标及多元化发展的需求，进一步推进公司彩票业务的发展，公司全资孙公司乐动科技拟与金陵乐彩（海南）科技有限公司及其原股东金陵乐彩科技有限公司签订《投资协议》，乐动科技拟使用自有资金2,000.00万元人民币对金陵乐彩（海南）科技有限公司进行增资，认购其新增注册资本2,000.00万元。","IS_PRECISE":"1","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0671","DERIVE_BOARD_CODE":"BI0671","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603863.SH","SECURITY_CODE":"603863","SECURITY_NAME_ABBR":"松炀资源","BOARD_CODE":"494","BOARD_NAME":"节能环保","SELECTED_BOARD_REASON":"主要从事环保再生纸。","IS_PRECISE":"1","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0494","DERIVE_BOARD_CODE":"BI0494","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603863.SH","SECURITY_CODE":"603863","SECURITY_NAME_ABBR":"松炀资源","BOARD_CODE":"470","BOARD_NAME":"造纸印刷","SELECTED_BOARD_REASON":"2025年半年报显示，公司主要从事环保再生纸的研发、生产和销售，是一家集废纸回收、环保造纸及涂布成型于一体，形成资源再生利用价值链的造纸企业，致力于为轻工制造、物流运输、电子商务、商业流通等下游应用领域客户提供中高档、高性能、绿色环保的包装纸及各种功能用纸。公司主要产品包括高强度瓦楞纸、特种纸（热敏纸等）、白板纸等。","IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0470","DERIVE_BOARD_CODE":"BI0470","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603863.SH","SECURITY_CODE":"603863","SECURITY_NAME_ABBR":"松炀资源","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1633","DERIVE_BOARD_CODE":"BI1633","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603863.SH","SECURITY_CODE":"603863"