{"ssbk":[{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"1210","BOARD_NAME":"交通运输","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"450","BOARD_NAME":"航运港口","IS_PRECISE":"0","BOARD_RANK":2},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"1482","BOARD_NAME":"航运","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"159","BOARD_NAME":"江苏板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"1668","BOARD_NAME":"小盘价值","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"1643","BOARD_NAME":"小盘股","IS_PRECISE":"0","BOARD_RANK":6},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"823","BOARD_NAME":"养老金","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"707","BOARD_NAME":"沪股通","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"596","BOARD_NAME":"融资融券","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"552","BOARD_NAME":"机构重仓","IS_PRECISE":"0","BOARD_RANK":10},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"712","BOARD_NAME":"一带一路","IS_PRECISE":"1","BOARD_RANK":11},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","BOARD_CODE":"683","BOARD_NAME":"央国企改革","IS_PRECISE":"1","BOARD_RANK":12}],"hxtc":[{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"国内沿海、长江中下游及支流省际油船运输;国际船舶危险品运输;台湾海峡两岸间海上直航不定期货物运输;国际船舶管理;汽油、煤油、柴油批发;油轮船舶机务、海务管理;船舶检修、保养;船舶买卖、租赁、营运及资产管理;船舶技术服务、修理;工业生产资料(燃料油、润滑油、沥青)销售;经营各类商品和技术的进出口业务(国家限定企业经营或禁止进出口的商品及技术除外)。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"干货运输、液货运输、集装箱运输","MAINPOINT":3,"MAINPOINT_CONTENT":"水上运输业按照运送货物的不同又可以细分为干货运输、液货运输和集装箱运输：干货运输包括件杂货运输和散货运输等，液货运输包括原油运输、成品油运输、液化气运输、化学品运输和沥青运输等。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"油轮运输行业","MAINPOINT":4,"MAINPOINT_CONTENT":"招商南油是招商局集团旗下从事油轮运输的专业化公司。公司实施“专业化、差异化、领先化”的发展战略，市场定位为全球中小船型液货运输服务商，立足于液货运输主业，秉承并聚焦于成品油、原油、化学品、气体运输等具有相对优势的市场领域，拓展船员劳务等关联业务，努力形成“油化气协同、内外贸兼营、江海洋直达”的业务格局，增强公司的核心竞争力、抵御风险和穿越周期的能力，建设成为全球领先的中小船型液货运输服务商。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"油化气综合运输解决方案能力突出","MAINPOINT":5,"MAINPOINT_CONTENT":"油化气综合运输解决方案能力突出。招商南油是国内领先的拥有国际国内油化气运输资质的水运企业。公司拥有国际、国内沿海、长江中下游及支流原油、成品油、化工品、气体等全产品运输服务资质，能够为石化客户提供原料进厂、产成品出厂的油化气综合运输服务解决方案。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"内外贸兼营优势明显","MAINPOINT":6,"MAINPOINT_CONTENT":"内外贸兼营优势明显。招商南油船舶不仅具有国内原油、成品油、化工品和气体运输资质，且五星旗船舶还具有内外贸兼营的资质。内外贸兼营，一方面可利用自身优势更好地调节船队运营，平衡内外贸货源的不均衡，减少船舶等待时间，提高船舶运行效率，从而提高船舶收益；另一方面通过内外贸兼营，有效防范单边市场运作风险，提高自身市场竞争力。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"大客户优质资源得到保障","MAINPOINT":7,"MAINPOINT_CONTENT":"大客户优质资源得到保障。招商南油重视大客户战略的执行，与大石油公司建立了良好的合作关系，已与美孚、中石油、中石化等公司签订了长期优质COA合同，具有优质货源保障。与其他国际大油公司和贸易商等优质客户建立长期稳定合作关系。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"市场地位及品牌突出","MAINPOINT":8,"MAINPOINT_CONTENT":"市场地位及品牌突出。目前招商南油在细分市场的市场地位和品牌优势明显，MR船队在国内及苏伊士运河以东区域规模占据优势地位，国际成品油运输已成为远东地区成品油运输市场的领先者，在国际市场具备良好的品牌声誉。作为最大的MR内贸成品油船东，竞争优势明显。原油运输（含燃料油）在国内和近洋区域占据重要位置，目前位列国内第二；化工品运输规模位居国内第一梯队，管船能力位列国内前列；乙烯特种气体运输保持国内经营先发优势。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"船舶管理、船员劳务等配套资源国内领先","MAINPOINT":9,"MAINPOINT_CONTENT":"船舶管理、船员劳务等配套资源国内领先。招商南油拥有综合素质高、数量充足的船舶管理专业人员，船舶管理经验丰富，资质齐全，具备良好的开展油船、化学品船、乙烯船等国内、国际船舶代管业务的条件。公司拥有国内领先的优质规模化和专业化的船员队伍，在保障自用船员的基础上，开展船员外派劳务条件优异。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"股份锁定","MAINPOINT":12,"MAINPOINT_CONTENT":"招商局集团、中外运长航集团均已出具承诺函,承诺:“本公司直接或者间接持有的长航油运股份,自长航油运股票重新上市后的三十六个月内将不会转让、委托他人管理或者由长航油运回购;但转让双方存在控制关系,或者均受同一实际控制人控制的,将依据届时中国证监会和上海证券交易所的相关规定处理。”公司相关董事、监事及高级管理人员均已出具承诺:“本人直接或间接持有的公司股份(如有)自公司股票重新上市之日起十二个月内不会转让或者由公司回购”。","KEY_CLASSIF":"自愿锁定","KEY_CLASSIF_CODE":"008005","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"实际控制人情况","MAINPOINT":10,"MAINPOINT_CONTENT":"公司实际控制人为招商局集团有限公司。招商局集团是国务院国资委直接管理的国有重要骨干企业,经营总部设于香港,亦被列为香港四大中资企业之一。招商局集团业务主要集中于交通运输及相关基础设施建设、经营与服务,金融投资与管理,房地产开发与园区经营等三大核心产业,主要分布于中国内地、中国香港、东南亚等极具活力和潜力的新兴市场。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"控股股东情况","MAINPOINT":11,"MAINPOINT_CONTENT":"公司的控股股东为中国外运长航集团有限公司,实际控制人为招商局集团有限公司,最终控制人为国务院国资委。外运长航集团的主要经营业务分为四大板块,分别为物流、航运、船舶重工及资源培育。中外运长航集团的物流业务包括海、陆、空货运代理、船务代理、快递、仓码、合同物流、冷链物流、汽车运输、大陆桥运输和金融物流等;中外运长航集团是由中国物流标准委员会审定的国内唯一的5A级综合服务型物流企业。中外运长航集团的航运业务包括干散货运输、石油等液货运输、集装箱运输、滚装船运输、件杂货运输、船舶管理、燃油贸易、船员培训及派遣等,是我国内河骨干航运企业。中外运长航集团的船舶重工业务具备以船舶建造和修理、港口机械、电机产品为核心的工业体系。资源培育业务主要包括物流地产、金融服务以及创新型业务等,与其他主营业务互为交叉和支持。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"},{"SECUCODE":"601975.SH","SECURITY_CODE":"601975","SECURITY_NAME_ABBR":"招商南油","KEYWORD":"股价稳定措施","MAINPOINT":13,"MAINPOINT_CONTENT":"中外运长航集团已出具《关于长航油运重新上市后稳定股价的承诺函》,承诺:重新上市后6个月内如长航油运股票连续20个交易日收盘价低于基准价格(每股4.31元)的50%,中外运长航集团持有的长航油运股票锁定期将自动延长6个月。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}