{"version":"7ae6aab070b29031b49f5aa3a194c8ee","result":{"pages":1,"data":[{"SECUCODE":"002951.SZ","SECURITY_CODE":"002951","SECURITY_NAME_ABBR":"金时科技","BOARD_CODE":"989","BOARD_NAME":"储能概念","SELECTED_BOARD_REASON":"2024年年报摘要显示，公司现阶段主要进行储能系统设备的研发、生产、销售，主要产品为分布式液冷储能一体机、分布式风冷储能一体机、集装箱式储能系统等，目前主推分布式液冷储能一体机，可为客户提供高安全性、高经济性新能源储能解决方案，满足不同用户储能需求。","IS_PRECISE":"1","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0989","DERIVE_BOARD_CODE":"BI0989","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002951.SZ","SECURITY_CODE":"002951","SECURITY_NAME_ABBR":"金时科技","BOARD_CODE":"937","BOARD_NAME":"蚂蚁金服概念","SELECTED_BOARD_REASON":"2025年6月6日回复称，公司在2025年1月与蚂蚁数科签署的是关于新能源业务领域方面的合作框架协议，目前合作模式尚在探索中，暂未开展实质性业务。","IS_PRECISE":"1","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0937","DERIVE_BOARD_CODE":"BI0937","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002951.SZ","SECURITY_CODE":"002951","SECURITY_NAME_ABBR":"金时科技","BOARD_CODE":"804","BOARD_NAME":"深股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0804","DERIVE_BOARD_CODE":"BI0804","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002951.SZ","SECURITY_CODE":"002951","SECURITY_NAME_ABBR":"金时科技","BOARD_CODE":"703","BOARD_NAME":"超级电容","SELECTED_BOARD_REASON":"2021年3月24日公告显示公司与自然人杨维清共同投资设立四川金时新能科技有限公司,金时新能拟组建专业团队开展超级电容器相关业务,超级电容器是指介于传统电容器和充电电池之间的一种新型储能装置。","IS_PRECISE":"1","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0703","DERIVE_BOARD_CODE":"BI0703","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002951.SZ","SECURITY_CODE":"002951","SECURITY_NAME_ABBR":"金时科技","BOARD_CODE":"169","BOARD_NAME":"四川板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0169","DERIVE_BOARD_CODE":"BI0169","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"002951.SZ","SECURITY_CODE":"002951","SECURITY_NAME_ABBR":"金时科技","BOARD_CODE":"1322","BOARD_NAME":"其他电源设备Ⅲ","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIE