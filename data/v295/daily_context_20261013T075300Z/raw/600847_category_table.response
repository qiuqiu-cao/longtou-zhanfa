{"version":"41885239387865166b38579d35fa4f92","result":{"pages":1,"data":[{"SECUCODE":"600847.SH","SECURITY_CODE":"600847","SECURITY_NAME_ABBR":"万里股份","BOARD_CODE":"989","BOARD_NAME":"储能概念","SELECTED_BOARD_REASON":"2025年12月31日公告显示，重庆万里新能源股份有限公司下属全资子公司北京万电新能源有限公司拟与北京普凯世杰投资咨询有限公司、北京普凯世纪投资管理有限公司签署《关于北京普凯世纪储能科技有限公司的100%股权转让协议》，以现金900万元收购北京普凯世纪储能科技有限公司100%股权。普凯世纪储能成立于2023年，主营业务为围绕电池为核心的光储充一体化解决方案。光伏项目指公司作为光伏站的投资方，将光伏设备所发电量以约定价格销售给合作方；储能项目指公司投资建设储能站，合作方使用储能站节约的波峰波谷电价差与公司进行节能分成；充电桩项目指公司作为充电桩建设方，与合作方就充电桩的充电服务收入进行分成。","IS_PRECISE":"1","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0989","DERIVE_BOARD_CODE":"BI0989","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600847.SH","SECURITY_CODE":"600847","SECURITY_NAME_ABBR":"万里股份","BOARD_CODE":"590","BOARD_NAME":"西部大开发","SELECTED_BOARD_REASON":"注册地址是重庆市江津区双福街道创业路26号。","IS_PRECISE":"1","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0590","DERIVE_BOARD_CODE":"BI0590","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600847.SH","SECURITY_CODE":"600847","SECURITY_NAME_ABBR":"万里股份","BOARD_CODE":"534","BOARD_NAME":"成渝特区","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0534","DERIVE_BOARD_CODE":"BI0534","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600847.SH","SECURITY_CODE":"600847","SECURITY_NAME_ABBR":"万里股份","BOARD_CODE":"170","BOARD_NAME":"重庆板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0170","DERIVE_BOARD_CODE":"BI0170","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"600847.SH","SECURITY_CODE":"600847","SECURITY_NAME_ABBR":"万里股份","BOARD_CODE":"1306","BOARD_NAME":"蓄电池及其他电池","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1306","DERIVE_BOARD_CODE":"BI1306","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"600847.SH","SECURITY_CODE":"600847","SECURITY_NAME_ABBR":"万里股份","BOARD_CODE":"1200","BOARD_NAME":"电力设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":