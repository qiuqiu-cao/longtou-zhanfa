{"version":"8e9ebd0cb70daf45ef8f8336ddf42023","result":{"pages":1,"data":[{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"993","BOARD_NAME":"宠物经济","SELECTED_BOARD_REASON":"2020年年报显示公司子公司丰乐宠物(杭州)有限责任公司,主要从事宠物玩具、用品销售。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0993","DERIVE_BOARD_CODE":"BI0993","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"972","BOARD_NAME":"快手概念","SELECTED_BOARD_REASON":"2024年半年报显示，实丰网络凭借其在 Web 端及手机端的多款游戏开发经验，以及对快手游戏平台的深耕，为快手用户打造了一系列高品质的休闲游戏，深受广大用户的喜爱和好评。在2024快手磁力引擎游戏行业峰会上，实丰网络荣获了“光芒之翼奖”。 ","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0972","DERIVE_BOARD_CODE":"BI0972","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"954","BOARD_NAME":"盲盒经济","SELECTED_BOARD_REASON":"2024年年报显示，公司一直积极与重磅优质IP合作，目前已取得国际IP宝可梦、游戏IP蛋仔派对、手游IP贪吃蛇大作战、动画IP超级飞侠、国漫IP奶龙、表情包IP小刘鸭、奇魔猪、萌二、乖巧宝宝等热门IP的正版授权，已开发的宝可梦场景套装玩具系列、可达鸭款（电动）、奶龙款（电动）玩具、贪吃蛇惊喜盲盒正热销中。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0954","DERIVE_BOARD_CODE":"BI0954","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"812","BOARD_NAME":"贬值受益","SELECTED_BOARD_REASON":"公司境外收入占比大于50%。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0812","DERIVE_BOARD_CODE":"BI0812","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"809","BOARD_NAME":"AI智能体","SELECTED_BOARD_REASON":"2024年年报显示，2024年，公司新一代AI玩具——AI魔法星正式上线预售，AI魔法星是基于AIGC技术，运用豆包先进的大模型底层，进行二次训练出符合儿童对话习惯且脱离敏感话题的后台，智能语音交互系统的植入，让玩具可与孩子进行流畅对话，不仅能解答孩子的各种疑问，还能根据孩子的语言反馈做出个性化回应，极大地提升了玩具的互动性与趣味性。","IS_PRECISE":"1","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0809","DERIVE_BOARD_CODE":"BI0809","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2024年1月8日回复称,公司一直致力于智能玩具的研发,先后研发智能机器狗、教育机器人与智能飞飞兔等AI玩具。近日,一款全新的陪伴型智能机器人——智能小怪兽也正式上市。这款产品拥有仿真悬浮车轮、可实现66组互动动作(活动摆臂、特技表演等)、智能编程设定专属动作、点阵屏形式展现丰富萌趣表情。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"665","BOARD_NAME":"电商概念","SELECTED_BOARD_REASON":"2020年半年报显示公司电商团队在阿里1688、阿里天猫、京东自营、孩子王、拼多多平台均有开设店铺。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0665","DERIVE_BOARD_CODE":"BI0665","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"664","BOARD_NAME":"婴童概念","SELECTED_BOARD_REASON":"公司主要产品包括电动遥控玩具、婴幼玩具、车模玩具、动漫游戏衍生品玩具和其他玩具五大类,产品规格品种达1,000多种,产品出口到全球近百个国家和地区。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0664","DERIVE_BOARD_CODE":"BI0664","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"588","BOARD_NAME":"光伏概念","SELECTED_BOARD_REASON":"2023年2月28日回复称公司参股公司超隆光电截止目前实际落地四条目前行业较先进的光伏组件生产线,总体产能为2.5GW,专业生产182和210电池的各类高效组件,产能利用率维持较高水平。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0588","DERIVE_BOARD_CODE":"BI0588","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SECURITY_NAME_ABBR":"实丰文化","BOARD_CODE":"509","BOARD_NAME":"网络游戏","SELECTED_BOARD_REASON":"2025年年报显示，2025 年度，公司凭借在游戏领域的持续创新突破与亮眼实战成果，荣获“年度商业突破奖”奖项，在荣耀首届全球开发者大会暨AI终端生态大会，公司游戏板块获评“荣耀游戏中心-最佳小游戏伙伴奖”。公司还登上引力引擎「2025年中国小游戏100 强企业榜」。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0509","DERIVE_BOARD_CODE":"BI0509","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002862.SZ","SECURITY_CODE":"002862","SE