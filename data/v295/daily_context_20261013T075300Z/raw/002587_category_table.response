{"version":"5aeb5f2f7b8539fe3b60f20eab25d393","result":{"pages":1,"data":[{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"948","BOARD_NAME":"MicroLED","SELECTED_BOARD_REASON":"2025年年报显示，公司microled项目研发投入1,200,000.00元。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0948","DERIVE_BOARD_CODE":"BI0948","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"902","BOARD_NAME":"MiniLED","SELECTED_BOARD_REASON":"2025年年报显示，2025年1月3日，公司召开第五届董事会第二十四次会议、第五届监事会第二十一次会议，并于2025年1月22日召开2025年第一次临时股东大会审议通过了《关于部分募投项目结项并将节余募集资金永久补充流动资金的议案》，同意公司对“MiniLED智能制造基地建设项目”结项并将节余募集资金用于永久补充流动资金，用于公司日常生产经营活动。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0902","DERIVE_BOARD_CODE":"BI0902","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"860","BOARD_NAME":"边缘计算","SELECTED_BOARD_REASON":"2022年半年报显示在新技术应用方面,公司成功中标“中国邮政储蓄银行大数据平台安全防护系统工程AI信息安全系统”项目,首次将边缘计算技术用于银行信息安全系统。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0860","DERIVE_BOARD_CODE":"BI0860","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"859","BOARD_NAME":"超清视频","SELECTED_BOARD_REASON":"2020年7月29日回复称公司研发的4K、8K、64K图像控制系统大大地满足了超高清、超极清显示的要求,是行业里领先的水平。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0859","DERIVE_BOARD_CODE":"BI0859","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2023年10月12日回复称,公司为华为提供过LED显示解决方案及相关产品。同时,全资子公司南京奥拓自主开发的智能营销播控、智能客户分流等平台应用软件,完成华为及统信的产品适配认证,配合公司自主设计生产的排队机、LCD、LED等硬件产品,服务于金融、通讯、广告等各种需要排队分流和营销互动展示的行业客户。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"830","BOARD_NAME":"区块链","SELECTED_BOARD_REASON":"控股子公司上海翰明计算机科技有限公司区块链的银企账务核对系统已在使用,此前已正式获得国家版权局《基于区块链技术的电子对账系统软件V1.0》著作权证书;与深圳市和信中欧金融科技研究院正式签署了共同推动区块链技术及应用的战略合作协议;与毕马威企业咨询(中国)有限公司积极推进区块链技术在传统金融产品中应用探索和研究,共同与台州银行三方进行区块链技术研发,将区块链技术应用于银行和企业客户的账务核对业务中.","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0830","DERIVE_BOARD_CODE":"BI0830","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"801","BOARD_NAME":"增强现实","SELECTED_BOARD_REASON":"2024年1月3日投资者关系活动记录表显示,公司的数字内容业务主要由控股子公司创想数维负责,创想数维成立于2021年,是一家以小型化XR虚拟直播解决方案为核心,Metabox虚拟直播间、XR技术服务和数字资产生成为主要业务的科技赋能型企业,产品及技术服务广泛应用于直播、短视频、教育、金融、文娱等市场。MetaBox解决方案具备沉浸式空间透视、相机追踪、动作捕捉(数字人)、实时渲染、扩展现实、AR特效等功能;可实现直播短视频虚拟制作、数字人/数字道具实时互动,可应用于TVC广告、综艺演出、虚拟发布会、活动等方面。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0801","DERIVE_BOARD_CODE":"BI0801","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2023年2月1日回复称公司全资子公司南京奥拓是华为云AI认证合作伙伴,将不断的推动公司智能视讯业务与人工智能技术的结合。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"722","BOARD_NAME":"虚拟现实","SELECTED_BOARD_REASON":"公司控股子公司创想数维致力于在XR虚拟拍摄、裸眼3D、数字虚拟内容、沉浸式空间创意视觉呈现及交互应用等多方面为客户提供相关的内容产品及服务。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0722","DERIVE_BOARD_CODE":"BI0722","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"708","BOARD_NAME":"体育产业","SELECTED_BOARD_REASON":"2014年1月,公司与德国公司LANG AG签订LED全彩色显示产品销售合同,将用于2014年6月12日-7月13日在巴西举行的FIFA巴西世界杯项目。 2016年3月16日晚间公告,近日公司与中国足球协会的全资子公司中国福特宝足球产业发展公司签署了《中国足协中国之队LED服务商合作协议》。奥拓电子为中国足协中国之队系列赛事独家提供LED显示设备及其比赛期间的相关服务。此外,奥拓电子为福特宝提供中国足协超级杯赛比赛用屏。协议有效期自2016年3月1日起至2020年3月1日止。","IS_PRECISE":"1","BOARD_RANK":25,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0708","DERIVE_BOARD_CODE":"BI0708","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"696","BOARD_NAME":"国产软件","SELECTED_BOARD_REASON":"2022年10月31日回复称全资子公司南京奥拓自主开发的智能营销播控、智能客户分流等平台应用软件,完成华为及统信的产品适配认证,配合公司自主设计生产的排队机、LCD、LED等硬件产品,服务于金融、通讯、广告等各种需要排队分流和营销互动展示的行业客户。","IS_PRECISE":"1","BOARD_RANK":26,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0696","DERIVE_BOARD_CODE":"BI0696","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"666","BOARD_NAME":"苹果概念","SELECTED_BOARD_REASON":"2023年2月15日回复称公司主要为苹果、腾讯、微软、奈飞、亚马逊等众多世界500强企业提供了XR虚拟拍摄解决方案。","IS_PRECISE":"1","BOARD_RANK":27,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0666","DERIVE_BOARD_CODE":"BI0666","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"662","BOARD_NAME":"在线教育","SELECTED_BOARD_REASON":"2024年6月7日回复称，作为拥有“硬件+软件+内容”综合能力的智能视讯解决方案提供商，目前解决方案已覆盖影视、金融及通信、租赁及体育、广告商业、数字内容、智慧教育、政企、光艺文旅等细分领域。","IS_PRECISE":"1","BOARD_RANK":28,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0662","DERIVE_BOARD_CODE":"BI0662","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"637","BOARD_NAME":"互联网金融","SELECTED_BOARD_REASON":"2019年年报显示参股公司深圳市鹏鼎创盈金融信息服务股份有限公司主要依托互联网手段提供金融中介服务。","IS_PRECISE":"1","BOARD_RANK":29,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0637","DERIVE_BOARD_CODE":"BI0637","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002587.SZ","SECURITY_CODE":"002587","SECURITY_NAME_ABBR":"奥拓电子","BOARD_CODE":"628","BOARD_NAME":"智慧城市","SELECTED_BOARD_REASON":"2020年半年报显示公司的智慧照明业务主要涵盖智慧城市景观亮化工程、智慧照明控制平台、智慧灯杆集成及平台开发等业务领域。","IS_PRECISE":"1","