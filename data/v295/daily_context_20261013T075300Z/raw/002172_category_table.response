{"version":"88e26d062b8b0a6d5a61d3a5d36cd649","result":{"pages":1,"data":[{"SECUCODE":"002172.SZ","SECURITY_CODE":"002172","SECURITY_NAME_ABBR":"澳洋健康","BOARD_CODE":"996","BOARD_NAME":"毛发医疗","SELECTED_BOARD_REASON":"2021年6月11日回复称公司子公司唯恩医疗美容包含植发业务。","IS_PRECISE":"1","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0996","DERIVE_BOARD_CODE":"BI0996","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002172.SZ","SECURITY_CODE":"002172","SECURITY_NAME_ABBR":"澳洋健康","BOARD_CODE":"939","BOARD_NAME":"辅助生殖","SELECTED_BOARD_REASON":"2021年5月12日回复称公司下属澳洋医院为三级综合医院,包含辅助生殖业务。","IS_PRECISE":"1","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0939","DERIVE_BOARD_CODE":"BI0939","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002172.SZ","SECURITY_CODE":"002172","SECURITY_NAME_ABBR":"澳洋健康","BOARD_CODE":"889","BOARD_NAME":"医美概念","SELECTED_BOARD_REASON":"2020年11月18日回复称公司控股子公司张家港唯恩医疗美容医院是由张家港市卫生部门审批的专科医疗美容医院,集医疗美容、皮肤美容、美容中医科于一体,具有多年临床整形经验。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0889","DERIVE_BOARD_CODE":"BI0889","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002172.SZ","SECURITY_CODE":"002172","SECURITY_NAME_ABBR":"澳洋健康","BOARD_CODE":"852","BOARD_NAME":"冷链物流","SELECTED_BOARD_REASON":"2020年7月29日回复称公司下属子公司医药物流具有医药冷链物流配送能力。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0852","DERIVE_BOARD_CODE":"BI0852","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002172.SZ","SECURITY_CODE":"002172","SECURITY_NAME_ABBR":"澳洋健康","BOARD_CODE":"806","BOARD_NAME":"精准医疗","SELECTED_BOARD_REASON":"  2015年11月公告,公司拟出资2000万元对上海吉凯基因化学技术有限公司进行增资,其中22.7303万元计入吉凯基因注册资本,其余计入其资本公积。本次增资完成后,吉凯基因注册资本由增加至1136.5145万元,公司持有其2%股权。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0806","DERIVE_BOARD_CODE":"BI0806","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002172.SZ","SECURITY_CODE":"002172","SECURITY_NAME_ABBR":"澳洋健康","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"公司官网介绍,公司通过外部资源整合深度捆绑苏州沃奇人工智能科技有限公司,成