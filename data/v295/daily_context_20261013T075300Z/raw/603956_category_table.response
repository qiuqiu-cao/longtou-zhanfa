{"version":"608dc68b8f9fa725ceb2de2c5d8f6a43","result":{"pages":1,"data":[{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"910","BOARD_NAME":"专用设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0910","DERIVE_BOARD_CODE":"BI0910","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"877","BOARD_NAME":"PCB","SELECTED_BOARD_REASON":"2026年8月10日回复称，威派格于近期以增资方式取得安徽提曼科技有限公司51.02%股权，已取得其控制权并纳入合并报表范围。安徽提曼主要产品系PCB微型钻针等，本次投资属于公司经营管理层审批权限内事项。目前该领域对公司营收贡献占比较低，不会对公司经营业绩产生重大影响。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0877","DERIVE_BOARD_CODE":"BI0877","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2023年11月16日回复称，公司与华为就智慧水务项目已有多年合作关系，于2021年3月27日共同发布了\"威派格-华为智慧水务一体化解决方案\"。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"834","BOARD_NAME":"乡村振兴","SELECTED_BOARD_REASON":"2022年12月30日回复称威派格作为一家以智慧水务为核心的上市公司,自2019年开始涉足农村供水领域,提供从水源头到水龙头全生命周期产品,其中威派格帮助浙江安吉县打造的城乡供水数字化监管平台、北京门头沟斋堂自来水厂项目荣登中国水利部农村供水红榜,成为水利部农村供水典型案例。威派格自主研发的城乡供水风险识别与管控软件技术入选2022年水利先进实用技术重点推广目录。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0834","DERIVE_BOARD_CODE":"BI0834","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"832","BOARD_NAME":"工业互联网","SELECTED_BOARD_REASON":"2025年11月21日回复称，公司深耕于智慧水务行业、以工业互联网为核心理念，并深度融合人工智能等前沿技术的集成性公司。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0832","DERIVE_BOARD_CODE":"BI0832","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"817","BOARD_NAME":"昨日触板","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0817","DERIVE_BOARD_CODE":"BI0817","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"809","BOARD_NAME":"AI智能体","SELECTED_BOARD_REASON":"2024年年度股东大会会议资料显示，报告期内，公司发布“威派格河图AI”平台，以平台化的思想打造水务智能化底座，深度融合大语言模型、NLP、机器学习、知识图谱等前沿技术，构建算法平台、知识平台及水务专用大模型，用于解决“从源头到龙头”各领域智能检测、调度、预测、故障诊断等问题。“威派格河图AI”平台行业算法库覆盖管网、二供、污水、营销等多领域数据，应用层聚焦智慧水务业务场景，包括智慧水厂、智慧管网、智慧营销、智慧工单等应用方向，深入水务管理的多个垂直场景，“威派格河图AI”平台的推出加速水务行业从经验驱动向数据智能驱动的跨越，可帮助企业提升运营效能，激发水务企业智能化转型的内在活力。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0809","DERIVE_BOARD_CODE":"BI0809","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2023年3月22日回复称公司基于人工智能技术项目已逐步进入落地阶段,在水务、水利等垂直领域的人工智能应用已具备一定市场竞争力。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"597","BOARD_NAME":"水利建设","SELECTED_BOARD_REASON":"在水利端,公司主要软件产品包括水利大数据平台、数字孪生流域、物联网平台、水雨情测报系统、灌区综合管控系统等;硬件产品包括遥测终端机、雷达水位计、雷达流速仪等。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0597","DERIVE_BOARD_CODE":"BI0597","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"554","BOARD_NAME":"物联网","SELECTED_BOARD_REASON":"2023年3月3日回复称物联网设备管理平台具有智能协议接入、数据分析、预警监测、远程控制等能力,具备实时高并发采集处理300物联网设备信息能力。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0554","DERIVE_BOARD_CODE":"BI0554","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1673","BOARD_NAME":"破增发价股","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1673","DERIVE_BOARD_CODE":"BI1673","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1633","DERIVE_BOARD_CODE":"BI1633","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1631","BOARD_NAME":"昨日炸板","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1631","DERIVE_BOARD_CODE":"BI1631","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1629","BOARD_NAME":"AI应用","SELECTED_BOARD_REASON":"2025年11月21日回复称，公司核心定位是利用包括AI在内的新一代信息技术，切实解决水务企业在生产、运营、管理和服务全链条中的痛点与难点。","IS_PRECISE":"1","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1629","DERIVE_BOARD_CODE":"BI1629","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"145","BOARD_NAME":"上海板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0145","DERIVE_BOARD_CODE":"BI0145","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1405","BOARD_NAME":"其他专用设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1405","DERIVE_BOARD_CODE":"BI1405","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1205","BOARD_NAME":"机械设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1205","DERIVE_BOARD_CODE":"BI1205","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1188","BOARD_NAME":"DeepSeek概念","SELECTED_BOARD_REASON":"2025年2月10日回复称,公司始终聚焦技术创新,致力于推动智慧水务行业的数字化发展。威派格研究院自2024年就开始对DeepSeek进行研究。目前,公司研发的“河图 AI” 平台产品已接入包括DeepSeek、智谱GLM等多款大模型,支持多用户交互及图文、视频等多模态数据处理,并广泛应用于智慧水厂、管网调度、智慧营销等多场景,以提升供水全流程的智能检测、调度优化、趋势预测和故障诊断能力,助力水务企业降本增效、优化资源配置。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1188","DERIVE_BOARD_CODE":"BI1188","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1104","BOARD_NAME":"信创","SELECTED_BOARD_REASON":"2021年年报显示威派格基于公司发展现状及发展目标,紧紧围绕高质量发展转型的主基调,坚持将高质量发展贯穿始末,加大对智慧水务的技术研发投入,致力于打造全国领先的集“智能硬件+专业软件+水务平台+行业物联网+全面服务”五位一体的智慧水务综合解决方案提供商。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1104","DERIVE_BOARD_CODE":"BI1104","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1090","BOARD_NAME":"机器人概念","SELECTED_BOARD_REASON":"2025年4月22日回复称，公司最新研发的四足机器人巡检技术，是结合智慧水务场景需求推出的创新解决方案，旨在帮助客户提升水厂运营的安全性和效率。目前机身由第三方提供，该技术搭载公司自主研发的AI平台，集成多光谱视觉、音频传感等功能，可应用于复杂高危环境下的无人巡检，对水厂内的表计偏差、跑冒滴漏、异常积水、控制故障、非法闯入、通道阻塞、异常噪声、水池漂浮物、有毒有害气体等情况进行有效监测。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1090","DERIVE_BOARD_CODE":"BI1090","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1068","BOARD_NAME":"净水概念","SELECTED_BOARD_REASON":"2023年2月2日回复称公司致力于综合运用物联网、大数据、自动化、云计算以及移动互联网等新一代信息技术提升水务行业的信息化、智能化建设,助力水务行业快速打通信息孤岛,充分发挥数据价值,提高各类水务活动的数字化、自动化、智能化管理水平,为水务行业落实国家节能节水行动计划、防治水污染、提高城乡供水服务水平等提供支持,实现从传统服务到智能化的转型升级,并在以安全可靠、节能降耗、智慧管理为建设目标的基础上,为中国老百姓提供安全健康的饮用水。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1068","DERIVE_BOARD_CODE":"BI1068","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1061","BOARD_NAME":"数字经济","SELECTED_BOARD_REASON":"2021年年报显示威派格基于公司发展现状及发展目标,紧紧围绕高质量发展转型的主基调,坚持将高质量发展贯穿始末,加大对智慧水务的技术研发投入,致力于打造全国领先的集“智能硬件+专业软件+水务平台+行业物联网+全面服务”五位一体的智慧水务综合解决方案提供商。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1061","DERIVE_BOARD_CODE":"BI1061","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1058","BOARD_NAME":"地下管网","SELECTED_BOARD_REASON":"2026年6月17日回复称，公司始终紧跟国家战略导向，核心服务于国家“六张网”中的水网、城市地下管网：在水网建设领域，公司致力于提供从源头到龙头的智慧水务整体解决方案，覆盖城乡供水一体化、农村饮用水安全提升等关键环节；在城市地下管网领域，公司的水泵、智慧泵房、管网漏损控制及分区计量系统等产品方案，可直接服务于全国老旧管网改造与二次供水设施升级。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1058","DERIVE_BOARD_CODE":"BI1058","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603956.SH","SECURITY_CODE":"603956","SECURITY_NAME_ABBR":"威派格","BOARD_CODE":"1005","BOARD_NAME":"专精特新","SELECTED_BOARD_REASON":"公司已入选工信部国家级专精特新小巨人企业名单。","IS_PRECISE":null,"BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1005","DERIVE_BOARD_CODE":"BI1005","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":24},"success":true,"message":"ok","code":0}