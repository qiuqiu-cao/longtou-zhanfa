{"version":"1f9630b9320085e84f817559b53f09aa","result":{"pages":1,"data":[{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"940","BOARD_NAME":"网红经济","SELECTED_BOARD_REASON":"在6月9日的合作发布会上,风语筑和安徽广电宣布达成深度战略合作伙伴关系,并就沉浸式网红直播空间、区域经济直播电商产业、超高清视频直播等领域展开合作,将共同出资设立MCN合资公司,拓展“沉浸式直播+短视频+区域经济电商”新零售供应链生态圈,并将联手打造全国首个沉浸式网红直播基地。","IS_PRECISE":"1","BOARD_RANK":28,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0940","DERIVE_BOARD_CODE":"BI0940","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"879","BOARD_NAME":"标准普尔","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0879","DERIVE_BOARD_CODE":"BI0879","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"861","BOARD_NAME":"数字孪生","SELECTED_BOARD_REASON":"2021年11月10日公开资料显示风语筑正式布局元宇宙赛道,拟将浙江深白数字科技有限公司更名为浙江风语宙数字科技有限公司,该公司专注对VR、AR、XR、数字虚拟人、3D渲染、沉浸式交互、数字孪生等技术的研发与应用。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0861","DERIVE_BOARD_CODE":"BI0861","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"859","BOARD_NAME":"超清视频","SELECTED_BOARD_REASON":"2019年年报显示公司与VR影视行业领军企业为快科技,5G+8K超高清视频应用企业极清慧视签署参股投资意向协议。公司将联合为快科技和极清慧视,共同推动VR影视内容及超高清视频编解码以及5G传输技术在数字文化产业的应用。","IS_PRECISE":"1","BOARD_RANK":25,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0859","DERIVE_BOARD_CODE":"BI0859","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2023年7月26日回复称，华为是公司商业端的客户，公司曾为华为建设过多个数字化体验中心。","IS_PRECISE":"1","BOARD_RANK":26,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"845","BOARD_NAME":"百度概念","SELECTED_BOARD_REASON":"2023年3月16日回复称，公司是文心一言的首批生态合作伙伴，公司已与百度签署战略合作协议共同探索并推进AIGC在文字、图片、音视频以及虚拟人、虚拟空间模型生成等3D内容场景的模型训练、落地应用和模型优化。","IS_PRECISE":"1","BOARD_RANK":27,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0845","DERIVE_BOARD_CODE":"BI0845","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"722","BOARD_NAME":"虚拟现实","SELECTED_BOARD_REASON":"公司拥有一支拥有丰富创意设计经验和专业数字技术知识的复合型人才队伍,在设计师负责制的基础上,充分运用数字沙盘、虚拟现实、动感影院特效技术和多媒体互动技术等高科技数字化展示技术,通过一体化全程控制运作服务整合各项资源,完成了一批具有市场影响力的展览展示系统项目,积累了丰富的项目实施经验和成功案例,在行业内建立了良好的知名度,为公司不断开拓市场打下了良好的基础。","IS_PRECISE":"1","BOARD_RANK":29,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0722","DERIVE_BOARD_CODE":"BI0722","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"706","BOARD_NAME":"脑机接口","SELECTED_BOARD_REASON":"2026年4月25日公告显示，公司与强脑科技（BrainCo）深化合作，运用数字化创意将非侵入式脑机接口（BCI）技术转化为可感知的沉浸式科普体验，实现尖端脑科学技术在数字展示空间的具象化应用。","IS_PRECISE":"1","BOARD_RANK":30,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0706","DERIVE_BOARD_CODE":"BI0706","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"699","BOARD_NAME":"全息技术","SELECTED_BOARD_REASON":"2019年报称,公司目前已掌握了人工智能、行业大数据、虚拟现实、全息成像等诸多高科技数字化展示技术的应用。","IS_PRECISE":"1","BOARD_RANK":31,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0699","DERIVE_BOARD_CODE":"BI0699","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"692","BOARD_NAME":"旅游概念","SELECTED_BOARD_REASON":"2025年2月7日回复称，公司先后在湖州潞村和荻港古镇等地打造了《典籍里的中国》《艺术里的中国》《非遗里的中国》等文化体验空间，成为湖州特色文化旅游的新热点。","IS_PRECISE":"1","BOARD_RANK":32,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0692","DERIVE_BOARD_CODE":"BI0692","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"528","BOARD_NAME":"转债标的","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0528","DERIVE_BOARD_CODE":"BI0528","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"509","BOARD_NAME":"网络游戏","SELECTED_BOARD_REASON":"2021年12月13日公开资料显示灵境绿洲近日宣布完成千万级人民币融资,本轮融资由风语筑投资。零境互娱是一家互联网泛娱乐文化创意服务商,具有游戏研发及发行,原创动漫IP打造、VR以及美术外包等业务线。","IS_PRECISE":"1","BOARD_RANK":33,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0509","DERIVE_BOARD_CODE":"BI0509","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"486","BOARD_NAME":"传媒","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0486","DERIVE_BOARD_CODE":"BI0486","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1749","BOARD_NAME":"2026中报预增","SELECTED_BOARD_REASON":"预计2026年1-6月归属于上市公司股东的净利润盈利:9,000万元至13,500万元。","IS_PRECISE":null,"BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1749","DERIVE_BOARD_CODE":"BI1749","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"145","BOARD_NAME":"上海板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0145","DERIVE_BOARD_CODE":"BI0145","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1295","BOARD_NAME":"其他数字媒体","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1295","DERIVE_BOARD_CODE":"BI1295","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1221","BOARD_NAME":"数字媒体","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1221","DERIVE_BOARD_CODE":"BI1221","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1188","BOARD_NAME":"DeepSeek概念","SELECTED_BOARD_REASON":"2025年2月7日回复称,公司目前已接入ChatGPT、文心一言、豆包AI和DeepSeek等国内外通用大模型,并已结合自身内容创意需求和数据安全需要完成了私有化部署,预期将会有效协助公司创意、策划、设计、CG渲染和3D内容生成、交互技术等团队为客户提供提质增效的服务。","IS_PRECISE":"1","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1188","DERIVE_BOARD_CODE":"BI1188","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1186","BOARD_NAME":"首发经济","SELECTED_BOARD_REASON":"公司是中国数字展示行业的龙头企业,致力于成为国内领先的数字化体验服务商。依托公司在数字科技应用领域的技术优势及公司在数字艺术、沉浸式体验领域积累的资源,公司的产品及服务广泛应用于数字展示、城市文化体验、数字文旅、商业展览及新零售体验、广电MCN及数字营销等众多领域。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1186","DERIVE_BOARD_CODE":"BI1186","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1184","BOARD_NAME":"人形机器人","SELECTED_BOARD_REASON":"2026年4月25日公告显示，公司依托线下数千座展馆场景优势，加速具身智能（EmbodiedAI）从技术研发走向规模化商业应用。依托风语筑具身智能研究院，运用空间计算技术提升机器人在复杂环境下的敏捷交互与环境感知能力，实现人形机器人在导览、演绎场景的常态化运营。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1184","DERIVE_BOARD_CODE":"BI1184","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1143","BOARD_NAME":"空间计算","SELECTED_BOARD_REASON":"2023年06月09日回复称空间计算技术目前主要应用于公司3D建模、实时渲染、交互设计和虚拟体验等业务环节,在三维数字沙盘、VR/AR/MR虚拟空间、数字人定位跟踪交互、AIGC人机交互等场景有广泛使用。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1143","DERIVE_BOARD_CODE":"BI1143","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1142","BOARD_NAME":"裸眼3D","SELECTED_BOARD_REASON":"2022年12月14日回复称裸眼3D、全息影像、VR/AR、实时渲染等前沿视觉技术手段广泛应用于公司各类数字化体验项目以及虚实结合的沉浸式数字文旅项目中,此外公司还拥有专业的VFX视效团队用于沉浸式体验的打造。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1142","DERIVE_BOARD_CODE":"BI1142","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1141","BOARD_NAME":"混合现实","SELECTED_BOARD_REASON":"公司业务包括数字化产品及服务主要通过全息影像、裸眼 3D、 CGI 特效等技术手段, AR/VR/MR、 4K/8K 超高清视频等媒介形式,为客户和消费者提供商业展览、数字艺术消费品及各类数字视觉服务。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1141","DERIVE_BOARD_CODE":"BI1141","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1135","BOARD_NAME":"数据要素","SELECTED_BOARD_REASON":"2023年9月8日回复称,公司储备了大量数字视觉模型、三维影视动画数字模型、倾斜摄影数字城市模型、数字文物模型、元宇宙数字模型、数字历史文物模型等数据。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1135","DERIVE_BOARD_CODE":"BI1135","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1126","BOARD_NAME":"ChatGPT概念","SELECTED_BOARD_REASON":"2023年2月14日回复称公司参股公司星图比特发挥本土团队在中文强化学习和本土合规方面的优势,围绕OpenAIGPT模型在NLP自然语言处理领域进行研发和应用。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1126","DERIVE_BOARD_CODE":"BI1126","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1111","BOARD_NAME":"AIGC概念","SELECTED_BOARD_REASON":"2024年年报显示，公司积极拥抱AI人工智能和数字化转型，利用先进工具实现各环节AI智能化升级，提高生产与工作效率。在创意设计方面，AI生成内容（AIGC）技术将辅助创意策划和内容生产，缩短设计周期，提升设计效率，并实现展览内容的实时迭代。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1111","DERIVE_BOARD_CODE":"BI1111","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1080","BOARD_NAME":"新型城镇化","SELECTED_BOARD_REASON":"2024年年报显示，报告期内，公司锚定城市更新与存量空间数字化再造的发展机遇，系统性整合设计、艺术、展览与数字化内容资源，深度介入文化遗址活化、工业遗存改造、历史保护建筑功能再造及历史文化街区复兴等领域，通过沉浸式体验内容和IP，有效盘活低效存量空间。依托在3D内容生成、空间计算及多模态交互领域的技术优势。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1080","DERIVE_BOARD_CODE":"BI1080","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1061","BOARD_NAME":"数字经济","SELECTED_BOARD_REASON":"2020年年报显示公司是中国领先的数字化体验服务商。依托公司强大的创意、设计和内容制作能力,结合长年积累的CG特效、人机交互、裸眼3D、全息影像、5G云XR、AI人工智能、大数据可视化等关键技术手段,公司的产品及系统广泛应用于政务服务、城市文化体验、数字展示、文化旅游、广电MCN、新零售体验及数字艺术消费等众多领域。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1061","DERIVE_BOARD_CODE":"BI1061","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1055","BOARD_NAME":"虚拟数字人","SELECTED_BOARD_REASON":"2021年11月8日回复称公司投资设立的浙江深白数字科技有限公司将开展短视频数字营销、CGI视效广告、超高清裸眼3D大屏、虚拟偶像和AI数字人开发及数字IP运营等创新业务。","IS_PRECISE":null,"BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1055","DERIVE_BOARD_CODE":"BI1055","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1022","BOARD_NAME":"职业教育","SELECTED_BOARD_REASON":"2026年半年报显示，在人工智能教育领域，公司围绕人工智能、具身智能等前沿技术推进课程开发和内容产品化，面向不同年龄及应用场景开发相关课程和AI科创研学产品，逐步拓展青少年科普、产业人才培养及职业技能培训等应用场景。报告期后，公司参与共建杭州具身智能培训与考试认证中心，并与宇树科技、浙江大学控制科学与工程学院等单位共同发布首期具身智能实践课程，进一步丰富人工智能教育及具身智能人才培养的课程产品和应用场景。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1022","DERIVE_BOARD_CODE":"BI1022","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603466.SH","SECURITY_CODE":"603466","SECURITY_NAME_ABBR":"风语筑","BOARD_CODE":"1009","BOARD_NAME":"元宇宙概念","SELECTED_BOARD_REASON":"2021年9月7日回复称公司擅长运用VR/AR等虚拟现实技术营造数字化场景、打造沉浸式体验,数字化内容和场景搭建是“元宇宙”相关产业发展的重要环节。此外,公司重视在VR/AR等5G后端应用领域的投资布局,于2020年战略入股VR内容平台公司为快科技(VeeR),共同探索VR+数字展馆、VR+线下体验等新型商业业态。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1009","DERIVE_BOARD_CODE":"BI1009","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":33},"success":true,"message":"ok","code":0}