2","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"151","BOARD_NAME":"福建板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0151","DERIVE_BOARD_CODE":"BI0151","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1400","BOARD_NAME":"制冷空调设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1400","DERIVE_BOARD_CODE":"BI1400","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1205","BOARD_NAME":"机械设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1205","DERIVE_BOARD_CODE":"BI1205","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1192","BOARD_NAME":"雅下水电概念","SELECTED_BOARD_REASON":"2025年7月24日回复称，近年来，公司持续为国家重大水利水电项目关键工程提供设备与技术支持。2024以来，公司承接了林芝市察隅县境内的扎拉水电项目混凝土冷却系统工程，以及雅砻江两河口瓦支沟项目、雅砻江中游第四个梯级水电站孟底沟导流洞项目。公司已参与雅鲁藏布江流域上游的多个水电项目，具备成熟的系统集成经验与交付能力。通过科学调控冷却水温、优化系统能效，公司冷却系统可有效保障混凝土施工质量，提升工程整体可持续性与节能减排效益。本次雅鲁藏布江下游水电工程正式全面启动建设，公司将积极参与该项目投标。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1192","DERIVE_BOARD_CODE":"BI1192","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1185","BOARD_NAME":"冰雪经济","SELECTED_BOARD_REASON":"公司制冰、制冷设备已应用在冰雪运动赛事项目场馆内。近年来已参与多项冰雪项目建设,包括国家雪车雪橇中心、崇礼长城岭滑雪场等。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1185","DERIVE_BOARD_CODE":"BI1185","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1163","BOARD_NAME":"可控核聚变","SELECTED_BOARD_REASON":"2025年12月31日回复称，可控核聚变领域如超导托克马克（人造小太阳）等多项大科学工程必须在液氦到超流氦温区环境下运行，氦气压缩机作为大型低温系统的核心部件，是实现大科学装置低温环境的主要手段。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1163","DERIVE_BOARD_CODE":"BI1163","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1138","BOARD_NAME":"液冷服务器","SELECTED_BOARD_REASON":"2025年2月25日投资者关系活动记录表显示，公司目前已在压缩机制冷设备供应以及重点项目建设两方面介入数据中心业务领域。一方面，公司凭借深厚的压缩机技术积累，构建了多元化的产品线，涵盖了活塞式压缩机、开启式螺杆压缩机、半封闭螺杆压缩机以及离心压缩机等。其中，新型离心压缩机经过多年研发，已开始投放市场，可适用于高能效需求的数据中心。在海外数据中心拓展方面，公司采用低充注的氨制冷技术替代传统氟利昂系统，具备高效节能、环保优势，例如公司为Facebook丹麦数据中心（液冷）提供第三代低充注的氨制冷技术，兼顾环保与能效。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1138","DERIVE_BOARD_CODE":"BI1138","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1109","BOARD_NAME":"供销社概念","SELECTED_BOARD_REASON":"2024年1月8日回复称，公司已为部分省市供销合作社的冷链物流项目提供产品与服务。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1109","DERIVE_BOARD_CODE":"BI1109","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002639.SZ","SECURITY_CODE":"002639","SECURITY_NAME_ABBR":"雪人集团","BOARD_CODE":"1102","BOARD_NAME":"空气能热泵","SELECTED_BOARD_REASON":"2022年7月29日回复称公司热泵产品可用于工业领域生产工艺热水供应及商用集中供暖、供应生活热水领域。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1102","DERIVE_BOARD_CODE":"BI1102","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":31},"success":true,"message":"ok","code":0}