{"ssbk":[{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"1202","BOARD_NAME":"房地产","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"451","BOARD_NAME":"房地产开发","IS_PRECISE":"0","BOARD_RANK":2},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"1346","BOARD_NAME":"住宅开发","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"164","BOARD_NAME":"山东板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"1693","BOARD_NAME":"近期摘帽","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"1672","BOARD_NAME":"破发股","IS_PRECISE":null,"BOARD_RANK":6},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"940","BOARD_NAME":"网红经济","IS_PRECISE":"1","BOARD_RANK":7},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","BOARD_CODE":"665","BOARD_NAME":"电商概念","IS_PRECISE":"1","BOARD_RANK":8}],"hxtc":[{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"许可项目:房地产开发经营;住宅室内装饰装修;施工专业作业。(依法须经批准的项目,经相关部门批准后方可开展经营活动,具体经营项目以相关部门批准文件或许可证件为准)一般项目:住房租赁;非居住房地产租赁;土地使用权租赁;物业管理;建筑物清洁服务;园林绿化工程施工;以自有资金从事投资活动;以私募基金从事股权投资、投资管理、资产管理等活动(须在中国证券投资基金业协会完成登记备案后方可从事经营活动)。(除依法须经批准的项目外,凭营业执照依法自主开展经营活动)。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"房地产业务","MAINPOINT":3,"MAINPOINT_CONTENT":"报告期内，公司主要推进长春国际金融中心（写字楼）销售及北京荣丰嘉园（住宅）项目销售。公司综合考虑政府政策及市场情况，适时调整经营及销售策略，降价促销，提高投资回报，同时加大项目宣传推介力度，采取全员销售、以老带新、以价换量等多种措施，加快存量资产处置。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"跨境物流业务","MAINPOINT":4,"MAINPOINT_CONTENT":"报告期内，公司通过控股子公司荣控伟华开展跨境物流业务。公司聚焦于跨境电商平台客户的国际空运出口全程物流服务，为跨境电商平台客户提供“门到港”及“港到港”的空运物流服务。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"房地产行业","MAINPOINT":5,"MAINPOINT_CONTENT":"2025年，房地产行业仍处于深度调整阶段，行业发展重心正从“房住不炒”逐步向“推动房地产高质量发展”转型。尽管去年房地产开发投资、销售等核心指标同比仍有所回落，但市场已呈现出结构性企稳的积极迹象。中央经济工作会议明确提出“着力稳定房地产市场”，进一步释放出坚定有力的稳楼市政策导向。随着各项政策效应持续释放、市场供求关系逐步改善，房地产市场有望稳步实现筑底企稳，也为房地产企业坚守功能定位、履行社会责任、迈向高质量发展创造了新的机遇。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"丰富的技术、管理和开发经验","MAINPOINT":6,"MAINPOINT_CONTENT":"公司有完善的治理结构，“三会”运作规范，内部管理制度较为系统完整，内部控制程序覆盖经营活动的各个环节，起到了良好的监督促进作用，为公司经营活动的有序开展提供了有力保障。\n房地产业务方面，经过二十多年的发展，公司积累了丰富的技术、管理和开发经验，有较强的创新能力，体现在个性化的设计、个性化的管理、个性化的服务等方面，产品设计、规划理念超前，曾引领全国小户型风潮。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"参股银行","MAINPOINT":7,"MAINPOINT_CONTENT":"公司初始投资1484万元持有长沙银行4745万股,占其总股本的1.81%,截至2015年6月末,期末账面值为1484万元。","KEY_CLASSIF":"对外扩张","KEY_CLASSIF_CODE":"006002","IS_POINT":"1"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"与国厚资产签订战略合作协议","MAINPOINT":9,"MAINPOINT_CONTENT":"2018年12月4日公告,公司与安徽国厚金融资产管理股份有限公司(以下简称国厚资产)签订了《荣丰控股与国厚资产战略合作协议》,双方合资拟设立公司及不良资产母基金,针对具体项目引入优先资金。公司表示,公司签订上述协议,有利于发挥合作双方的优势,为公司打造新的利润增长点,提升持续盈利能力,符合公司及全体股东的利益。","KEY_CLASSIF":"其他扩张","KEY_CLASSIF_CODE":"006004","IS_POINT":"1"},{"SECUCODE":"000668.SZ","SECURITY_CODE":"000668","SECURITY_NAME_ABBR":"荣丰控股","KEYWORD":"参股公司长沙银行IPO获证监会核准","MAINPOINT":8,"MAINPOINT_CONTENT":"2018年8月16日公告,公司控股子公司北京荣丰房地产开发有限公司(以下简称北京荣丰)接到长沙银行通知,长沙银行于10日收到证监会《关于核准长沙银行股份有限公司首次公开发行股票的批复》,核准长沙银行首次公开发行股票。截止到公告日,北京荣丰持有长沙银行4982.51万股,占其首次公开发行前股份总数的1.62%。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}