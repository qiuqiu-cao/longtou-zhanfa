{"ssbk":[{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1214","BOARD_NAME":"社会服务","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1272","BOARD_NAME":"旅游及景区","IS_PRECISE":null,"BOARD_RANK":2},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1562","BOARD_NAME":"人工景区","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"161","BOARD_NAME":"辽宁板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1722","BOARD_NAME":"高市净率","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1750","BOARD_NAME":"2026中报扭亏","IS_PRECISE":null,"BOARD_RANK":6},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"707","BOARD_NAME":"沪股通","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"552","BOARD_NAME":"机构重仓","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1654","BOARD_NAME":"文娱消费","IS_PRECISE":"1","BOARD_RANK":10},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1185","BOARD_NAME":"冰雪经济","IS_PRECISE":"1","BOARD_RANK":11},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"1183","BOARD_NAME":"谷子经济","IS_PRECISE":"1","BOARD_RANK":12},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"485","BOARD_NAME":"旅游酒店","IS_PRECISE":"0","BOARD_RANK":13},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"838","BOARD_NAME":"东北振兴","IS_PRECISE":"1","BOARD_RANK":14},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"692","BOARD_NAME":"旅游概念","IS_PRECISE":"1","BOARD_RANK":15},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"683","BOARD_NAME":"央国企改革","IS_PRECISE":"1","BOARD_RANK":16},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","BOARD_CODE":"525","BOARD_NAME":"参股银行","IS_PRECISE":"0","BOARD_RANK":17}],"hxtc":[{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"建设、经营水族馆、海洋探险人造景观、游乐园、海洋生物标本陈列馆、船舶模型陈列馆、餐饮、营业性演出、水生野生动物驯养繁育(展览展示)、水生野生动物经营利用(展览展示、驯养繁殖展演、科普教育)、国家重点保护野生动物的驯养繁殖(观赏)。(依法须经批准的项目,经相关部门批准后方可开展经营活动。)","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"景区经营","MAINPOINT":3,"MAINPOINT_CONTENT":"报告期内，公司经营的景区为大连圣亚海洋世界景区和哈尔滨极地公园景区。大连圣亚海洋世界景区包括海洋世界、极地世界、珊瑚世界、银河星海、厉害塔；哈尔滨极地公园景区包括海洋馆、极地馆、恐龙馆/异宠馆、淘学企鹅馆，哈尔滨极地公园异宠馆系在原恐龙馆基础上升级改造的场馆，于2025年5月启幕。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"商业运营","MAINPOINT":4,"MAINPOINT_CONTENT":"景区场馆内商业空间对外出租、商业自营、联营等，系公司主营业务之一。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"动物经营","MAINPOINT":5,"MAINPOINT_CONTENT":"动物经营业务主要包括动物租赁和销售，系公司主营业务之一。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"酒店运营","MAINPOINT":6,"MAINPOINT_CONTENT":"酒店运营业务主要包括圣亚企鹅酒店与北极熊酒店，系公司主营业务之一。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"旅游业","MAINPOINT":7,"MAINPOINT_CONTENT":"我国旅游业经历多年发展历程，在资源开发、产品生产、服务体系等构建方面取得了显著成绩，现代旅游业体系日益成熟。政府及有关部门根据市场变化和消费需求不断推出、调整政策支持，有效调动旅游市场的积极性，推动旅游业持续稳步发展。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"产品优势","MAINPOINT":8,"MAINPOINT_CONTENT":"公司两大景区拥有多个特色主题场馆，坚持创新驱动发展，注重旅游产品供给数量扩充及质量升级，不断改造景区软硬件设备设施及深化丰富表演内容，持续优化旅游产业业态与产品品质，提升产品市场竞争力。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"技术优势","MAINPOINT":9,"MAINPOINT_CONTENT":"公司拥有国内水族馆行业一流的技术团队，在行业诸多领域保持创新，拥有国内领先的技术优势。在企鹅饲养繁育领域，公司被授予“国家级南极企鹅种源繁育基地”；在国家一级保护动物斑海豹的野外救助、繁育野化方面，公司拥有领先业内的技术，制定了《斑海豹驯养繁殖行业标准》《斑海豹救助和放归技术规程》等系列标准和技术规程，其中《斑海豹救助和放归技术规程》已被列为辽宁省级地方标准；在其他海洋动物科研领域，公司自行创办海洋生物研究所，专门从事珍稀海洋生物、极地生物、水族生态系统等方向的研究。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"服务优势","MAINPOINT":10,"MAINPOINT_CONTENT":"公司作为资深海洋馆运营公司，拥有丰富服务经验，并不断创新服务举措、升级服务模式，探索实现旅游服务标准化、品牌化，促进服务质量持续提升，让广大游客感受更多的幸福感、获得感，将高质量服务作为推动高质量发展的重要抓手。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"品牌优势","MAINPOINT":11,"MAINPOINT_CONTENT":"作为唯一经营海洋馆的A股上市公司，公司坚持以深耕海洋文化为核心，以公益为载体，以圣亚媒体矩阵为路径，不断增强品牌影响力，维护大连圣亚品牌在市场行业中的知名度与美誉度。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"管理优势","MAINPOINT":12,"MAINPOINT_CONTENT":"公司坚守“安全、环保、专注、效率”的企业基因，倡导“创新、务实、服务、忠诚”的工作精神，将企业文化融入经营管理，创新氛围浓郁，团队凝聚力、执行力强；公司不断优化管理模式，推行实施数字化、智慧化、精细化管理，推动运营效能与游客体验同步提升。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"人才优势","MAINPOINT":13,"MAINPOINT_CONTENT":"公司重视人才的培养和发展，持续实施人才培养提升计划。多年来，公司已经储备了一批专门从事海洋馆经营的运营管理人员，及拥有海洋馆行业领先的专业技术人才；公司重视与科研院所的学术合作，通过科研和实践结合的方式完善人才积累，为公司创新发展、管理输出、技术输出提供人才保障。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600593.SH","SECURITY_CODE":"600593","SECURITY_NAME_ABBR":"大连圣亚","KEYWORD":"参股银行","MAINPOINT":14,"MAINPOINT_CONTENT":"公司于2011年投资1000万元参股大连旅顺蒙银村镇银行股份有限公司,占其股份的10%。公司于2012年投资500万元参股大连中山信德小额贷款有限公司,占其股份的10%。","KEY_CLASSIF":"对外扩张","KEY_CLASSIF_CODE":"006002","IS_POINT":"1"}]}