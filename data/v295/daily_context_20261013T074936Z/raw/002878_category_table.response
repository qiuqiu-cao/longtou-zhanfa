{"version":"010ab79a2e8f7506701b6e78a27c2095","result":{"pages":1,"data":[{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"972","BOARD_NAME":"快手概念","SELECTED_BOARD_REASON":"2021年1月20日回复称公司是快手的礼品供应商,公司在礼赠品和新媒体营销领域服务于大企业客户,近年来陆续开发了阿里、腾讯、抖音、快手、京东、拼多多、小红书等互联网企业客户。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0972","DERIVE_BOARD_CODE":"BI0972","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"957","BOARD_NAME":"拼多多概念","SELECTED_BOARD_REASON":"2020年6月29日回复称拼多多是公司控股子公司谦玛网络的客户,有实质性业务往来,谦玛网络为拼多多在快手、抖音等平台投放短视频广告,业务增长较快,上半年投放额已达4千万+。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0957","DERIVE_BOARD_CODE":"BI0957","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"954","BOARD_NAME":"盲盒经济","SELECTED_BOARD_REASON":"2020年11月30日回复称公司的冬奥特许商品冰墩墩已推出盲盒系列。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0954","DERIVE_BOARD_CODE":"BI0954","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"940","BOARD_NAME":"网红经济","SELECTED_BOARD_REASON":"控股子公司谦玛网络控股子公司杭州仟美文化有限公司专注MCN业务,已经与10余位网红签约,目前聚焦美妆、护肤、时尚等垂直行业。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0940","DERIVE_BOARD_CODE":"BI0940","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"923","BOARD_NAME":"抖音概念(字节概念)","SELECTED_BOARD_REASON":"2025年2月10日回复称，抖音及其母公司字节跳动是公司重要的营销服务客户，抖音也是公司重要的媒介合作伙伴。公司是巨量引擎综合代理商、抖音星图核心服务商。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0923","DERIVE_BOARD_CODE":"BI0923","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"893","BOARD_NAME":"无线耳机","SELECTED_BOARD_REASON":"2020年4月17日回复称公司智能音箱和蓝牙耳机目前都以完成产品设计,与科大讯飞合作开发的儿童陪伴智能音箱即将投产。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0893","DERIVE_BOARD_CODE":"BI0893","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2023年9月28日回复称，公司长期服务于各行各业的中国知名企业和品牌，阿里巴巴、贵州茅台、华为、荣耀等知名企业都是公司的头部客户。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"845","BOARD_NAME":"百度概念","SELECTED_BOARD_REASON":"2023年3月13日回复称公司宣布成为百度“文心一言”(英文名:ERNIEBot)首批生态合作伙伴。元隆雅图将于近期全面体验并接入“文心一言”的能力,基于AIGC(AI-GeneratedContent人工智能自主生成内容)技术全面打造全场景科技营销服务体系。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0845","DERIVE_BOARD_CODE":"BI0845","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"804","BOARD_NAME":"深股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0804","DERIVE_BOARD_CODE":"BI0804","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2024年5月22日回复称，公司成立了AI研究院，持续开发营销垂类AIGC模型，构建AI数据中心，在产品创意设计、图文及视频内容制作、新媒体达人采买，IP数字资产生成、元宇宙场景运营、虚拟人等各业务领域全面应用AI技术。其中，公司基于新媒体营销业务长期积累的爆品文案，可以作为AIGC模型训练的语料。公司在国际主流的AIGC文生视频通用大模型的基础上，结合公司垂类应用技术和经验对大模型进行优化，探索AIGC文生视频技术在营销场景中的应用。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"722","BOARD_NAME":"虚拟现实","SELECTED_BOARD_REASON":"2025年5月8日年报显示，公司圆明园VR大空间沉浸式体验项目进展顺利，后续还将合作开设更多VR体验馆并开展圆明园数字IP运营业务，包括线上观景门票、虚实文创品开发及销售、线下互动、数字权益发行等，力争为国潮IP的虚实一体化运营打造经典案例。 ","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0722","DERIVE_BOARD_CODE":"BI0722","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"665","BOARD_NAME":"电商概念","SELECTED_BOARD_REASON":"2020年年报显示公司开发并上线了“元隆有品”电商平台,集合公司的供应链资源,解决客户礼赠品采购集中化、电商化、规范化的需求。“元隆有品”为公司数千家供应商企业和同行业友商进行创意设计、资金、客户资源赋能,利用电商平台整合行业资源并快速提升市场占有率。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0665","DERIVE_BOARD_CODE":"BI0665","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"664","BOARD_NAME":"婴童概念","SELECTED_BOARD_REASON":"2022年3月7日回复称公司经营的产品中包含儿童玩具等产品,并且母婴客户、母婴用品和儿童玩具是公司的重要客户和礼赠品类别,公司与多家品牌婴童企业有合作关系。","IS_PRECISE":"1","BOARD_RANK":25,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0664","DERIVE_BOARD_CODE":"BI0664","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"486","BOARD_NAME":"传媒","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0486","DERIVE_BOARD_CODE":"BI0486","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"1673","BOARD_NAME":"破增发价股","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1673","DERIVE_BOARD_CODE":"BI1673","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SECURITY_CODE":"002878","SECURITY_NAME_ABBR":"元隆雅图","BOARD_CODE":"1652","BOARD_NAME":"新消费","SELECTED_BOARD_REASON":"2024年09月18日回复称，公司开展IP盲盒相关产品业务，广泛布局体育、动漫、游戏、文旅文博、国潮、原创艺术等各类IP,形成了从IP资源、IP内容创意及传播、实物及数字IP文创衍生品设计开发及生产发行、IP虚拟场景建设及运营,到B+C渠道销售及运营的完整的一体化产业链。","IS_PRECISE":"1","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1652","DERIVE_BOARD_CODE":"BI1652","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002878.SZ","SEC