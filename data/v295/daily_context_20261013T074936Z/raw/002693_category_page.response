{"ssbk":[{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1216","BOARD_NAME":"医药生物","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"465","BOARD_NAME":"化学制药","IS_PRECISE":"0","BOARD_RANK":2},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1594","BOARD_NAME":"化学制剂","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"176","BOARD_NAME":"海南板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1693","BOARD_NAME":"近期摘帽","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1750","BOARD_NAME":"2026中报扭亏","IS_PRECISE":null,"BOARD_RANK":6},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1193","BOARD_NAME":"海南自贸","IS_PRECISE":"1","BOARD_RANK":8},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","BOARD_CODE":"1174","BOARD_NAME":"合成生物","IS_PRECISE":"1","BOARD_RANK":9}],"hxtc":[{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"注射剂、胶囊剂、片剂、颗粒剂、原料药的研究、开发、生产、销售;化工产品(专营除外)、普通机械设备的生产销售;药品研发项目的咨询和转让;自有房屋租赁;转让、出租自有专利、非专利技术及商标(凡需行政许可项目凭许可证经营)。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","KEYWORD":"医药制造","MAINPOINT":3,"MAINPOINT_CONTENT":"公司所属行业为医药制造业，公司主营业务涵盖药品注射剂、固体制剂、原料药的研发、生产、销售等。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","KEYWORD":"医药行业","MAINPOINT":4,"MAINPOINT_CONTENT":"医药行业是我国国民经济的重要组成部分，在保障人民群众身体健康和生命安全方面发挥重要作用。近几年医药行业受行业政策、其他外部环境等因素的影响，整体收入和利润增速空间受到挤压，医药制造行业面临新机遇和新挑战。根据国家统计局统计数据，2025年度我国规模以上工业企业中的医药制造业营业收入24,870亿元，实现利润总额3,490亿元，较上年增长2.7%。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","KEYWORD":"核心产品优势","MAINPOINT":5,"MAINPOINT_CONTENT":"原料药方面，公司的胸腺法新已通过意大利AIFA技术审核、生长抑素原料药获得CEP（欧洲药典适用性）证书。\n制剂方面，公司研发的复杂制剂：注射用紫杉醇（白蛋白结合型）获得美国FDA的上市许可批准并已上市销售；\n公司的产品注射用胸腺法新获得经意大利AIFA核准ANDA批文；注射用比伐芦定、依替巴肽注射液、醋酸奥曲肽注射液、注射用硼替佐米已通过美国FDA上市许可，其中，注射用比伐芦定、依替巴肽注射液均已出口美国；注射用比伐芦定、依替巴肽注射液、注射用硼替佐米、精氨加压素注射液获得澳大利亚TGA上市许可批准；注射用胸腺法新、注射用比伐芦定、注射用生长抑素等一致性评价获批。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","KEYWORD":"研发、生产的技术优势","MAINPOINT":6,"MAINPOINT_CONTENT":"多年来，公司始终坚持国际化路线，公司已分别通过美国FDA和欧盟EMA的GMP检查、菲律宾FDA GMP检查及沙特SFDA GMP检查，检查内容包括多肽原料药和复杂制剂；公司有仿制药研发、注册以及对专利事务处理的全面综合能力；在研发项目上储备丰富的产品管线，公司拟定在未来不断地向美国和欧盟国家申报原料药DMF和ANDA，进一步加快公司国际化进程。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"002693.SZ","SECURITY_CODE":"002693","SECURITY_NAME_ABBR":"双成药业","KEYWORD":"人才优势","MAINPOINT":7,"MAINPOINT_CONTENT":"公司建立具有多年国际经验的专业技术人员的研发团队，提高和完善了公司GMP的体系，其研发和GMP均能满足国际要求，具备开发成份复杂、工艺特殊、科技含量高的原料药和制剂的科研能力。公司现拥有高水平、高效率的符合国际、国内法规的注册团队。另外，公司多年来努力贯彻国际化方针和全面深入开展各方面工作，建立了可靠的质量管理体系，拥有具有GMP概念的质量、生产队伍，取得了显著成果。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"}]}