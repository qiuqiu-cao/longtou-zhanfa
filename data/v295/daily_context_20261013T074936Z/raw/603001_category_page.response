{"ssbk":[{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"436","BOARD_NAME":"纺织服饰","IS_PRECISE":"0","BOARD_RANK":1},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"1225","BOARD_NAME":"服装家纺","IS_PRECISE":null,"BOARD_RANK":2},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"1354","BOARD_NAME":"鞋帽及其他","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"172","BOARD_NAME":"浙江板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"1750","BOARD_NAME":"2026中报扭亏","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"1672","BOARD_NAME":"破发股","IS_PRECISE":null,"BOARD_RANK":6},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"552","BOARD_NAME":"机构重仓","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"535","BOARD_NAME":"QFII重仓","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"1115","BOARD_NAME":"跨境电商","IS_PRECISE":"1","BOARD_RANK":10},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"955","BOARD_NAME":"C2M概念","IS_PRECISE":"1","BOARD_RANK":11},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"825","BOARD_NAME":"新零售","IS_PRECISE":"1","BOARD_RANK":12},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","BOARD_CODE":"665","BOARD_NAME":"电商概念","IS_PRECISE":"1","BOARD_RANK":13}],"hxtc":[{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"鞋制造;制鞋原辅材料销售;制鞋原辅材料制造;服装制造;服装服饰零售;服装服饰批发;皮革制品销售;箱包销售;皮革销售;皮革制品制造;服装、服饰检验、整理服务;服饰研发;服装辅料销售;服饰制造;服装辅料制造;技术服务、技术开发、技术咨询、技术交流、技术转让、技术推广;进出口代理;技术进出口;货物进出口;普通货物仓储服务(不含危险化学品等需许可审批的项目);日用百货销售;箱包制造;互联网销售(除销售需要许可的商品);箱包修理服务;鞋和皮革修理;鞋帽批发;鞋帽零售;劳动保护用品销售;劳动保护用品生产;国内贸易代理;日用品销售;特种劳动防护用品生产;特种劳动防护用品销售;新材料技术研发;(除依法须经批准的项目外,凭营业执照依法自主开展经营活动)。许可项目:第二类增值电信业务;第一类增值电信业务;基础电信业务。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"皮鞋及皮具产品的研发、生产、零售及分销业务","MAINPOINT":3,"MAINPOINT_CONTENT":"公司主要从事皮鞋及皮具产品的研发、生产、零售及分销业务，产品种类主要有商务正装鞋、商务休闲鞋等鞋类产品以及皮具配套产品，主要用于满足消费者日益增长的鞋类及皮具产品的功能性和时尚性需求。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"鞋类制造行业","MAINPOINT":4,"MAINPOINT_CONTENT":"近年来，随着国内消费者对鞋类产品品质要求不断提升，市场消费分级趋势愈加显著。在外需持续走弱、传统商务场景需求收缩的背景下，行业整体重心转向内需市场与技术升级，公司作为本土鞋企代表，正积极顺应行业转型趋势。消费场景由传统正装为主，逐步拓展至日常通勤、轻户外及休闲舒适穿搭，舒适化、功能化产品占比持续提升，行业已进入功能优先、体验至上的新阶段。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"技术驱动的创新优势","MAINPOINT":5,"MAINPOINT_CONTENT":"依托长期深耕鞋履研发制造的深厚经验，构建从研发到销售的全流程数字化运营体系。通过自主研发鞋楦设计体系大幅缩短开发周期，结合智能产线覆盖超70%制造环节，显著提升生产效率并降低次品率。瓯北基地获评浙江省“先进级智能工厂”，通过全流程数字化管控实现原料到终端的实时协同，具备成熟的个性化设计与小单快反能力，精准响应市场对轻量化、缓震功能的消费需求。全链路智能制造持续优化成本结构，加快产品迭代速度，成为公司提质增效的核心引擎。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"绿色转型的可持续产品创新优势","MAINPOINT":6,"MAINPOINT_CONTENT":"聚焦“更舒适的鞋履专家”定位，奥康推出“地球漫步”系列，采用低碳帆布与再生材料，实现单鞋减碳目标。其“旧鞋焕新”项目通过资源循环利用，将回收鞋品转化为塑胶跑道材料，为行业提供循环经济实践范例。在行业低碳发展与相关政策指引下，公司积极推进全生命周期绿色低碳实践，主动履行生态环保责任。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"持续迭代的技术创新与专利积累","MAINPOINT":7,"MAINPOINT_CONTENT":"公司坚持技术创新与专利积累，构建“研发—生产—销售”一体化创新体系。轻量化方面，联合意大利XLEXTRALIGHT研发“奥康XL超轻大底”，运用超发泡技术实现单鞋显著减重，为通勤与商旅场景提供轻便舒适体验。缓震科技通过多级减震结构与高性能发泡中底，有效吸收冲击力，减轻长时间穿着疲劳。透气技术以“舒适透”国家专利为核心，采用多层透气结构，实现高效透气与防水防护兼备。贴合设计基于长期人体工学研究与市场实践，精准匹配国人脚型特征，全面提升穿着舒适度与贴合度。同时，运用高强度纤维面料与“三防科技”（防穿刺、防滑、防水），提升产品多场景适应能力与安全性能。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"全渠道融合的品牌与营销升级优势","MAINPOINT":8,"MAINPOINT_CONTENT":"公司构建“线上+线下”深度融合的全渠道运营体系，线上覆盖平台电商、兴趣电商与社交电商，通过精细化内容运营精准触达25-35岁年轻消费群体。线下加快旗舰店形象升级，打造场景化、沉浸式消费体验，强化品牌体验与用户粘性。公司持续推进数字化营销创新，以多元视觉呈现与场景化交互展示产品科技与设计理念，不断优化品牌传播效率，拓展年轻用户圈层，构建行业领先的全域营销模式。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603001.SH","SECURITY_CODE":"603001","SECURITY_NAME_ABBR":"奥康国际","KEYWORD":"收到政府补助","MAINPOINT":9,"MAINPOINT_CONTENT":"2022年12月9日公司对外公告,浙江奥康鞋业股份有限公司(以下简称“公司”)及下属子公司自2022年8月25日至2022年12月7日,累计收到政府补助362.34万元,占公司2021年度归属于上市公司股东净利润的比例为10.64%。公司根据《企业会计准则第16号—政府补助》的相关规定确认上述政府补助属于与收益相关的政府补助,计入当期损益。具体会计处理以及对公司当年损益的影响情况以审计机构年度审计确认后的结果为准。","KEY_CLASSIF":"政府补贴","KEY_CLASSIF_CODE":"010002","IS_POINT":"1"}]}