{"version":"0b2e703f347941b3ba4bce7e8941a8b2","result":{"pages":1,"data":[{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"989","BOARD_NAME":"储能概念","SELECTED_BOARD_REASON":"2025年2月26日投资者关系管理信息显示，公司可提供储能电池管理系统（BMS）及储能电池高效热管理换热机组，2024年订单过亿，相关产能快速提升中。","IS_PRECISE":"1","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0989","DERIVE_BOARD_CODE":"BI0989","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"966","BOARD_NAME":"碳交易","SELECTED_BOARD_REASON":"2020年12月28日回复称公司拥有二氧化碳冷凝捕集系统实用新型专利。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0966","DERIVE_BOARD_CODE":"BI0966","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"860","BOARD_NAME":"边缘计算","SELECTED_BOARD_REASON":"2020年4月20日回复称公司子公司冰山嘉德聚焦冷冻冷藏领域物联网自动控制,推出BINGO-BOX物联网关等具有边缘计算能力的智能设备。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0860","DERIVE_BOARD_CODE":"BI0860","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"852","BOARD_NAME":"冷链物流","SELECTED_BOARD_REASON":"公司是中国最大的工业制冷设备生产企业,并拥有中国驰名商标。 公司加大了新产品的营销力度,新系列螺杆机组、单机双级螺杆机组、大型撬块机组的市场增长率超过40%;完成新产品开发10多项,延伸了新系列螺杆机组和单机双级螺杆机组产品系列,强化了公司在冷链物流领域的技术优势。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0852","DERIVE_BOARD_CODE":"BI0852","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"708","BOARD_NAME":"体育产业","SELECTED_BOARD_REASON":"2019年9月2日公司回复称冰雪事业领域是公司重点拓展的事业领域之一,由公司子公司冰山工程承建的广州融创文旅城室内滑雪场已于今年6月正式投入运营,同时公司还中标了冬奥会雪橇道模拟测试段以及深圳佳兆业金沙湾国际乐园冰雪乐园等项目。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0708","DERIVE_BOARD_CODE":"BI0708","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"697","BOARD_NAME":"IPO受益","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0697","DERIVE_BOARD_CODE":"BI0697","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"634","BOARD_NAME":"大数据","SELECTED_BOARD_REASON":"2017年11月6日早间公告,近日,公司通过新事业投资平台大连冰山集团管理咨询有限公司,与昆仑智汇数据科技(北京)有限公司的子公司北京工业大数据创新中心有限公司,共同投资设立了大连开尔文科技有限公司。开尔文科技将以冰山冷热产品的全生命周期为轴心,将冰山在冷热事业的应用场景等资源优势与昆仑数据在大数据和人工智能领域的技术优势深度结合,积极推动冰山在冷热产业的大数据应用创新、物联网平台建设以及在智能制造领域的深入探索,实现冰山核心事业的智慧成长。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0634","DERIVE_BOARD_CODE":"BI0634","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"623","BOARD_NAME":"海洋经济","SELECTED_BOARD_REASON":"2025年3月28日回复称，深海经济内涵广泛，船舰制冷是公司传统优势细分市场之一。作为中国船舶制冷领军者，专业助力节能型大型远洋金枪鱼围网渔船开发，打破金枪鱼低温冷冻冷藏的外国垄断。多年来，凭借机组性能高可靠性，新造大型冷冻渔船制冷市场占有率遥遥领先。自主研发全球首套船用二氧化碳跨临界制冷设备碳捕集系统，大幅提升舰艇减碳能力；船用溴化锂吸收式制冷机组入选“辽宁省首台（套）重大技术装备推广应用指导目录”。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0623","DERIVE_BOARD_CODE":"BI0623","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"601","BOARD_NAME":"海工装备","SELECTED_BOARD_REASON":"2025年3月28日回复称，深海经济内涵广泛，船舰制冷是公司传统优势细分市场之一。作为中国船舶制冷领军者，专业助力节能型大型远洋金枪鱼围网渔船开发，打破金枪鱼低温冷冻冷藏的外国垄断。多年来，凭借机组性能高可靠性，新造大型冷冻渔船制冷市场占有率遥遥领先。自主研发全球首套船用二氧化碳跨临界制冷设备碳捕集系统，大幅提升舰艇减碳能力；船用溴化锂吸收式制冷机组入选“辽宁省首台（套）重大技术装备推广应用指导目录”。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0601","DERIVE_BOARD_CODE":"BI0601","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000530.SZ","SECURITY_CODE":"000530","SECURITY_NAME_ABBR":"冰山冷热","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEV