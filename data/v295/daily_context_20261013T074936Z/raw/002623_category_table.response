{"version":"b4f9e314891c9c9a60b2d0f39b69377c","result":{"pages":1,"data":[{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"685","BOARD_NAME":"举牌","SELECTED_BOARD_REASON":"2026年07月10日公告显示获朱兵,岑燕举牌。","IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0685","DERIVE_BOARD_CODE":"BI0685","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"644","BOARD_NAME":"特斯拉概念","SELECTED_BOARD_REASON":"成为特斯拉合格供应商,向其提供太阳能瓦片玻璃。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0644","DERIVE_BOARD_CODE":"BI0644","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"588","BOARD_NAME":"光伏概念","SELECTED_BOARD_REASON":"2015年5月4日公司公告称拟与弘石投资共同设立太阳能电站产业基金,主要从事投资太阳能电站业务。该产业基金总规模不超过10亿元,首期出资额为5亿元; 2014年7月21日午间公告,公司全资子公司亚玛顿电力投资约4607.91万元在公司既有工业厂房建筑屋顶及其他可依托光伏电站的建筑物上建设5.003MW分布式光伏发电项目,项目采用合同能源管理方式供电给公司使用,不足部分由电网补充。项目资金为亚玛顿电力自筹。公司是国内光伏减反玻璃龙头,主要从事光伏玻璃镀膜技术的研发以及光伏镀膜玻璃的生产和销售。2014年4月,公司拟以2000万元投资设立关于太阳能电站项目及能源投资的全资子公司,公司名称为江苏亚玛顿电力投资有限公司。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0588","DERIVE_BOARD_CODE":"BI0588","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"552","BOARD_NAME":"机构重仓","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0552","DERIVE_BOARD_CODE":"BI0552","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"535","BOARD_NAME":"QFII重仓","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0535","DERIVE_BOARD_CODE":"BI0535","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"523","BOARD_NAME":"新材料","SELECTED_BOARD_REASON":"2021年6月18日回复称公司自成立以来一直专注于对新材料和新技术的自主研发和创新,是国内首家研发和生产应用纳米材料在大面积光伏玻璃上镀制减反射膜的企业。公司是国内率先一家用物理钢化技术规模化生产≤2.0mm超薄物理钢化玻璃并制成超薄双玻组件的企业,引领光伏行业进入更薄、更轻、更耐久的“轻量化”时代,在国内双玻组件市场位居行业前列的优势地位。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0523","DERIVE_BOARD_CODE":"BI0523","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"493","BOARD_NAME":"新能源","SELECTED_BOARD_REASON":"公司是国内光伏减反玻璃龙头,主要从事光伏玻璃镀膜技术的研发以及光伏镀膜玻璃的生产和销售。截至2011年6月,已形成年产1800万平方米光伏减反玻璃产能;公司将完成五条生产线技改工作,届时,总生产能力将达到2550万平方米/年。公司并不生产玻璃,主要采取两种商业模式,一种是公司自主采购超白玻璃原片进行生产加工成光伏减反玻璃,形成镀膜玻璃产品;另一种是由光伏组件制造商提供钢化超白玻璃,委托公司加工光伏减反玻璃,形成镀膜加工产品。 2012年12月,公司“亞瑪頓”注册商标被认定为中国驰名商标。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0493","DERIVE_BOARD_CODE":"BI0493","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1672","BOARD_NAME":"破发股","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1672","DERIVE_BOARD_CODE":"BI1672","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"159","BOARD_NAME":"江苏板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0159","DERIVE_BOARD_CODE":"BI0159","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1316","BOARD_NAME":"光伏辅材","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1316","DERIVE_BOARD_CODE":"BI1316","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1200","BOARD_NAME":"电力设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1200","DERIVE_BOARD_CODE":"BI1200","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1197","BOARD_NAME":"反内卷概念","SELECTED_BOARD_REASON":"2024年年报显示，亚玛顿太阳能玻璃营业占比90.58%。","IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1197","DERIVE_BOARD_CODE":"BI1197","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1094","BOARD_NAME":"钙钛矿电池","SELECTED_BOARD_REASON":"2024年年报显示，在钙钛矿电池组件中，TCO玻璃已成为一种重要的产业化应用材料，为此公司成立专门的钙钛矿项目研究小组，凭借公司早期TCO玻璃相关技术经验和成熟的电子显示面板技术，开发专注于独创气浮式钢化技术的ITO导电玻璃可钢化（高平整度）的技术研发，以满足未来大尺寸钙钛矿产品高强度、低厚度盖板玻璃的市场需求。该产品现阶段已经在实际生产线进行小量产化实验并给客户送样过程中。未来，公司将不断进行技术创新和工艺改进，以满足客户不断的需求变化，力争做强TCO导电膜光伏玻璃产业链，为钙钛矿光伏行业快速发展做好核心原材料准备。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1094","DERIVE_BOARD_CODE":"BI1094","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1031","BOARD_NAME":"光伏设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1031","DERIVE_BOARD_CODE":"BI1031","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"002623.SZ","SECURITY_CODE":"002623","SECURITY_NAME_ABBR":"亚玛顿","BOARD_CODE":"1024","BOARD_NAME":"绿色电力","SELECTED_BOARD_REASON":"2023年3月3日回复称公司目前在江苏地区以及河南合计持有约100MW左右的光伏发电站项目。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1024","DERIVE_BOARD_CODE":"BI1024","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":16},"success":true,"message":"ok","code":0}