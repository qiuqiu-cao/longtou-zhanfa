{"version":"68baa414ae0fe64a8e5dc02bde3ef9f6","result":{"pages":1,"data":[{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"969","BOARD_NAME":"汽车芯片","SELECTED_BOARD_REASON":"2024年3月22日回复称,公司投资参股的上海芯钛信息科技有限公司,主要从事汽车级半导体芯片产品的设计研发,提供安全类MCU、通用型MCU等芯片产品,并为汽车智能网联提供整体信息安全解决方案。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0969","DERIVE_BOARD_CODE":"BI0969","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"953","BOARD_NAME":"鸿蒙概念","SELECTED_BOARD_REASON":"2023年年报显示,公司的PKI软件(含信创版本)亦已成功进入华为云市场营销平台,基于鸿蒙生态的合作已在金融行业端展开。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0953","DERIVE_BOARD_CODE":"BI0953","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"920","BOARD_NAME":"车联网(车路云)","SELECTED_BOARD_REASON":"2025年年报显示，公司主要从事身份安全、密码安全、数据安全和物联安全产品的研发、生产和销售及服务业务，并形成了完备的以密码为基础、以身份为中心的信息安全产品和服务体系。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0920","DERIVE_BOARD_CODE":"BI0920","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"886","BOARD_NAME":"智慧政务","SELECTED_BOARD_REASON":"格尔软件专注于信息安全行业PKI领域,主要从事以公钥基础设施PKI(Public Key Infrastructure)为核心的商用密码软件产品的研发、生产和销售及服务业务,为用户提供基于PKI的信息安全系列产品、安全服务和信息安全整体解决方案。公司的主要客户包括国家部委、地方政府部门、军工、金融机构、大中型企事业单位等。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0886","DERIVE_BOARD_CODE":"BI0886","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"883","BOARD_NAME":"数字货币","SELECTED_BOARD_REASON":"2025年6月20日回复称，密码技术是数字货币的核心技术，在数字货币业务中有着广泛的应用。作为以PKI技术为核心的安全厂商，数字货币业务是公司重点关注的密码技术应用领域，公司一直积极跟进相关技术的发展和应用场景的变化。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0883","DERIVE_BOARD_CODE":"BI0883","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2026年6月4日回复称，在合作方面，公司基于海光、华为CPU的内生密码应用方案已获用户认可并落地，安全解决方案已在华为财经系统成功部署。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"845","BOARD_NAME":"百度概念","SELECTED_BOARD_REASON":"2023年3月6日回复称公司宣布成为百度文心一言(英文名:ERNIEBot)首批生态合作伙伴。后续,格尔软件将通过百度智能云全面体验并接入文心一言的能力。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0845","DERIVE_BOARD_CODE":"BI0845","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"830","BOARD_NAME":"区块链","SELECTED_BOARD_REASON":"2025年04月26日，公司发布《格尔软件股份有限公司2024年环境、社会及公司治理(ESG)报告》，其中提及：2024年6月，格尔软件作为商用密码行业领军企业，在第十届上交会上密码技术与人工智能、区块链、隐私计算等前沿技术融合的创新示范应用。","IS_PRECISE":"1","BOARD_RANK":25,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0830","DERIVE_BOARD_CODE":"BI0830","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2025年年报显示，在AI与密码融合研究方面，公司与西安电子科技大学围绕“密码与AI 融合赋能”核心技术方向开展产学研协同创新，开展多轮技术研讨并联合开展相关技术研究，推动“玄知大模型”在密码应用安全测评、密码应用安全改造、商用密码产品安全评估等领域落地应用，充分发挥人工智能技术对密码领域的赋能效用。在研发体系建设上，公司积极拥抱AI，将SDD（Spec DrivenDevelopment）开发模式融入进 CMMI5 的流程中，用AI原生开发模式实现了多个核心模块，建立了覆盖API接口到 UI 界面的智能化测试平台，为质量体系的高效推进奠定了基础。","IS_PRECISE":"1","BOARD_RANK":26,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"737","BOARD_NAME":"软件开发","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0737","DERIVE_BOARD_CODE":"BI0737","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"710","BOARD_NAME":"量子科技","SELECTED_BOARD_REASON":"2024年年报显示，量子安全领域，在量子威胁逐渐显现的背景下，公司提前布局，2024年完成了全线密码产品抗量子能力的升级工作，不仅兼容美国NIST发布的抗量子算法，还完成了CTRU/CNTR、LMS/HSS-SM3、Aigis-Sig等中国抗量子算法的工程实现。在2024年6月召开的中国（上海）国际技术进出口交易会上，公司发布了量子安全PKI基础设施、量子安全密钥管理系统等一系列抗量子产品，格尔安全认证网关成为首家通过中国信息通信研究院抗量子技术验证的网关产品。","IS_PRECISE":"1","BOARD_RANK":27,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0710","DERIVE_BOARD_CODE":"BI0710","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"704","BOARD_NAME":"无人机","SELECTED_BOARD_REASON":"2024年3月22日回复称,在无人机安全方面,公司研发了自主可控软硬件的无人机身份信标系统,深度融合匹配国产芯片、信创系统、国密算法,精准识别无人机身份,可有效解决无人机身份识别难控制的问题,助力实现符合复杂空情态势下的无人机管控。","IS_PRECISE":"1","BOARD_RANK":28,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0704","DERIVE_BOARD_CODE":"BI0704","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"696","BOARD_NAME":"国产软件","SELECTED_BOARD_REASON":"2019年年报显示公司主要从事以PKI公钥基础设施为核心的商用密码软件产品的研发、生产和销售及服务业务。","IS_PRECISE":"1","BOARD_RANK":29,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0696","DERIVE_BOARD_CODE":"BI0696","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"655","BOARD_NAME":"网络安全","SELECTED_BOARD_REASON":"2025年6月20日回复称，公司目前主要专注于基于密码技术为核心的信息安全业务。","IS_PRECISE":"1","BOARD_RANK":30,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0655","DERIVE_BOARD_CODE":"BI0655","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"556","BOARD_NAME":"移动支付","SELECTED_BOARD_REASON":"2023年度环境、社会及治理(ESG)报告显示,格尔软件为支撑金融电商领域央企安全实现运营移动支付业务、超级 SIM 卡业务等,依据央行140 号文件对其重要网络与信息系统进行商用密码改造要求,重要网络与信息系统需满足商用密码应用合规性,替换原有非国密算法等。","IS_PRECISE":"1","BOARD_RANK":31,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0556","DERIVE_BOARD_CODE":"BI0556","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"490","BOARD_NAME":"军工","SELECTED_BOARD_REASON":"2025年6月20日回复称，公司为多家军工集团完成了身份认证、安全应用平台的部署与应用，具体名单涉及敏感信息不便披露。公司积极探索无人机身份识别技术，为低空航空器的反制提供实时数据支持，公司研发的自主可控软硬件的无人机身份信标系统，深度融合匹配国产芯片、信创系统、国密算法，精准识别无人机身份，可有效解决无人机身份识别难控制的问题，助力实现符合复杂空情态势下的无人机管控。","IS_PRECISE":"1","BOARD_RANK":32,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0490","DERIVE_BOARD_CODE":"BI0490","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1638","BOARD_NAME":"最近多板","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1638","DERIVE_BOARD_CODE":"BI1638","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1637","BOARD_NAME":"东方财富热股","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1637","DERIVE_BOARD_CODE":"BI1637","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1633","DERIVE_BOARD_CODE":"BI1633","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1630","DERIVE_BOARD_CODE":"BI1630","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1629","BOARD_NAME":"AI应用","SELECTED_BOARD_REASON":"2026年6月4日公告显示， AI方面，公司认为，无论是密码安全行业或其他行业，AI的普及和应用\n都是重要趋势之一，“玄知大模型”作为AI驱动密码算法工程化落地的成果，旨在推动人工智能技术与密码行业的深度融合。公司已与西安电子科技大学围绕“密码与AI融合赋能”这一核心技术方向，开展了多轮技术研讨，并联合推进相关技术研究。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1629","DERIVE_BOARD_CODE":"BI1629","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"145","BOARD_NAME":"上海板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0145","DERIVE_BOARD_CODE":"BI0145","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1447","BOARD_NAME":"垂直应用软件","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1447","DERIVE_BOARD_CODE":"BI1447","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1207","BOARD_NAME":"计算机","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1207","DERIVE_BOARD_CODE":"BI1207","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1110","BOARD_NAME":"Web3.0","SELECTED_BOARD_REASON":"2022年12月28日回复称,公司掌握的PKI公钥密码技术是Web3.0应用的基础技术支撑,在此基础上与Web3.0应用相关的产品主要是IDaaS身份管理产品与分布式身份系统。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1110","DERIVE_BOARD_CODE":"BI1110","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1104","BOARD_NAME":"信创","SELECTED_BOARD_REASON":"公司自成立以来一直专注于信息安全行业PKI领域,主要从事以公钥基础设施PKI(Public Key Infrastructure)为核心的商用密码软件产品的研发、生产和销售及服务业务,为用户提供基于PKI的信息安全系列产品、安全服务和信息安全整体解决方案。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1104","DERIVE_BOARD_CODE":"BI1104","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1075","BOARD_NAME":"电子身份证","SELECTED_BOARD_REASON":"2022年3月17日回复称,电子身份证是由国家公安部以身份证制证数据为基础认证发布的个人身份电子凭证。主要用于用户的身份识别,满足线上线下服务的实名认证需要。公司以密码技术为核心,在多种应用场景中,向用户提供基于密码的可信身份认证及可信数据保障等多层次、全方位的综合性安全解决方案。建设以PKI技术为基础,囊括身份的签发、验签、授权、加密、访问控制等功能的安全基础设施,并提供围绕身份的安全支撑与保障。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1075","DERIVE_BOARD_CODE":"BI1075","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1050","DERIVE_BOARD_CODE":"BI1050","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1047","BOARD_NAME":"数据安全","SELECTED_BOARD_REASON":"2023年半年度业绩报告,在数据安全方面,公司进一步完善数据安全产品体系,发布了数据库加密系统、存储加密系统的新版本,推出了同时支持加密和特权账号管理的云原生数据安全密码解决方案。在身份安全方面,零信任智能策略中心新增安全编排能力,提升了基于身份风险的自动化响应能力,在物联网、工控网络环境中开展了轻量级身份认证技术的预研工作。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1047","DERIVE_BOARD_CODE":"BI1047","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603232.SH","SECURITY_CODE":"603232","SECURITY_NAME_ABBR":"格尔软件","BOARD_CODE":"1005","BOARD_NAME":"专精特新","SELECTED_BOARD_REASON":"公司已入选工信部国家级专精特新小巨人企业名单。","IS_PRECISE":null,"BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1005","DERIVE_BOARD_CODE":"BI1005","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":32},"success":true,"message":"ok","code":0}