{"version":"c61758108ec7c15dfde7685c36423bcd","result":{"pages":1,"data":[{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"972","BOARD_NAME":"快手概念","SELECTED_BOARD_REASON":"2024年11月5日投资者关系活动记录表显示,公司与行业头部品牌以及京东、天猫、抖音、快手、拼多多、唯品会、微信视频号等主要电商平台建立了深度战略合作伙伴关系,具有较强的市场影响力。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0972","DERIVE_BOARD_CODE":"BI0972","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"957","BOARD_NAME":"拼多多概念","SELECTED_BOARD_REASON":"2024年半年报显示,公司深入布局酒类、水饮、日化、母婴等行业赛道,积淀了跨行业的电商销售运营能力和资源,全链路、多样化的业务组合充分发挥了公司的竞争优势,形成了较强的抗风险、抗周期能力。其中,在优势酒类板块,公司已持续多年位居天猫、京东、拼多多、抖音、快手、唯品会等电商平台综合酒类品牌运营商头部阵列。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0957","DERIVE_BOARD_CODE":"BI0957","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"940","BOARD_NAME":"网红经济","SELECTED_BOARD_REASON":"2020年1月10日,公司互动平台回应称公司旗下久爱致和已经为伊利、全友家居、云南白药、泸州老窖、汾酒等知名品牌商提供直播服务,并且开始孵化主播和开展MCN相关业务。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0940","DERIVE_BOARD_CODE":"BI0940","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"923","BOARD_NAME":"抖音概念(字节概念)","SELECTED_BOARD_REASON":"2023年年报显示,报告期内,公司通过抖音、快手、微信视频号等渠道建立了包括五粮液久实快手专卖店、茅台保健酒抖音旗舰店、习酒君品抖音旗舰店、古井贡酒微信视频号旗舰店等在内的16个品牌直播间,包括酒连酒拼多多旗舰店、五粮液酒连酒抖音专卖店、泸州老窖聚酒抖音专卖店等在内的8个自有商号直播间,开展店播、自播和短视频运营相关业务。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0923","DERIVE_BOARD_CODE":"BI0923","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"835","BOARD_NAME":"独角兽","SELECTED_BOARD_REASON":"2017年9月26日公告,公司控股股东不仅以低于市价的价格将10%股权转让给阿里巴巴成都及其一致行动人杭州瀚云,并与杭州阿里巴巴泽泰签署了合作框架协议,双方将设立合资公司作为合作平台,借此实现资源互补,共享各自供应链优势。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0835","DERIVE_BOARD_CODE":"BI0835","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"825","BOARD_NAME":"新零售","SELECTED_BOARD_REASON":"2017年9月26日晚间,新华都发布公告称,公司控股股东新华都集团将10%股权转让至阿里巴巴成都及一致行动人,且新华都与杭州阿里巴巴泽泰签订了合作框架协议,双方将合资设立公司,投资、建设和运营创新门店。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0825","DERIVE_BOARD_CODE":"BI0825","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"804","BOARD_NAME":"深股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0804","DERIVE_BOARD_CODE":"BI0804","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2024年半年报显示,报告期内,公司持续推动智能化建设进程,结合AI大模型与电商场景,开发并上线试运行智能化平台“久爱AI”,一期版本开放商品评论分析、商品信息采集、违禁词风险评估、摘要抽取、文案大纲助手、简历筛选6项AI工具,为优化营销策略、产品结构和日常办公提供技术支持。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"689","BOARD_NAME":"阿里概念","SELECTED_BOARD_REASON":"2025年12月19日回复称，公司当前与阿里旗下天猫平台保持合作，该平台为公司互联网营销业务的重要渠道之一 。公司持续优化全链路营销策略，通过阿里妈妈万相台无界版，包括但不限于全站推广、AI小万、引力魔方、直通车等核心功能模块，实现用户画像、数据采集分析、广告投放等环节的全链路营销优化，转化ROI增量，实现降本提效。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0689","DERIVE_BOARD_CODE":"BI0689","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"665","BOARD_NAME":"电商概念","SELECTED_BOARD_REASON":"受电子商务的快速发展扩张等影响,零售业态结构、经营模式乃至整体格局都出现了新的调整变化,为此,公司积极从传统零售向与电子商务融合转变,协同发展,打造O2O商业模式,提升消费者粘度。报告期内,公司筹划收购久爱致和(北京)科技有限公司、久爱(天津)科技发展有限公司和泸州聚酒致和电子商务有限公司等三家电商,利用网络大数据研究和精准营销,促进公司传统零售与电子商务的全面融合。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0665","DERIVE_BOARD_CODE":"BI0665","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"486","BOARD_NAME":"传媒","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0486","DERIVE_BOARD_CODE":"BI0486","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"447","BOARD_NAME":"互联网服务","SELECTED_BOARD_REASON":"2026年1月20日回复称，公司自2022年起加速推动AI在营销及电商领域的落地，特别是在图文视频内容生成、广告精准投放、用户行为数据分析等方面，已通过系统集群如「知猪侠」、「久爱智行」、「久爱智库」等工具实现精准触达目标客群，提升营销效能 。公司深度合作京东、天猫、淘宝、抖音、TikTok、Lazada等国内外主要电商平台，深入服务泸州老窖、山西汾酒、五粮液、金佰利、欧莱雅、联合利华、宝洁等头部快消品客户。公司长期积累跨区域、跨品类电商数据及GMV归因模型，近期发布“麦点AI智能体矩阵”年度战略级AI产品，积极探索AI新技术在客户端的商业化落地。","IS_PRECISE":"0","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0447","DERIVE_BOARD_CODE":"BI0447","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1633","DERIVE_BOARD_CODE":"BI1633","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"1629","BOARD_NAME":"AI应用","SELECTED_BOARD_REASON":"2025年12月25日回复称，在AI营销领域，公司自2022年起加速推动AI在营销及电商领域的落地，特别是在图文视频内容生成、广告精准投放、用户行为数据分析等方面，已通过系统集群如「知猪侠」、「久爱智行」、「久爱智库」等工具实现精准触达目标客群，提升营销效能。","IS_PRECISE":"1","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1629","DERIVE_BOARD_CODE":"BI1629","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002264.SZ","SECURITY_CODE":"002264","SECURITY_NAME_ABBR":"新华都","BOARD_CODE":"151","BOARD_NAME":"福建板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0151","DERIVE_BOARD_CODE":"BI0151","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"002264.SZ",