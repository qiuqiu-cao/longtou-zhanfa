药物、儿童药物、男科及生殖健康等领域，截至本招股说明书出具之日，储备了22项研发产品，其中3项1类创新药和19项2类改良型创新药品种。","IS_PRECISE":"1","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1106","DERIVE_BOARD_CODE":"BI1106","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":16},"success":true,"message":"ok","code":0}