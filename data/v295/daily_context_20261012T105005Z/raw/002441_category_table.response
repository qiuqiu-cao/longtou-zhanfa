{"version":"223ea975de4f6086c3b633ed09f04237","result":{"pages":1,"data":[{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"900","BOARD_NAME":"新能源车","SELECTED_BOARD_REASON":"2024年4月15日回复称，公司充电桩/站属于公司系统集成与成套制造业务之一，公司能够为下游用户提供方案咨询、系统设计、编程组态、系统集成、成套生产、安装调试、系统培训、维护保养等一揽子服务。目前该业务主要在国内开展。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0900","DERIVE_BOARD_CODE":"BI0900","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"804","BOARD_NAME":"深股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0804","DERIVE_BOARD_CODE":"BI0804","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"700","BOARD_NAME":"充电桩","SELECTED_BOARD_REASON":"2020年半年报显示系统集成与成套制造产品主要有石油钻井平台电气控制系统配套产品、风力发电电气控制系统配套产品、风力发电水冷系统、风力发电机变桨控制系统、船用电气系统、电气控制柜、充电桩/站等。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0700","DERIVE_BOARD_CODE":"BI0700","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"665","BOARD_NAME":"电商概念","SELECTED_BOARD_REASON":"工业电气分销网是公司开通的网上电气分销商城,同时公司已拥有第三方支付牌照。公司建立了以标准化管理平台支持的全国性销售网络以及完善的服务体系。公司工业电气分销网IP访问量已经达到数万次。通过公司的工业电气分销网在电子商城下单支持支付宝直接付款。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0665","DERIVE_BOARD_CODE":"BI0665","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"581","BOARD_NAME":"智能电网","SELECTED_BOARD_REASON":"2019年3月12日回复称公司是工业电气产品的专业分销商,公司分销的工业电气产品以输配电产品和工业自动化产品为主,绝大多数产品可用于智能电网。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0581","DERIVE_BOARD_CODE":"BI0581","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"554","BOARD_NAME":"物联网","SELECTED_BOARD_REASON":"2022年10月26日回复称公司研发的“E控物联”平台,能够提供设备联网、报表订阅、状态监测、预警报警、远程运维等工业物联网基础服务,助力中小设备制造商提升设备价值与市场竞争力。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0554","DERIVE_BOARD_CODE":"BI0554","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"457","BOARD_NAME":"电网设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0457","DERIVE_BOARD_CODE":"BI0457","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1673","BOARD_NAME":"破增发价股","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1673","DERIVE_BOARD_CODE":"BI1673","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1647","BOARD_NAME":"电网概念","SELECTED_BOARD_REASON":"2025年年报显示，公司是工业电气产品的专业分销商，主营业务为通过自有的销售网络分销签约供应商的工业电气元器件产品，以及进行系统集成产品和成套制造产品的生产和销售。公司自成立以来，一直从事工业电气产品的分销业务和系统集成、成套制造业务。","IS_PRECISE":"1","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1647","DERIVE_BOARD_CODE":"BI1647","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"153","BOARD_NAME":"广东板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0153","DERIVE_BOARD_CODE":"BI0153","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1310","BOARD_NAME":"配电设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1310","DERIVE_BOARD_CODE":"BI1310","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1200","BOARD_NAME":"电力设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1200","DERIVE_BOARD_CODE":"BI1200","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1188","BOARD_NAME":"DeepSeek概念","SELECTED_BOARD_REASON":"2025年7月16日回复称，工控网的搜索接入了DEEPSEEK，为用户提供对话式搜索服务。工控猫开展了AI替代人工客服，同时提供云端ERP、WMS、OA等SAAS服务。","IS_PRECISE":"1","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1188","DERIVE_BOARD_CODE":"BI1188","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1133","BOARD_NAME":"ERP概念","SELECTED_BOARD_REASON":"2024年1月29日回复称，公司持续进行数字化建设与升级，ERP 系统作为整个众业达集团业务系统的核心，日常有 2000 以上的并发用户，日处理各类单据数量达 10 万张以上，并与多个供应商的订单平台通过EDI接口进行订单等数据的交换。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1133","DERIVE_BOARD_CODE":"BI1133","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1090","BOARD_NAME":"机器人概念","SELECTED_BOARD_REASON":"2025年8月11日回复称，公司分销的工业电气产品以中低压输配电产品和工业自动化产品为主，机器人涉及前述需求的均在公司业务范围内，例如伺服系统中的伺服电机及伺服驱动器；此外，公司是ABB公司合作伙伴，与ABB上海机器人公司开展合作，选择一些特定客户开展机器人分销。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1090","DERIVE_BOARD_CODE":"BI1090","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1061","BOARD_NAME":"数字经济","SELECTED_BOARD_REASON":"2022年10月26日回复称5G网络规模化部署,5G的数据传递可应用于物联网和智慧工厂、数字化工厂等方面的建设,建设过程中使用的电气设备和需要通讯采集、边缘计算、人机交互等各种产品,这些类型产品都属于公司的布局范围。公司研发的“E控物联”平台,能够提供设备联网、报表订阅、状态监测、预警报警、远程运维等工业物联网基础服务,助力中小设备制造商降低数字化应用门槛、提升设备价值与市场竞争力。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1061","DERIVE_BOARD_CODE":"BI1061","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1022","BOARD_NAME":"职业教育","SELECTED_BOARD_REASON":"2022年10月26日回复称，工控网(北京)教育科技有限公司为公司控股子公司工控网的全资子公司,该公司的主营业务是:技术推广;计算机技术培训。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1022","DERIVE_BOARD_CODE":"BI1022","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002441.SZ","SECURITY_CODE":"002441","SECURITY_NAME_ABBR":"众业达","BOARD_CODE":"1001","BOARD_NAME":"内贸流通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1001","DERIVE_BOARD_CODE":"BI1001","BOARD_TYPE":null,"BOARD_LEVEL":null}],"count":19},"success":true,"message":"ok","code":0}