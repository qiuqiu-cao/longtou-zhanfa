"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"821","BOARD_NAME":"MSCI中国","IS_PRECISE":"0","BOARD_RANK":14},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"707","BOARD_NAME":"沪股通","IS_PRECISE":"0","BOARD_RANK":15},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"612","BOARD_NAME":"上证180_","IS_PRECISE":"0","BOARD_RANK":16},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"611","BOARD_NAME":"上证50_","IS_PRECISE":"0","BOARD_RANK":17},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"596","BOARD_NAME":"融资融券","IS_PRECISE":"0","BOARD_RANK":18},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"500","BOARD_NAME":"HS300_","IS_PRECISE":"0","BOARD_RANK":19},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"499","BOARD_NAME":"AH股","IS_PRECISE":"0","BOARD_RANK":20},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"1029","BOARD_NAME":"汽车整车","IS_PRECISE":"0","BOARD_RANK":21},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"984","BOARD_NAME":"华为汽车","IS_PRECISE":"1","BOARD_RANK":22},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"924","BOARD_NAME":"地摊经济","IS_PRECISE":"1","BOARD_RANK":23},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"923","BOARD_NAME":"抖音概念(字节概念)","IS_PRECISE":"1","BOARD_RANK":24},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"854","BOARD_NAME":"华为概念","IS_PRECISE":"1","BOARD_RANK":25},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"845","BOARD_NAME":"百度概念","IS_PRECISE":"1","BOARD_RANK":26},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"920","BOARD_NAME":"车联网(车路云)","IS_PRECISE":"1","BOARD_RANK":27},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"900","BOARD_NAME":"新能源车","IS_PRECISE":"1","BOARD_RANK":28},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"802","BOARD_NAME":"智能驾驶","IS_PRECISE":"1","BOARD_RANK":29},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"800","BOARD_NAME":"人工智能","IS_PRECISE":"1","BOARD_RANK":30},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"689","BOARD_NAME":"阿里概念","IS_PRECISE":"1","BOARD_RANK":31},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"590","BOARD_NAME":"西部大开发","IS_PRECISE":"1","BOARD_RANK":32},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"554","BOARD_NAME":"物联网","IS_PRECISE":"1","BOARD_RANK":33},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","BOARD_CODE":"534","BOARD_NAME":"成渝特区","IS_PRECISE":"0","BOARD_RANK":34}],"hxtc":[{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"制造、销售:汽车零部件、机动车辆零部件、普通机械、电器机械、电器、电子产品(不含电子出版物)、仪器仪表;销售:日用百货、家用电器、五金、金属材料(不含稀贵金属);房屋租赁、机械设备租赁;经济技术咨询服务;货物进出口(除依法须经批准的项目外,凭营业执照依法自主开展经营活动)","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"高端智能电动汽车","MAINPOINT":3,"MAINPOINT_CONTENT":"公司是以高端智能电动汽车为主营业务的技术科技型企业，聚焦问界汽车业务，坚持用户定义汽车的市场导向和软件定义汽车的技术路线，贯通研产供销服全链路，以创新技术提升用户产品体验、品牌认知，实现经营成果转化。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"汽车行业","MAINPOINT":4,"MAINPOINT_CONTENT":"报告期内，汽车行业在新能源变革驱动下，加快从传统燃油车主导迈向电动化、智能化发展新阶段。行业在产品、技术、制造、品牌、渠道等方面出现了新趋势。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"体系化大单品打造能力","MAINPOINT":5,"MAINPOINT_CONTENT":"公司已具备持续锻造大单品的体系化能力，涵盖深度用户洞察、精准产品定义、数据闭环运营、敏捷平台化开发以及前沿技术高效转化等核心维度，并在高端SUV市场得到充分验证——2025年，问界在高端新能源SUV市场份额超20%，既支撑了品牌高端化进程，也为产品谱系拓展提供了可复用的能力基础。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"跨界融合协同创新能力","MAINPOINT":6,"MAINPOINT_CONTENT":"科技型企业的核心竞争力，根植于持续创新的能力体系。公司以自主创新夯实技术底座，以融合创新实现能力跃升，以硬核技术创新践行科技型整车企业的中国新实践，推动公司成为智能化领域的引领者。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"产业大脑+超级工厂的高端制造能力体系","MAINPOINT":7,"MAINPOINT_CONTENT":"公司已形成以产业大脑+超级工厂为核心、以质量控制为抓手、以供应链协同为支撑的高端制造能力体系。依托全球领先的超级工厂和体系完备的产业链配套基础，公司将智能制造打造为科技成果规模化稳定兑现的重要载体。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"专属专营的营销服一体化模式","MAINPOINT":8,"MAINPOINT_CONTENT":"公司已形成覆盖门店布局与智慧服务的问界专属专营一体化模式，将技术、产品与安全层面的核心积累沉淀为品牌认同、用户信赖和服务体验，切实实现品牌价值、用户价值的双提升。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"科技创新驱动的新旧动能转换能力","MAINPOINT":9,"MAINPOINT_CONTENT":"在汽车行业新旧动能转换浪潮下，公司摒弃简单推倒重来的粗放转型路径，以科技创新与产业升级为抓手，聚焦技术、制造、供应链、门店四大维度盘活存量、培育增量，推动传统模式向现代化汽车产业体系升级，实现“旧积累”向“新优势”的高效跃迁，走出独具特色的赛力斯实践之路。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"工程师思维与奋斗者意识锻造的人才队伍","MAINPOINT":10,"MAINPOINT_CONTENT":"公司以《赛力斯基本纲领》为指引，营造“人人都是工程师，人人争当奋斗者”的组织氛围，弘扬“敢创、敢干、敢担当”的企业精神。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"拟6.4亿收购泸州容大86.37%股权","MAINPOINT":12,"MAINPOINT_CONTENT":"2018年3月9日公告,公司拟收购控股股东小康控股持有的泸州容大车辆传动有限公司86.37%的股权,交易价格为63,965.22万元。泸州容大已掌握汽车无级自动变速器(CVT)关键核心技术,拥有行业领先的汽车无级自动变速器总成、关键零部件和电控系统的研发及生产能力。转让方承诺,于承诺期内,目标公司泸州容大车辆传动有限公司实现的净利润总额不低于26000万元(2018年度2000万元、2019年度9000万元、2020年度15000万元)。交易完成后,公司合并报表范围将扩大。本公司将直接持有泸州容大86.37%股权,间接持有湖南容大98.21%股权。交易有利于公司发动机和自动变速器系统集成并提升公司汽车动力系统的整体竞争实力,公司将形成新业务、创造新的利润增长点。","KEY_CLASSIF":"对外扩张","KEY_CLASSIF_CODE":"006002","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"拟定增48.3亿元收购东风小康50%股权","MAINPOINT":15,"MAINPOINT_CONTENT":"2018年11月18日公告,公司拟以14.54元/股向东风汽车集团发行332,187,070股公司股份,合计48.3亿元购买东风小康50%股权。本次交易完成后,东风小康将成为小康股份全资子公司。同时,东风汽车集团将成为上市公司持股5%以上的法人股东,将继续作为公司的关联方。","KEY_CLASSIF":"对外扩张","KEY_CLASSIF_CODE":"006002","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"拟30亿元增资新能源汽车项目","MAINPOINT":13,"MAINPOINT_CONTENT":"2018年6月12日公告,公司拟对金康新能源增资30亿元,增资后,金康新能源的注册资本从10亿元增至40亿元,仍为公司全资子公司。具体而言,公司计划使用可转债募集资金4.23亿元、自有资金25.77亿元,分别用于纯电动乘用车建设项目、发展新能源汽车相关业务。","KEY_CLASSIF":"其他扩张","KEY_CLASSIF_CODE":"006004","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"与阿里巴巴签署合作协议","MAINPOINT":14,"MAINPOINT_CONTENT":"2018年8月23日公告,公司与阿里巴巴(中国)签署了框架合作协议。合作内容包括搭载阿里车载系统;在电动车领域与阿里合作;使用阿里云、钉钉提升公司办公水平;使用阿里大数据对市场和客户进行分析。","KEY_CLASSIF":"其他扩张","KEY_CLASSIF_CODE":"006004","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"拟定增募资27亿元加码高端智能电动车业务","MAINPOINT":18,"MAINPOINT_CONTENT":"2020年10月12日晚间推出非公开发行股票计划。公司拟向不超过35名特定投资者增发不超过3.78亿股股票,募集资金总额不超过 27.05亿元,将用于SERES智能网联新能源系列车型开发及产品技术升级项目、营销渠道建设项目及补充流动资金。","KEY_CLASSIF":"其他扩张","KEY_CLASSIF_CODE":"006004","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"重组过会:将全控东风小康","MAINPOINT":16,"MAINPOINT_CONTENT":"2020年3月12日晚间传来喜讯,在当天召开的中国证监会并购重组委2020年第7次工作会议上,公司发行股份购买资产暨关联交易事项经审核,获得有条件通过。据悉,2019年9月16日,小康股份推出重组预案,拟以11.76元/股价格,向东风汽车集团定向增发约3.27亿股股票,收购其持有的东风小康50%股权。交易完成后,东风小康将由公司持股比例50%的控股子公司变为控股100%的全资子公司,而东风汽车亦将合计持有小康32.9%的股份晋位为第二大股东。对于此次重组,市场曾将其解读为国企参与民企反向混改的经典案例。小康股份表示,与东风汽车在子公司层面长达17年的密切合作升级到更高层级的混改,从以业务合作为主升级为全面战略合作,体现出当前汽车产业大变革时期联盟抱团式发展的战略协同,这也有利于进一步增强上市公司整体竞争力,进一步提升归属于上市公司的股东权益和盈利能力;此外,也体现了东风汽车对公司智能电动汽车业务的认可。同时,东风汽车亦表示,通过此次重组,虽然放弃了对盈利能力较强的子公司的少数股权,但藉此成为了上市公司小康股份的重要股东,实现了国有资产的保值增值;同时,打开了在高端汽车及相关零部件、智能电动车领域的更广阔蓝海,有助于市场各方互利共赢,也有力践行了国企鼓励、支持、引导和保护民营经济发展的号召。","KEY_CLASSIF":"资产重组","KEY_CLASSIF_CODE":"006005","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"以集中竞价交易方式回购股份","MAINPOINT":11,"MAINPOINT_CONTENT":"2023年9月2日公司对外公告,赛力斯集团股份有限公司(以下简称“公司”)于 2022 年 10 月 24 日召开第四届董事会第三十二次会议,审议通过了《关于以集中竞价交易方式回购股份方案的议案》,同意公司以自有资金回购已经发行的 A 股股票,用于员工持股计划、股权激励或国家政策法规允许范围内的其他用途。本次回购的资金总额不低于人民币 20,000 万元(含)、不超过人民币 40,000 万元(含),回购价格为不超过人民币 91 元/股(含)。本次回购实施期限为自公司董事会审议通过本次回购方案之日起不超过 12 个月。截至2023 年 8 月 31 日,公司通过集中竞价交易方式已累计回购股份数量为 225.90万股,占公司总股本的比例为 0.15%,回购成交的最高价为人民币 46.74 元/股、最低价为人民币 41.16 元/股,支付的资金总额为人民币 9,999.11 万元(不含交易费用)。上述回购符合相关法律法规的规定及公司既定的回购股份方案。","KEY_CLASSIF":"股票回购","KEY_CLASSIF_CODE":"007002","IS_POINT":"1"},{"SECUCODE":"601127.SH","SECURITY_CODE":"601127","SECURITY_NAME_ABBR":"赛力斯","KEYWORD":"获2.14亿元政府补助","MAINPOINT":17,"MAINPOINT_CONTENT":"2020年4月3日公告,公司及子公司自2019年12月30日至2020年4月1日,共计收到政府补助约2.14亿元。其中,与资产相关的2亿元;与收益相关的1366.15万元,对公司归母净利润的影响金额为1169.56万元。根据公告,上述补助最大的一笔金额为2亿元,项目为“迁建支持资金”,属与资产相关;其它项目还包括人才补助、稳岗及社保补贴、科技项目补助、产业发展资金、工业与信息化发展专项补贴等,均与收益相关。","KEY_CLASSIF":"政府补贴","KEY_CLASSIF_CODE":"010002","IS_POINT":"1"}]}