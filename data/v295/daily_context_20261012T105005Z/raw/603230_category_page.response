{"ssbk":[{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"486","BOARD_NAME":"传媒","IS_PRECISE":"0","BOARD_RANK":1},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"1218","BOARD_NAME":"出版","IS_PRECISE":null,"BOARD_RANK":2},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"1289","BOARD_NAME":"大众出版","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"175","BOARD_NAME":"内蒙古","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"1752","BOARD_NAME":"2026中报预减","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":6},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"1632","BOARD_NAME":"昨日高换手","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"707","BOARD_NAME":"沪股通","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"683","BOARD_NAME":"央国企改革","IS_PRECISE":"1","BOARD_RANK":9},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","BOARD_CODE":"590","BOARD_NAME":"西部大开发","IS_PRECISE":"1","BOARD_RANK":10}],"hxtc":[{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"图书、报刊、音像制品及电子出版物、文化用品、体育用品及器材、珠宝首饰、工艺品及收藏品、教材教辅、教育装备的批发零售;林业产品的批发零售;自营和代理各类商品和技术的进出口,但国家限定公司经营或禁止进出口的商品和技术除外;纺织、服装及家庭用品的批发零售;机械设备、五金产品及电子用品批发零售;广告业;自有房屋租赁;自有物业管理;物流(除专营);其他仓储业(除危险仓储服务)。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"文化消费","MAINPOINT":3,"MAINPOINT_CONTENT":"公司深耕实体书店图书发行业务，着力提升运营效能，创新管理模式，打造现代化、体验式文化消费场景。依托“七进”工程、“鸿雁悦读”等特色文化载体，线下打造“文化会客厅”，完善“大书城立根、中小书吧补充”布局，推动多业态融合与全渠道资源整合，不断丰富文化服务供给。以募投项目建设为抓手，优化营业网点布局，依托发行网络延伸服务链条、重组产业要素，激活发展新动能。公司坚持传统发行与新兴业态协同发展，实体书店多元拓展文化消费新场景，建成新零售中台、直播电商基地、线上线下融合发力，持续提升文化传播力与影响力。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"教育服务","MAINPOINT":4,"MAINPOINT_CONTENT":"作为全区重要的教育服务主力军，公司始终坚守教材教辅发行主责主业，以传统业务升级与新兴赛道布局为双轮驱动，不断完善多元业务体系。凭借覆盖内蒙古自治区全域的教育服务网络和专业团队，精准服务全区基础教育，全面保障教材教辅供应，同步拓展教育装备、教育信息化等综合服务。公司持续推进网格化运营体系的精细化升级，着力构筑高效协同、环环相扣的教育产业价值链。以专业、规范、可靠的服务，打造区域影响力突出的教育服务品牌，为教育事业高质量发展提供坚实支撑。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"现代物流","MAINPOINT":5,"MAINPOINT_CONTENT":"公司构建以呼和浩特市物流基地为核心，辐射全区盟市、旗县终端，形成覆盖全区的现代化供应链体系。聚焦教育服务“最后一公里”，强化教材教辅等传统业务支撑能力，完善全周期服务链条。公司持续织密发行网络，优化物流配送体系，显著提升服务效率与保障能力，切实履行传播先进文化、服务立德树人根本任务的重要使命，以专业可靠的教材教辅及草原书屋等图书供应，为全区文化事业的高质量发展注入坚实力量。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"文化行业","MAINPOINT":6,"MAINPOINT_CONTENT":"2025年中国文化行业整体呈现稳中有进、提质增效的发展态势，总量规模持续扩大，结构优化趋势显著。据国家统计局统计，全年规模以上文化及相关产业企业（以下简称“文化企业”）营业收入达152,135亿元，同比增长7.4%，8.2万家文化企业共同支撑起行业发展大盘。从产业类型来看，文化服务业成为绝对主力，营收占比达56.4%，同比增长12.0%，对规模以上文化企业营业收入增长的贡献率高达88.3%；文化批发和零售业稳健增长，同比增速4.0%，而文化制造业增长放缓，同比仅增长0.6%，行业呈现明显的服务化转型特征。文化新业态特征较为明显的16个行业小类实现营业收入68,253亿元，增长14.3%，快于全部规模以上文化企业6.9个百分点。此外，规模以上文化企业实现利润总额13,763亿元，增长6.5%，营业收入利润率为9.05%，与上年基本持平。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"品牌深化与拓展优势","MAINPOINT":7,"MAINPOINT_CONTENT":"公司前身为自治区新华书店，历经数十年深耕积淀，“内蒙新华”品牌已成为内蒙古地区文化消费领域的标杆符号，具备品牌知名度、美誉度与市场认可度。报告期内，公司以“七进”工程、“鸿雁悦读”为核心载体，深化品牌文化内涵与场景融合，策划开展各类主题阅读、流动售书等活动，联动全区各盟市打造品牌联动矩阵，广泛吸引读者参与，品牌文化传播力与群众认同感显著提升。依托“草原书屋”升级工程，推动优质文化资源向全区延伸，打造各类特色文化空间，品牌社会公信力与文化引领力实现双提升。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"渠道升级与多元化优势","MAINPOINT":8,"MAINPOINT_CONTENT":"公司立足“线上线下融合、全域网络覆盖”的渠道布局基础，2025年持续加大渠道建设投入与业态创新力度，构建起“线下场景化、线上智能化、物流一体化”的全渠道发展格局，实现渠道效能与市场渗透力双重提升。线下渠道方面，深化“大书城、小书吧”发展模式，推进实体书店提质焕新与布局优化，完成多家标杆门店升级改造，新增各类微型文化空间，推动“七进”工程落地见效，实现核心区域全覆盖；线上渠道方面，以新零售直播基地为核心，拓展多平台直播矩阵，开展各类主题直播活动，精准触达细分读者群体，有效增强用户粘性。实现线上线下联动，构建全渠道消费闭环。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"人才培养与团队建设优势","MAINPOINT":9,"MAINPOINT_CONTENT":"公司始终秉持“人尽其才、共谋发展、赋能未来”的人才发展理念，深化“引、育、用、留”三位一体人才战略，构建系统化、分层级、实战化的人才培养与激励体系，为企业培育新质生产力提供坚实人才保障。人才培养方面，优化分层分类培养机制，开展各类内部专题培训与外部研修交流，选派业务骨干外出跟岗锻炼、青年干部开展上挂下派交流，推动人才能力与企业发展需求精准匹配；团队建设方面，常态化开展跨部门项目协作、团队融合活动，推动部门间资源共享、优势互补，激发团队协同效能与创新活力；激励机制方面，完善基于战略目标的绩效管理体系，优化“双通道”职业发展体系，推行绩效薪酬与岗位晋升联动机制，充分激发员工内生动力与创新活力，打造出一支专业精湛、结构合理、富有战斗力的高素质人才队伍。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"文化传承与社会责任优势","MAINPOINT":10,"MAINPOINT_CONTENT":"公司始终以传承弘扬中华优秀传统文化、铸牢中华民族共同体意识为核心使命，践行“新华之爱、和以致远”的核心价值观，培育“传承、创新、包容、引领”的企业精神，以实际行动履行社会责任、彰显国企担当。文化传承方面，深化特色阅读品牌建设，升级“阅旧知新·图书共享”公益项目，推动图书资源循环利用；优化“鸿雁阅读”服务体系，打造全民阅读品牌，策划开展各类特色阅读活动，推动中华优秀传统文化传承传播；社会责任方面，依托品牌与渠道优势，深度参与乡村振兴、全民阅读普及、文化惠民等工作。开展各类公益捐赠等活动，切实解决基层文化资源匮乏问题。策划开展民族团结相关阅读活动，以铸牢中华民族共同体意识为主线，助力构建书香社会，赢得社会各界广泛认可，凝聚了良好的社会口碑与发展合力。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"自愿锁定股份","MAINPOINT":11,"MAINPOINT_CONTENT":"自公司股票上市之日起三十六个月内,不转让或者委托他人管理本次发行前本人直接及间接持有的公司股份,也不由公司回购本人直接及间接持有的该部分股份。","KEY_CLASSIF":"自愿锁定","KEY_CLASSIF_CODE":"008005","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"股利分配","MAINPOINT":12,"MAINPOINT_CONTENT":"在满足现金分红条件的基础上,结合公司持续经营和长期发展,公司每年以现金方式分配的利润不少于当年实现的可分配利润的10%,且最近3年以现金方式累计分配的利润不少于最近3年实现的年均可分配利润的30%。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"},{"SECUCODE":"603230.SH","SECURITY_CODE":"603230","SECURITY_NAME_ABBR":"内蒙新华","KEYWORD":"稳定股价措施","MAINPOINT":13,"MAINPOINT_CONTENT":"公司首次公开发行股票并上市后三年内,如公司股票收盘价格连续20个交易日低于最近一期经审计的每股净资产,公司将通过控股股东增持股份、公司全体董事(独立董事除外)和高级管理人员增持公司股票以及公司回购股份等措施来稳定股价。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}