{"version":"bbddee092f5864c5b174b667a7ee85d9","result":{"pages":1,"data":[{"SECUCODE":"002531.SZ","SECURITY_CODE":"002531","SECURITY_NAME_ABBR":"天顺风能","BOARD_CODE":"989","BOARD_NAME":"储能概念","SELECTED_BOARD_REASON":"2026年半年报显示，公司积极筹备成立售电公司，形成从\"开发-建设-运营-售电\"的全产业链布局。在开发方面，公司已获取的风电项目指标持续增加，项目分布在河南、广西、湖北等省份，公司积极拓展，持续稳步、多措并举地扩大风电开发规模。在建设方面，公司在建项目按计划推进，同步建设多个风电场和储能站。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0989","DERIVE_BOARD_CODE":"BI0989","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002531.SZ","SECURITY_CODE":"002531","SECURITY_NAME_ABBR":"天顺风能","BOARD_CODE":"879","BOARD_NAME":"标准普尔","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0879","DERIVE_BOARD_CODE":"BI0879","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002531.SZ","SECURITY_CODE":"002531","SECURITY_NAME_ABBR":"天顺风能","BOARD_CODE":"867","BOARD_NAME":"富时罗素","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0867","DERIVE_BOARD_CODE":"BI0867","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002531.SZ","SECURITY_CODE":"002531","SECURITY_NAME_ABBR":"天顺风能","BOARD_CODE":"804","BOARD_NAME":"深股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0804","DERIVE_BOARD_CODE":"BI0804","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002531.SZ","SECURITY_CODE":"002531","SECURITY_NAME_ABBR":"天顺风能","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002531.SZ","SECURITY_CODE":"002531","SECURITY_NAME_ABBR":"天顺风能","BOARD_CODE":"595","BOARD_NAME":"风能","SELECTED_BOARD_REASON":"2026年3月30日回复称，公司整体业务从陆上风电转向海上风电，产品也从陆上塔筒叶片切换到海上风电基础。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0595","DERIVE_BOARD_CODE":"BI0595","BOARD_TYPE":null,"BOARD_LEVEL":