{"version":"6d09a00f2aba6edac8ec76bf1f602c88","result":{"pages":1,"data":[{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"995","BOARD_NAME":"华为昇腾","SELECTED_BOARD_REASON":"2023年9月7日回复称,公司作为华为昇腾AI产业链的重要合作伙伴之一,与华为昇腾合作完成多项信创技术及产品的认证,其中包含鲲鹏技术认证书、华为昇腾技术认证书、麒麟软件认证书以及国产化部署的企业资质报告。","IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0995","DERIVE_BOARD_CODE":"BI0995","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"920","BOARD_NAME":"车联网(车路云)","SELECTED_BOARD_REASON":"2024年年报显示，公司是国内领先的以交通安全为核心的“数字化解决方案+生活服务”科技驱动型企业，涵盖“人、车、路”完整产业链布局，为行业客户提供领先的数字化产品和解决方案。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0920","DERIVE_BOARD_CODE":"BI0920","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"900","BOARD_NAME":"新能源车","SELECTED_BOARD_REASON":"2025年年报显示，公司是国内领先的以交通安全为核心的“数字化解决方案+生活服务”科技驱动型企业，涵盖“人、车、路”完整产业链布局，目前已形成以“人”为核心的驾驶员考试、驾驶员培训产品线，以“车”为核心的数智化车管平台及新能源汽车检测设备与服务运营产品线，以“路”为核心的信号控制及智能网联产品线，同时配有新能源汽车交直流充电设备及工商业储能产品。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0900","DERIVE_BOARD_CODE":"BI0900","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"891","BOARD_NAME":"国产芯片","SELECTED_BOARD_REASON":"公司参股的湖南北云科技系专业从事北斗高精度卫星导航定位相关软硬件技术产品的高新技术企业,该公司基于全球卫星导航系统(GNSS),自主研发实时高精度卫星导航定位芯片,能为客户提供全面的高精度导航定位相关产品包括核心板卡、接收机产品、智能网联汽车业务和基于位置的行业应用服务与解决方案,主要应用于卫星导航、驾考驾培、测绘与地理信息、智慧交通、自动驾驶与辅助驾驶等领域。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0891","DERIVE_BOARD_CODE":"BI0891","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2024年9月6日公告显示，公司驾驶员考试平台已完成了基于海光CPU，统信/麒麟操作系统，华为OpenGauss数据库的适配，并取得了相应的信创认证报告。作为华为鲲鹏展翅伙伴计划及昇腾万里伙伴计划中的一员，公司正携手合作伙伴积极打造交通安全领域自主可控、安全可靠、竞争力强的产业体系。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"802","BOARD_NAME":"智能驾驶","SELECTED_BOARD_REASON":"2020年1月6日回复称公司开发的基于“二维高精度地图和激光雷达点云数据融合的环境感知AI技术”是自动驾驶的关键支撑技术之一;公司自主开发的基于多传感融合的环境感知技术研发的“机动车驾驶人道路驾驶技能考试智能评估系统”,为自动驾驶落地应用提供了技术评判依据。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0802","DERIVE_BOARD_CODE":"BI0802","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2020年6月16日回复称多伦科技与华为在5G通信、云计算、人工智能计算平台和行业解决方案等方面展开了积极合作,未来双方将进一步拓展合作的广度和深度,共同推动交通管理科技与服务的数字化转型。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"737","BOARD_NAME":"软件开发","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0737","DERIVE_BOARD_CODE":"BI0737","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"696","BOARD_NAME":"国产软件","SELECTED_BOARD_REASON":"2020年1月6日回复称在软件方面,公司为自动驾驶检测综合管理平台的测试系统打造了提供自动驾驶能力评判的功能核心模块,实现对不同级别的自动驾驶车辆的自动驾驶评测。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0696","DERIVE_BOARD_CODE":"BI0696","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"634","BOARD_NAME":"大数据","SELECTED_BOARD_REASON":"2022年半年报显示公司拥有自主知识产权的大数据管理平台并在总部建有可视化运营中心,通过对全国各业务单元的动态数据流汇聚、统计、分析与研判,实现数据治理,提升精细化运营管理能力。来自实际应用场景的精准大数据可以为行业及主管部门提供决策参考,并向客户提供有价值的市场动态及产品信息,不断提升客户体验。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0634","DERIVE_BOARD_CODE":"BI0634","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"629","BOARD_NAME":"卫星导航","SELECTED_BOARD_REASON":"2023年2月23日回复称，公司投资的北云科技（持股约12.63%）始终专注于高精度卫星导航核心部件的研发，其自主研发的实时高精度北斗卫星导航定位芯片，可以为客户提供自主可控、安全可靠的高精度导航定位及雷达辅助相关产品，目前已经成功获得多家国内知名主机厂商的供应商定点资格通知书。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0629","DERIVE_BOARD_CODE":"BI0629","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"628","BOARD_NAME":"智慧城市","SELECTED_BOARD_REASON":"2021年5月12日回复称公司围绕大数据、云计算、深度学习、三维虚拟仿真、物联网感知、北斗卫星定位六大核心技术,形成了以智慧车管、智慧驾培、智慧城市和智慧车检为主的四大产品体系,业务涵盖交通安全出行领域的诸多环节。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0628","DERIVE_BOARD_CODE":"BI0628","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"554","BOARD_NAME":"物联网","SELECTED_BOARD_REASON":"2020年3月12日回复称公司围绕大数据、云计算、深度学习、三维虚拟仿真、物联网感知、北斗卫星定位六大核心技术,形成了以智能驾考、智慧驾培和智慧交通为主的三大成熟产品体系。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0554","DERIVE_BOARD_CODE":"BI0554","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"159","BOARD_NAME":"江苏板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0159","DERIVE_BOARD_CODE":"BI0159","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"1447","BOARD_NAME":"垂直应用软件","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1447","DERIVE_BOARD_CODE":"BI1447","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"1207","BOARD_NAME":"计算机","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1207","DERIVE_BOARD_CODE":"BI1207","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"1190","BOARD_NAME":"虚拟机器人","SELECTED_BOARD_REASON":"2025年12月4日回复称，此次亮相的智能交通指挥机器人，由多伦科技基于众擎PM01本体二次开发而成。该机器人融合智能感知、实时决策与多模态交互三大核心技术，通过高精度关节模组完美复现，实现标准手势纯自主指挥。同时，该机器人还能基于实时车流感知，智能协同信号灯实现动态放行，有效提升路口通行效率，既是智慧交通领域的创新实践，也为具身智能技术从“性能突破”到“规模落地”提供了生动范本。","IS_PRECISE":"1","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1190","DERIVE_BOARD_CODE":"BI1190","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"1090","BOARD_NAME":"机器人概念","SELECTED_BOARD_REASON":"2025年年报显示，公司以 AI+大交通为战略核心，构建自主创新、合作开发、生产代工三位一体的机器人业务体系，深耕具身智能与智慧交管、政务服务、商业零售的深度融合。自主创新方面，聚焦机动车查验机器人核心技术攻关，依托行业数据与算法优势，打造高精度、全流程智能查验终端，赋能车检场景数字化革新。合作开发层面，与深圳众警机器人深度协同，基于其先进人形机器人本体开展场景化二次开发，推出交通指挥、政务导办、安防巡逻等系列化具身智能产品，构建 “本体+算法+场景”的技术闭环。生产组装领域，携手影智科技布局服务机器人代工业务，承接咖啡机器人、冰淇淋机器人的规模化制造，拓展商业零售场景应用矩阵。","IS_PRECISE":"1","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1090","DERIVE_BOARD_CODE":"BI1090","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"1022","BOARD_NAME":"职业教育","SELECTED_BOARD_REASON":"2024年12月27日回复称，公司多年来高度关注前沿科技发展，不断探索前沿科技与自身业务产品的融合并追求在客户场景的有效落地，人工智能技术在公司智慧车管、智慧驾培、智慧交通等多个主营产业中均有应用。","IS_PRECISE":"1","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1022","DERIVE_BOARD_CODE":"BI1022","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603528.SH","SECURITY_CODE":"603528","SECURITY_NAME_ABBR":"多伦科技","BOARD_CODE":"1005","