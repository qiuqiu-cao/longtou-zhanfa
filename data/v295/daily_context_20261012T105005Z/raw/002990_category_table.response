{"version":"5c8955985883eac441b4791640bda679","result":{"pages":1,"data":[{"SECUCODE":"002990.SZ","SECURITY_CODE":"002990","SECURITY_NAME_ABBR":"盛视科技","BOARD_CODE":"995","BOARD_NAME":"华为昇腾","SELECTED_BOARD_REASON":"2023年6月14日回复称，盛视科技携手昇腾AI已推出多项联合解决方案，包括无感考勤、智慧工地、智慧城管、智慧煤矿等，所有方案均采用华为昇腾AI芯片及MindSpore框架，已完成兼容性测试，获得五项“盛视\u0026华为联合解决方案技术认证”证书。","IS_PRECISE":"0","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0995","DERIVE_BOARD_CODE":"BI0995","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002990.SZ","SECURITY_CODE":"002990","SECURITY_NAME_ABBR":"盛视科技","BOARD_CODE":"920","BOARD_NAME":"车联网(车路云)","SELECTED_BOARD_REASON":"2024年年报显示，公司2022年推出了智慧防控整体解决方案、半挂车360°车辆环视系统等车联网产品。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0920","DERIVE_BOARD_CODE":"BI0920","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002990.SZ","SECURITY_CODE":"002990","SECURITY_NAME_ABBR":"盛视科技","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2025年9月26日回复称，盛视是华为领先级智能交通解决方案合作伙伴，双方在道路交通感知、交通违法管理、城市交通缓堵、交通事件AI感知、交通运维等方面打造了端到端整体解决方案。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002990.SZ","SECURITY_CODE":"002990","SECURITY_NAME_ABBR":"盛视科技","BOARD_CODE":"804","BOARD_NAME":"深股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0804","DERIVE_BOARD_CODE":"BI0804","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002990.SZ","SECURITY_CODE":"002990","SECURITY_NAME_ABBR":"盛视科技","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"招股说明书披露:经过二十余年的发展,公司已在应用人工智能的智慧口岸查验等领域形成了技术研发水平、整体方案解决能力、品牌影响力等竞争优势。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002990.SZ","SECURITY_CODE":"002990","SECURITY_NAME_ABBR":"盛视科技","BOARD_CODE":"735","BOARD_NAME":"计算机设备","SELECTED_BOARD_REASON":null,"IS_