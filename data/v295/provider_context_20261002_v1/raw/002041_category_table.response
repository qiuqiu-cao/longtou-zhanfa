{"version":"3b385cd6b6df073e6f49a65122adc822","result":{"pages":1,"data":[{"SECUCODE":"002041.SZ","SECURITY_CODE":"002041","SECURITY_NAME_ABBR":"登海种业","BOARD_CODE":"907","BOARD_NAME":"转基因","SELECTED_BOARD_REASON":"2026年1月22日回复称，公司与山东省农业科学院合作研发的转基因玉米转化体LD05获得农业农村部农业转基因生物安全证书。其他生物育种技术应用正在稳步推进。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0907","DERIVE_BOARD_CODE":"BI0907","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002041.SZ","SECURITY_CODE":"002041","SECURITY_NAME_ABBR":"登海种业","BOARD_CODE":"888","BOARD_NAME":"农业种植","SELECTED_BOARD_REASON":"公司主要从事玉米科研育种和高产攻关研究,在被称为“中国紧凑型杂交玉米之父”的李登海研究员带领下,历经40多年持续不间断地玉米育种研发创新和高产攻关,完成了5代玉米杂交种的进步性替代。公司主推的玉米杂交种为登海605 、登海618 、先玉335 、良玉99。公司自主选育的玉米新品种登海605推广面积超过千万亩。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0888","DERIVE_BOARD_CODE":"BI0888","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002041.SZ","SECURITY_CODE":"002041","SECURITY_NAME_ABBR":"登海种业","BOARD_CODE":"867","BOARD_NAME":"富时罗素","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0867","DERIVE_BOARD_CODE":"BI0867","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002041.SZ","SECURITY_CODE":"002041","SECURITY_NAME_ABBR":"登海种业","BOARD_CODE":"834","BOARD_NAME":"乡村振兴","SELECTED_BOARD_REASON":"登海种业主要从事农作物新品种选育、许可证规定经营范围内的农作物种子生产、分装、销售。公司是国家高新技术企业、国家创新型企业,先后获得国家星火一等奖、国家科技进步一等奖、山东省科技进步一等奖等25项国家及省部级奖励,在海南省建有稳定的育种基地,具有较强的技术开发和创新能力。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0834","DERIVE_BOARD_CODE":"BI0834","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002041.SZ","SECURITY_CODE":"002041","SECURITY_NAME_ABBR":"登海种业","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002041.SZ","SECURITY_CODE":"002041","SECURITY_NAME_ABBR":"登海种业","BOARD_CODE":"804","BOARD_NAME":"深股通"