{"ssbk":[{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1212","BOARD_NAME":"轻工制造","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1267","BOARD_NAME":"造纸","IS_PRECISE":null,"BOARD_RANK":2},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1545","BOARD_NAME":"特种纸","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"146","BOARD_NAME":"黑龙江","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1717","BOARD_NAME":"题材股","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1715","BOARD_NAME":"趋势股","IS_PRECISE":null,"BOARD_RANK":6},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1638","BOARD_NAME":"最近多板","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1637","BOARD_NAME":"东方财富热股","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","IS_PRECISE":"0","BOARD_RANK":10},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","IS_PRECISE":"0","BOARD_RANK":11},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","IS_PRECISE":"0","BOARD_RANK":12},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"1181","BOARD_NAME":"并购重组概念","IS_PRECISE":"1","BOARD_RANK":13},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"470","BOARD_NAME":"造纸印刷","IS_PRECISE":"0","BOARD_RANK":14},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"856","BOARD_NAME":"工业大麻","IS_PRECISE":"1","BOARD_RANK":15},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"838","BOARD_NAME":"东北振兴","IS_PRECISE":"1","BOARD_RANK":16},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","BOARD_CODE":"683","BOARD_NAME":"央国企改革","IS_PRECISE":"1","BOARD_RANK":17}],"hxtc":[{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"一般项目:纸浆制造;纸制造;纸制品制造;纸浆销售;纸制品销售;新材料技术研发;技术服务、技术开发、技术咨询、技术交流、技术转让、技术推广;货物进出口;机械零件、零部件加工;污水处理及其再生利用;包装材料及制品销售;图文设计制作;专业设计服务;包装服务;油墨销售(不含危险化学品);技术进出口。(除依法须经批准的项目外,凭营业执照依法自主开展经营活动)许可项目:烟草专卖品生产;烟草专卖品批发;特定印刷品印刷;包装装潢印刷品印刷。(依法须经批准的项目,经相关部门批准后方可开展经营活动,具体经营项目以相关部门批准文件或许可证件为准)","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"特种纸的生产和销售、纸浆的生产和销售","MAINPOINT":3,"MAINPOINT_CONTENT":"公司始终致力于安全环保型特色产品的研制开发。主要业务为特种纸、纸浆的生产和销售。特种纸按类别划分为烟草工业用纸、机械光泽纸、薄型印刷纸及其他生产生活用纸四大类别，主要产品包括烟草工业用纸、印刷工业用纸、医疗保健生活用纸、食品食材接触用纸等系列；纸浆包括剑麻浆、大麻浆及亚麻浆等特种浆。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"特种纸行业","MAINPOINT":4,"MAINPOINT_CONTENT":"从细分领域看，中国特种纸行业正在从“规模扩张”转向“质量提升”阶段，高端产品进口替代加速。食品包装纸在限塑令、消费升级、出口增长的驱动下，维持了为高景气度的增长，装饰原纸价格战趋缓，整体趋稳承压。医疗/透析纸呈现高壁垒高增长趋势。烟草工业用纸存量博弈下，卷烟结构升级（细支/中支烟）、新型烟草（HNB）仍为未来增长的驱动因素。受宏观经济影响，热转印/标签纸需求波动明显，但受益于服装印花、物流标签数字化影响，有望迎来温和复苏。高端特种木浆（如针叶浆）对外依存度仍高，供应链安全风险犹存，中低端产能过剩引发的同质化竞争仍未完全缓解。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"经营管理团队人员稳定","MAINPOINT":5,"MAINPOINT_CONTENT":"公司经营管理团队凝聚力强、发展共识清晰，得到企业与社会的广泛认同。通过每年开展战略总结、政策研讨、规划调整与思想统一等工作，为企业快速发展提供了坚实的决策保障，确保公司经营理念与战略方向等核心要素高度协同。公司高度重视人才梯次结构及中高层队伍建设，以企业长远发展为导向实施战略性人力资源管理，为企业做强做大提供了强有力的支撑。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"战略与文化协调发展","MAINPOINT":6,"MAINPOINT_CONTENT":"公司坚持战略引领、文化驱动，构建可持续发展运行机制，积极推动战略与文化体系对公司核心竞争力的支撑作用。公司愿景、使命等核心价值观，已成为企业凝聚力和向心力的源泉。围绕战略规划目标，公司积极推进企业文化建设，深度关注战略与文化的匹配度，对企业文化理念的认同推动了各项工作的同心同向，进而打造出同行业难以复制的战略与文化管理体系。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"细分领域技术实力雄厚","MAINPOINT":7,"MAINPOINT_CONTENT":"公司是中国卷烟直接材料用纸研发与生产领域的领军企业，作为国内首批通过科技部和中国科学院认定的造纸行业重点高新技术企业，设有博士后科研工作站，同时也是国家知识产权优势企业、制造业单项冠军企业。公司始终坚持自主研发，引领行业研发与生产方向，其技术中心既是省级企业技术中心，也是黑龙江省特种纸中试基地与中试熟化平台。多年来，公司承担了国家火炬计划项目、国家重点新产品项目及省级重点科研项目等多项研发任务，是国家及行业标准制定的重要参与者。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"智能化水平行业领先","MAINPOINT":8,"MAINPOINT_CONTENT":"公司大力建设智能工厂，全面树立以数字化企业为核心的管理理念，持续提升企业经营管理水平，构建企业数据治理标准平台，进一步理顺并明确公司数据治理的管控要求，推进企业数字化转型升级，提升数据应用价值与信息增值能力。公司已通过国家工信部两化融合管理体系贯标认证，荣获黑龙江省智能工厂称号、工信部卓越智能工厂称号。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"国际化市场打开新发展格局","MAINPOINT":9,"MAINPOINT_CONTENT":"公司率先布局出口市场，坚持走向世界，建设一流企业的初心，卷烟直接材料用纸出口保持行业领先水平，连续多年实现超过20%以上产品出口的成绩，与菲莫国际、英美烟草及日烟国际建立了稳定的合作关系，为开展新型烟草产品材料用纸合作奠定了坚实的基础。2024年公司成为国内首个明确科学碳目标（SBTi）的特种纸企业，持续提升了企业国际化形象。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600356.SH","SECURITY_CODE":"600356","SECURITY_NAME_ABBR":"恒丰纸业","KEYWORD":"第一期员工持股计划存续期即将届满","MAINPOINT":10,"MAINPOINT_CONTENT":"2023年2月23日公司对外公告,2018年6月16日,公司召开九届董事会第二次会议,审议通过了《公司第一期员工持股计划(草案)及其摘要》、《公司第一期员工持股计划管理细则》及《关于提请股东大会授权董事会办理公司第一期员工持股计划相关事宜》的议案。2018年7月4日,公司召开2018年第一次临时股东大会,审议通过了上述相关议案,同意授权董事会办理公司员工持股计划等相关事宜。2021年6月19日公司召开十届董事会第二会议,审议通过了《关于公司第一期员工持股计划延期的议案》,同意将员工持股计划存续期延长24个月,即延长至2023年7月3日为止。截至本公告日,员工持股计划共持有公司股份  8,153,940  股,占公司股本总额的 2.73%。","KEY_CLASSIF":"员工持股","KEY_CLASSIF_CODE":"008004","IS_POINT":"1"}]}