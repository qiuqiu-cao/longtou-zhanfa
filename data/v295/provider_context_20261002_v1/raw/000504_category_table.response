{"version":"efcdcf465407bce7f7a45e902295e64e","result":{"pages":1,"data":[{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"889","BOARD_NAME":"医美概念","SELECTED_BOARD_REASON":"2023年9月18日回复称,公司目前已开发出EE18系列产品,主要有精华液、面膜、面霜等,另外公司还存在部分在研产品,感谢您的关注。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0889","DERIVE_BOARD_CODE":"BI0889","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"727","BOARD_NAME":"医疗服务","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0727","DERIVE_BOARD_CODE":"BI0727","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"698","BOARD_NAME":"免疫治疗","SELECTED_BOARD_REASON":"2017年12月3日晚间公告,公司拟以支付现金的方式购买湖南出版集团、信仰诚富、易银沙合计持有的湖南远泰生物技术有限公司54%股权,交易金额为5,130万元。本次交易完成后,公司将持有远泰生物54%的股权,远泰生物将成为公司的控股子公司。远泰生物主要从事CAR-T细胞免疫治疗研发及相关服务。通过本次交易,公司将实现在生物医药新领域的拓展,介入细胞免疫治疗产业。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0698","DERIVE_BOARD_CODE":"BI0698","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"683","BOARD_NAME":"央国企改革","SELECTED_BOARD_REASON":"公司的实际控制人为湖南省人民政府。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0683","DERIVE_BOARD_CODE":"BI0683","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"668","BOARD_NAME":"医疗器械概念","SELECTED_BOARD_REASON":"2025年半年报显示,公司根据客户需求扩展提供生物医药相关医疗器械等产品。公司生物医药板块业务主要通过控股公司南华生物技术、博爱康民、南华干细胞转化、爱世为民等具体运营。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0668","DERIVE_BOARD_CODE":"BI0668","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"574","BOARD_NAME":"锂电池概念","SELECTED_BOARD_REASON":"2025年年报显示，公司通过收购金弘新材及金大路环保，构建起以“碳酸锂生产及销售”与“废钢铁回收加工及销售”为核心的“碳酸锂+废钢”双赛道协同发展布局，与原有节能环保业务形成互补协同，有效提升了公司整体抗风险能力与资源综合利用效率。其中，金弘新材与中南大学建立深度技术合作，合作研发的“退役动力电池回收制备碳酸锂和磷酸铁”技术，采用湿法提锂工艺提取高品质碳酸锂，技术优势突出；其中一期 2.4 万吨/年废旧磷酸铁锂电池回收利用项目已基本建成达产，产品包括工业级碳酸锂等，项目严格落实环保要求，实现循环水利用、废水零排放、渣料综合利用等环保目标，环保合规性强，符合地方产业政策导向。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0574","DERIVE_BOARD_CODE":"BI0574","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"552","BOARD_NAME":"机构重仓","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0552","DERIVE_BOARD_CODE":"BI0552","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"494","BOARD_NAME":"节能环保","SELECTED_BOARD_REASON":"2016年8月30日晚间发布重组预案,公司拟剥离新闻和出版业务,并通过现金收购新增节能技术服务业务,公司拟以支付现金方式向黄少和收购惠州梵宇100%股权,交易作价为5448.33万元。惠州梵宇主要经营性资产为其控股子公司城光节能,后者主要从事节能环保服务业务。据介绍,城光节能主要从事城市及道路照明节能项目实施、合同能源管理服务及节能产品销售业务。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0494","DERIVE_BOARD_CODE":"BI0494","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"1750","BOARD_NAME":"2026中报扭亏","SELECTED_BOARD_REASON":"预计2026年1-6月归属于上市公司股东的净利润盈利:420万元至620万元。","IS_PRECISE":null,"BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1750","DERIVE_BOARD_CODE":"BI1750","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"000504.SZ","SECURITY_CODE":"000504","SECURITY_NAME_ABBR":"南华生物","BOARD_CODE":"1722","BOARD_NAME":"高市净率","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":5,"B