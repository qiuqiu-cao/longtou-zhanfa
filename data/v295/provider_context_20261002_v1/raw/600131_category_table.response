},{"SECUCODE":"600131.SH","SECURITY_CODE":"600131","SECURITY_NAME_ABBR":"国网信通","BOARD_CODE":"683","BOARD_NAME":"央国企改革","SELECTED_BOARD_REASON":"最终控股股东为国务院国资委","IS_PRECISE":"1","BOARD_RANK":43,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0683","DERIVE_BOARD_CODE":"BI0683","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600131.SH","SECURITY_CODE":"600131","SECURITY_NAME_ABBR":"国网信通","BOARD_CODE":"655","BOARD_NAME":"网络安全","SELECTED_BOARD_REASON":"2025年半年报显示，公司旗下子公司持有全国电信增值业务许可证（ISP),获得软件领域最高等级CMMI5认证，并通过ISO27001信息安全管理体系认证。在信息安全服务领域，公司已取得安全运维、风险评估、应急处理、系统集成等四项一级服务资质，同时拥有ITSS 信息技术服务运行维护标准认证等40余项专业资质。基于完善的客户服务体系，公司提供全年7x24小时快速响应的运维支持与应急保障，在重大活动电力保障、突发公共事件处置、极端天气电网抢修等场景中展现出强大的实战支撑能力。","IS_PRECISE":"1","BOARD_RANK":44,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0655","DERIVE_BOARD_CODE":"BI0655","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600131.SH","SECURITY_CODE":"600131","SECURITY_NAME_ABBR":"国网信通","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600131.SH","SECURITY_CODE":"600131","SECURITY_NAME_ABBR":"国网信通","BOARD_CODE":"590","BOARD_NAME":"西部大开发","SELECTED_BOARD_REASON":"注册地址是四川汶川县下索桥。","IS_PRECISE":"1","BOARD_RANK":45,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0590","DERIVE_BOARD_CODE":"BI0590","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600131.SH","SECURITY_CODE":"600131","SECURITY_NAME_ABBR":"国网信通","BOARD_CODE":"581","BOARD_NAME":"智能电网","SELECTED_BOARD_REASON":"本次重组拟将主要配售电及发电业务相关资产负债等置出上市公司,与信产集团持有的中电飞华67.31%股份、继远软件100%股权、中电普华100%股权、中电启明星75%股权的等值部分进行置换。上市公司拟向不超过10名投资者非公开发行股票募集配套资金本次募集配套资金拟用于投资标的公司“云网基础平台光纤骨干网建设项目”、“云网基础平台软硬件系统建设项目”、“互联网+电力营销平台建设项目”。","IS_PRECISE":"1","BOARD_RANK":46,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0581","DERIVE_BOARD_CODE":"BI0581","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600131.SH","SECURITY_CODE":"600131","SECURITY_NAME_ABBR":"国网信通","BOARD_CODE":"554","BO