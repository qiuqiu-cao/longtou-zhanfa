","BOARD_NAME":"电子身份证","IS_PRECISE":"1","BOARD_RANK":27},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"1071","BOARD_NAME":"跨境支付","IS_PRECISE":"1","BOARD_RANK":28},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"1069","BOARD_NAME":"智慧灯杆","IS_PRECISE":"1","BOARD_RANK":29},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"1061","BOARD_NAME":"数字经济","IS_PRECISE":"1","BOARD_RANK":30},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"1047","BOARD_NAME":"数据安全","IS_PRECISE":"1","BOARD_RANK":31},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"995","BOARD_NAME":"华为昇腾","IS_PRECISE":"0","BOARD_RANK":32},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"963","BOARD_NAME":"商业航天","IS_PRECISE":"1","BOARD_RANK":33},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"953","BOARD_NAME":"鸿蒙概念","IS_PRECISE":"1","BOARD_RANK":34},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"921","BOARD_NAME":"卫星互联网","IS_PRECISE":"1","BOARD_RANK":35},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"885","BOARD_NAME":"VPN","IS_PRECISE":"1","BOARD_RANK":36},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"883","BOARD_NAME":"数字货币","IS_PRECISE":"1","BOARD_RANK":37},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"861","BOARD_NAME":"数字孪生","IS_PRECISE":"1","BOARD_RANK":38},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"854","BOARD_NAME":"华为概念","IS_PRECISE":"1","BOARD_RANK":39},{"SECUCODE":"002212.SZ","SECURITY_CODE":"002212","SECURITY_NAME_ABBR":"天融信","BOARD_CODE":"920","BOARD_NAME":"车联网(车路云)","IS_PRECISE":"1","BOARD_RANK":40