YIELD":null,"NEW_BOARD_CODE":"BK1135","DERIVE_BOARD_CODE":"BI1135","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"605168.SH","SECURITY_CODE":"605168","SECURITY_NAME_ABBR":"三人行","BOARD_CODE":"1126","BOARD_NAME":"ChatGPT概念","SELECTED_BOARD_REASON":"2025年7月17日公告显示，目前公司致力于对营销领域的多模态AI产品进行全面升级，将“一个”AI从1.0版本升级为2.0版本。2.0版本将在算法和架构上进行深度优化，整合Deepseek、豆包、讯飞星火等先进大模型，构建一个统一的多模态数据处理平台。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1126","DERIVE_BOARD_CODE":"BI1126","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"605168.SH","SECURITY_CODE":"605168","SECURITY_NAME_ABBR":"三人行","BOARD_CODE":"1111","BOARD_NAME":"AIGC概念","SELECTED_BOARD_REASON":"2024年年报显示，以二十年来沉淀的海量数据积累和服务经验为基础，公司通过AI技术智能化为广告主提供专业的营销服务，开发并持续升级营销领域的多模态AI产品，将“一个”AI从1.0版本升级为2.0版本，2.0版本将在算法和架构上进行深度优化，整合DeepSeek、豆包、讯飞星火等先进大模型，构建一个统一的多模态数据处理平台。这一升级将能够更高效地处理和整合文本、图像、语音、视频等多种模态的数据，从而提供更精准的营销策略、更个性化的用户体验以及更高效的运营流程。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1111","DERIVE_BOARD_CODE":"BI1111","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"605168.SH","SECURITY_CODE":"605168","SECURITY_NAME_ABBR":"三人行","BOARD_CODE":"1110","BOARD_NAME":"Web3.0","SELECTED_BOARD_REASON":"2022年11月17日回复称公司建立运营的洞天数字藏品平台,在WEB3.0语境下积极探索下一阶段的平台内容生态,以三人行传媒集团的海量创意资源为基础,结合AIGC技术,在广告营销方面突破传统营销界限,结合AIGC技术畅想未来新型营销趋势,帮助品牌在私域元宇宙中实现流量价值增级。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1110","DERIVE_BOARD_CODE":"BI1110","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"605168.SH","SECURITY_CODE":"605168","SECURITY_NAME_ABBR":"三人行","BOARD_CODE":"1061","BOARD_NAME":"数字经济","SELECTED_BOARD_REASON":"公司2023年7月21日披露,拟设立全资子公司,持续推进公司由传统的数字媒介采购代理商向为客户提供包括数据采买、数字媒体资源采买、数字化转型等在内的综合数字科技服务商转型。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1061","DERIVE_BOARD_CODE":"BI1061","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"605168.SH","SECURITY_CODE":"605168","SECURITY_NAME_ABBR":"三人行","BOARD_CODE":"1055","BOARD_NAME":"虚拟数字人","SELECTED_BOARD_REASON":"2021年年报显示公