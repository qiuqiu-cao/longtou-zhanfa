{"version":"7ffd29ec6119a729a5dc514698e7f326","result":{"pages":1,"data":[{"SECUCODE":"600400.SH","SECURITY_CODE":"600400","SECURITY_NAME_ABBR":"红豆股份","BOARD_CODE":"940","BOARD_NAME":"网红经济","SELECTED_BOARD_REASON":"2020年6月19日回复称目前公司结合快手、抖音、一直播等直播平台,以网红直播带货等形式拓宽销售渠道。同时,面向全员开展线上直播培训,内部培育网络直播人员。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0940","DERIVE_BOARD_CODE":"BI0940","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600400.SH","SECURITY_CODE":"600400","SECURITY_NAME_ABBR":"红豆股份","BOARD_CODE":"835","BOARD_NAME":"独角兽","SELECTED_BOARD_REASON":"“2018中国独角兽100强”榜单近日发布,在众多领域中,华云数据集团凭借着在云计算领域的开创性精神和在私有云细分市场所取得的卓越成绩,成为行业内最可能快速登陆A股的100家公司之一。红豆股份:参与华云数据的B轮和C轮股权融资,持有其2.22%股权。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0835","DERIVE_BOARD_CODE":"BI0835","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600400.SH","SECURITY_CODE":"600400","SECURITY_NAME_ABBR":"红豆股份","BOARD_CODE":"832","BOARD_NAME":"工业互联网","SELECTED_BOARD_REASON":"2025年年报显示，2023年度“红豆男装5G全连接工厂”入选工信部公示的《2022年工业互联网试点示范名单》。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0832","DERIVE_BOARD_CODE":"BI0832","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600400.SH","SECURITY_CODE":"600400","SECURITY_NAME_ABBR":"红豆股份","BOARD_CODE":"825","BOARD_NAME":"新零售","SELECTED_BOARD_REASON":"2019年年报显示公司以全渠道业务全面上线为抓手,加速线上线下的双向引流,并积极尝试新零售业态,推行快闪店、异业联盟等创新营销。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0825","DERIVE_BOARD_CODE":"BI0825","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600400.SH","SECURITY_CODE":"600400","SECURITY_NAME_ABBR":"红豆股份","BOARD_CODE":"816","BOARD_NAME":"昨日连板","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0816","DERIVE_BOARD_CODE":"BI0816","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600400.SH","SECURITY_CODE":"600400","SECURITY_NAME_ABBR":"红豆股份","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0",