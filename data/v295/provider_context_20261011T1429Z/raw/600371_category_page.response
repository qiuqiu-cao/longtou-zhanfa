{"ssbk":[{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"433","BOARD_NAME":"农林牧渔","IS_PRECISE":"0","BOARD_RANK":1},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1261","BOARD_NAME":"种植业","IS_PRECISE":null,"BOARD_RANK":2},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1518","BOARD_NAME":"种子","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"146","BOARD_NAME":"黑龙江","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1717","BOARD_NAME":"题材股","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":6},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1632","BOARD_NAME":"昨日高换手","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","IS_PRECISE":"0","BOARD_RANK":10},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"1086","BOARD_NAME":"粮食概念","IS_PRECISE":null,"BOARD_RANK":11},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"907","BOARD_NAME":"转基因","IS_PRECISE":"1","BOARD_RANK":12},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"888","BOARD_NAME":"农业种植","IS_PRECISE":"1","BOARD_RANK":13},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","BOARD_CODE":"834","BOARD_NAME":"乡村振兴","IS_PRECISE":"1","BOARD_RANK":14}],"hxtc":[{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"一般项目:农业科学研究和试验发展;技术服务、技术开发、技术咨询、技术交流、技术转让、技术推广;农作物种子经营(仅限不再分装的包装种子);谷物种植;农副产品销售;肥料销售;农业机械服务;信息技术咨询服务;企业管理;社会经济咨询服务;货物进出口;技术进出口。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"玉米杂交种子研发、生产、销售","MAINPOINT":3,"MAINPOINT_CONTENT":"公司从事的主要业务仍为玉米杂交种子研发、生产、销售。公司主营包括但不限于“京科968”、“德单系列”等玉米杂交种的生产与销售。公司主要产品为玉米杂交种，主要用途为商品玉米种植。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"五年见成效","MAINPOINT":4,"MAINPOINT_CONTENT":"2025年，全国各地扎实推进种业振兴各项任务落实落细，取得一批重要成果。我国农业种质资源“家底”更加厚实，农业生产用种安全保障水平稳步提升，风险可管控的态势更加牢固。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"品种全链条管理","MAINPOINT":5,"MAINPOINT_CONTENT":"2025年以来，农业农村部进一步加强农作物品种全链条管理，严格监管品种试验，严把品种审定关口，严防同质化、修饰性育种，坚决打击套牌侵权等违法行为，加快突破性新品种培育推广。在“露头就打”常态化监管基础上，聚焦关键农时强化监管、加大涉种案件查处力度。集中开展专项整治，开展品种审定“两个通道”整治及登记品种“仿种子”清理、开展网络售种专项整治。推进打基础管长远工作，强化法规制度建设、继续开展种子生产经营许可核查、加强种子检验机构管理。激励创新、保护创新的良好市场环境不断优化。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"生物育种产业化继续推进","MAINPOINT":6,"MAINPOINT_CONTENT":"2025年中央一号文件提出，继续推进生物育种产业化。我国转基因玉米的产业化试点自2021年开始，2023年顺利完成。2024年进入为期3年的转基因产业化示范阶段。2025年我国转基因、基因编辑等生","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"发展新质生产力，为种业创新注入新动力","MAINPOINT":7,"MAINPOINT_CONTENT":"2025年，人工智能大模型陆续亮相，在深刻改变人类工作、生活的同时，也在重塑种业生态，AI育种、智慧育种已逐步迈入现实。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"种业企业继续发展壮大","MAINPOINT":8,"MAINPOINT_CONTENT":"2025年，我国种业企业继续发展壮大，梯度培育体系基本构建。金融资本持续布局种业，行业头部企业掀起增资潮，多家种业相关企业冲刺上市。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"库存高企","MAINPOINT":9,"MAINPOINT_CONTENT":"2025年，玉米杂交种的供需比达175%，市场严重供过于求，行业整体承压。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"品种是种业的核心竞争力","MAINPOINT":10,"MAINPOINT_CONTENT":"品种是种业的核心竞争力。公司坚持自主研发的同时，继续加大对外合作力度，选育、储备适合不同区域的优势品种。目前与中国农业大学、北京市农林科学院等国内科研院所都有长期的品种合作；与拜耳（孟山都）等国际企业也建立了合作渠道，部分品种已投放到市场，且后续品种在试验筛选中。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"质量是企业参与竞争的基石","MAINPOINT":11,"MAINPOINT_CONTENT":"质量是企业参与竞争的基石。公司始终严把质量关，在纯度、发芽率、净度、水分四项指标检测的基础上，提升种子活力、健康度等项目检测能力；持续完善杂交种、原种生产质量控制作业指导书，从亲本加工与检测、隔离区划定、播种规范性调查、去杂去雄检查、烘干、晾晒全过程监管、粗脱籽粒大密度检测、成品加工全过程监管等关键环节管控，以检促管，提高生产人员及农户质量意识，从源头上保证种子质量。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"服务是企业重要的核心竞争力之一","MAINPOINT":12,"MAINPOINT_CONTENT":"服务是企业重要的核心竞争力之一。报告期内，公司坚持在渠道及产品上积极探索创新，围绕“为种植户服务”的理念，以为种植户服务为核心，联动经销商、零售商开展一系列培训及促销活动，再通过抖音、快手短视频等自媒体平台，按玉米各生育期应注意的问题进行阶段性推送与宣传，加强配套技术与服务支持，赢得良好口碑，做好“技术+销售”型营销。同时通过与其他农化企业合作，进一步规范并优化种植结构，降低品种风险，提高灾害应对能力，实现了由价格销售向价值营销的转变。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"600371.SH","SECURITY_CODE":"600371","SECURITY_NAME_ABBR":"万向德农","KEYWORD":"实际控制人设立慈善信托","MAINPOINT":13,"MAINPOINT_CONTENT":"2018年6月29日公告,公司实控人鲁伟鼎基于慈善目的设立鲁冠球三农扶志基金,并将其持有的万向三农6亿元出资额对应的全部股权无偿授予鲁冠球三农扶志基金,导致鲁冠球三农扶志基金通过万向三农间接控制上市公司48.76%股权。本次收购不会导致本公司控股股东、实际控制人发生变化,公司控股股东仍为万向三农,实际控制人仍为鲁伟鼎,间接控股股东将变为鲁冠球三农扶志基金。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}