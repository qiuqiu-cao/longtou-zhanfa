{"version":"a7784346c7c5c3d05e7bf01dc6193fa7","result":{"pages":1,"data":[{"SECUCODE":"600882.SH","SECURITY_CODE":"600882","SECURITY_NAME_ABBR":"妙可蓝多","BOARD_CODE":"965","BOARD_NAME":"社区团购","SELECTED_BOARD_REASON":"2022年年报显示公司积极开展社区团购等相关业务,公司奶酪产品通过社区团购进入千家万户,备受消费者欢迎。社区团购推动了奶酪的品类教育,进一步扩大了消费者对奶酪的认知,助力公司品牌建设与传播。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0965","DERIVE_BOARD_CODE":"BI0965","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600882.SH","SECURITY_CODE":"600882","SECURITY_NAME_ABBR":"妙可蓝多","BOARD_CODE":"892","BOARD_NAME":"乳业","SELECTED_BOARD_REASON":"2026年6月26日回复称，公司主营业务为以奶酪为核心的特色乳制品的研发、生产和销售。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0892","DERIVE_BOARD_CODE":"BI0892","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600882.SH","SECURITY_CODE":"600882","SECURITY_NAME_ABBR":"妙可蓝多","BOARD_CODE":"825","BOARD_NAME":"新零售","SELECTED_BOARD_REASON":"2022年年报显示公司零售渠道线上线下全域协同,餐饮渠道提供专业产品与服务。报告期内,针对零售渠道,公司坚持“低温做精、常温做广”、电商/新零售持续创新的策略;渠道深度方面,不断增加陈列面积、丰富终端产品矩阵,持续精耕现代渠道,渠道广度方面,在广泛覆盖大润发、永辉、沃尔玛等全国连锁和区域连锁终端的基础上,强化流通、特渠、烘焙等多渠道开发,拓展新赛道,重构“人、货、场”,不断开拓渠道边界。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0825","DERIVE_BOARD_CODE":"BI0825","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600882.SH","SECURITY_CODE":"600882","SECURITY_NAME_ABBR":"妙可蓝多","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600882.SH","SECURITY_CODE":"600882","SECURITY_NAME_ABBR":"妙可蓝多","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600882.SH","SECURITY_CODE":"600882","SECURITY_NAME_ABBR":"妙可蓝多","BOARD_CODE":"664","BOARD_NAME":"婴童概念","SELECTED_BOARD_REASON":"2020年年报显示公司生