{"version":"99f164fa5497e40921916f1fb22375d4","result":{"pages":1,"data":[{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"989","BOARD_NAME":"储能概念","SELECTED_BOARD_REASON":"2020年年报显示公司经发改委批复成立先进储能材料国家工程研究中心,是国内先进储能技术及关键储能材料领域唯一的国家级工程研究中心,研究中心在催化剂制备、膜电极水管理、膜电极浆料分散和稀释工艺上获得多项创新。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0989","DERIVE_BOARD_CODE":"BI0989","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"968","BOARD_NAME":"固态电池","SELECTED_BOARD_REASON":"2025年12月23日回复称，公司与联合体成员单位中固时代双方优势互补，将干法电极技术与其结构创新和系统创新技术结合，加快干法电极技术在固态和半固态电池领域的应用，共同开展固态电池技术开发。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0968","DERIVE_BOARD_CODE":"BI0968","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"966","BOARD_NAME":"碳交易","SELECTED_BOARD_REASON":"2021年3月19日回复称子公司科力远混合动力技术有限公司经营范围包含主营节能技术、碳排放权交易、核证减排量交易、温室气体自愿减排量交易、碳汇交易等内容。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0966","DERIVE_BOARD_CODE":"BI0966","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"900","BOARD_NAME":"新能源车","SELECTED_BOARD_REASON":"科力远希望抓住混合动力汽车高增长的市场机遇。日前,科力远和吉利汽车联手,推手国内首款自主深度油电混合动力汽车吉利MR7184HEV混合动力汽车,该车搭载了CHS混合动力系统,百公里油耗4.9L(NEDC工况),整车排放达到国V标准。随着首辆深度油电混合动力汽车的量产,CHS公司已经从技术研发到批量生产再到终端市场形成一套完善的产业链条布局。目前长安汽车、海马、江淮、东风等十余家车企已有意和CHS公司进行混合动力汽车合作。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0900","DERIVE_BOARD_CODE":"BI0900","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"864","BOARD_NAME":"氢能源","SELECTED_BOARD_REASON":"2025年1月2日回复称，公司子公司常德力元深耕泡沫金属材料设计、制造、推广应用20多年，在三维泡沫金属材料方面储备了多项核心技术，积累了丰富的应用经验。目前正在开发与推广泡沫合金材料，应用于电解水制氢电极、SOFC燃料电池导电层，致力于以关键核心材料促进电解槽行业进行技术升级，打破SOFC关键材料对中国的封锁。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0864","DERIVE_BOARD_CODE":"BI0864","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"574","BOARD_NAME":"锂电池概念","SELECTED_BOARD_REASON":"2020年半年报显示公司民用电池产品系列包括锂电池(电动车、充电宝等),镍氢电池(玩具、工具等)。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0574","DERIVE_BOARD_CODE":"BI0574","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"523","BOARD_NAME":"新材料","SELECTED_BOARD_REASON":"2019年年报显示子公司常德力元新材料有限责任公司经营范围包括有色金属冶炼及压延加工;钢压延加工;电池制造、加工与销售;新材料技术推广及技术咨询服务;进出口业务。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0523","DERIVE_BOARD_CODE":"BI0523","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"493","BOARD_NAME":"新能源","SELECTED_BOARD_REASON":"公司是中国唯一一家能为镍氢动力电池提供配套原材料的企业。混合动力汽车(HEV)被认为是今后10年最实用、最具有前景的环保节能车型,预计到2020年全球HEV将达到2500万辆,而研究及使用结果表明在HEV所用动力电池中,镍氢动力电池综合性能最佳,每辆HEV的泡沫镍用量在8至10平方米,公司将面临历史性的发展契机。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0493","DERIVE_BOARD_CODE":"BI0493","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1648","BOARD_NAME":"电池技术","SELECTED_BOARD_REASON":"2025年12月23日回复称，公司与联合体成员单位中固时代双方优势互补，将干法电极技术与其结构创新和系统创新技术结合，加快干法电极技术在固态和半固态电池领域的应用，共同开展固态电池技术开发。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1648","DERIVE_BOARD_CODE":"BI1648","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1633","DERIVE_BOARD_CODE":"BI1633","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":6,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1630","DERIVE_BOARD_CODE":"BI1630","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"158","BOARD_NAME":"湖南板块","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":4,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0158","DERIVE_BOARD_CODE":"BI0158","BOARD_TYPE":"板块","BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1303","BOARD_NAME":"锂电池","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":3,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1303","DERIVE_BOARD_CODE":"BI1303","BOARD_TYPE":"行业","BOARD_LEVEL":"3"},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1200","BOARD_NAME":"电力设备","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":1,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1200","DERIVE_BOARD_CODE":"BI1200","BOARD_TYPE":"行业","BOARD_LEVEL":"1"},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1173","BOARD_NAME":"锂矿概念","SELECTED_BOARD_REASON":"2025年11月25日回复称，公司是集锂矿资源、电池材料、先进电池及管理系统、储能系统、电池回收等产品和服务于一体的新能源整体解决方案供应商。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1173","DERIVE_BOARD_CODE":"BI1173","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1052","BOARD_NAME":"动力电池回收","SELECTED_BOARD_REASON":"2021年11月17日回复称在锂电回收领域,公司子公司金科公司已通过合资参股的方式,开展锂电池的回收、拆解、处理、资源综合利用等方面的研发、生产、销售,预计今年内完成生产线建设;在镍氢电池回收领域,公司旗下国家工程研究中心,正积极推动电池回收项目,中试线已建成,通过验证,镍钴锰的回收率可达到98%以上。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1052","DERIVE_BOARD_CODE":"BI1052","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":7,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1050","DERIVE_BOARD_CODE":"BI1050","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600478.SH","SECURITY_CODE":"600478","SECURITY_NAME_ABBR":"科力远","BOARD_CODE":"1033","BOARD_NAME":"电池","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1033","DERIVE_BOARD_CODE":"BI1033","BOARD_TYPE":"行业","BOARD_LEVEL":"2"}],"count":21},"success":true,"message":"ok","code":0}