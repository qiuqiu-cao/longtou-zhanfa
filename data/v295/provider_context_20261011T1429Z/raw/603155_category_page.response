{"ssbk":[{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1206","BOARD_NAME":"基础化工","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"538","BOARD_NAME":"化学制品","IS_PRECISE":"0","BOARD_RANK":2},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1431","BOARD_NAME":"有机硅","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"159","BOARD_NAME":"江苏板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":5},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","IS_PRECISE":"0","BOARD_RANK":6},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"707","BOARD_NAME":"沪股通","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1753","BOARD_NAME":"光刻胶","IS_PRECISE":"1","BOARD_RANK":10},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"961","BOARD_NAME":"有机硅概念","IS_PRECISE":"1","BOARD_RANK":11},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"917","BOARD_NAME":"半导体概念","IS_PRECISE":"1","BOARD_RANK":12},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"889","BOARD_NAME":"医美概念","IS_PRECISE":"1","BOARD_RANK":13},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"683","BOARD_NAME":"央国企改革","IS_PRECISE":"1","BOARD_RANK":14},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"580","BOARD_NAME":"LED概念","IS_PRECISE":"1","BOARD_RANK":15},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"574","BOARD_NAME":"锂电池概念","IS_PRECISE":"1","BOARD_RANK":16},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"523","BOARD_NAME":"新材料","IS_PRECISE":"1","BOARD_RANK":17}],"hxtc":[{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"许可项目:危险化学品生产;危险化学品经营;货物进出口;技术进出口;进出口代理(依法须经批准的项目,经相关部门批准后方可开展经营活动,具体经营项目以审批结果为准)。一般项目:化工产品生产(不含许可类化工产品);化工产品销售(不含许可类化工产品);专用化学产品制造(不含危险化学品);专用化学产品销售(不含危险化学品);电子专用材料研发;电子专用材料制造;电子专用材料销售;新材料技术研发;合成材料制造(不含危险化学品);新型有机活性材料销售;表面功能材料销售;新型催化材料及助剂销售;高纯元素及化合物销售;生物化工产品技术研发;日用化学产品制造、日用化学产品销售;国内贸易代理;知识产权服务;技术服务、技术开发、技术咨询、技术交流、技术转让、技术推广(除依法须经批准的项目外,凭营业执照依法自主开展经营活动)","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"有机硅功能性助剂","MAINPOINT":3,"MAINPOINT_CONTENT":"产品主要包括甲基系列的六甲基二硅氮烷（含电子级）、硅醚（含电子级）等，以及乙烯基系列的乙烯基双封头、乙烯基硅氮烷、乙烯基氯硅烷等。有机硅功能性助剂产品用途广泛，其中六甲基二硅氮烷作为硅橡胶、硅油等有机硅下游产品生产过程中不可或缺的关键改性材料，能够显著提升有机硅材料的疏水、补强、延展等性能；作为基团保护剂用于部分抗生素、肝炎、肿瘤、艾滋病、心脑血管疾病等治疗药物的合成；作为粘接助剂、清洗剂、抗蚀剂等用于半导体工业；作为稳定剂用于锂电池电解液，改善锂离子电池的电化学性能和循环性能。乙烯基双封头主要作为封头剂用于生产高温硫化硅橡胶、加成型硅橡胶、硅凝胶和乙烯基硅油等系列产品。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"苯基硅烷系列产品","MAINPOINT":4,"MAINPOINT_CONTENT":"产品主要包括苯基三氯硅烷和二苯基二氯硅烷等有机硅新型特种单体；苯基三甲氧基硅烷、苯基三乙氧基硅烷、二苯基二甲氧基硅烷、二苯基二乙氧基硅烷、八苯基环四硅氧烷、二苯基二羟基硅烷等苯基中间体；苯基硅橡胶、苯基硅树脂、苯基硅油等下游产品。苯基硅烷系列产品是提高下游产品特种性能的关键原料。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"有机硅行业","MAINPOINT":5,"MAINPOINT_CONTENT":"有机硅以其独特的分子结构兼具无机材料与有机材料的双重性能，在耐高低温、电气绝缘、耐候性、生理惰性等方面表现优异，被广泛应用于建筑装饰、电子电器、电力新能源、纺织制造、医疗护理、汽车交通等领域。随着有机硅材料在下游应用的持续渗透，终端用户对其功能特性提出了更高要求。有机硅功能性助剂作为下游硅橡胶、硅油、硅树脂等产品合成过程中不可或缺的关键改性材料，虽用量较小，但能够显著改善材料的加工性能、力学性能、光学性能及老化性能，对终端产品的品质起着决定性作用。全球有机硅行业发展呈现上游单体集中生产、下游产品分散深加工的特点，以下游产品开发为中心带动上游单体合成。2025年是有机硅行业深度调整的一年，经历前期产能快速扩张后，行业开启“反内卷”自律调控，从“规模扩张”向“高质量发展”转型。行业产能集中度持续提升。有机硅需求端延续“传统领域收缩、新兴领域增长”的格局，新能源汽车、AI算力液冷等新兴领域成为2025年需求增量主力。若行业协同减产得到有效执行，有机硅行业因扩产周期造成的供需错配在有望得到扭转。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"工艺与质量优势","MAINPOINT":6,"MAINPOINT_CONTENT":"公司高度重视技术工艺的创新与先进性，自主研发的六甲基二硅氮烷无溶剂法专利技术，使产品具有高纯低杂的品质优势。公司自主研发乙烯基新型特种单体专利技术，完成乙烯基产品循环产业链的技术突破和规模化工业生产。公司在国内率先实现直接法生产苯基氯硅烷，建有目前国内唯一同时产出苯基三氯硅烷与二苯基二氯硅烷的直接法生产线。公司积极发挥自身工艺与质量技术优势，通过了ISO9001：2015质量管理体系及QC080000:2017有害物质管理体系认证，作为主要起草单位参与16项行业、团体标准的编写。六甲基二硅氮烷、乙烯基双封头、苯基氯硅烷等核心产品在细分领域中质量优势突出，处于行业领先水平，市场占有率、出口量国内领先，得到众多国际有机硅巨头、半导体企业和制药企业的认证和认可。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"多产品综合服务优势","MAINPOINT":7,"MAINPOINT_CONTENT":"公司的主要产品多为下游产品性能提升的关键原料，基于下游产品生产工艺的特点，公司产品与下游客户产品的适配性尤为重要。很多客户需要同时使用多种性能提升原料，多品种综合服务也具有广泛市场需求。为拓展市场服务空间，公司组建了由生产、市场和研发技术人员组成的客户服务团队，建立快速响应机制，结合客户个性化产品需求，做有针对性的独立或联合产品研发和产品定制，为客户提供满足个性需求的多品种产品组合服务方案，一站式满足客户个性化的品质需求和多品类的采购需求。公司已为全球多家大型有机硅企业提供多产品综合服务方案，拓展了公司与客户之间合作的广度和深度，形成了长期稳定的客户合作关系。新亚强上海投入运行，更加充分的发挥公司市场开拓和客户服务的优势，进一步增强公司的综合服务能力。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"研发创新优势","MAINPOINT":8,"MAINPOINT_CONTENT":"公司建有江苏省研究生工作站、江苏省企业技术中心、江苏省苯基单体工程技术研究中心、江苏省有机硅化合物及材料工程研究中心，与杭州师范大学、武汉大学建立了长期的产学研合作关系，搭建了多层次研发创新平台，为技术攻关和成果转化提供坚实支撑。上海研发中心运行以来，进一步整合了长三角人才、技术资源，聚焦高端领域，提升了公司研发创新与技术迭代能力。经过多年发展，公司在产品升级和新产品研发等方面积累了丰富经验与核心技术，累计取得专利82项，拥有高新技术产品4项，省级新产品认定11项。六甲基二硅氮烷产品被中华人民共和国工业和信息化部、中国工业经济联合会认定为制造业单项冠军产品。电子级六甲基二硅氮烷、电子级二甲基二甲氧基硅烷、电子级正硅酸乙酯、电子级四甲基二硅氧烷等多个高端湿电子化学品实现技术突破与规模化应用，切入高端下游领域、打破部分进口垄断，为业绩增长注入新动能。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"产业链拓展延伸及循环经济优势","MAINPOINT":9,"MAINPOINT_CONTENT":"公司持续向有机硅产业链上下游延伸拓展产品线，不断丰富甲基、乙烯基和苯基三大产品线产品品类。公司甲基产品线向电子级高端应用领域积极拓展，乙烯基和苯基产品线实现向上下游延伸，力求实现各个环节的中间产品，既可继续向下生产，又可实现市场销售的产出结构，有利于公司根据市场和自身生产需要灵活调整，满足市场需求、平衡市场风险。与此同时，公司不断加强副产物的综合利用，拓展有机硅副产物综合利用和无害化处置，有效提高资源利用效率，建设绿色工艺和清洁生产的循环经济，积极践行“双碳”发展理念，创造良好的社会效益、经济效益和环保效益，提高公司盈利能力和市场竞争力。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"市场品牌优势","MAINPOINT":10,"MAINPOINT_CONTENT":"新亚强品牌创立三十多年来，依托多年来在质量、技术、信誉、服务等方面优势，得到了市场的广泛认可和选择，形成了稳固的市场地位和全球品牌效应。公司商标通过马德里商标注册，完成了在美国、日本、印度、韩国以及欧盟等国家和地区的商标注册，并通过欧盟REACH注册、清真HALAL认证、英国DUIN认证、韩国K-REACH注册，为产品全球流通奠定了坚实基础。公司先后获得中国质量诚信企业、中国十大有机硅下游上市公司、中国氟硅行业十大品牌等荣誉称号，品牌影响力持续提升。多年来，通过为全球不同地区不同需求的行业客户提供满足个性化需求的高品质产品，为客户提供售前、售中、售后全方位服务，公司品牌获得了较为广泛的客户认可，拥有大量长期稳定、多品种合作的优质客户群体，客户粘性持续增强。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"自愿锁定股份","MAINPOINT":11,"MAINPOINT_CONTENT":"自公司股票上市之日起三十六个月内,不转让或者委托他人管理本次发行前本人直接及间接持有的公司股份,也不由公司回购本人直接及间接持有的该部分股份。","KEY_CLASSIF":"自愿锁定","KEY_CLASSIF_CODE":"008005","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"股利分配","MAINPOINT":12,"MAINPOINT_CONTENT":"在满足现金分红条件的基础上,结合公司持续经营和长期发展,公司每年以现金方式分配的利润不少于当年实现的可分配利润的10%,且最近3年以现金方式累计分配的利润不少于最近3年实现的年均可分配利润的30%。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","KEYWORD":"稳定股价措施","MAINPOINT":13,"MAINPOINT_CONTENT":"公司首次公开发行股票并上市后三年内,如公司股票收盘价格连续20个交易日低于最近一期经审计的每股净资产,公司将通过控股股东增持股份、公司全体董事(独立董事除外)和高级管理人员增持公司股票以及公司回购股份等措施来稳定股价。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}