{"ssbk":[{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"1213","BOARD_NAME":"商贸零售","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"482","BOARD_NAME":"一般零售","IS_PRECISE":"0","BOARD_RANK":2},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"1552","BOARD_NAME":"超市","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"160","BOARD_NAME":"江西板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":5},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","IS_PRECISE":"0","BOARD_RANK":6},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"1001","BOARD_NAME":"内贸流通","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"707","BOARD_NAME":"沪股通","IS_PRECISE":"0","BOARD_RANK":10},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"825","BOARD_NAME":"新零售","IS_PRECISE":"1","BOARD_RANK":11},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","BOARD_CODE":"665","BOARD_NAME":"电商概念","IS_PRECISE":"1","BOARD_RANK":12}],"hxtc":[{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"商业经营;商业投资管理;经营场地出租;停车场管理。(依法须经批准的项目,经相关部门批准后方可开展经营活动。)","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"连锁超市、百货商场","MAINPOINT":3,"MAINPOINT_CONTENT":"公司自设立以来主要从事连锁超市、百货商场的运营业务。公司立足于江西省内，多年来通过深耕本地市场、持续推进门店升级转型，成为以生鲜、食品为核心品类的零售企业。截至本报告期末，公司拥有门店40家，是江西省商贸流通行业首家上市企业，江西本土领先的连锁经营企业。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"连锁零售行业","MAINPOINT":4,"MAINPOINT_CONTENT":"2025年我国持续发力扩大内需，随着提振消费专项行动落地见效，消费市场规模稳步扩大、结构持续优化，新的消费热点不断涌现。在提振消费各项政策措施共同作用下，消费市场稳定增长，供给体系日益完善，消费结构优化升级。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"区域密集布局，培育区域市场竞争力和品牌美誉度","MAINPOINT":5,"MAINPOINT_CONTENT":"公司深耕本地市场，在吉安市、赣州市、宜春市布局了40家门店，现有门店位于所在区域的核心地段，门店区位辐射范围广、周边消费人群多、占据城市交通有利位置等优势，形成了本地化竞争壁垒。公司诚信经营20多年，获得一大批稳固的客户群体，随着公司持续深化“好品质、好价格、好生活”经营理念，门店不断提升服务质量，形成了国光品牌美誉度。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"高比例自有物业优势","MAINPOINT":6,"MAINPOINT_CONTENT":"截至报告期末，公司及子公司拥有43.13万平方米商业门店物业（已开门店），其中自有商业门店物业占商业门店经营总面积的46%。高比例的自有物业，不仅能够确保经营稳定，还能抵御租金上涨风险，从而具备一定的成本优势。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"本地化供应链优势","MAINPOINT":7,"MAINPOINT_CONTENT":"作为江西本土领先的零售连锁企业，公司在江西本地建立了丰富的采购渠道，树立了良好的口碑，与供应商建立了稳定、灵活的合作关系，具有较强的议价能力，采购“破价”转型后商品采购简单、高效、阳光。同时，公司拥有吉安、赣州配送中心，立体辐射所在门店区域，物流配送高效、响应迅速。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"稳定的梯队人才培养","MAINPOINT":8,"MAINPOINT_CONTENT":"公司注重人才选拔和梯队建设，建立了人才培养体系，设立了绩效评谈、股权激励考核和末位淘汰等机制，挖掘和培养了一批“业绩担当”和“责任担当”型人才，推动员工个人成长与企业发展同频共振。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"自愿锁定股份","MAINPOINT":9,"MAINPOINT_CONTENT":"自公司股票上市之日起三十六个月内,不转让或者委托他人管理本次发行前本人直接及间接持有的公司股份,也不由公司回购本人直接及间接持有的该部分股份。","KEY_CLASSIF":"自愿锁定","KEY_CLASSIF_CODE":"008005","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"股利分配","MAINPOINT":10,"MAINPOINT_CONTENT":"在满足现金分红条件的基础上,结合公司持续经营和长期发展,公司每年以现金方式分配的利润不少于当年实现的可分配利润的10%,且最近3年以现金方式累计分配的利润不少于最近3年实现的年均可分配利润的30%。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"},{"SECUCODE":"605188.SH","SECURITY_CODE":"605188","SECURITY_NAME_ABBR":"国光连锁","KEYWORD":"稳定股价措施","MAINPOINT":11,"MAINPOINT_CONTENT":"公司首次公开发行股票并上市后三年内,如公司股票收盘价格连续20个交易日低于最近一期经审计的每股净资产,公司将通过控股股东增持股份、公司全体董事(独立董事除外)和高级管理人员增持公司股票以及公司回购股份等措施来稳定股价。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}