{"version":"94922e5eafefed12d78d49e753c9a751","result":{"pages":1,"data":[{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"953","BOARD_NAME":"鸿蒙概念","SELECTED_BOARD_REASON":"2021年6月22日回复称,公司已基于鸿蒙系统单独开发了大智慧鸿蒙版APP。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0953","DERIVE_BOARD_CODE":"BI0953","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"940","BOARD_NAME":"网红经济","SELECTED_BOARD_REASON":"2017年年报,\"视吧\"直播平台聚焦到财经领域,已入驻财经老师百余人,既发挥大智慧财经平台的平台属性,又反哺服务于财经用户、为平台提供内容。业务垂直下沉也大大减少了开发、运维及推广等投入成本。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0940","DERIVE_BOARD_CODE":"BI0940","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"922","BOARD_NAME":"数据中心","SELECTED_BOARD_REASON":"2025年半年报显示，全资子公司财汇科技致力于建立中国及海内外最专业、最精准、最全面的金融数据中心，向银行、保险公司、基金公司、证券公司、信托公司等金融机构及高等院校提供金融数据以及数据管理、数据监控、数据挖掘等服务。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0922","DERIVE_BOARD_CODE":"BI0922","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"867","BOARD_NAME":"富时罗素","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0867","DERIVE_BOARD_CODE":"BI0867","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"854","BOARD_NAME":"华为概念","SELECTED_BOARD_REASON":"2023年8月5日,互联网金融信息服务提供商大智慧与华为举办鸿蒙生态合作签约仪式,宣布在技术创新、产业应用、商业合作等领域开展全方位、深层次合作。此次双方签署深化合作协议,旨在共同推进鸿蒙生态快速发展。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0854","DERIVE_BOARD_CODE":"BI0854","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"823","BOARD_NAME":"养老金","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0823","DERIVE_BOARD_CODE":"BI0823","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"800","BOARD_NAME":"人工智能","SELECTED_BOARD_REASON":"2023年8月31日,大智慧在上海举行大智慧VIP产品发布会。据介绍,大智慧VIP汲取了金融科技领域的最新技术,在内容的专业性、服务的智能化、信息的及时性等各方面都达到了更高水准。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0800","DERIVE_BOARD_CODE":"BI0800","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"737","BOARD_NAME":"软件开发","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0737","DERIVE_BOARD_CODE":"BI0737","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"696","BOARD_NAME":"国产软件","SELECTED_BOARD_REASON":"公司移动APP是业内领先的一站式证券信息服务平台,全方位覆盖全球金融市场信息,包括A股、港股、美股、基金、期货、外汇、债券等行情和数据。还为广大投资者提供了大智慧365、大智慧专业版、大智慧财富版、大智慧策略投资终端、大智慧港股通专业版等多款PC版软件、向投资者提供及时、专业的金融数据和数据分析服务。","IS_PRECISE":"1","BOARD_RANK":21,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0696","DERIVE_BOARD_CODE":"BI0696","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"689","BOARD_NAME":"阿里概念","SELECTED_BOARD_REASON":"2015年7月1日,知名的金融信息服务商大智慧宣布,搭建在阿里金融云上的信息云系统部署完成。","IS_PRECISE":"1","BOARD_RANK":22,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0689","DERIVE_BOARD_CODE":"BI0689","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"637","BOARD_NAME":"互联网金融","SELECTED_BOARD_REASON":"公司率先向互联网金融内容服务平台进行转型,积极打造以用户需求为导向,以财富管理为中心,集资讯,服务,交易为一体的一站式互联网金融服务平台。“大智慧 券商”联合开户及服务平台已于2015年7月初上线,除提供开户联合服务外,券商的投资顾问,产品路演等入驻,联合为用户提供更加高效,便捷的移动服务。另外,“大智慧金融旗舰店”也于2015年7月底开始试运行,已有多家银行,基金,保险等金融巨头及私募入驻,进行系列联合服务。2016年,公司将持续推进“平台化”业务模式,打造to B与to C两个生态系统,同时在C端打造连接金融机构与互联网企业的生态系统。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0637","DERIVE_BOARD_CODE":"BI0637","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"634","BOARD_NAME":"大数据","SELECTED_BOARD_REASON":"公司的主要业务聚焦在互联网金融信息服务平台、大数据及数据工程服务和海外业务三大板块。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0634","DERIVE_BOARD_CODE":"BI0634","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"596","BOARD_NAME":"融资融券","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0596","DERIVE_BOARD_CODE":"BI0596","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"594","BOARD_NAME":"长江三角","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":25,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0594","DERIVE_BOARD_CODE":"BI0594","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_CODE":"1722","BOARD_NAME":"高市净率","SELECTED_BOARD_REASON":null,"IS_PRECISE":null,"BOARD_RANK":5,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1722","DERIVE_BOARD_CODE":"BI1722","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"601519.SH","SECURITY_CODE":"601519","SECURITY_NAME_ABBR":"大智慧","BOARD_COD