{"version":"9fc47a101382cc69d3380ae6fb91c26c","result":{"pages":1,"data":[{"SECUCODE":"600127.SH","SECURITY_CODE":"600127","SECURITY_NAME_ABBR":"金健米业","BOARD_CODE":"892","BOARD_NAME":"乳业","SELECTED_BOARD_REASON":"2025年6月3日回复称，金健乳业以巴氏鲜牛奶、酸奶等低温奶产品为核心，打造了“鲜系列、嚼系列”特色乳制品产品体系，同时布局纯牛奶、含乳饮料等常温奶产品，构建了学校、社区、酒餐、商超和通路相结合的销售网络体系。","IS_PRECISE":"1","BOARD_RANK":18,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0892","DERIVE_BOARD_CODE":"BI0892","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600127.SH","SECURITY_CODE":"600127","SECURITY_NAME_ABBR":"金健米业","BOARD_CODE":"834","BOARD_NAME":"乡村振兴","SELECTED_BOARD_REASON":"2025年4月21日回复称，作为中国消费名品方阵首批获评企业，同时也是湖南省首批消费品工业“三品”标杆企业，公司将坚持贯彻落实“国家粮食安全战略”“乡村振兴战略”，继续构建更加完善的“从田园到餐桌”的全产业链发展模式，以科技引领推动多元化技术创新和高端化产业升级，坚定走好“规模化、标准化、市场化、品牌化、生态化”道路；通过线上线下深度融合，聚焦核心战略单品打造，持续讲好品牌故事，为消费者创造更加美好的生活体验。","IS_PRECISE":"1","BOARD_RANK":19,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0834","DERIVE_BOARD_CODE":"BI0834","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600127.SH","SECURITY_CODE":"600127","SECURITY_NAME_ABBR":"金健米业","BOARD_CODE":"825","BOARD_NAME":"新零售","SELECTED_BOARD_REASON":"2019年4月,公司将旗下乐米乐公司确立为与兴盛优选新零售业务对接的平台,积极跟进兴盛优选新零售业务,乐米乐公司的销售业绩得到了大的突破,发展势头向好。二是探索渠道多元化发展。","IS_PRECISE":"1","BOARD_RANK":20,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0825","DERIVE_BOARD_CODE":"BI0825","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600127.SH","SECURITY_CODE":"600127","SECURITY_NAME_ABBR":"金健米业","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600127.SH","SECURITY_CODE":"600127","SECURITY_NAME_ABBR":"金健米业","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"600127.SH","SECURITY_CODE":"600127","SECURITY_NAME_ABBR":"金健米业","BOARD_CO