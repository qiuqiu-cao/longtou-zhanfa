{"version":"8c33be95dc2cd194aa60e657ba785b70","result":{"pages":1,"data":[{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"961","BOARD_NAME":"有机硅概念","SELECTED_BOARD_REASON":"2020年8月19日招股书显示公司是一家专业从事有机硅精细化学品研发、生产及销售的高新技术企业,主要产品包括以六甲基二硅氮烷为核心的有机硅功能性助剂和苯基氯硅烷两大产品类别。","IS_PRECISE":"1","BOARD_RANK":11,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0961","DERIVE_BOARD_CODE":"BI0961","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"917","BOARD_NAME":"半导体概念","SELECTED_BOARD_REASON":"2020年8月11日招股书显示公司生产的六甲基二硅氮烷作为粘接助剂、清洗剂、抗蚀剂等用于半导体工业。","IS_PRECISE":"1","BOARD_RANK":12,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0917","DERIVE_BOARD_CODE":"BI0917","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"889","BOARD_NAME":"医美概念","SELECTED_BOARD_REASON":"公司生产的高纯六甲基二硅氧烷是疤痕修复与皮肤护理的主要原料，可在皮肤表面形成一层透气性薄膜，减少水分流失，保持疤痕区域的湿润环境，从而缓解干燥和刺激，促进皮肤自我修复。常用于疤痕凝胶或贴片中，帮助改善疤痕的质地和颜色，尤其是术后或创伤后的增生性疤痕。","IS_PRECISE":"1","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0889","DERIVE_BOARD_CODE":"BI0889","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":8,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0815","DERIVE_BOARD_CODE":"BI0815","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"707","BOARD_NAME":"沪股通","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":9,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0707","DERIVE_BOARD_CODE":"BI0707","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"683","BOARD_NAME":"央国企改革","SELECTED_BOARD_REASON":"实际控制人是邯郸市人民政府国有资产监督管理委员会。","IS_PRECISE":"1","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0683","DERIVE_BOARD_CODE":"BI0683","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"580","BOARD_NAME":"LED概念","SELECTED_BOARD_REASON":"2025年年度报告显示，苯基硅树脂在大功率LED封装、MiniLED背光与显示、车用LED及高端照明等领域需求持续增加，Mini/MicroLED技术的普及对其折射率与耐久性提出了更高要求，进一步推动了高折射率苯基硅树脂的市场需求。","IS_PRECISE":"1","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0580","DERIVE_BOARD_CODE":"BI0580","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"574","BOARD_NAME":"锂电池概念","SELECTED_BOARD_REASON":"公司生产的六甲基二硅氮烷产品作为锂电池电解液添加剂，可处理痕量水分，提升电池的循环性能，延长锂电池的使用寿命。也可用于气凝胶的制备，作为电池的密封和防护材料，提升其阻火、抗震性能，保证电池使用安全性。","IS_PRECISE":"1","BOARD_RANK":16,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0574","DERIVE_BOARD_CODE":"BI0574","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"538","BOARD_NAME":"化学制品","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":2,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0538","DERIVE_BOARD_CODE":"BI0538","BOARD_TYPE":"行业","BOARD_LEVEL":"2"},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"523","BOARD_NAME":"新材料","SELECTED_BOARD_REASON":"2020年8月19日招股书显示公司生产的有机硅功能性助剂广泛应用于有机硅新材料、制药、电子化学等领域。","IS_PRECISE":"1","BOARD_RANK":17,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0523","DERIVE_BOARD_CODE":"BI0523","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"1753","BOARD_NAME":"光刻胶","SELECTED_BOARD_REASON":"2025年12月11日回复称，公司核心产品电子级六甲基二硅氮烷是光刻胶工艺中的关键配套材料，已稳定供应于半导体及平板显示领域。此外，公司持续进行相关电子级产品的技术研发与品类拓展，致力于为光刻胶等高端电子材料提供更丰富的特种化学品解决方案。","IS_PRECISE":"1","BOARD_RANK":10,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK1753","DERIVE_BOARD_CODE":"BI1753","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"603155.SH","SECURITY_CODE":"603155","SECURITY_NAME_ABBR":"新亚强","BOARD_CODE":"