{"ssbk":[{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1206","BOARD_NAME":"基础化工","IS_PRECISE":null,"BOARD_RANK":1},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"471","BOARD_NAME":"化学纤维","IS_PRECISE":"0","BOARD_RANK":2},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1416","BOARD_NAME":"粘胶","IS_PRECISE":null,"BOARD_RANK":3},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"148","BOARD_NAME":"吉林板块","IS_PRECISE":"0","BOARD_RANK":4},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1673","BOARD_NAME":"破增发价股","IS_PRECISE":null,"BOARD_RANK":5},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1633","BOARD_NAME":"昨日高振幅","IS_PRECISE":"0","BOARD_RANK":6},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1630","BOARD_NAME":"昨日首板","IS_PRECISE":"0","BOARD_RANK":7},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1050","BOARD_NAME":"昨日涨停_含一字","IS_PRECISE":"0","BOARD_RANK":8},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","IS_PRECISE":"0","BOARD_RANK":9},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"804","BOARD_NAME":"深股通","IS_PRECISE":"0","BOARD_RANK":10},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"596","BOARD_NAME":"融资融券","IS_PRECISE":"0","BOARD_RANK":11},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1185","BOARD_NAME":"冰雪经济","IS_PRECISE":"1","BOARD_RANK":12},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1171","BOARD_NAME":"碳纤维","IS_PRECISE":"1","BOARD_RANK":13},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"1166","BOARD_NAME":"低空经济","IS_PRECISE":"1","BOARD_RANK":14},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"838","BOARD_NAME":"东北振兴","IS_PRECISE":"1","BOARD_RANK":15},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","BOARD_CODE":"683","BOARD_NAME":"央国企改革","IS_PRECISE":"1","BOARD_RANK":16}],"hxtc":[{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"纤维素纤维原料及纤维制造;化工产品销售(不含许可类化工产品);石墨及碳素制品制造;石墨及碳素制品销售;高性能纤维及复合材料制造;高性能纤维及复合材料销售;货物进出口;新材料技术研发;普通机械设备安装服务;通用零部件制造;劳务服务(不含劳务派遣)。","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"粘胶纤维和碳纤维产品","MAINPOINT":3,"MAINPOINT_CONTENT":"报告期内，公司以粘胶纤维和碳纤维产品的生产、销售为主，包括粘胶长丝、粘胶短纤和碳纤维产品。根据《上市公司行业分类指引》(2012年修订)，公司主营业务所属行业为“制造业”(代码C)中的“化学纤维制造业”(代码C28)。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"纤维行业","MAINPOINT":4,"MAINPOINT_CONTENT":"（一）碳纤维:碳纤维被称为材料领域的“黑色黄金”，是一种比重不到钢的1/4，而抗拉强度是钢的7-9倍，同时还具有轻质、高强度、高弹性模量、耐高低温、耐腐蚀、疲劳等优异特性的新型材料，通常与树脂、金属、陶瓷等复合后形成碳纤维复合材料，在各种工业领域中的应用非常广泛，如风电、交通工具、航空航天、压力容器、氢能利用等重点领域都有它的身影。\n（二）粘胶长丝:又叫“人造丝”，是天然真丝的替代品，具有光滑凉爽、透气、抗静电、染色绚丽等特性，在主要纺织纤维中含湿率最符合人体皮肤的生理要求，主要应用于高端服装和家用纺织品。据统计，粘胶长丝全球总产能约为25万-28万吨之间，我国粘胶长丝产能整体平稳，维持在21万-24万吨左右，全球行业内主要厂商有吉林化纤、新乡化纤等。\n（三）粘胶短纤:俗称“人造棉、人棉或粘纤”，与天然棉很像，具有“出于棉而优于棉”的特点，是我国纺织工业的重要原料，其生产原料资源丰富，具有吸湿性好，易于染色，织物穿着舒适的特点。粘胶短纤产品广泛应用于纺织领域，即可纯纺为人棉纱，亦可与棉花、涤纶短纤等混纺，制得混纺纱，终端主要应用于服装、家纺等领域。粘胶短纤全球产能也高度集中，中国产能居世界首位。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"不断加强的粘胶长丝行业领跑地位","MAINPOINT":5,"MAINPOINT_CONTENT":"经过多年的发展，公司主要产品粘胶长丝，凭借突出的技术优势和质量优势，已成长为全球重要的粘胶长丝厂商，行业内竞争优势明显。当前，受到更高的环保要求及行业竞争压力影响，国内粘胶长丝落后产能已经退出，后来者也难以进入，公司有充足实力站稳地位，并深度优化产品性能，精准提高高端产品的差别化率，不断提升收入规模和利润规模，填补市场需求空白并进一步扩大竞争优势，实现行业领跑。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"迈入碳纤维产业链的独特优势","MAINPOINT":6,"MAINPOINT_CONTENT":"在国内碳纤维产业化与规模化的发展道路上，吉林市的碳纤维研发和生产起步较早，是国家科技部认定的唯一碳纤维产业化基地。为加快实现发展战略目标，公司作为吉林国资旗下的上市平台，在坚持“夯实主业，加快升级转型”的原则基础上，充分借力吉林本地碳纤维产业链优势，并结合自身在化学纤维行业的影响力，积极向碳纤维复合材料产业布局。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"持续提升的经营管理能力","MAINPOINT":7,"MAINPOINT_CONTENT":"作为大型化学纤维生产企业，规模化稳定运行、不断降低成本提高效率是公司不断积累竞争能力的重要基因特质，而公司的管理层也与公司特质高度匹配。公司目前核心管理团队稳定，主要成员均从公司基层培养并逐步委以重任，是公司从经营低谷到走上崛起之路的亲历者，对于公司低成本、大规模、高效率生产的经营管理传统具有深厚的理解与认同，是公司持续健康经营的强力保障。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"地方平台支撑并助力产业发展","MAINPOINT":8,"MAINPOINT_CONTENT":"作为地方国有控股的龙头企业，公司承担了国企改革与引领地方产业经济发展的重要职责，受到国家、吉林省、吉林各级领导的高度重视与关注，充分肯定了公司在产品研发和转型升级方面做出的努力和取得的成就，并给予全力支持。公司将继续聚焦主业，加快创新升级，以强大的研发能力做出更多更好的产品，不断提升发展质量，为区域经济发展责献力量。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"长期的技术积淀和成熟的技术工人队伍","MAINPOINT":9,"MAINPOINT_CONTENT":"公司通过将近60年的积淀，拥有一支稳定且实力雄厚的研发团队和成熟技术工人队伍，公司秉持“有中生新、三化升级”要求，形成了数十项专利以及百余项工艺技术创新，为公司生产工艺进一步提升、产品不断升级及成本控制形成强有力且持续的支撑。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"000420.SZ","SECURITY_CODE":"000420","SECURITY_NAME_ABBR":"吉林化纤","KEYWORD":"品牌效应的重要作用","MAINPOINT":10,"MAINPOINT_CONTENT":"公司相继通过了IS09001:2000质量管理体系、IS014001环境管理体系和 GB/T28001职业健康安全管理体系认证，并率先在全国同行业获得质量、环境、职业健康安全三体系整合注册认证。产品通过了国际环保纺织标准0eko-TexStandard100的认证，“白山”牌粘胶短纤获得国家唯一的最高级别银质奖，2007年“白山牌”粘胶长丝、粘胶短纤双双荣获了“中国名牌产品”的殊荣。公司曾先后被评为“全国用户满意企业”“全国质量效益型先进企业”“中国企业信息化500强”等诸多殊荣。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"}]}