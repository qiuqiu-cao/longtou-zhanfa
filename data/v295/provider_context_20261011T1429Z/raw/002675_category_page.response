RITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"867","BOARD_NAME":"富时罗素","IS_PRECISE":"0","BOARD_RANK":14},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","IS_PRECISE":"0","BOARD_RANK":15},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"804","BOARD_NAME":"深股通","IS_PRECISE":"0","BOARD_RANK":16},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"596","BOARD_NAME":"融资融券","IS_PRECISE":"0","BOARD_RANK":17},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"1656","BOARD_NAME":"特色药","IS_PRECISE":"1","BOARD_RANK":18},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"1659","BOARD_NAME":"精准诊断","IS_PRECISE":"1","BOARD_RANK":19},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"1657","BOARD_NAME":"病原体防治","IS_PRECISE":"1","BOARD_RANK":20},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"1106","BOARD_NAME":"创新药","IS_PRECISE":"1","BOARD_RANK":21},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"1056","BOARD_NAME":"幽门螺杆菌概念","IS_PRECISE":"1","BOARD_RANK":22},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"944","BOARD_NAME":"肝素概念","IS_PRECISE":"1","BOARD_RANK":23},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"899","BOARD_NAME":"CRO","IS_PRECISE":"1","BOARD_RANK":24},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"894","BOARD_NAME":"阿兹海默","IS_PRECISE":"1","BOARD_RANK":25},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"806","BOARD_NAME":"精准医疗","IS_PRECISE":"1","BOARD_RANK":26},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"698","BOARD_NAME":"免疫治疗","IS_PRECISE":"1","BOARD_RANK":27},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"676","BOARD_NAME":"独家药品","IS_PRECISE":"1","BOARD_RANK":28},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"615","BOARD_NAME":"中药概念","IS_PRECISE":"1","BOARD_RANK":29}],"hxtc":[{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"经营范围","MAINPOINT":2,"MAINPOINT_CONTENT":"原料药(肝素钠、肝素钙、硫酸软骨素钠、硫酸软骨素钠(供注射用)、那屈肝素钙、依诺肝素钠、达肝素钠)的生产、加工和销售;硫酸软骨素、胶原蛋白、透明质酸、细胞色素C(冻干)、鲨鱼骨粉、盐酸氨基葡萄糖的生产、加工和销售;货物及技术进出口;医药技术和产品的研发及成果转让、相关技术咨询及服务。(依法须经批准的项目,经相关部门批准后方可开展经营活动,有效期以许可证为准)","KEY_CLASSIF":"经营范围","KEY_CLASSIF_CODE":"002","IS_POINT":"0"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"核医药业务板块","MAINPOINT":3,"MAINPOINT_CONTENT":"（一）公司近年来重点打造从诊断用核药到治疗用核药的全产业链体系，全面布局诊疗一体化和精准医疗。\n（二）以米度生物为核心，以公司核医疗全产业链为基础，以核医学技术为抓手，为国内外药企客户提供CRDMO服务。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"化药业务板块","MAINPOINT":4,"MAINPOINT_CONTENT":"（一）原料药业务板块\n公司作为专业的肝素API生产商和硫酸软骨素（药品级和膳食补充剂级）的全球供应商，销售网络遍布全球40多个国家和地区，在生化原料药行业内拥有领先地位。\n（二）制剂业务板块\n公司制剂产品管线丰富，拥有年产7000万支的冻干粉针剂生产线、水针生产线及多条固体制剂生产线（片剂、胶囊剂、颗粒剂、软胶囊剂、滴丸剂），产品全面覆盖抗凝、心血管、抗肿瘤、泌尿、骨科及抗感染等多个治疗领域。","KEY_CLASSIF":"主营业务","KEY_CLASSIF_CODE":"003","IS_POINT":"0"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"医药制造业","MAINPOINT":5,"MAINPOINT_CONTENT":"2025年作为“十四五”规划的收官之年，是向“十五五”启航过渡的关键枢纽年。2025年1-12月，医药制造业规模以上工业企业实现营业收入24,870亿元，同比下降1.2%；营业成本14,362亿元，同比下降1.3%；利润总额3,490亿元，同比增长2.7%。呈现“营收微降、利润微增”的经营态势。中国医药行业处于“政策引领、创新驱动、监管强化、医保优化”四大核心趋势，正从规模扩张转向高质量发展，从要素驱动转向创新导向，从跟随模仿转向引领突破，行业发展带来了新的机遇与挑战。","KEY_CLASSIF":"行业背景","KEY_CLASSIF_CODE":"004","IS_POINT":"1"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"多维共振，为核医药产业赋能","MAINPOINT":6,"MAINPOINT_CONTENT":"公司积极扩展在核医疗产业链各环节的布局—从同位素供应、药物研发到生产、配送及临床应用—逐步构建完整的生态体系。该策略不仅确保关键原料的稳定供应，更有助于推动放射性药物在肿瘤等重大疾病领域的临床转化与广泛应用。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"垂直整合，发挥原料与制剂的链条优势","MAINPOINT":7,"MAINPOINT_CONTENT":"作为肝素行业领先企业，公司拥有垂直一体化的肝素全产业链，公司肝素API出口、硫酸软骨素生产居于行业领先。公司构建了从原料药到制剂产品的完整制药产业链，并且持续不断地向上下游延伸、完善。原料药与制剂产品的垂直一体化产业链，不但能够为制剂产品提供稳定的原料来源，也带动了原料药业务的发展，赋予了其在成本控制上的强劲实力以及市场竞争中的显著优势。\n公司不断夯实特色原料药基础，大力发展制剂业务，进一步完善在抗凝领域的产品线布局，做细分治疗领域的领军者。2025年，公司高规格硫酸软骨素以过硬的资质和稳定的质量得到客户的一致认可，销量创历史新高；肝素钠原料药出口位列前茅，以零缺陷（零483）通过美国食品药品监督管理局（FDA）现场检查，标志着东诚药业的质量体系建设和管理能力得到了国际认可，有助于进一步开拓国内外市场。制剂销售总量屡创新高，其中注射用氢化可的松琥珀酸钠年销量单品突破1000万支，产品市场覆盖和品牌影响力持续提升。","KEY_CLASSIF":"核心竞争力","KEY_CLASSIF_CODE":"005","IS_POINT":"1"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"拟收购广东回旋等五家公司股权","MAINPOINT":9,"MAINPOINT_CONTENT":"2019年1月7日公告,公司近日与广东高尚集团有限公司签署《股权转让意向协议》,公司拟通过收购控股广东回旋医药科技股份有限公司、湖南省回旋医药科技有限公司、昆明回旋医药科技有限公司、四川省回旋医药科技有限公司,拟通过收购参股广东高尚医学影像科技有限公司。广东回旋、湖南回旋、昆明回旋、四川回旋四家公司主要从事氟[18F]脱氧葡萄糖注射液(18F-FDG)等正电子放射性药物的规范化生产、配送和核医学领域相关技术服务,属于核药中心业务模式。如广东回旋、湖南回旋、昆明回旋、四川回旋四家公司能够成功收购,公司将分别在广东、湖南、云南和四川这四个省区快速各新增一个核药中心。高尚医学影像主要从事独立第三方医学影像诊断业务。如高尚医学影像能够成功收购,将是公司向核医药诊断下游独立第三方医学影像中心的一次有益探索,符合公司在核医药领域的长远布局。","KEY_CLASSIF":"对外扩张","KEY_CLASSIF_CODE":"006002","IS_POINT":"1"},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","KEYWORD":"下属公司获得药品GMP证书","MAINPOINT":8,"MAINPOINT_CONTENT":"2018年10月10日公告,公司于2018年10月10日收到全资子公司安迪科的通知,安迪科全资子公司广东安迪科正电子技术有限公司收到广东省食品药品监督管理局颁发的《药品GMP证书》,认证范围:体内放射性药品(小容量注射液,氟[18F]脱氧葡糖注射液)。广东安迪科正电子技术有限公司取得药品GMP证书,标志着安迪科的广东核药中心已达到投产要求,安迪科将新增一个核药中心。","KEY_CLASSIF":"其他项目","KEY_CLASSIF_CODE":"010","IS_POINT":"1"}]}