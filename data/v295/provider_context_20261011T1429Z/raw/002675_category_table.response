{"version":"a1e5b460236f9751c081d2d9f3d8aba2","result":{"pages":1,"data":[{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"944","BOARD_NAME":"肝素概念","SELECTED_BOARD_REASON":"2020年7月27日回复称公司产品中包括肝素原料药。","IS_PRECISE":"1","BOARD_RANK":23,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0944","DERIVE_BOARD_CODE":"BI0944","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"899","BOARD_NAME":"CRO","SELECTED_BOARD_REASON":"2025年年报显示，在非核药领域，米度生物作为分子影像 CRO，在小分子、多肽、抗体、多糖、细胞治疗等创新品类上的临床前分子标记能力卓越，能够为客户提供定制化的伴随诊断方案，具有良好的放射性示踪剂生产和影像分析能力。","IS_PRECISE":"1","BOARD_RANK":24,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0899","DERIVE_BOARD_CODE":"BI0899","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"894","BOARD_NAME":"阿兹海默","SELECTED_BOARD_REASON":"2023年9月15日回复称,老年痴呆领域为公司在研产品布局管线之一,其中老年痴呆诊断性核素药物18F-APN-1607国内目前正在进行III临床试验,临床病例入组已经过半;关于老年痴呆治疗性药物,公司的参股公司新旭生技的mAb005产品据了解目前已在美国开展I临床试验。","IS_PRECISE":"1","BOARD_RANK":25,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0894","DERIVE_BOARD_CODE":"BI0894","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"879","BOARD_NAME":"标准普尔","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":13,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0879","DERIVE_BOARD_CODE":"BI0879","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"867","BOARD_NAME":"富时罗素","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":14,"BOARD_YIELD":null,"NEW_BOARD_CODE":"BK0867","DERIVE_BOARD_CODE":"BI0867","BOARD_TYPE":null,"BOARD_LEVEL":null},{"SECUCODE":"002675.SZ","SECURITY_CODE":"002675","SECURITY_NAME_ABBR":"东诚药业","BOARD_CODE":"815","BOARD_NAME":"昨日涨停","SELECTED_BOARD_REASON":null,"IS_PRECISE":"0","BOARD_RANK":15,"BOARD_YIELD":null,"NEW_BOARD_CODE":