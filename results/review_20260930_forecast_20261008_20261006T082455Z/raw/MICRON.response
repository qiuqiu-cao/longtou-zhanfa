<script type="text/javascript">
//<![CDATA[
(function(){ try {
$('head').append('<link rel="stylesheet" type="text/css" href="/files/header/new-corp-fonts.css">');

var $embed = $($tudio('#_ctrl0_ctl04_divShadowHost')[0].shadowRoot);
// Treat the Shadow Root as our "document"
const root = $embed[0];

// ── Nav constants ────────────────────────────────────────────────────────────
const ACTIVE      = 'active';
const HIDDEN      = 'hidden';
const CLS_LANG    = 'cmp-language';
const CLS_NAV     = 'cmp-nav';
const CLS_NAV_MOB = 'cmp-nav-mobile';
const CLS_SEARCH  = 'cmp-header-search';

// ── Hero / transparency markers (queried once) ───────────────────────────────
const heroBanner      = root.querySelector('.heroBanner');
const heroBannerCarousel = root.querySelector('.herobannercarousel');
const transparentMarker      = root.querySelector('.set-header-transparent');
const transparentBlackMarker = root.querySelector('.set-header-transparent-blacktxt');
const headerEl = root.querySelector('.cmp-header');

// ── Toggles ──────────────────────────────────────────────────────────────────
function toggleLanguageDropdown(globeBtn, clearBtn, dropdown) {
    globeBtn.classList.toggle(HIDDEN);
    clearBtn.classList.toggle(HIDDEN);
    dropdown.classList.toggle(ACTIVE);

    const overlay    = root.querySelector('.overlay');
    const activeItem = root.querySelector('.active:not(.overlay)');
    if (dropdown && overlay) {
        if (dropdown.classList.contains(ACTIVE) && !overlay.classList.contains(ACTIVE)) {
            overlay.classList.add(ACTIVE);
        } else if (!activeItem) {
            overlay.classList.remove(ACTIVE);
        }
    }
}

function toggleNavMenu() {
    const wrapper   = root.querySelector('.cmp-header__wrapper') || root;
    const hamburger = wrapper.querySelector('#nav-hamburger');
    const menuClear = wrapper.querySelector('#menu-clear');
    if (hamburger && menuClear) {
        hamburger.classList.toggle(HIDDEN);
        menuClear.classList.toggle(HIDDEN);
    }

    const nav      = wrapper.querySelector('.cmp-nav');
    const navMobile = wrapper.querySelector('.cmp-nav-mobile');
    const overlay  = wrapper.querySelector('.overlay');
    if (nav && navMobile && overlay) {
        nav.classList.toggle(ACTIVE);
        navMobile.classList.toggle(ACTIVE);

        const activeItem = root.querySelector('.active:not(.overlay)');
        const navOpen = nav.classList.contains(ACTIVE) || navMobile.classList.contains(ACTIVE);
        if (!navOpen || overlay.classList.contains(ACTIVE)) {
            if (!activeItem) overlay.classList.remove(ACTIVE);
        } else {
            overlay.classList.add(ACTIVE);
        }
    }
}

// ── Header click setup ───────────────────────────────────────────────────────
function setupHeaderClicks(closeActiveNavItems) {
    const wrapper     = root.querySelector('.cmp-header__wrapper') || root;
    const globeBtn    = wrapper.querySelector('#language-globe');
    const clearBtn    = wrapper.querySelector('#language-clear');
    const dropdown    = wrapper.querySelector('#language-dropdown');
    const langBtn     = wrapper.querySelector('.cmp-header__lang-btn');
    const navLang     = wrapper.querySelector('.cmp-nav__lang');
    const goBackIcon  = wrapper.querySelector('.cmp-language__go-back-icon-wrapper');
    const searchBtn   = wrapper.querySelector('#header-search-btn');
    const menuBtn     = wrapper.querySelector('.cmp-header__menu');
    const hamburger   = wrapper.querySelector('#nav-hamburger');
    const menuClear   = wrapper.querySelector('#menu-clear');
    const nav         = wrapper.querySelector('.cmp-nav');
    const navMobile   = wrapper.querySelector('.cmp-nav-mobile');
    const overlay     = wrapper.querySelector('.overlay');
    const signinArrow = wrapper.querySelector('.signin__arrow');

    // Close all active items except the one identified by `exceptClass`
    function closeOtherActiveItems(exceptClass) {
        const activeItems = wrapper.querySelectorAll('.active:not(.overlay)');
        if (!activeItems) return;
        activeItems.forEach(function(item) {
            const isNavMobileForNav = exceptClass === CLS_NAV && item.classList.contains(CLS_NAV_MOB);
            if (exceptClass) {
                if (exceptClass !== CLS_NAV && (item.classList.contains(CLS_NAV) || item.classList.contains(CLS_NAV_MOB))) {
                    // Opening something other than nav — close nav if open
                    if (nav.classList.contains(ACTIVE)) {
                        nav.classList.remove(ACTIVE);
                        navMobile.classList.remove(ACTIVE);
                    }
                } else if (!item.classList.contains(exceptClass) && !isNavMobileForNav) {
                    item.classList.remove(ACTIVE);
                }
            } else {
                item.classList.remove(ACTIVE);
            }

            // Reset language globe/clear
            if (exceptClass !== CLS_LANG && item.classList.contains(CLS_LANG) && globeBtn?.classList.contains(HIDDEN)) {
                globeBtn.classList.remove(HIDDEN);
                clearBtn?.classList.add(HIDDEN);
            }
            // Reset search button text
            if (exceptClass !== CLS_SEARCH && item.classList.contains(CLS_SEARCH) && searchBtn?.firstElementChild?.textContent === 'clear') {
                searchBtn.firstElementChild.textContent = 'search';
            }
            // Reset hamburger/menu-clear
            if (exceptClass !== CLS_NAV && (item.classList.contains(CLS_NAV) || item.classList.contains(CLS_NAV_MOB)) && hamburger?.classList.contains(HIDDEN)) {
                hamburger.classList.remove(HIDDEN);
                menuClear?.classList.add(HIDDEN);
            }
            // Reset signin arrow
            if (exceptClass !== 'cmp-account' && item.classList.contains('cmp-account') && signinArrow && signinArrow.textContent === 'keyboard_arrow_up') {
                signinArrow.textContent = 'keyboard_arrow_down';
            }
        });
    }

    if (dropdown) {
        if (langBtn) {
            langBtn.onclick = function() {
                closeOtherActiveItems(CLS_LANG);
                toggleLanguageDropdown(globeBtn, clearBtn, dropdown);
            };
        }
        if (navLang) {
            navLang.onclick = function() { toggleLanguageDropdown(globeBtn, clearBtn, dropdown); };
        }
        if (goBackIcon) {
            goBackIcon.onclick = function() { toggleLanguageDropdown(globeBtn, clearBtn, dropdown); };
        }
    }

    if (menuBtn) {
        menuBtn.onclick = function() {
            closeOtherActiveItems(CLS_NAV);
            toggleNavMenu();
            closeActiveNavItems();
        };
    }

    if (overlay) {
        overlay.onclick = function() {
            closeOtherActiveItems();
            overlay.classList.remove(ACTIVE);
            if (signinArrow && signinArrow.textContent === 'keyboard_arrow_up') {
                signinArrow.textContent = 'keyboard_arrow_down';
            }
            const xssValidation = root.querySelector('#xssValidation');
            if (xssValidation) xssValidation.classList.remove('show');
        };
    }
}

// ── Header transparency ──────────────────────────────────────────────────────
function handleHeaderTransparency() {
    if (!headerEl) return;

    if (heroBanner) heroBanner.classList.add('hero-banner--transparent-offset');
    if (heroBannerCarousel) heroBannerCarousel.classList.add('hero-banner--transparent-offset');

    function check() {
        const openPanels = root.querySelectorAll('.cmp-navmenu__panel:not([hidden])').length;
        const searchOpen = !!root.querySelector('.cmp-header-search.width-resizer');
        const scrolled = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop;
        if (openPanels || scrolled || searchOpen) {
            headerEl.classList.remove('transperant-bg', 'transperant-bg-black-txt');
        } else {
            headerEl.classList.add('transperant-bg');
        }
    }

    document.addEventListener('scroll', check);
    check();
}

function handleHeaderTransparencyBlackTxt() {
    if (!transparentBlackMarker || !headerEl) return;

    if (heroBanner) heroBanner.classList.add('hero-banner--transparent-offset');
    if (heroBannerCarousel) heroBannerCarousel.classList.add('hero-banner--transparent-offset');

    function check() {
        const openPanels = root.querySelectorAll('.cmp-navmenu__panel:not([hidden])').length;
        const searchOpen = !!root.querySelector('.cmp-header-search.width-resizer');
        const scrolled = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop;
        if (openPanels || scrolled || searchOpen) {
            headerEl.classList.remove('transperant-bg', 'transperant-bg-black-txt');
        } else {
            headerEl.classList.add('transperant-bg-black-txt');
        }
    }

    document.addEventListener('scroll', check);
    check();
}

// ── Keyboard nav ─────────────────────────────────────────────────────────────
function setNavKeydown() {
    const menuBtn = root.querySelector('.cmp-header__menu');
    if (!menuBtn) {
        console.error('nav menu button not found.');
        return;
    }
    menuBtn.onkeydown = function(e) {
        if (e.key !== 'Tab' || e.shiftKey) return;

        const desktopVisible = root.querySelector('.cmp-nav').checkVisibility();
        const mobileVisible  = root.querySelector('.cmp-nav-mobile').checkVisibility();
        if (!desktopVisible && !mobileVisible) return;

        const firstItem = desktopVisible
            ? root.querySelector('.cmp-nav.active li[tabIndex="0"]')
            : root.querySelector('.cmp-nav-mobile.active button');
        if (!firstItem) {
            console.error('menu item not found');
            return;
        }
        e.preventDefault();
        firstItem.focus();
    };
}

// ── Desktop nav panel clicks ─────────────────────────────────────────────────
function setDesktopNavClicks() {
    const navLinks       = root.querySelectorAll('.cmp-navmenu__link');
    const panels         = root.querySelectorAll('.cmp-navmenu__panel');
    const navMenu        = root.querySelector('.cmp-navmenu');
    const panelsContainer = root.querySelector('.cmp-header__panels');

    if (!navMenu || !panelsContainer) {
        console.error('Desktop nav containers not found.');
        return;
    }

    const wrapper     = root.querySelector('.cmp-header__wrapper') || root;
    const globeBtn    = wrapper?.querySelector('#language-globe');
    const clearBtn    = wrapper?.querySelector('#language-clear');
    const signinArrow = wrapper?.querySelector('.signin__arrow');
    const searchBtn   = wrapper?.querySelector('#header-search-btn');
    const overlay     = wrapper?.querySelector('.overlay');
    const dropdown    = wrapper?.querySelector('#language-dropdown');
    const accountMenu = wrapper?.querySelector('.cmp-account');
    const headerSearch = wrapper?.querySelector('.cmp-header-search');

    function closeAllPanels() {
        panels.forEach(function(panel) { panel.setAttribute('hidden', ''); });
        navLinks.forEach(function(link) {
            link.setAttribute('aria-expanded', 'false');
            link.classList.remove(ACTIVE);
            if ((transparentMarker || transparentBlackMarker) && headerEl && (heroBanner || heroBannerCarousel)) {
                const searchOpen = !!root.querySelector('.cmp-header-search.width-resizer');
                if (!(window.scrollY || document.documentElement.scrollTop || document.body.scrollTop) && !searchOpen) {
                    headerEl.classList.add('transperant-bg');
                }
            }
        });
    }

    function closeOtherOpenItems() {
        if (dropdown?.classList.contains(ACTIVE)) {
            dropdown.classList.remove(ACTIVE);
            globeBtn?.classList.remove(HIDDEN);
            clearBtn?.classList.add(HIDDEN);
        }
        if (accountMenu?.classList.contains(ACTIVE)) {
            accountMenu.classList.remove(ACTIVE);
            if (signinArrow?.textContent === 'keyboard_arrow_up') {
                signinArrow.textContent = 'keyboard_arrow_down';
            }
        }
        if (headerSearch?.classList.contains(ACTIVE)) {
            headerSearch.classList.remove(ACTIVE);
            if (searchBtn?.firstElementChild?.textContent === 'clear') {
                searchBtn.firstElementChild.textContent = 'search';
            }
        }
        overlay?.classList.remove(ACTIVE);
    }

    navLinks.forEach(function(link) {
        link.onclick = function() {
            const panelId = link.getAttribute('aria-controls');
            if (!panelId) {
                console.error('aria-controls attribute not found on nav link.', link);
                return;
            }
            const panel = root.querySelector('#' + panelId);
            if (!panel) {
                console.error('Panel with id "' + panelId + '" not found.');
                return;
            }

            if (link.classList.contains(ACTIVE)) {
                closeAllPanels();
            } else {
                closeOtherOpenItems();
                closeAllPanels();
                panel.removeAttribute('hidden');
                link.setAttribute('aria-expanded', 'true');
                link.classList.add(ACTIVE);
                if (headerEl) headerEl.classList.remove('transperant-bg', 'transperant-bg-black-txt');
            }
        };
    });

    function handleOutsideClick(e) {
        const path = e.composedPath();
        if (!path.includes(panelsContainer) && !path.includes(navMenu)) {
            closeAllPanels();
        }
    }
    document.addEventListener('click', handleOutsideClick);
}

// ── Mobile nav construction ──────────────────────────────────────────────────
function buildMobileNavLevelOne() {
    const navLinks  = root.querySelectorAll('.cmp-nav .cmp-navmenu__item .cmp-navmenu__link');
    const container = root.querySelector('.cmp-nav-mobile .cmp-nav__categories');
    if (!container || !navLinks.length) return;

    container.innerHTML = '';
    navLinks.forEach(function(link) {
        const label = link.textContent?.trim();
        if (!label) return;

        const panelId = link.getAttribute('aria-controls');
        const li      = document.createElement('li');
        li.className  = 'cmp-nav__category';
        if (panelId) li.dataset.panelId = panelId;

        const btn     = document.createElement('button');
        btn.type      = 'button';
        btn.className = 'cmp-nav__category-btn';
        btn.innerHTML = '<span class="cmp-nav__category-label">' + label + '</span><em class="material-icons">expand_more</em>';

        const ul     = document.createElement('ul');
        ul.className = 'cmp-nav__category-items';

        li.append(btn, ul);
        container.appendChild(li);

        btn.addEventListener('click', function() {
            if (!li.classList.contains(ACTIVE)) {
                const current = container.querySelector('.cmp-nav__category.' + ACTIVE);
                if (current) current.classList.remove(ACTIVE);
            }
            li.classList.toggle(ACTIVE);
        });
    });
}

function populateMobileNavLevelTwo() {
    const categories    = root.querySelectorAll('.cmp-nav-mobile .cmp-nav__category');
    const panelsWrapper = root.querySelector('.cmp-header__panels-wrapper');
    if (!categories.length || !panelsWrapper) return;

    categories.forEach(function(category) {
        const panelId   = category.dataset.panelId;
        const itemsList = category.querySelector('.cmp-nav__category-items');
        if (!panelId || !itemsList) return;

        const panel = panelsWrapper.querySelector('#' + CSS.escape(panelId));
        if (!panel) return;

        const links = panel.querySelectorAll('.cmp-title__link, .cmp-text a');
        links.forEach(function(linkEl) {
            const href  = linkEl.getAttribute('href');
            const label = linkEl.textContent?.trim();
            if (!href || !label) return;

            const li     = document.createElement('li');
            li.className = 'cmp-nav__category-item cmp-nav__category-item--split';

            const div     = document.createElement('div');
            div.className = 'd-flex';

            const a = document.createElement('a');
            a.className = 'cmp-nav__category-item-link';
            a.setAttribute('data-level', '2');
            a.href = href;

            const span       = document.createElement('span');
            span.className   = 'cmp-nav__category-item-label';
            span.textContent = label;
            a.appendChild(span);
            div.appendChild(a);
            li.appendChild(div);

            // Check for a sibling list that becomes level-3
            const parentEl        = linkEl.closest('.cmp-title, .cmp-text');
            const parentContainer = parentEl?.parentElement;
            const sibling         = parentContainer?.nextElementSibling;
            let listEl = null;
            if (sibling?.classList.contains('list')) {
                listEl = sibling.querySelector('.cmp-list');
            }
            if (!listEl && sibling?.querySelector('.cmp-list')) {
                listEl = sibling.querySelector('.cmp-list');
            }

            if (listEl) {
                a.removeAttribute('href');
                a.style.cursor = 'pointer';

                const toggleLevel3 = function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    li.classList.toggle(ACTIVE);
                    const cats = li.closest('.cmp-nav__categories');
                    if (cats) cats.classList.add('level-3-open');
                    const cat = li.closest('.cmp-nav__category');
                    if (cat) cat.classList.add('level-3-active');
                };
                a.addEventListener('click', toggleLevel3);

                const arrowBtn     = document.createElement('button');
                arrowBtn.type      = 'button';
                arrowBtn.className = 'cmp-nav__category-item-arrow';
                arrowBtn.innerHTML = '<em class="material-icons">chevron_right</em>';
                arrowBtn.addEventListener('click', toggleLevel3);
                div.appendChild(arrowBtn);

                const subUl     = document.createElement('ul');
                subUl.className = 'cmp-nav__category-item-link-list';

                const backLi      = document.createElement('li');
                backLi.className  = 'cmp-nav__category-item-link-list-item back-item';
                const backBtn     = document.createElement('button');
                backBtn.type      = 'button';
                backBtn.className = 'cmp-nav__category-item-child-link back-button';
                backBtn.innerHTML = '<em class="material-icons">chevron_left</em> ' + label;
                backBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    li.classList.remove(ACTIVE);
                    const cats = li.closest('.cmp-nav__categories');
                    if (cats) cats.classList.remove('level-3-open');
                    const cat = li.closest('.cmp-nav__category');
                    if (cat) cat.classList.remove('level-3-active');
                });
                backLi.appendChild(backBtn);
                subUl.appendChild(backLi);

                const seeLi      = document.createElement('li');
                seeLi.className  = 'cmp-nav__category-item-link-list-item';
                const seeA       = document.createElement('a');
                seeA.className   = 'cmp-nav__category-item-child-link';
                seeA.href        = href;
                seeA.textContent = label;
                seeLi.appendChild(seeA);
                subUl.appendChild(seeLi);

                listEl.querySelectorAll('.cmp-list__item-link').forEach(function(childLink) {
                    const childHref  = childLink.getAttribute('href');
                    const titleEl    = childLink.querySelector('.cmp-list__item-title');
                    const childLabel = titleEl ? titleEl.textContent?.trim() : childLink.textContent?.trim();
                    if (!childHref || !childLabel) return;

                    const childLi      = document.createElement('li');
                    childLi.className  = 'cmp-nav__category-item-link-list-item';
                    const childA       = document.createElement('a');
                    childA.className   = 'cmp-nav__category-item-child-link';
                    childA.href        = childHref;
                    childA.textContent = childLabel;
                    childLi.appendChild(childA);
                    subUl.appendChild(childLi);
                });

                li.appendChild(subUl);
            }

            itemsList.appendChild(li);
        });
    });
}

function buildFaceLinks() {
    const sideLinks  = root.querySelector('.cmp-header-face-wrapper .left-sidelinks');
    const mobileHead = root.querySelector('.cmp-nav-mobile .mobile-header-face');
    if (sideLinks && mobileHead) mobileHead.innerHTML = sideLinks.innerHTML;
}

// ── Header search ────────────────────────────────────────────────────────────
function setHeaderSearch() {
    const searchApiEl = root.querySelector('#search-api-path');
    let   searchApiBase = null;
    if (searchApiEl) {
        const base  = searchApiEl.getAttribute('value');
        searchApiBase = function(q) { return base + '' + q; };
    }

    const searchField     = root.querySelector('.cmp-header-search .cmp-search-field');
    const searchContainer = root.querySelector('.cmp-header-search');
    const loader          = root.querySelector('.cmp-header-search_loader');
    if (!searchField) return;

    const textInput      = searchField.querySelector('.cmp-text-input');
    const suggestionsBox = searchContainer?.querySelector('.cmp-input-suggestions');
    const suggestionList = suggestionsBox?.querySelector('.cmp-suggestions-list');
    const announcer      = searchField.querySelector('.cmp-search-field__announce');

    let suggestions = [];
    let activeIdx   = -1;

    function saveRecentSearch(value) {
        if (!value || !window.DOMPurify) return;
        const sanitized = window.DOMPurify.sanitize(value);
        const recent = JSON.parse(localStorage.getItem('userRecentSearches')) || [];
        if (recent.indexOf(sanitized) === -1) {
            recent.unshift(sanitized);
            if (recent.length > 6) recent.pop();
            localStorage.setItem('userRecentSearches', JSON.stringify(recent));
        }
    }

    function setAriaExpanded(expanded) {
        if (!textInput) return;
        textInput.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        if (!expanded) textInput.removeAttribute('aria-activedescendant');
    }

    function announce(count) {
        if (!announcer) return;
        const annEl  = root.querySelector('.ann-suggestions');
        const noSugg = root.querySelector('.no-sugg');
        announcer.textContent = count
            ? count + ' ' + (annEl?.value || '')
            : '' + (noSugg?.value || '');
    }

    function clearActive() {
        suggestions.forEach(function(s) {
            s.classList.remove('is-active');
            s.setAttribute('aria-selected', 'false');
        });
        activeIdx = -1;
        if (textInput) textInput.removeAttribute('aria-activedescendant');
    }

    function activateItem(idx) {
        if (!suggestions.length) return;
        clearActive();
        const item = suggestions[idx];
        if (!item) return;
        item.classList.add('is-active');
        item.setAttribute('aria-selected', 'true');
        activeIdx = idx;
        if (textInput) textInput.setAttribute('aria-activedescendant', item.id);
        if (announcer) {
            const linkEl = item.querySelector('.cmp-suggestions-list-link');
            const text   = linkEl?.textContent.trim() ?? item.textContent.trim();
            announcer.textContent = text + ', suggestion ' + (activeIdx + 1) + ' of ' + suggestions.length + '.';
        }
    }

    function moveActive(delta) {
        if (suggestions.length) activateItem((activeIdx + delta + suggestions.length) % suggestions.length);
    }

    function clearSuggestions(opts) {
        clearActive();
        suggestions = [];
        if (suggestionsBox) suggestionsBox.style.display = 'none';
        if (suggestionList) suggestionList.innerHTML = '';
        setAriaExpanded(false);
        if (!opts?.keepMessage && announcer) announcer.textContent = '';
    }

    async function fetchSuggestions(query) {
        const apiEl = root.querySelector('#suggestions-api-path');
        if (!apiEl || !loader) return;
        loader.style.display = 'block';
        try {
            const url  = apiEl.getAttribute('value').replace('SEARCH-TEXT', query.toLowerCase());
            const res  = await fetch(url);
            const data = await res.json();
            const raw  = Array.isArray(data) ? data : (Array.isArray(data?.suggestions) ? data.suggestions : []);
            const countEl = root.querySelector('#suggestions-search-number-of-result');
            const max  = parseInt(countEl?.getAttribute('value')) || raw.length;
            const items = raw.slice(0, max);

            if (suggestionsBox && suggestionList) {
                if (items.length) {
                    suggestionList.innerHTML = items.map(function(item, i) {
                        return '<li class="cmp-suggestions-list-item" role="option" id="header-search-option-' + i + '" aria-selected="false">'
                            + '<a href="' + item.pageUrl + '" class="cmp-suggestions-list-link">' + item.suggestion + '</a>'
                            + '</li>';
                    }).join('');
                    suggestionsBox.style.display = 'block';
                    suggestions = Array.from(suggestionList.querySelectorAll('.cmp-suggestions-list-item'));
                    suggestions.forEach(function(el, i) {
                        el.id = 'header-search-option-' + i;
                        el.setAttribute('aria-selected', 'false');
                    });
                    clearActive();
                    suggestions.length ? (setAriaExpanded(true), announce(suggestions.length)) : (setAriaExpanded(false), announce(0));
                } else {
                    clearSuggestions();
                    announce(0);
                }
            }
        } catch (err) {
            console.log('err', err);
        }
        loader.style.display = 'none';
    }

    // Form submit
    searchField.addEventListener('submit', function(e) {
        e.preventDefault();
        const input      = e.target.elements.searchValue;
        const xssEl      = root.querySelector('#xssValidation');
        const suggestWrapper = root.querySelector('.cmp-suggestions-wrapper');

        if (/<\/?[^>]+(>|$)/g.test(input.value)) {
            if (xssEl) {
                xssEl.classList.add('show');
                if (suggestWrapper) suggestWrapper.appendChild(xssEl);
            }
            if (loader) loader.style.display = 'none';
        } else {
            if (xssEl) xssEl.classList.remove('show');
            if (loader) loader.style.display = 'block';
            saveRecentSearch(input.value);
            sessionStorage.setItem('header-search-submitted', 'true');
            if (searchApiBase) window.location.href = searchApiBase(input.value);
        }
    });

    if (textInput) {
        const xssEl  = root.querySelector('#xssValidation');
        const hideXss = function() { if (xssEl) xssEl.classList.remove('show'); };

        textInput.addEventListener('keydown', function(e) {
            
            if (e.key === ' ' || e.code === 'Space') {
                e.stopPropagation();
            }
            if (!suggestions.length && e.key !== 'Escape') return;
            switch (e.key) {
                case 'ArrowDown':
                    e.preventDefault();
                    moveActive(1);
                    break;
                case 'ArrowUp':
                    e.preventDefault();
                    moveActive(-1);
                    break;
                case 'Enter':
                    if (activeIdx >= 0) {
                        e.preventDefault();
                        const activeItem = suggestions[activeIdx];
                        if (activeItem && textInput) {
                            const linkEl  = activeItem.querySelector('.cmp-suggestions-list-link');
                            const text    = linkEl?.textContent.trim() ?? activeItem.textContent.trim();
                            const suggActive = root.querySelector('.sugg-active-opt');
                            textInput.value = text;
                            if (announcer) announcer.textContent = text + ' ' + (suggActive?.value || '');
                            clearSuggestions({ keepMessage: true });
                        }
                    }
                    break;
                case 'Escape':
                    hideXss();
                    clearSuggestions();
                    break;
            }
        });

        textInput.addEventListener('input', function(e) {
            const val = e.target.value;
            if (val.length > 2) {
                fetchSuggestions(val);
            } else {
                if (loader) loader.style.display = 'none';
                clearSuggestions();
                announce(0);
            }
            if (xssEl?.classList.contains('show')) {
                hideXss();
                if (loader) loader.style.display = 'none';
                clearSuggestions();
            }
        });

        textInput.addEventListener('focus', function() {
            if (searchContainer) searchContainer.classList.add('width-resizer');
            const recent = JSON.parse(localStorage.getItem('userRecentSearches'));
            if (recent?.length > 0) {
                const recentEl = searchContainer?.querySelector('.cmp-recentsearch');
                if (recentEl) recentEl.classList.remove(HIDDEN);
            }
            if (headerEl) headerEl.classList.remove('transperant-bg', 'transperant-bg-black-txt');
        });

        textInput.addEventListener('blur', hideXss);

        document.addEventListener('click', function(e) {
            const path = e.composedPath();
            if (searchContainer && !path.includes(searchContainer)) {
                searchContainer.classList.remove('width-resizer');
                textInput.value = '';
                clearSuggestions();
                const recentEl = searchContainer.querySelector('.cmp-recentsearch');
                if (recentEl) recentEl.classList.add(HIDDEN);
                hideXss();
                window.dispatchEvent(new Event('scroll'));
            }
        });
    }

    // Mobile search icon toggle
    const mobileSearchIcon = root.querySelector('.cmp-nav__wrapper .mobile-search-icon');
    const logoWrapper      = root.querySelector('.cmp-header__logo-wrapper');
    if (mobileSearchIcon && searchContainer && logoWrapper) {
        mobileSearchIcon.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileSearchIcon.style.display = 'none';
            logoWrapper.style.display      = 'none';
            searchContainer.style.display  = 'block';

            const wrapper   = root.querySelector('.cmp-header__wrapper') || root;
            const nav       = wrapper.querySelector('.cmp-nav');
            const navMobile = wrapper.querySelector('.cmp-nav-mobile');
            const overlay   = wrapper.querySelector('.overlay');
            const hamburger = wrapper.querySelector('#nav-hamburger');
            const menuClear = wrapper.querySelector('#menu-clear');
            if (navMobile?.classList.contains(ACTIVE)) {
                if (nav)       nav.classList.remove(ACTIVE);
                navMobile.classList.remove(ACTIVE);
                if (overlay)   overlay.classList.remove(ACTIVE);
                if (hamburger) hamburger.classList.remove(HIDDEN);
                if (menuClear) menuClear.classList.add(HIDDEN);
            }
        });

        document.addEventListener('click', function(e) {
            if (searchContainer.style.display !== 'block') return;
            const path = e.composedPath();
            if (!path.includes(searchContainer) && !path.includes(mobileSearchIcon)) {
                searchContainer.style.display  = 'none';
                mobileSearchIcon.style.display = 'block';
                logoWrapper.style.display      = 'block';
            }
        });
    }
}

// ── Notification banner scroll collapse ──────────────────────────────────────
function handleHeaderScroll() {
    const headerEnhanced = root.querySelector('.headerenhanced');
    if (!headerEnhanced) return;

    function onScroll() {
        const scrolled = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop;
        if (scrolled) {
            headerEnhanced.classList.add('scrolled');
        } else {
            headerEnhanced.classList.remove('scrolled');
        }
    }

    document.addEventListener('scroll', onScroll);
    onScroll();
}

// ── Close active mobile nav items ────────────────────────────────────────────
function closeActiveNavItems() {
    const activeCategory = root.querySelector('.cmp-nav-mobile .cmp-nav__category.active');
    if (activeCategory) {
        const activeItem = activeCategory.querySelector('.cmp-nav__category-item.active');
        if (activeItem) activeItem.classList.remove(ACTIVE);
        activeCategory.classList.remove(ACTIVE);
    }
}

// ── Initialization ───────────────────────────────────────────────────────────
function init() {
    buildMobileNavLevelOne();
    populateMobileNavLevelTwo();
    buildFaceLinks();
    setupHeaderClicks(closeActiveNavItems);
    handleHeaderTransparency();
    handleHeaderTransparencyBlackTxt();
    handleHeaderScroll();
    setNavKeydown();
    setDesktopNavClicks();
    setHeaderSearch();
}

// Wait for the header to load before initializing
function waitForHeader() {
    const header = root.querySelector('.cmp-header');
    if (header) {
        init();
    } else {
        setTimeout(waitForHeader, 100);
    }
}

waitForHeader();
} catch(e) { console.error('Embed module script error (host: _ctrl0_ctl04_divShadowHost):', e.message); } })();//]]>
</script>
</form>
