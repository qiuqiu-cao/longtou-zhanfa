<script src="/cms_files/filemanager/1077459795/script/20233/d9e950c10e9041749d2f4a76d4c986f7.js" type="text/javascript" charset="utf-8"></script>	<script type="text/javascript">
		$(function(){
			var str = window.location.href;	
			var index = str.lastIndexOf("\/");  
			str = str.substring(index + 1, str.length);
			var labelIframeUrl = "/cms_files/filemanager/label/"+str;
			var relatedReadingIframeUrl = "/cms_files/filemanager/relatedReading/"+str;
			var relatedServicesIframeUrl = "/cms_files/filemanager/relatedServices/"+str;
          	//404扫描完后放开
			IsLoad(labelIframeUrl,"#labelIframeUrl");
			IsLoad(relatedReadingIframeUrl,'#relatedReadingIframeUrl');
			//IsLoad(relatedServicesIframeUrl,'#relatedServicesIframeUrl');
			$("#labelIframeUrl").attr('src',labelIframeUrl);
			$("#relatedReadingIframeUrl").attr('src',relatedReadingIframeUrl);
			//$("#relatedServicesIframeUrl").attr('src',relatedServicesIframeUrl);
		})

		function iframeAutoFit(iframeObj){
			setTimeout(function(){if(!iframeObj) return;iframeObj.height=(iframeObj.Document?iframeObj.Document.body.scrollHeight:iframeObj.contentDocument.body.offsetHeight);},200)
		}
		
		function IsLoad(_url,iframeId){
		  $.ajax({
			  //url:'http://211.88.32.151'+_url,
              url:_url,
			  type:"get",
			  success:function(){
					$(iframeId).show();
			  },
			  statusCode:{
				404:function(){
				  $(iframeId).hide();
				}
			  }
			});
		}
	</script>
