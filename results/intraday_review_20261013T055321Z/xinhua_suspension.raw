					turnover: "--",
					volume:  "--",
					buy:  "--",
					sell: "--",
					buyoneM: "--",
					buyoneP: "--",
					selloneM: "--",
					selloneP: "--"
			};
		}
		this._update();
	},
	
	_update: function () {
		var _htmlTmp = this._html;
